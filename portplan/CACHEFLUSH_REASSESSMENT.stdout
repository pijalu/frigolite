                    CREATE VIEW TASKINFO as 
                    
                   
                   		select
                    			t.ISSUEID as ISSUEID,
                    			t.OBJECTID as OBJECTID,
                    			t.ASSIGNEDTO as ASSIGNEDTO,
                    			t.TARGETOBJECTIDS as TARGETOBJECTIDS,
                    			t.DUETIME as DUETIME,
