{
  "file": "alter2.test",
  "name": "alter2",
  "tests": [
    {
      "name": "alter2-1.0",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT substr('abcdefg',1,3)",
          "expect": "1 {bad function}"
        }
      ]
    },
    {
      "name": "alter2-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE abc(a, b);\n    INSERT INTO abc VALUES(1, 2);\n    INSERT INTO abc VALUES(3, 4);\n    INSERT INTO abc VALUES(5, 6);"
        }
      ]
    },
    {
      "name": "alter2-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM abc;",
          "expect": "1 2 {} 3 4 {} 5 6 {}"
        }
      ]
    },
    {
      "name": "alter2-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "UPDATE abc SET c = 10 WHERE a = 1;\n    SELECT * FROM abc;",
          "expect": "1 2 10 3 4 {} 5 6 {}"
        }
      ]
    },
    {
      "name": "alter2-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE INDEX abc_i ON abc(c);"
        }
      ]
    },
    {
      "name": "alter2-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT c FROM abc ORDER BY c;",
          "expect": "{} {} 10"
        }
      ]
    },
    {
      "name": "alter2-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM abc WHERE c = 10;",
          "expect": "1 2 10"
        }
      ]
    },
    {
      "name": "alter2-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT sum(a), c FROM abc GROUP BY c;",
          "expect": "8 {} 1 10"
        }
      ]
    },
    {
      "name": "alter2-1.9",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM abc;"
        },
        {
          "type": "exec",
          "sql": "UPDATE abc SET d = 11 WHERE c IS NULL AND a\u003c4;\n    SELECT * FROM abc;",
          "expect": "1 2 10 {} 3 4 {} 11 5 6 {} {}"
        }
      ]
    },
    {
      "name": "alter2-1.10",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT typeof(d) FROM abc;",
          "expect": "null integer null"
        }
      ]
    },
    {
      "name": "alter2-1.99",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE abc;"
        }
      ]
    },
    {
      "name": "alter2-4.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM sqlite_master;"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM sqlite_master;",
          "expect": "1 {unsupported file format}"
        }
      ]
    },
    {
      "name": "alter2-4.4",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM sqlite_master;",
          "expect": "1 {unsupported file format}"
        }
      ]
    },
    {
      "name": "alter2-6.3",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);",
          "expect": "2"
        }
      ]
    },
    {
      "name": "alter2-7.1",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE t1;\n    CREATE TABLE t1(a);\n    INSERT INTO t1 VALUES(1);\n    INSERT INTO t1 VALUES(2);\n    INSERT INTO t1 VALUES(3);\n    INSERT INTO t1 VALUES(4);\n    SELECT * FROM t1;",
          "expect": "1 2 3 4"
        }
      ]
    },
    {
      "name": "alter2-7.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1 LIMIT 1;",
          "expect": "1 123 123"
        }
      ]
    },
    {
      "name": "alter2-7.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT a, typeof(a), b, typeof(b), c, typeof(c) FROM t1 LIMIT 1;",
          "expect": "1 integer 123 text 123 integer"
        }
      ]
    },
    {
      "name": "alter2-7.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT a, typeof(a), b, typeof(b), c, typeof(c) FROM t1 LIMIT 1;",
          "expect": "1 integer 123 text 123 integer"
        }
      ]
    },
    {
      "name": "alter2-7.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT a, typeof(a), b, typeof(b), c, typeof(c) FROM t1 LIMIT 1;",
          "expect": "1 integer -123.0 real 5 text"
        }
      ]
    },
    {
      "name": "alter2-8.2",
      "steps": [
        {
          "type": "exec",
          "sql": "UPDATE t1 SET c = 10 WHERE a = 1;\n    SELECT a, typeof(a), b, typeof(b), c, typeof(c) FROM t1 LIMIT 1;",
          "expect": "1 integer -123.0 real 10 text"
        }
      ]
    }
  ]
}