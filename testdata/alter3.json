{
  "file": "alter3.test",
  "name": "alter3",
  "ordered": true,
  "tests": [
    {
      "name": "alter3-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE abc(a, b, c);\n    SELECT sql FROM sqlite_master;",
          "expect": "{CREATE TABLE abc(a, b, c)}"
        }
      ]
    },
    {
      "name": "alter3-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE abc ADD d INTEGER;"
        },
        {
          "type": "exec",
          "sql": "SELECT sql FROM sqlite_master;",
          "expect": "{CREATE TABLE abc(a, b, c, d INTEGER)}"
        }
      ]
    },
    {
      "name": "alter3-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE abc ADD e"
        },
        {
          "type": "exec",
          "sql": "SELECT sql FROM sqlite_master;",
          "expect": "{CREATE TABLE abc(a, b, c, d INTEGER, e)}"
        }
      ]
    },
    {
      "name": "alter3-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE main.t1(a, b);\n    ALTER TABLE t1 ADD c;\n    SELECT sql FROM sqlite_master WHERE tbl_name = 't1';",
          "expect": "{CREATE TABLE t1(a, b, c)}"
        }
      ]
    },
    {
      "name": "alter3-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE t1 ADD d CHECK (a\u003ed);\n    SELECT sql FROM sqlite_master WHERE tbl_name = 't1';",
          "expect": "{CREATE TABLE t1(a, b, c, d CHECK (a\u003ed))}"
        }
      ]
    },
    {
      "name": "alter3-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t2(a, b, UNIQUE(a, b));\n      ALTER TABLE t2 ADD c REFERENCES t1(c)  ;\n      SELECT sql FROM sqlite_master WHERE tbl_name = 't2' AND type = 'table';",
          "expect": "{CREATE TABLE t2(a, b, c REFERENCES t1(c), UNIQUE(a, b))}"
        }
      ]
    },
    {
      "name": "alter3-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t3(a, b, UNIQUE(a, b));\n    ALTER TABLE t3 ADD COLUMN c VARCHAR(10, 20);\n    SELECT sql FROM sqlite_master WHERE tbl_name = 't3' AND type = 'table';",
          "expect": "{CREATE TABLE t3(a, b, c VARCHAR(10, 20), UNIQUE(a, b))}"
        }
      ]
    },
    {
      "name": "alter3-1.99",
      "steps": [
        {
          "type": "catch",
          "sql": "# May not exist if foreign-keys are omitted at compile time.\n    DROP TABLE t2;"
        },
        {
          "type": "exec",
          "sql": "DROP TABLE abc; \n    DROP TABLE t1; \n    DROP TABLE t3;"
        }
      ]
    },
    {
      "name": "alter3-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n    INSERT INTO t1 VALUES(1,2);"
        },
        {
          "type": "catch",
          "sql": "ALTER TABLE t1 ADD c PRIMARY KEY;",
          "expect": "1 {Cannot add a PRIMARY KEY column}"
        }
      ]
    },
    {
      "name": "alter3-2.2",
      "steps": [
        {
          "type": "catch",
          "sql": "ALTER TABLE t1 ADD c UNIQUE",
          "expect": "1 {Cannot add a UNIQUE column}"
        }
      ]
    },
    {
      "name": "alter3-2.3",
      "steps": [
        {
          "type": "catch",
          "sql": "ALTER TABLE t1 ADD b VARCHAR(10)",
          "expect": "1 {duplicate column name: b}"
        },
        {
          "type": "catch",
          "sql": "ALTER TABLE t1 ADD c NOT NULL;",
          "expect": "1 {Cannot add a NOT NULL column with default value NULL}"
        }
      ]
    },
    {
      "name": "alter3-2.4",
      "steps": [
        {
          "type": "catch",
          "sql": "ALTER TABLE t1 ADD c NOT NULL DEFAULT 10;",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "alter3-2.5",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIEW v1 AS SELECT * FROM t1;"
        },
        {
          "type": "catch",
          "sql": "alter table v1 add column d;",
          "expect": "1 {Cannot add a column to a view}"
        }
      ]
    },
    {
      "name": "alter3-2.6",
      "steps": [
        {
          "type": "catch",
          "sql": "alter table t1 add column d DEFAULT CURRENT_TIME;",
          "expect": "1 {Cannot add a column with non-constant default}"
        }
      ]
    },
    {
      "name": "alter3-2.99",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE t1;"
        }
      ]
    },
    {
      "name": "alter3-3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n    INSERT INTO t1 VALUES(1, 100);\n    INSERT INTO t1 VALUES(2, 300);\n    SELECT * FROM t1;",
          "expect": "1 100 2 300"
        },
        {
          "type": "exec",
          "sql": "PRAGMA schema_version = 10;"
        }
      ]
    },
    {
      "name": "alter3-3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE t1 ADD c;\n    SELECT * FROM t1;",
          "expect": "1 100 {} 2 300 {}"
        }
      ]
    },
    {
      "name": "alter3-3.4",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA schema_version;",
          "expect": "11"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "alter3-4.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n    INSERT INTO t1 VALUES(1, 100);\n    INSERT INTO t1 VALUES(2, 300);\n    SELECT * FROM t1;",
          "expect": "1 100 2 300"
        },
        {
          "type": "exec",
          "sql": "PRAGMA schema_version = 20;"
        }
      ]
    },
    {
      "name": "alter3-4.2",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE t1 ADD c DEFAULT 'hello world';\n    SELECT * FROM t1;",
          "expect": "1 100 {hello world} 2 300 {hello world}"
        }
      ]
    },
    {
      "name": "alter3-4.4",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA schema_version;",
          "expect": "21"
        }
      ]
    },
    {
      "name": "alter3-4.99",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE t1;"
        }
      ]
    },
    {
      "name": "alter3-5.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n      INSERT INTO t1 VALUES(1, 'one');\n      INSERT INTO t1 VALUES(2, 'two');\n      ATTACH 'test2.db' AS aux;\n      CREATE TABLE aux.t1 AS SELECT * FROM t1;\n      PRAGMA aux.schema_version = 30;\n      SELECT sql FROM aux.sqlite_master;",
          "expect": "{CREATE TABLE t1(a,b)}"
        }
      ]
    },
    {
      "name": "alter3-5.2",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE aux.t1 ADD COLUMN c VARCHAR(128);\n      SELECT sql FROM aux.sqlite_master;",
          "expect": "{CREATE TABLE t1(a,b, c VARCHAR(128))}"
        }
      ]
    },
    {
      "name": "alter3-5.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM aux.t1;",
          "expect": "1 one {} 2 two {}"
        }
      ]
    },
    {
      "name": "alter3-5.4",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA aux.schema_version;",
          "expect": "31"
        }
      ]
    },
    {
      "name": "alter3-5.6",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE aux.t1 ADD COLUMN d DEFAULT 1000;\n      SELECT sql FROM aux.sqlite_master;",
          "expect": "{CREATE TABLE t1(a,b, c VARCHAR(128), d DEFAULT 1000)}"
        }
      ]
    },
    {
      "name": "alter3-5.7",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM aux.t1;",
          "expect": "1 one {} 1000 2 two {} 1000"
        }
      ]
    },
    {
      "name": "alter3-5.8",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA aux.schema_version;",
          "expect": "32"
        }
      ]
    },
    {
      "name": "alter3-5.9",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1;",
          "expect": "1 one 2 two"
        }
      ]
    },
    {
      "name": "alter3-5.99",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE aux.t1;\n      DROP TABLE t1;"
        }
      ]
    },
    {
      "name": "alter3-6.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n      CREATE TABLE log(trig, a, b);\n\n      CREATE TRIGGER t1_a AFTER INSERT ON t1 BEGIN\n        INSERT INTO log VALUES('a', new.a, new.b);\n      END;\n      CREATE TEMP TRIGGER t1_b AFTER INSERT ON t1 BEGIN\n        INSERT INTO log VALUES('b', new.a, new.b);\n      END;\n  \n      INSERT INTO t1 VALUES(1, 2);\n      SELECT * FROM log;",
          "expect": "b 1 2 a 1 2"
        }
      ]
    },
    {
      "name": "alter3-6.2",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE t1 ADD COLUMN c DEFAULT 'c';\n      INSERT INTO t1(a, b) VALUES(3, 4);\n      SELECT * FROM log;",
          "expect": "b 1 2 a 1 2 b 3 4 a 3 4"
        }
      ]
    },
    {
      "name": "alter3-7.1",
      "steps": [
        {
          "type": "exec",
          "sql": "VACUUM;",
          "expect": "1"
        }
