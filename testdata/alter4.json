    {
      "name": "alter4-9.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t5(\n    a INTEGER DEFAULT -9223372036854775808,\n    b INTEGER DEFAULT (-(-9223372036854775808))\n  );\n  INSERT INTO t5 DEFAULT VALUES;"
        }
      ]
    },
    {
      "name": "alter4-9.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT typeof(a), a, typeof(b), b FROM t5;",
          "expect": "\n  integer -9223372036854775808\n  real     9.22337203685478e+18\n"
        }
      ]
    },
    {
      "name": "alter4-9.3",
      "steps": [
        {
          "type": "query",
          "sql": "ALTER TABLE t5 ADD COLUMN c INTEGER DEFAULT (-(-9223372036854775808));\n  SELECT typeof(c), c FROM t5;",
          "expect": "real 9.22337203685478e+18"
        }
      ]
    },
    {
      "name": "alter4-10.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b,c);\n    CREATE INDEX t1a ON t1(a DESC);\n    INSERT INTO t1 VALUES(1,2,3);\n    INSERT INTO t1 VALUES(2,3,4);\n    ALTER TABLE t1 ADD COLUMN d;\n    PRAGMA integrity_check;",
          "expect": "ok"
        }
      ]
    },
    {
      "name": "alter4-11.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(c INTEGER PRIMARY KEY, d);\n  INSERT INTO t1(c,d) VALUES(1,2);\n  PRAGMA foreign_keys = on;\n  ALTER TABLE t1 ADD COLUMN e;"
        }
      ]
    },
    {
      "name": "alter4-11.1",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE t1 ADD COLUMN f REFERENCES t1;"
        }
      ]
    },
    {
      "name": "alter4-11.2",
      "steps": [
        {
          "type": "catch",
          "sql": "ALTER TABLE t1 ADD COLUMN g REFERENCES t1 DEFAULT 4;",
          "expect": "1 {Cannot add a REFERENCES column with non-NULL default value}"
        }
      ]
    },
    {
      "name": "alter4-11.3",
      "steps": [
        {
          "type": "catch",
          "sql": "ALTER TABLE t2 ADD COLUMN g;",
          "expect": "1 {no such table: t2}"
        }
      ]
    }
