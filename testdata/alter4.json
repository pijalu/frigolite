{
  "file": "alter4.test",
  "name": "alter4",
  "tests": [
    {
      "name": "alter4-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TEMP TABLE abc(a, b, c);\n    SELECT sql FROM sqlite_temp_master;",
          "expect": "{CREATE TABLE abc(a, b, c)}"
        }
      ]
    },
    {
      "name": "alter4-1.1b",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT sql FROM temp.sqlite_master;",
          "expect": "{CREATE TABLE abc(a, b, c)}"
        }
      ]
    },
    {
      "name": "alter4-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE abc ADD d INTEGER;"
        },
        {
          "type": "exec",
          "sql": "SELECT sql FROM sqlite_temp_master;",
          "expect": "{CREATE TABLE abc(a, b, c, d INTEGER)}"
        }
      ]
    },
    {
      "name": "alter4-1.2b",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT sql FROM temp.sqlite_master;",
          "expect": "{CREATE TABLE abc(a, b, c, d INTEGER)}"
        }
      ]
    },
    {
      "name": "alter4-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE abc ADD e"
        },
        {
          "type": "exec",
          "sql": "SELECT sql FROM sqlite_temp_master;",
          "expect": "{CREATE TABLE abc(a, b, c, d INTEGER, e)}"
        }
      ]
    },
    {
      "name": "alter4-1.3b",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT sql FROM temp.sqlite_master;",
          "expect": "{CREATE TABLE abc(a, b, c, d INTEGER, e)}"
        }
      ]
    },
    {
      "name": "alter4-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE temp.t1(a, b);\n    ALTER TABLE t1 ADD c;\n    SELECT sql FROM sqlite_temp_master WHERE tbl_name = 't1';",
          "expect": "{CREATE TABLE t1(a, b, c)}"
        }
      ]
    },
    {
      "name": "alter4-1.4b",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT sql FROM temp.sqlite_master WHERE tbl_name = 't1';",
          "expect": "{CREATE TABLE t1(a, b, c)}"
        }
      ]
    },
    {
      "name": "alter4-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE t1 ADD d CHECK (a\u003ed);\n    SELECT sql FROM sqlite_temp_master WHERE tbl_name = 't1';",
          "expect": "{CREATE TABLE t1(a, b, c, d CHECK (a\u003ed))}"
        }
      ]
    },
    {
      "name": "alter4-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TEMPORARY TABLE t3(a, b, UNIQUE(a, b));\n    ALTER TABLE t3 ADD COLUMN c VARCHAR(10, 20);\n    SELECT sql FROM sqlite_temp_master\n     WHERE tbl_name = 't3' AND type = 'table';",
          "expect": "{CREATE TABLE t3(a, b, c VARCHAR(10, 20), UNIQUE(a, b))}"
        }
      ]
    },
    {
      "name": "alter4-1.99",
      "steps": [
        {
          "type": "catch",
          "sql": "# May not exist if foreign-keys are omitted at compile time.\n    DROP TABLE t2;"
        },
        {
          "type": "exec",
          "sql": "DROP TABLE abc; \n    DROP TABLE t1; \n    DROP TABLE t3;"
        }
      ]
    },
    {
      "name": "alter4-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE temp.t1(a, b);\n    INSERT INTO t1 VALUES(1,2);"
        },
        {
          "type": "catch",
          "sql": "ALTER TABLE t1 ADD c PRIMARY KEY;",
          "expect": "1 {Cannot add a PRIMARY KEY column}"
        }
      ]
    },
    {
      "name": "alter4-2.2",
      "steps": [
        {
          "type": "catch",
          "sql": "ALTER TABLE t1 ADD c UNIQUE",
          "expect": "1 {Cannot add a UNIQUE column}"
        }
      ]
    },
    {
      "name": "alter4-2.3",
      "steps": [
        {
          "type": "catch",
          "sql": "ALTER TABLE t1 ADD b VARCHAR(10)",
          "expect": "1 {duplicate column name: b}"
        },
        {
          "type": "catch",
          "sql": "ALTER TABLE t1 ADD c NOT NULL;",
          "expect": "1 {Cannot add a NOT NULL column with default value NULL}"
        }
      ]
    },
    {
      "name": "alter4-2.4",
      "steps": [
        {
          "type": "catch",
          "sql": "ALTER TABLE t1 ADD c NOT NULL DEFAULT 10;",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "alter4-2.6",
      "steps": [
        {
          "type": "catch",
          "sql": "alter table t1 add column d DEFAULT CURRENT_TIME;",
          "expect": "1 {Cannot add a column with non-constant default}"
        }
      ]
    },
    {
      "name": "alter4-2.7",
      "steps": [
        {
          "type": "catch",
          "sql": "alter table t1 add column d default (-5+1);",
          "expect": "1 {Cannot add a column with non-constant default}"
        }
      ]
    },
    {
      "name": "alter4-2.99",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE t1;"
        }
      ]
    },
    {
      "name": "alter4-3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TEMP TABLE t1(a, b);\n    INSERT INTO t1 VALUES(1, 100);\n    INSERT INTO t1 VALUES(2, 300);\n    SELECT * FROM t1;",
          "expect": "1 100 2 300"
        },
        {
          "type": "exec",
          "sql": "PRAGMA schema_version = 10;"
        }
      ]
    },
    {
      "name": "alter4-3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE t1 ADD c;\n    SELECT * FROM t1;",
          "expect": "1 100 {} 2 300 {}"
        }
      ]
    },
    {
      "name": "alter4-4.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TEMP TABLE t1(a, b);\n    INSERT INTO t1 VALUES(1, 100);\n    INSERT INTO t1 VALUES(2, 300);\n    SELECT * FROM t1;",
          "expect": "1 100 2 300"
        },
        {
          "type": "exec",
          "sql": "PRAGMA schema_version = 20;"
        }
      ]
    },
    {
      "name": "alter4-4.2",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE t1 ADD c DEFAULT 'hello world';\n    SELECT * FROM t1;",
          "expect": "1 100 {hello world} 2 300 {hello world}"
        }
      ]
    },
    {
      "name": "alter4-4.99",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE t1;"
        }
      ]
    },
