{
  "file": "alterauth.test",
  "name": "alterauth",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "auth_proc",
          "authProc": "xAuth",
          "callbackVars": {
            "": "",
            "::auth": "",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "testdir": "",
            "testprefix": "alterauth"
          },
          "callbackProcs": [
            {
              "Name": "xAuth",
              "Args": [
                "type",
                "args"
              ],
              "Body": "\n  if {$type == \"SQLITE_ALTER_TABLE\"} {\n    lappend ::auth [concat $type [lrange $args 0 3]]\n  }\n  return SQLITE_OK\n",
              "Defaults": null
            }
          ],
          "functionProc": "xAuth",
          "functionBody": "\n  if {$type == \"SQLITE_ALTER_TABLE\"} {\n    lappend ::auth [concat $type [lrange $args 0 3]]\n  }\n  return SQLITE_OK\n"
        }
      ]
    },
    {
      "name": "alterauth-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b, c);"
        }
      ]
    },
    {
      "name": "alterauth-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE t1 RENAME TO t2"
        },
        {
          "type": "runtime_var",
          "variable": "auth",
          "expect": "{SQLITE_ALTER_TABLE main t1 {} {}}"
        }
      ]
    },
    {
      "name": "alterauth-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE t2 RENAME c TO ccc"
        },
        {
          "type": "runtime_var",
          "variable": "auth",
          "expect": "{SQLITE_ALTER_TABLE main t2 {} {}}"
        }
      ]
    },
    {
      "name": "alterauth-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE t2 ADD COLUMN d"
        },
        {
          "type": "runtime_var",
          "variable": "auth",
          "expect": "{SQLITE_ALTER_TABLE main t2 {} {}}"
        }
      ]
    },
    {
      "name": "alterauth-2.1",
      "steps": [
        {
          "type": "catch",
          "sql": "ALTER TABLE t2 RENAME TO t3",
          "expect": "1 {not authorized}"
        }
      ]
    },
    {
      "name": "alterauth-2.2",
      "steps": [
        {
          "type": "catch",
          "sql": "ALTER TABLE t2 RENAME d TO ddd",
          "expect": "1 {not authorized}"
        }
      ]
    },
    {
      "name": "alterauth-2.3",
      "steps": [
        {
          "type": "catch",
          "sql": "ALTER TABLE t2 ADD COLUMN e",
          "expect": "1 {not authorized}"
        }
      ]
    }
  ]
}