{
  "file": "alterauth.test",
  "name": "alterauth",
  "tests": [
    {
      "name": "1.0",
      "steps": [
        {"type": "exec", "sql": "CREATE TABLE t1(a, b, c);"}
      ]
    },
    {
      "name": "1.1",
      "steps": [
        {"type": "exec", "sql": "ALTER TABLE t1 RENAME TO t2"}
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {"type": "exec", "sql": "ALTER TABLE t2 RENAME c TO ccc"}
      ]
    },
    {
      "name": "1.3",
      "steps": [
        {"type": "exec", "sql": "ALTER TABLE t2 ADD COLUMN d"}
      ]
    },
    {
      "name": "2.0",
      "steps": [
        {"type": "auth", "action": "SQLITE_ALTER_TABLE", "result": "SQLITE_DENY"}
      ]
    },
    {
      "name": "2.1",
      "steps": [
        {"type": "exec", "sql": "ALTER TABLE t2 RENAME TO t3", "expect": "1 {not authorized}"}
      ]
    },
    {
      "name": "2.2",
      "steps": [
        {"type": "exec", "sql": "ALTER TABLE t2 RENAME d TO ddd", "expect": "1 {not authorized}"}
      ]
    },
    {
      "name": "2.3",
      "steps": [
        {"type": "exec", "sql": "ALTER TABLE t2 ADD COLUMN e", "expect": "1 {not authorized}"}
      ]
    }
  ]
}
