{
  "file": "alterauth.test",
  "name": "alterauth",
  "tests": [
    {
      "name": "1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b, c);"
        }
      ]
    },
    {
      "name": "1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE t1 RENAME TO t2",
          "expect": "{SQLITE_ALTER_TABLE main t1 {} {}}"
        }
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE t2 RENAME c TO ccc",
          "expect": "{SQLITE_ALTER_TABLE main t2 {} {}}"
        }
      ]
    },
    {
      "name": "1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE t2 ADD COLUMN d",
          "expect": "{SQLITE_ALTER_TABLE main t2 {} {}}"
        }
      ]
    },
    {
      "name": "2.1",
      "steps": [
        {
          "type": "catch",
          "sql": "ALTER TABLE t2 RENAME TO t3",
          "expect": "1 {not authorized}"
        }
      ]
    },
    {
      "name": "2.2",
      "steps": [
        {
          "type": "catch",
          "sql": "ALTER TABLE t2 RENAME d TO ddd",
          "expect": "1 {not authorized}"
        }
      ]
    },
    {
      "name": "2.3",
      "steps": [
        {
          "type": "catch",
          "sql": "ALTER TABLE t2 ADD COLUMN e",
          "expect": "1 {not authorized}"
        }
      ]
    }
  ]
}