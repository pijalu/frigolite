        }
      ]
    },
    {
      "name": "altercons3-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "ALTER TABLE c1 DROP CONSTRAINT fk;\n  SELECT sql FROM sqlite_schema WHERE name='c1';",
          "expect": "{CREATE TABLE c1(b)}"
        }
      ]
