  "tests": [
    {
      "name": "1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE p1(a PRIMARY KEY);\n  CREATE TABLE c1(b CONSTRAINT fk REFERENCES p1(a));"
        }
      ]
    },
    {
      "name": "1.1",
      "steps": [
        {
          "type": "query",
          "sql": "ALTER TABLE c1 DROP CONSTRAINT fk;\n  SELECT sql FROM sqlite_schema WHERE name='c1';",
          "expect": "{CREATE TABLE c1(b)}"
        }
      ]
    },
