{
  "file": "altercorrupt.test",
  "name": "altercorrupt",
  "tests": [
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    },
    {
      "name": "1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE t2 DROP COLUMN e;\n  ALTER TABLE t1 DROP COLUMN f;",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    },
    {
      "name": "2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE t1 DROP COLUMN a;",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    }
  ]
}