{
  "file": "altercorrupt.test",
  "name": "altercorrupt",
  "ordered": true,
  "tests": [
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "altercorrupt-1.0",
      "steps": [
        {
          "type": "open_empty_db"
        }
      ]
    },
    {
      "name": "altercorrupt-1.1",
      "steps": [
        {
          "type": "catch",
          "sql": "ALTER TABLE t2 DROP COLUMN e;\n  ALTER TABLE t1 DROP COLUMN f;",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "altercorrupt-2.0",
      "steps": [
        {
          "type": "open_empty_db"
        }
      ]
    },
    {
      "name": "altercorrupt-2.1",
      "steps": [
        {
          "type": "catch",
          "sql": "ALTER TABLE t1 DROP COLUMN a;",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    }
  ]
