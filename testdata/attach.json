          "type": "exec",
          "sql": "CREATE TABLE tx(x1,x2,y1,y2);\n    CREATE TRIGGER r1 AFTER UPDATE ON t2 FOR EACH ROW BEGIN\n      INSERT INTO tx(x1,x2,y1,y2) VALUES(OLD.x,NEW.x,OLD.y,NEW.y);\n    END;\n    SELECT * FROM tx;",
          "database": "db2"
        }
      ]
    },
    {
      "name": "attach-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "UPDATE t2 SET x=x+10;\n    SELECT * FROM tx;",
