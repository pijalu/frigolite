    {
      "name": "attach-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b);\n    INSERT INTO t1 VALUES(1,2);\n    INSERT INTO t1 VALUES(3,4);\n    SELECT * FROM t1;",
          "expect": "1 2 3 4"
        }
      ]
    },
    {
      "name": "attach-1.2",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test2.db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t2(x,y);\n    INSERT INTO t2 VALUES(1,'x');\n    INSERT INTO t2 VALUES(2,'y');\n    SELECT * FROM t2;",
          "expect": "1 x 2 y",
          "database": "db2"
        }
      ]
    },
    {
      "name": "attach-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "ATTACH DATABASE 'test2.db' AS two;\n    SELECT * FROM two.t2;",
          "expect": "1 x 2 y"
        }
      ]
    },
    {
      "name": "attach-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t2;",
          "expect": "1 x 2 y"
        }
      ]
    },
    {
      "name": "attach-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "DETACH DATABASE two;\n    SELECT * FROM t1;",
          "expect": "1 2 3 4"
        }
      ]
    },
    {
      "name": "attach-1.6",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t2;",
          "expect": "1 {no such table: t2}"
        }
      ]
    },
    {
      "name": "attach-1.7",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM two.t2;",
          "expect": "1 {no such table: two.t2}"
        }
      ]
    },
