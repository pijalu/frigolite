{
  "file": "attach.test",
  "name": "attach",
  "tests": [
    {
      "name": "attach-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b);\n    INSERT INTO t1 VALUES(1,2);\n    INSERT INTO t1 VALUES(3,4);\n    SELECT * FROM t1;",
          "expect": "1 2 3 4"
        }
      ]
    },
    {
      "name": "attach-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t2(x,y);\n    INSERT INTO t2 VALUES(1,'x');\n    INSERT INTO t2 VALUES(2,'y');\n    SELECT * FROM t2;",
          "expect": "1 x 2 y"
        }
      ]
    },
    {
      "name": "attach-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "ATTACH DATABASE 'test2.db' AS two;\n    SELECT * FROM two.t2;",
          "expect": "1 x 2 y"
        }
      ]
    },
    {
      "name": "attach-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t2;",
          "expect": "1 x 2 y"
        }
      ]
    },
    {
      "name": "attach-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "DETACH DATABASE two;\n    SELECT * FROM t1;",
          "expect": "1 2 3 4"
        }
      ]
    },
    {
      "name": "attach-1.6",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t2;",
          "expect": "1 {no such table: t2}"
        }
      ]
    },
    {
      "name": "attach-1.7",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM two.t2;",
          "expect": "1 {no such table: two.t2}"
        }
      ]
    },
    {
      "name": "attach-1.8",
      "steps": [
        {
          "type": "catch",
          "sql": "ATTACH DATABASE 'test3.db' AS three;",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "attach-1.9",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM three.sqlite_master;",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "attach-1.10",
      "steps": [
        {
          "type": "catch",
          "sql": "DETACH DATABASE 16;",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "attach-1.11",
      "steps": [
        {
          "type": "exec",
          "sql": "ATTACH 'test.db' AS db2;\n    ATTACH 'test.db' AS db3;\n    ATTACH 'test.db' AS db4;\n    ATTACH 'test.db' AS db5;\n    ATTACH 'test.db' AS db6;\n    ATTACH 'test.db' AS db7;\n    ATTACH 'test.db' AS db8;\n    ATTACH 'test.db' AS db9;"
        }
      ]
    },
    {
      "name": "attach-1.12",
      "steps": [
        {
          "type": "catch",
          "sql": "ATTACH 'test.db' as db2;",
          "expect": "1 {database db2 is already in use}"
        }
      ]
    },
    {
      "name": "attach-1.13",
      "steps": [
        {
          "type": "catch",
          "sql": "ATTACH 'test.db' as db5;",
          "expect": "1 {database db5 is already in use}"
        }
      ]
    },
    {
      "name": "attach-1.14",
      "steps": [
        {
          "type": "catch",
          "sql": "ATTACH 'test.db' as db9;",
          "expect": "1 {database db9 is already in use}"
        }
      ]
    },
    {
      "name": "attach-1.15",
      "steps": [
        {
          "type": "catch",
          "sql": "ATTACH 'test.db' as main;",
          "expect": "1 {database main is already in use}"
        }
      ]
    },
    {
      "name": "attach-1.17",
      "steps": [
        {
          "type": "catch",
          "sql": "ATTACH 'test.db' as MAIN;",
          "expect": "1 {database MAIN is already in use}"
        }
      ]
    },
    {
      "name": "attach-1.18",
      "steps": [
        {
          "type": "catch",
          "sql": "ATTACH 'test.db' as db10;\n    ATTACH 'test.db' as db11;",
          "expect": "0 {}"
        }
      ]
    }
  ]
}