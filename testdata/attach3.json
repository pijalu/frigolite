{
  "file": "attach3.test",
  "name": "attach3",
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "catch",
          "sql": "pragma recursive_triggers = off"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n  CREATE TABLE t2(c, d);"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n  CREATE TABLE t2(c, d);"
        }
      ]
    },
    {
      "name": "attach3-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "ATTACH 'test2.db' AS aux;"
        }
      ]
    },
    {
      "name": "attach3-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE aux.t3(e, f);"
        }
      ]
    },
    {
      "name": "attach3-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM sqlite_master WHERE name = 't3';"
        }
      ]
    },
    {
      "name": "attach3-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM aux.sqlite_master WHERE name = 't3';"
        }
      ]
    },
    {
      "name": "attach3-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t3 VALUES(1, 2);\n    SELECT * FROM t3;",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "attach3-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE INDEX aux.i1 on t3(e);"
        }
      ]
    },
    {
      "name": "attach3-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM sqlite_master WHERE name = 'i1';"
        }
      ]
    },
    {
      "name": "attach3-2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM aux.sqlite_master WHERE name = 'i1';"
        }
      ]
    },
    {
      "name": "attach3-3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP INDEX aux.i1;\n    SELECT * FROM aux.sqlite_master WHERE name = 'i1';"
        }
      ]
    },
    {
      "name": "attach3-3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE INDEX aux.i1 on t3(e);\n    SELECT * FROM aux.sqlite_master WHERE name = 'i1';"
        }
      ]
    },
    {
      "name": "attach3-3.3",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP INDEX i1;\n    SELECT * FROM aux.sqlite_master WHERE name = 'i1';"
        }
      ]
    },
    {
      "name": "attach3-4.1",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE aux.t1;\n    SELECT name FROM aux.sqlite_master;",
          "expect": "t2 t3"
        }
      ]
    },
    {
      "name": "attach3-4.2",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE t2;\n    SELECT name FROM aux.sqlite_master;",
          "expect": "t2 t3"
        }
      ]
    },
    {
      "name": "attach3-4.3",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE t2;\n    SELECT name FROM aux.sqlite_master;",
          "expect": "t3"
        }
      ]
    },
    {
      "name": "attach3-10.0",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO aux.sqlite_master VALUES(1, 2, 3, 4, 5);",
          "expect": "1 {table sqlite_master may not be modified}"
        }
      ]
    },
    {
      "name": "attach3-11.0",
      "steps": [
        {
          "type": "catch",
          "sql": "ATTACH DATABASE '/nodir/nofile.x' AS notadb;",
          "expect": "1 {unable to open database: /nodir/nofile.x}"
        }
      ]
    },
    {
      "name": "attach3-11.1",
      "steps": [
        {
          "type": "catch",
          "sql": "ATTACH DATABASE ':memory:' AS notadb;",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "attach3-11.2",
      "steps": [
        {
          "type": "catch",
          "sql": "DETACH DATABASE notadb;",
          "expect": "0 {}"
        }
      ]
    }
  ]
}