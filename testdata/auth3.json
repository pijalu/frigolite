{
  "file": "auth3.test",
  "name": "auth3",
  "tests": [
    {
      "name": "auth3-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b,c);\n    INSERT INTO t1 VALUES(1, 2, 3);\n    INSERT INTO t1 VALUES(4, 5, 6);"
        }
      ]
    },
    {
      "name": "auth3.1.2",
      "steps": [
        {
          "type": "catch",
          "sql": "DELETE FROM t1",
          "expect": "1 {not authorized}"
        }
      ]
    },
    {
      "name": "auth3.1.3",
      "steps": [
        {
          "type": "catch",
          "sql": "DELETE FROM t1",
          "expect": "1 {authorizer malfunction}"
        }
      ]
    },
    {
      "name": "auth3.1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4 5 6"
        }
      ]
    },
    {
      "name": "auth3-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "DELETE FROM t1;\n    SELECT * FROM t1;"
        }
      ]
    },
    {
      "name": "auth3-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(1, 2, 3);\n    INSERT INTO t1 VALUES(4, 5, 6);\n    DELETE FROM t1;\n    SELECT * FROM t1;"
        }
      ]
    },
    {
      "name": "auth3-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(1, 2, 3);\n    INSERT INTO t1 VALUES(4, 5, 6);"
        },
        {
          "type": "exec",
          "sql": "DELETE FROM t1;",
          "expect": "0"
        }
      ]
    },
    {
      "name": "auth3-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(1, 2, 3);\n    INSERT INTO t1 VALUES(4, 5, 6);"
        },
        {
          "type": "exec",
          "sql": "DELETE FROM t1;",
          "expect": "1"
        }
      ]
    }
  ]
}