{
  "file": "backup4.test",
  "name": "backup4",
  "ordered": true,
  "tests": [
    {
      "name": "backup4-1.0",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t1(x, y, UNIQUE(x, y));\n  INSERT INTO t1 VALUES('one', 'two');\n  SELECT * FROM t1 WHERE x='one';\n  PRAGMA integrity_check;",
          "expect": "one two ok"
        }
      ]
    },
    {
      "name": "backup4-1.1",
      "steps": [
        {
          "type": "open_named_db",
          "sql": ":memory:",
          "database": "db1"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db1"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x, y);\n    INSERT INTO t1 VALUES('one', 'two');",
          "database": "db1"
        },
        {
          "type": "close_named_db",
          "database": "db1"
        }
      ]
    },
    {
      "name": "backup4-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1 WHERE x='one';\n  PRAGMA integrity_check;",
          "expect": "one two ok"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "backup4-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n  CREATE INDEX i1 ON t1(a, b);"
        }
      ]
    },
    {
      "name": "backup4-2.3",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db2",
          "database": "db1"
        },
        {
          "type": "close_named_db",
          "expect": "1024",
          "database": "db1"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    },
    {
      "name": "setup_3",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "backup4-3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA page_size = 4096;\n  CREATE TABLE t1(a, b);\n  CREATE INDEX i1 ON t1(a, b);"
        }
      ]
    },
    {
      "name": "backup4-3.3",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db2",
          "database": "db1"
        },
        {
          "type": "close_named_db",
          "expect": "1024",
          "database": "db1"
        }
      ]
    }
  ]
}