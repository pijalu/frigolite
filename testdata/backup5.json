    {
      "name": "backup5-2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n  CREATE TABLE t2(a, b);\n  INSERT INTO t2 VALUES(1, 1);\n  INSERT INTO t2 VALUES(2, 2);\n  INSERT INTO t2 VALUES(3, 3);\n  CREATE INDEX i1 ON t1(a);\n  CREATE INDEX i2 ON t2(a);\n  ATTACH 'test2.db' AS aux2;"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test2.db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "backup5-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "ATTACH 'test3.db' AS aux3;\n    ATTACH 'test4.db' AS aux4;\n    ATTACH 'test5.db' AS aux5;\n    ATTACH 'test6.db' AS aux6;\n    ATTACH 'test7.db' AS aux7;\n    ATTACH 'test8.db' AS aux8;",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "backup5-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE aux7.t3(a, b);\n  CREATE TABLE aux7.t4(a, b);\n  INSERT INTO t4 VALUES(1, 1);\n  INSERT INTO t4 VALUES(2, 2);\n  INSERT INTO t4 VALUES(3, 3);\n  CREATE INDEX aux7.i3 ON t3(a);\n  CREATE INDEX aux7.i4 ON t4(a);"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test2.db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "backup5-2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "DETACH aux4;",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "setup_3",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        }
