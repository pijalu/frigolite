{
  "file": "backup5.test",
  "name": "backup5",
  "ordered": true,
  "tests": [
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test2.db"
        }
      ]
    },
    {
      "name": "backup5-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n  CREATE TABLE t2(a, b);\n  INSERT INTO t2 VALUES(1, 1);\n  INSERT INTO t2 VALUES(2, 2);\n  INSERT INTO t2 VALUES(3, 3);"
        }
      ]
    },
    {
      "name": "backup5-1.1",
      "steps": [
        {
          "type": "copy_file",
          "sql": "test.db",
          "fileTarget": "test.db2"
        },
        {
          "type": "exec",
          "sql": "DROP TABLE t2;\n    INSERT INTO t1 VALUES(zeroblob(1000), zeroblob(1000));\n    INSERT INTO t1 VALUES(randomblob(1000), randomblob(1000));"
        }
      ]
    },
    {
      "name": "backup5-1.2",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db2",
          "database": "db2"
        },
        {
          "type": "prepare_stmt",
          "sql": "SELECT * FROM t2",
          "variable": "stmt_1",
          "database": "db2"
        },
        {
          "type": "stmt_step",
          "sql": "SELECT * FROM t2",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__",
          "expect": "SQLITE_ROW"
        }
      ]
    },
    {
      "name": "backup5-1.5",
      "steps": [
        {
          "type": "stmt_reset",
          "sql": "SELECT * FROM t2",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "SQLITE_OK",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "backup5-1.6",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "SELECT * FROM t2",
          "variable": "stmt_1"
        },
        {
          "type": "stmt_finalize",
          "sql": "SELECT * FROM t2",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__ SQLITE_OK",
          "expect": "SQLITE_ERROR SQLITE_ERROR"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test2.db"
        }
      ]
    },
