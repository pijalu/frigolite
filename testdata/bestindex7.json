{
  "file": "bestindex7.test",
  "name": "bestindex7",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "register_tcl_module",
          "callbackVars": {
            "": "bestindex7",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "testdir": "",
            "testprefix": "bestindex7"
          },
          "callbackProcs": [
            {
              "Name": "vtab_command",
              "Args": [
                "src",
                "method",
                "args"
              ],
              "Body": "\n  switch -- $method {\n    xConnect {\n      return \"CREATE TABLE xxx(a)\"\n    }\n\n    xBestIndex {\n      set hdl [lindex $args 0]\n      set clist [$hdl constraints]\n      set orderby [$hdl orderby]\n      set mask [$hdl mask]\n      \n      set iCons 0\n      set ret [list]\n      foreach cons $clist {\n        catch { array unset C }\n        array set C $cons\n        if {$C(usable)} {\n          lappend ret use $iCons\n        }\n        incr iCons\n      }\n      return $ret\n    }\n\n    xFilter {\n      return [list sql \"SELECT rowid, x FROM $src\"]\n    }\n\n  }\n\n  return {}\n",
              "Defaults": null
            }
          ],
          "moduleArgs": [
            "db"
          ]
        }
      ]
    },
    {
      "name": "bestindex7-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n  INSERT INTO t1 VALUES(0), (2);\n  CREATE VIRTUAL TABLE vt1 USING tcl(vtab_command t1);"
        }
      ]
    },
    {
      "name": "bestindex7-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "select * from vt1",
          "expect": "0 2"
        }
      ]
    },
    {
      "name": "bestindex7-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "select * from vt1 WHERE a=0",
          "expect": "0"
        }
      ]
    },
    {
      "name": "bestindex7-1.3",
      "steps": [
        {
          "type": "query",
          "sql": "select * from vt1 WHERE a=1"
        }
      ]
    },
    {
      "name": "bestindex7-1.4",
      "steps": [
        {
          "type": "query",
          "sql": "select * from vt1 WHERE a=1 OR a=0",
          "expect": "0"
        }
      ]
    },
    {
      "name": "bestindex7-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "UPDATE t1 SET x=NULL WHERE x=2;"
        }
      ]
    },
    {
      "name": "bestindex7-1.6",
      "steps": [
        {
          "type": "query",
          "sql": "select * from vt1",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "bestindex7-1.7",
      "steps": [
        {
          "type": "query",
          "sql": "select * from vt1 WHERE a=0",
          "expect": "0"
        }
      ]
    },
    {
      "name": "bestindex7-1.8",
      "steps": [
        {
          "type": "query",
          "sql": "select * from vt1 WHERE a=1"
        }
      ]
    },
    {
      "name": "bestindex7-1.9",
      "steps": [
        {
          "type": "query",
          "sql": "select * from vt1 WHERE a=1 OR a=0",
          "expect": "0"
        }
      ]
    },
    {
      "name": "bestindex7-1.10",
      "steps": [
        {
          "type": "query",
          "sql": "select * from vt1 WHERE a IN (2)"
        },
        {
          "type": "query",
          "sql": "select * from vt1 WHERE a IN (0,1,2,3)",
          "expect": "0"
        }
      ]
    },
    {
      "name": "bestindex7-1.11",
      "steps": [
        {
          "type": "query",
          "sql": "select * from vt1 WHERE a IN (0, NULL)",
          "expect": "0"
        }
      ]
    },
    {
      "name": "bestindex7-1.12",
      "steps": [
        {
          "type": "query",
          "sql": "select * from vt1 WHERE a IN (NULL)"
        }
      ]
    }
  ]
}