{
  "file": "bestindexB.test",
  "name": "bestindexB",
  "tests": [
    {
      "name": "1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE x1 USING tcl(vtab_command);\n  CREATE TABLE y1(a, b);\n  CREATE TABLE y2(a, b);"
        }
      ]
    },
    {
      "name": "1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM x1",
          "expect": "1 2 3"
        }
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO y1 VALUES(1, 2) RETURNING rowid;",
          "expect": "1"
        }
      ]
    },
    {
      "name": "1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TRIGGER y1tr BEFORE INSERT ON y1 BEGIN\n    SELECT * FROM x1;\n  END;\n  INSERT INTO y1 VALUES(3, 4) RETURNING rowid;",
          "expect": "2"
        }
      ]
    },
    {
      "name": "1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO y1 VALUES(5, 6) RETURNING rowid;",
          "expect": "3"
        }
      ]
    }
  ]
}