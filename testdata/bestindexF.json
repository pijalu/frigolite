{
  "file": "bestindexF.test",
  "name": "bestindexF",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "register_tcl_module",
          "callbackVars": {
            "": "bestindexF",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "testdir": "",
            "testprefix": "bestindexF"
          },
          "callbackProcs": [
            {
              "Name": "vtab_command",
              "Args": [
                "method",
                "args"
              ],
              "Body": "\n  switch -- $method {\n    xConnect {\n      return \"CREATE TABLE t1(a, b, c)\"\n    }\n\n    xBestIndex {\n      set hdl [lindex $args 0]\n      set ::vtab_orderby [$hdl orderby]\n      set ::vtab_distinct [$hdl distinct]\n\n      if {$::vtab_orderby == \"{column 0 desc 0} {column 1 desc 0}\"\n       || $::vtab_orderby == \"{column 0 desc 0}\"\n      } {\n        return [list orderby 1]\n      }\n\n      return \"\"\n    }\n\n    xFilter {\n      set sql {\n        SELECT 1, 1, 'a', 555\n          UNION ALL\n        SELECT 2, 1, 'a', NULL\n          UNION ALL\n        SELECT 3, 1, 'b', 'text'\n          UNION ALL\n        SELECT 4, 2, 'a', 3.14\n          UNION ALL\n        SELECT 5, 2, 'b', 0\n      }\n      return [list sql $sql]\n    }\n  }\n\n  return {}\n",
              "Defaults": null
            },
            {
              "Name": "uses_idxinsert",
              "Args": [
                "sql"
              ],
              "Body": "\n  return [expr [lsearch [db eval \"explain $sql\"] IdxInsert]\u003e=0]\n",
              "Defaults": null
            },
            {
              "Name": "do_idxinsert_test",
              "Args": [
                "tn",
                "sql",
                "res"
              ],
              "Body": "\n  set uses [uses_idxinsert $sql]\n  uplevel [list do_execsql_test $tn \"SELECT $uses ; $sql\" $res]\n",
              "Defaults": null
            },
            {
              "Name": "do_vtabsorter_test",
              "Args": [
                "tn",
                "sql",
                "expect"
              ],
              "Body": "\n  set vm [db eval \"EXPLAIN $sql\"]\n\n  set ii [lsearch $vm VFilter]\n  set ::res [lindex $vm [expr $ii+4]]\n\n  set ::idx [expr [lsearch $vm IdxInsert]\u003e=0]\n\n  set iSort [lsearch $vm SorterSort]\n  if {$iSort\u003e=0} {\n    error \"query is using sorter\"\n  }\n\n  uplevel [list do_test $tn.0 { set ::idx } [lindex $expect 0]]\n  uplevel [list do_test $tn.1 { set ::res } [lindex $expect 1]]\n  uplevel [list do_execsql_test $tn.2 $sql [lrange $expect 2 end]]\n",
              "Defaults": null
            }
          ],
          "moduleArgs": [
            "db"
          ]
        }
      ]
    },
    {
      "name": "bestindexF-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE t1 USING tcl(vtab_command)"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "exec",
          "sql": "explain \n  SELECT DISTINCT a, b FROM t1"
        }
      ]
    },
    {
      "name": "bestindexF-1.1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 0 ; \n  SELECT DISTINCT a, b FROM t1",
          "expect": "0    1 a 1 b 2 a 2 b"
        }
      ]
    },
    {
