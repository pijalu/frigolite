{
  "file": "bind.test",
  "name": "bind",
  "tests": [
    {
      "name": "bind-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b,c);"
        }
      ]
    },
    {
      "name": "bind-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid, * FROM t1",
          "expect": "1 {} {} {}"
        }
      ]
    },
    {
      "name": "bind-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid, * FROM t1",
          "expect": "1 {} {} {} 2 {test value 1} {} {}"
        }
      ]
    },
    {
      "name": "bind-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid, * FROM t1",
          "expect": "1 {} {} {} 2 {test value 1} {} {} 3 {test value 1} {} {'test value 2'}"
        }
      ]
    },
    {
      "name": "bind-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "DELETE FROM t1"
        },
        {
          "type": "exec",
          "sql": "SELECT rowid, * FROM t1",
          "expect": "1 123 abcdefg {}"
        }
      ]
    },
    {
      "name": "bind-1.9",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid, * FROM t1",
          "expect": "1 123 abcdefg {} 2 456 abcdefg {}"
        }
      ]
