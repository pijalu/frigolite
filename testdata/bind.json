    {
      "name": "setup_0",
      "steps": [
        {
          "type": "query_assign",
          "sql": "PRAGMA encoding",
          "variable": "enc",
          "resultAll": true
        }
      ]
    },
    {
      "name": "bind-6.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT  hex(a), hex(b), hex(c) FROM t1",
          "condition": "$enc==\"UTF-8\" || $enc==\"\"",
          "expect": "68656C6C6F00746865726500 68656C6C6F007468657265 68656C6C6F"
        },
        {
          "type": "exec",
          "sql": "SELECT  hex(a), hex(b), hex(c) FROM t1",
          "condition": "!($enc==\"UTF-8\" || $enc==\"\") \u0026\u0026 ($enc==\"UTF-16le\")",
          "expect": "680065006C006C006F000000740068006500720065000000 680065006C006C006F00000074006800650072006500 680065006C006C006F00"
        },
        {
          "type": "exec",
          "sql": "SELECT  hex(a), hex(b), hex(c) FROM t1",
          "condition": "!($enc==\"UTF-8\" || $enc==\"\") \u0026\u0026 !($enc==\"UTF-16le\") \u0026\u0026 ($enc==\"UTF-16be\")",
          "expect": "00680065006C006C006F0000007400680065007200650000 00680065006C006C006F000000740068006500720065 00680065006C006C006F"
        }
      ]
    },
