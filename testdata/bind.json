{
  "file": "bind.test",
  "name": "bind",
  "ordered": true,
  "tests": [
    {
      "name": "bind-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b,c);"
        },
        {
          "type": "prepare_stmt",
          "sql": "INSERT INTO t1 VALUES(:1,?,:abc)",
          "variable": "stmt_1"
        }
      ]
    },
    {
      "name": "bind-1.2",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "INSERT INTO t1 VALUES(:1,?,:abc)",
          "variable": "stmt_1",
          "expect": "SQLITE_DONE"
        }
      ]
    },
    {
      "name": "bind-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid, * FROM t1",
          "expect": "1 {} {} {}"
        }
      ]
    },
    {
      "name": "bind-1.4",
      "steps": [
        {
          "type": "stmt_reset",
          "sql": "INSERT INTO t1 VALUES(:1,?,:abc)",
          "variable": "stmt_1"
        },
        {
          "type": "stmt_step",
          "sql": "INSERT INTO t1 VALUES(:1,?,:abc)",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__",
          "expect": "SQLITE_DONE"
        }
      ]
    },
    {
      "name": "bind-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid, * FROM t1",
          "expect": "1 {} {} {} 2 {test value 1} {} {}"
        }
      ]
    },
    {
      "name": "bind-1.6",
      "steps": [
        {
          "type": "stmt_reset",
          "sql": "INSERT INTO t1 VALUES(:1,?,:abc)",
          "variable": "stmt_1"
        },
        {
          "type": "stmt_step",
          "sql": "INSERT INTO t1 VALUES(:1,?,:abc)",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__",
          "expect": "SQLITE_DONE"
        }
      ]
    },
    {
      "name": "bind-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid, * FROM t1",
          "expect": "1 {} {} {} 2 {test value 1} {} {} 3 {test value 1} {} {'test value 2'}"
        }
      ]
    },
    {
      "name": "bind-1.8",
      "steps": [
        {
          "type": "stmt_reset",
          "sql": "INSERT INTO t1 VALUES(:1,?,:abc)",
          "variable": "stmt_1"
        },
        {
          "type": "exec",
          "sql": "DELETE FROM t1"
        },
        {
          "type": "stmt_step",
          "sql": "INSERT INTO t1 VALUES(:1,?,:abc)",
          "variable": "stmt_1"
        },
        {
          "type": "exec",
          "sql": "SELECT rowid, * FROM t1"
        },
        {
          "type": "runtime_assert",
          "expect": "1 123 abcdefg {}"
        }
      ]
    },
    {
      "name": "bind-1.9",
      "steps": [
        {
          "type": "stmt_reset",
