          "variable": "stmt_1"
        },
        {
          "type": "stmt_step",
          "sql": "INSERT INTO t1 VALUES(:1,?,:abc)",
          "variable": "stmt_1"
        },
        {
          "type": "exec",
          "sql": "SELECT rowid, * FROM t1"
        },
        {
          "type": "runtime_assert",
          "expect": "1 123 abcdefg {} 2 456 abcdefg {}"
        }
      ]
    },
    {
      "name": "bind-1.10",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "INSERT INTO t1 VALUES($abc:123,?,:abc)",
          "variable": "rc",
          "catchResult": true,
          "catchMessage": "msg",
          "expect": "1 {(1) near \":123\": syntax error}"
        }
      ]
    },
    {
      "name": "bind-1.11",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "INSERT INTO t1 VALUES(@abc:xyz,?,:abc)",
          "variable": "rc",
          "catchResult": true,
          "catchMessage": "msg",
          "expect": "1 {(1) near \":xyz\": syntax error}"
        }
      ]
    },
    {
