{
  "file": "bind2.test",
  "name": "bind2",
  "tests": [
    {
      "name": "1.0",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t1(a REAL);\n  INSERT INTO t1 VALUES(42.0);\n  SELECT * FROM t1;",
          "expect": "42.0"
        }
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "UPDATE t1 SET a=43;",
          "expect": "42.0 43.0"
        }
      ]
    }
  ]
}