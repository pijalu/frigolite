    },
    {
      "name": "blob-2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a BLOB, b BLOB);\n    INSERT INTO t1 VALUES(X'123456', x'7890ab');\n    INSERT INTO t1 VALUES(X'CDEF12', x'345678');"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "123456 7890AB CDEF12 345678"
        }
      ]
    },
    {
      "name": "blob-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE INDEX i1 ON t1(a);"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "123456 7890AB CDEF12 345678"
        }
      ]
    },
    {
      "name": "blob-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1 where a = X'123456'",
          "expect": "123456 7890AB"
        }
      ]
    },
    {
      "name": "blob-2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1 where a = X'CDEF12'",
          "expect": "CDEF12 345678"
        }
      ]
    },
    {
      "name": "blob-2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1 where a = X'CD12'"
        }
      ]
    },
    {
      "name": "blob-3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "CDEF12 345678"
        }
      ]
    }
  ]
