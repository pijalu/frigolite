{
  "file": "blob.test",
  "name": "blob",
  "tests": [
    {
      "name": "blob-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT X'01020304';",
          "expect": "01020304"
        }
      ]
    },
    {
      "name": "blob-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT x'ABCDEF';",
          "expect": "ABCDEF"
        }
      ]
    },
    {
      "name": "blob-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT x'';"
        }
      ]
    },
    {
      "name": "blob-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT x'abcdEF12';",
          "expect": "ABCDEF12"
        }
      ]
    },
    {
      "name": "blob-1.3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT x'0123456789abcdefABCDEF';",
          "expect": "0123456789ABCDEFABCDEF"
        }
      ]
    },
    {
      "name": "blob-1.4",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT X'01020k304', 100",
          "expect": "1 {unrecognized token: \"X'01020k304'\"}"
        }
      ]
    },
    {
      "name": "blob-1.5",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT X'01020, 100",
          "expect": "1 {unrecognized token: \"X'01020, 100\"}"
        }
      ]
    },
    {
      "name": "blob-1.6",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT X'01020 100'",
          "expect": "1 {unrecognized token: \"X'01020 100'\"}"
        }
      ]
    },
    {
      "name": "blob-1.7",
      "steps": [
        {
          "type": "catch",
