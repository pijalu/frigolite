{
  "file": "capi2.test",
  "name": "capi2",
  "ordered": true,
  "tests": [
    {
      "name": "capi2-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b,c)"
        },
        {
          "type": "prepare_stmt",
          "sql": "SELECT name, rowid FROM sqlite_master",
          "variable": "stmt_1"
        }
      ]
    },
    {
      "name": "capi2-1.2",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "SELECT name, rowid FROM sqlite_master",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__",
          "expect": "SQLITE_ROW"
        }
      ]
    },
    {
      "name": "capi2-1.6",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "SELECT name, rowid FROM sqlite_master",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__",
          "expect": "SQLITE_DONE"
        }
      ]
    },
    {
      "name": "capi2-1.8",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "SELECT name, rowid FROM sqlite_master",
          "variable": "stmt_1"
