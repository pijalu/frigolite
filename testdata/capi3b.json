          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__",
          "expect": "SQLITE_BUSY"
        }
      ]
    },
    {
      "name": "capi3b-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        },
        {
          "type": "stmt_step",
          "sql": "INSERT INTO t1 VALUES(3)",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__",
          "expect": "SQLITE_DONE"
        }
      ]
    },
    {
      "name": "capi3b-1.7",
      "steps": [
        {
          "type": "stmt_finalize",
          "sql": "INSERT INTO t1 VALUES(3)",
          "variable": "stmt_1",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "capi3b-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
