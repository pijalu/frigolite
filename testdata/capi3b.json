{
  "file": "capi3b.test",
  "name": "capi3b",
  "tests": [
    {
      "name": "capi3b-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n    INSERT INTO t1 VALUES(1);\n    INSERT INTO t1 VALUES(2);\n    SELECT * FROM t1",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "capi3b-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "capi3b-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    SELECT * FROM t1;",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "capi3b-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        }
      ]
    },
    {
      "name": "capi3b-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3"
        }
      ]
    },
    {
      "name": "capi3b-1.9",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3"
        }
      ]
    },
    {
      "name": "capi3b-2.12",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4"
        }
      ]
    }
  ]
}