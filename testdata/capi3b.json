{
  "file": "capi3b.test",
  "name": "capi3b",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "capi3b-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n    INSERT INTO t1 VALUES(1);\n    INSERT INTO t1 VALUES(2);\n    SELECT * FROM t1",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "capi3b-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "capi3b-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    SELECT * FROM t1;",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "capi3b-1.4",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "INSERT INTO t1 VALUES(3)",
          "variable": "stmt_1"
        },
        {
          "type": "stmt_step",
          "sql": "INSERT INTO t1 VALUES(3)",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__",
          "expect": "SQLITE_BUSY"
        }
      ]
    },
    {
      "name": "capi3b-1.5.1",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "INSERT INTO t1 VALUES(3)",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__",
          "expect": "SQLITE_BUSY"
        }
      ]
    },
    {
      "name": "capi3b-1.5.2",
