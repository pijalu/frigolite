    {
      "name": "cast-5.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT CAST('9223372036854775808' AS integer);\n  SELECT CAST('  +000009223372036854775808' AS integer);\n  SELECT CAST('12345678901234567890123' AS INTEGER);",
          "expect": "9223372036854775807 9223372036854775807 9223372036854775807"
        }
      ]
    },
    {
      "name": "cast-5.2",
      "steps": [
