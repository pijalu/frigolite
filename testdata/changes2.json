{
  "file": "changes2.test",
  "name": "changes2",
  "ordered": true,
  "tests": [
    {
      "name": "changes2-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE some_table ( \n    id INTEGER NOT NULL, value VARCHAR(40) NOT NULL, PRIMARY KEY (id)\n  );\n  INSERT INTO some_table (id, value) VALUES (1, 'v1');"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "UPDATE some_table SET value='v2' WHERE id=1 RETURNING id",
          "variable": "stmt_1"
        }
      ]
    },
    {
      "name": "changes2-1.1",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "UPDATE some_table SET value='v2' WHERE id=1 RETURNING id",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__ __DB_CHANGES__",
          "expect": "SQLITE_ROW 1"
        }
      ]
    },
    {
      "name": "changes2-1.2",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "UPDATE some_table SET value='v2' WHERE id=1 RETURNING id",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__ __DB_CHANGES__",
          "expect": "SQLITE_DONE 1"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "stmt_reset",
          "sql": "UPDATE some_table SET value='v2' WHERE id=1 RETURNING id",
          "variable": "stmt_1"
        }
      ]
    },
    {
      "name": "changes2-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE some_table;\n  CREATE TABLE some_table ( \n    id INTEGER NOT NULL, value VARCHAR(40) NOT NULL, PRIMARY KEY (id)\n  );\n  INSERT INTO some_table (id, value) VALUES (1, 'v1');"
        }
      ]
    },
    {
      "name": "changes2-1.3",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "UPDATE some_table SET value='v2' WHERE id=1 RETURNING id",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__ __DB_CHANGES__",
          "expect": "SQLITE_ROW 1"
        }
      ]
    },
    {
      "name": "changes2-1.4",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "UPDATE some_table SET value='v2' WHERE id=1 RETURNING id",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__ __DB_CHANGES__",
          "expect": "SQLITE_DONE 1"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "stmt_finalize",
          "sql": "UPDATE some_table SET value='v2' WHERE id=1 RETURNING id",
          "variable": "stmt_1"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "changes2-2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n  CREATE TABLE log(t);"
        }
      ]
    },
    {
      "name": "setup_3",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "INSERT INTO log VALUES(changes() || ' changes')",
          "variable": "stmt_2"
        }
      ]
    },
    {
      "name": "changes2-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES (1, 'v1'), (2, 'v2');"
        }
      ]
    },
    {
      "name": "changes2-2.2",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "INSERT INTO log VALUES(changes() || ' changes')",
          "variable": "stmt_2"
        },
        {
          "type": "stmt_reset",
          "sql": "INSERT INTO log VALUES(changes() || ' changes')",
          "variable": "stmt_2"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_2__ SQLITE_OK",
          "expect": "SQLITE_DONE SQLITE_OK"
        }
      ]
    },
    {
      "name": "changes2-2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t3(x);"
        }
      ]
    },
    {
      "name": "changes2-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES (3, 'v1'), (4, 'v2');"
        }
      ]
    },
    {
      "name": "changes2-2.3",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "INSERT INTO log VALUES(changes() || ' changes')",
          "variable": "stmt_2"
        },
        {
          "type": "stmt_reset",
          "sql": "INSERT INTO log VALUES(changes() || ' changes')",
          "variable": "stmt_2"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_2__ SQLITE_OK",
          "expect": "SQLITE_DONE SQLITE_OK"
        }
      ]
    },
    {
      "name": "setup_4",
      "steps": [
        {
          "type": "stmt_finalize",
          "sql": "INSERT INTO log VALUES(changes() || ' changes')",
          "variable": "stmt_2"
        }
      ]
    },
    {
      "name": "changes2-2.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM log;",
          "expect": "{2 changes} {2 changes}"
        }
      ]
    }
  ]
}