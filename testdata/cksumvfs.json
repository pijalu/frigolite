{
  "file": "cksumvfs.test",
  "name": "cksumvfs",
  "tests": [
    {
      "name": "1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1;"
        }
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "DELETE FROM t1;"
        }
      ]
    },
    {
      "name": "1.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT count(b) FROM t1",
          "expect": "8500"
        }
      ]
    },
    {
      "name": "1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = wal;\n  DELETE FROM t1;"
        }
      ]
    },
    {
      "name": "1.6",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA wal_checkpoint;",
          "expect": "/0 # #/"
        }
      ]
    },
    {
      "name": "1.7",
      "steps": [
        {
          "type": "query",
          "sql": "WITH s(i) AS (\n    VALUES(1) UNION ALL SELECT i+1 FROM s WHERE i<100\n  )\n  INSERT INTO t1 SELECT NULL, randomblob(5000), randomblob(i) FROM s;\n  SELECT count(*) FROM t1;",
          "expect": "100"
        }
      ]
    },
    {
      "name": "1.8",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT count(*) FROM t1;",
          "expect": "100"
        }
      ]
    },
    {
      "name": "1.9",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT count(*) FROM t1;",
          "expect": "100"
        },
        {
          "type": "exec",
          "sql": "PRAGMA page_size = 4096;"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    }
  ],
  "source": "capi"
}