{
  "file": "close.test",
  "name": "close",
  "ordered": true,
  "tests": [
    {
      "name": "close-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n  INSERT INTO t1 VALUES('one');\n  INSERT INTO t1 VALUES('two');\n  INSERT INTO t1 VALUES('three');"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "close-1.2.1",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "SELECT * FROM t1",
          "variable": "stmt_1",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "close-1.2.2",
      "steps": [
        {
          "type": "stmt_finalize",
          "sql": "SELECT * FROM t1",
          "variable": "stmt_1",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "close-1.3.1",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "SELECT * FROM t1",
          "variable": "stmt_2"
        },
        {
          "type": "stmt_step",
          "sql": "SELECT * FROM t1",
          "variable": "stmt_2"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_2__",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "close-1.3.3",
      "steps": [
        {
          "type": "stmt_finalize",
          "sql": "SELECT * FROM t1",
          "variable": "stmt_2",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "close-1.4.1",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "SELECT * FROM t1",
          "variable": "stmt_3"
        },
        {
          "type": "stmt_step",
          "sql": "SELECT * FROM t1",
          "variable": "stmt_3"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_3__",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "close-1.4.2",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "SELECT * FROM t1",
          "variable": "stmt_3"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_3__ {}",
          "expect": "SQLITE_ROW two"
        }
      ]
    },
    {
      "name": "close-1.4.3",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "SELECT * FROM sqlite_master",
          "variable": "stmt_4",
          "catchMessage": "msg"
        }
      ]
    },
    {
      "name": "close-1.4.4",
      "steps": [
        {
          "type": "stmt_finalize",
          "sql": "SELECT * FROM t1",
          "variable": "stmt_3",
          "expect": "SQLITE_OK"
        }
      ]
    }
  ]
}