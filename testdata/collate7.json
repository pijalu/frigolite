{
  "file": "collate7.test",
  "name": "collate7",
  "ordered": true,
  "tests": [
    {
      "name": "collate7-1.1",
      "steps": [
        {
          "type": "register_collation",
          "collationName": "CASELESS",
          "collationProc": "caseless_cmp",
          "collationBody": "\n  string compare -nocase $zLeft $zRight\n",
          "destructorBody": "incr ::caseless_del",
          "callbackVars": {
            "": "incr ::caseless_del",
            "::caseless_del": "0",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "cmd": "incr ::caseless_del",
            "testdir": ""
          },
          "functionArgs": [
            "zLeft",
            "zRight"
          ],
          "database": "db"
        },
        {
          "type": "runtime_var",
          "variable": "caseless_del",
          "expect": "0"
        }
      ]
    },
    {
      "name": "collate7-1.2",
      "steps": [
        {
          "type": "delete_collation",
          "collationName": "CASELESS",
          "database": "db"
        },
        {
          "type": "runtime_var",
          "variable": "caseless_del",
          "expect": "1"
        }
      ]
    },
    {
      "name": "collate7-1.3",
      "steps": [
        {
          "type": "catch",
          "sql": "CREATE TABLE abc(a COLLATE CASELESS, b, c);",
          "expect": "1 {no such collation sequence: CASELESS}"
        }
      ]
    },
    {
      "name": "collate7-1.4",
      "steps": [
        {
          "type": "register_collation",
          "collationName": "CASELESS",
          "collationProc": "caseless_cmp",
          "collationBody": "\n  string compare -nocase $zLeft $zRight\n",
          "destructorBody": "incr ::caseless_del",
          "callbackVars": {
            "": "0",
            "::caseless_del": "0",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "cmd": "incr ::caseless_del",
            "testdir": ""
          },
          "functionArgs": [
            "zLeft",
            "zRight"
          ],
          "database": "db"
        },
        {
          "type": "close_db"
        },
        {
          "type": "runtime_var",
          "variable": "caseless_del",
          "expect": "2"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db-journal"
        }
      ]
    },
    {
      "name": "collate7-2.1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "register_collation",
          "collationName": "CASELESS",
          "collationProc": "caseless_cmp",
          "collationBody": "\n  string compare -nocase $zLeft $zRight\n",
          "destructorBody": "incr ::caseless_del",
          "callbackVars": {
            "": "0",
            "::caseless_del": "0",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "cmd": "incr ::caseless_del",
            "testdir": ""
          },
          "functionArgs": [
            "zLeft",
            "zRight"
          ],
          "database": "db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA encoding='utf-16';\n    CREATE TABLE abc16(a COLLATE CASELESS, b, c);"
        },
        {
          "type": "runtime_var",
          "variable": "caseless_del",
          "expect": "2"
        }
      ]
    },
    {
      "name": "collate7-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM abc16 WHERE a \u003c 'abc';"
        },
        {
          "type": "runtime_var",
          "variable": "caseless_del",
          "expect": "2"
        }
      ]
    },
    {
      "name": "collate7-2.3",
      "steps": [
        {
          "type": "delete_collation",
          "collationName": "CASELESS",
          "database": "db"
        },
        {
          "type": "runtime_var",
          "variable": "caseless_del",
          "expect": "3"
        }
      ]
    },
    {
      "name": "collate7-2.4",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM abc16 WHERE a \u003c 'abc';",
          "expect": "1 {no such collation sequence: CASELESS}"
        }
      ]
    }
  ]
}