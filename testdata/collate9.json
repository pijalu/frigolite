{
  "file": "collate9.test",
  "name": "collate9",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "register_collation",
          "collationName": "reverse sort",
          "collationProc": "reverse_sort",
          "collationBody": "\n  return [string compare $rhs $lhs]\n",
          "callbackVars": {
            "": "",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "testdir": ""
          },
          "functionArgs": [
            "lhs",
            "rhs"
          ]
        }
      ]
    },
    {
      "name": "collate9-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE xy(x COLLATE \"reverse sort\", y COLLATE binary);\n    INSERT INTO xy VALUES('one', 'one');\n    INSERT INTO xy VALUES('two', 'two');\n    INSERT INTO xy VALUES('three', 'three');"
        }
      ]
    },
    {
      "name": "collate9-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT x FROM xy ORDER BY x",
          "expect": "two three one"
        }
      ]
    },
    {
      "name": "collate9-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT y FROM xy ORDER BY y",
          "expect": "one three two"
        }
      ]
    },
    {
      "name": "collate9-1.4",
      "steps": [
        {
          "type": "query_assign",
          "sql": "SELECT x FROM xy ORDER BY x",
          "variable": "data",
          "resultAll": true,
          "sortMarker": true,
          "expect": "two three one sort"
        }
      ]
    },
    {
      "name": "collate9-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE INDEX xy_i ON xy(x)"
        }
      ]
    },
    {
      "name": "collate9-1.6",
      "steps": [
        {
          "type": "query_assign",
          "sql": "SELECT x FROM xy ORDER BY x",
          "variable": "data",
          "resultAll": true,
          "sortMarker": true,
          "expect": "two three one nosort"
        }
      ]
    },
    {
      "name": "collate9-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT x, x \u003c 'seven' FROM xy ORDER BY x",
          "expect": "two 1 three 1 one 0"
        }
      ]
    },
    {
      "name": "collate9-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT y, y \u003c 'seven' FROM xy ORDER BY x",
          "expect": "two 0 three 0 one 1"
        }
      ]
    },
    {
      "name": "collate9-2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT y, y COLLATE \"reverse sort\" \u003c 'seven' FROM xy ORDER BY x",
          "expect": "two 1 three 1 one 0"
        }
      ]
    },
    {
      "name": "collate9-2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT y FROM xy ORDER BY y",
          "expect": "one three two"
        }
      ]
    },
    {
      "name": "collate9-2.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT y FROM xy ORDER BY y COLLATE \"reverse sort\"",
          "expect": "two three one"
        }
      ]
    },
    {
      "name": "collate9-2.6",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT y COLLATE \"reverse sort\" AS aaa FROM xy ORDER BY aaa",
          "expect": "two three one"
        }
      ]
    },
    {
      "name": "collate9-3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE INDEX xy_i2 ON xy(y COLLATE \"reverse sort\");"
        }
      ]
    },
    {
      "name": "collate9-3.2",
      "steps": [
        {
          "type": "query_assign",
          "sql": "SELECT y FROM xy ORDER BY y",
          "variable": "data",
          "resultAll": true,
          "sortMarker": true,
          "expect": "one three two sort"
        }
      ]
    },
    {
      "name": "collate9-3.3",
      "steps": [
        {
          "type": "query_assign",
          "sql": "SELECT y FROM xy ORDER BY y COLLATE \"reverse sort\"",
          "variable": "data",
          "resultAll": true,
          "sortMarker": true,
          "expect": "two three one nosort"
        }
      ]
    },
    {
      "name": "collate9-3.4",
      "steps": [
        {
          "type": "query_assign",
          "sql": "SELECT y AS aaa FROM xy ORDER BY aaa",
          "variable": "data",
          "resultAll": true,
          "sortMarker": true,
          "expect": "one three two sort"
        }
      ]
    },
    {
      "name": "collate9-3.5",
      "steps": [
        {
          "type": "query_assign",
          "sql": "SELECT y COLLATE \"reverse sort\" AS aaa FROM xy ORDER BY aaa",
          "variable": "data",
          "resultAll": true,
          "sortMarker": true,
          "expect": "two three one nosort"
        }
      ]
    },
    {
      "name": "collate9-4.1",
      "steps": [
        {
          "type": "exec",
          "sql": "REINDEX \"reverse sort\""
        }
      ]
    },
    {
      "name": "collate9-4.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA integrity_check",
          "expect": "0"
        }
      ]
    },
    {
      "name": "collate9-4.3",
      "steps": [
        {
          "type": "exec",
          "sql": "REINDEX \"reverse sort\""
        }
      ]
    },
    {
      "name": "collate9-4.4",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA integrity_check",
          "expect": "1"
        }
      ]
    },
    {
      "name": "collate9-4.5",
      "steps": [
        {
          "type": "query_assign",
          "sql": "SELECT x FROM xy ORDER BY x COLLATE \"reverse sort\"",
          "variable": "data",
          "resultAll": true,
          "sortMarker": true,
          "expect": "one three two nosort"
        }
      ]
    }
  ]
}