{
  "file": "collate9.test",
  "name": "collate9",
  "tests": [
    {
      "name": "collate9-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE xy(x COLLATE \"reverse sort\", y COLLATE binary);\n    INSERT INTO xy VALUES('one', 'one');\n    INSERT INTO xy VALUES('two', 'two');\n    INSERT INTO xy VALUES('three', 'three');"
        }
      ]
    },
    {
      "name": "collate9-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT x FROM xy ORDER BY x",
          "expect": "two three one"
        }
      ]
    },
    {
      "name": "collate9-1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT y FROM xy ORDER BY y",
          "expect": "one three two"
        }
      ]
    },
    {
      "name": "collate9-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE INDEX xy_i ON xy(x)"
        }
      ]
    },
    {
      "name": "collate9-2.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT x, x < 'seven' FROM xy ORDER BY x",
          "expect": "two 1 three 1 one 0"
        }
      ]
    },
    {
      "name": "collate9-2.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT y, y < 'seven' FROM xy ORDER BY x",
          "expect": "two 0 three 0 one 1"
        }
      ]
    },
    {
      "name": "collate9-2.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT y, y COLLATE \"reverse sort\" < 'seven' FROM xy ORDER BY x",
          "expect": "two 1 three 1 one 0"
        }
      ]
    },
    {
      "name": "collate9-2.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT y FROM xy ORDER BY y",
          "expect": "one three two"
        }
      ]
    },
    {
      "name": "collate9-2.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT y FROM xy ORDER BY y COLLATE \"reverse sort\"",
          "expect": "two three one"
        }
      ]
    },
    {
      "name": "collate9-2.6",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT y COLLATE \"reverse sort\" AS aaa FROM xy ORDER BY aaa",
          "expect": "two three one"
        }
      ]
    },
    {
      "name": "collate9-3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE INDEX xy_i2 ON xy(y COLLATE \"reverse sort\");"
        }
      ]
    },
    {
      "name": "collate9-4.1",
      "steps": [
