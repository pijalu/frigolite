{
  "file": "colname.test",
  "name": "colname",
  "ordered": true,
  "tests": [
    {
      "name": "colname-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA short_column_names",
          "expect": "1"
        }
      ]
    },
    {
      "name": "colname-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA full_column_names",
          "expect": "0"
        }
      ]
    },
    {
      "name": "colname-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE tabc(a,b,c);\n    INSERT INTO tabc VALUES(1,2,3);\n    CREATE TABLE txyz(x,y,z);\n    INSERT INTO txyz VALUES(4,5,6);\n    CREATE TABLE tboth(a,b,c,x,y,z);\n    INSERT INTO tboth VALUES(11,12,13,14,15,16);\n    CREATE VIEW v1 AS SELECT tabC.a, txyZ.x, * \n      FROM tabc, txyz ORDER BY 1 LIMIT 1;\n    CREATE VIEW v2 AS SELECT tabC.a, txyZ.x, tboTh.a, tbotH.x, *\n      FROM tabc, txyz, tboth ORDER BY 1 LIMIT 1;"
        },
        {
          "type": "query2",
          "sql": "SELECT * FROM tabc;",
          "expect": "a 1 b 2 c 3"
        }
      ]
    },
    {
      "name": "colname-2.2",
      "steps": [
        {
          "type": "query2",
          "sql": "SELECT Tabc.a, tAbc.b, taBc.c, * FROM tabc",
          "expect": "a 1 b 2 c 3 a 1 b 2 c 3"
        }
      ]
    },
    {
      "name": "colname-2.3",
      "steps": [
        {
          "type": "query2",
          "sql": "SELECT +tabc.a, -tabc.b, tabc.c, * FROM tabc",
          "expect": "+tabc.a 1 -tabc.b -2 c 3 a 1 b 2 c 3"
        }
      ]
    },
    {
      "name": "colname-2.4",
      "steps": [
        {
          "type": "query2",
          "sql": "SELECT +tabc.a AS AAA, -tabc.b AS BBB, tabc.c CCC, * FROM tabc",
          "expect": "AAA 1 BBB -2 CCC 3 a 1 b 2 c 3"
        }
      ]
    },
    {
      "name": "colname-2.5",
      "steps": [
        {
          "type": "query2",
          "sql": "SELECT tabc.a, txyz.x, * FROM tabc, txyz;",
          "expect": "a 1 x 4 a 1 b 2 c 3 x 4 y 5 z 6"
        }
      ]
    },
    {
      "name": "colname-2.6",
      "steps": [
        {
          "type": "query2",
          "sql": "SELECT tabc.a, txyz.x, tabc.*, txyz.* FROM tabc, txyz;",
          "expect": "a 1 x 4 a 1 b 2 c 3 x 4 y 5 z 6"
        }
      ]
    },
    {
      "name": "colname-2.7",
