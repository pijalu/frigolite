{
  "file": "corrupt3.test",
  "name": "corrupt3",
  "tests": [
    {
      "name": "corrupt3-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT x FROM t1"
        }
      ]
    },
    {
      "name": "corrupt3-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA integrity_check",
          "expect": "0 {{*** in database main ***\nTree 2 page 2 cell 0: 2nd reference to page 3}}"
        }
      ]
    },
    {
      "name": "corrupt3-1.9",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT substr(x,1,10) FROM t1"
        }
      ]
    },
    {
      "name": "corrupt3-1.10",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA integrity_check",
          "expect": "0 {{*** in database main ***\nTree 2 page 2 cell 0: invalid page number 4\nPage 3: never used}}"
        }
      ]
    },
    {
      "name": "corrupt3-1.11",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT substr(x,1,10) FROM t1"
        }
      ]
    },
    {
      "name": "corrupt3-1.12",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA integrity_check",
          "expect": "0 {{*** in database main ***\nTree 2 page 2 cell 0: overflow list length is 0 but should be 1\nPage 3: never used}}"
        }
      ]
    }
  ]
