{
  "file": "corrupt4.test",
  "name": "corrupt4",
  "tests": [
    {
      "name": "2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA page_size = 512;\n  CREATE TABLE t1(a, b, c);"
        }
      ]
    },
    {
      "name": "2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA writable_schema = 1;\n    SELECT * FROM sqlite_schema;",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "corrupt4-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA freelist_count",
          "expect": "2"
        }
      ]
    },
    {
      "name": "corrupt4-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE t2",
          "expect": "1 {database disk image is malformed}"
        },
        {
          "type": "exec",
          "sql": "PRAGMA freelist_count"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    }
  ]
}