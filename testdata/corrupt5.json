  "ordered": true,
  "tests": [
    {
      "name": "corrupt5-1.1",
      "steps": [
        {
          "type": "defensive",
          "sql": "0"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b,c);\n    CREATE INDEX i1 ON t1(a,b);\n    PRAGMA writable_schema=ON;\n    UPDATE sqlite_master SET name=NULL, sql=NULL WHERE name='i1';"
        },
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "1 {malformed database schema (?)}"
        }
      ]
    }
  ]
}