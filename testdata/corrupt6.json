{
  "file": "corrupt6.test",
  "name": "corrupt6",
  "ordered": true,
  "tests": [
    {
      "name": "corrupt6-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum=OFF;\n    PRAGMA page_size=1024;\n    CREATE TABLE t1(x);\n    INSERT INTO t1(x) VALUES('varint32-01234567890123456789012345678901234567890123456789');\n    INSERT INTO t1(x) VALUES('varint32-01234567890123456789012345678901234567890123456789');",
          "expect": "2048"
        }
      ]
    },
    {
      "name": "corrupt6-1.6",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "catch",
          "sql": "SELECT substr(x,1,8) FROM t1",
          "expect": "0 {varint32 varint32}"
        }
      ]
    },
    {
      "name": "corrupt6-1.8.1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "hexio_write",
          "sql": "test.db",
          "fileData": "8105",
          "fileTarget": "test.db",
          "fileOffset": 1923
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "catch",
          "sql": "SELECT substr(x,1,8) FROM t1",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
