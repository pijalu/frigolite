{
  "file": "corrupt9.test",
  "name": "corrupt9",
  "ordered": true,
  "tests": [
    {
      "name": "corrupt9-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum=NONE;\n    PRAGMA page_size=1024;\n    CREATE TABLE t1(x);\n    INSERT INTO t1(x) VALUES(1);\n    INSERT INTO t1(x) VALUES(2);\n    INSERT INTO t1(x) SELECT x+2 FROM t1;\n    INSERT INTO t1(x) SELECT x+4 FROM t1;\n    INSERT INTO t1(x) SELECT x+8 FROM t1;\n    INSERT INTO t1(x) SELECT x+16 FROM t1;\n    INSERT INTO t1(x) SELECT x+32 FROM t1;\n    INSERT INTO t1(x) SELECT x+64 FROM t1;\n    INSERT INTO t1(x) SELECT x+128 FROM t1;\n    INSERT INTO t1(x) SELECT x+256 FROM t1;\n    CREATE TABLE t2(a,b);\n    INSERT INTO t2 SELECT x, x*x FROM t1;\n    CREATE INDEX i1 ON t1(x);\n    CREATE INDEX i2 ON t2(b,a);\n    DROP INDEX i2;",
          "expect": "1"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "copy_file",
          "sql": "test.db",
          "fileTarget": "test.db-template"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "corrupt9-2.1",
      "steps": [
        {
          "type": "query_assign",
          "sql": "PRAGMA integrity_check",
          "variable": "x",
          "resultAll": true
        },
        {
          "type": "runtime_expr",
          "sql": "$x!=\"ok\"",
          "expect": "1"
        }
      ]
    },
    {
      "name": "corrupt9-2.2",
      "steps": [
        {
          "type": "catch",
          "sql": "CREATE INDEX i2 ON t2(b,a);\n    REINDEX;",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "copy_file",
