{
  "file": "corruptA.test",
  "name": "corruptA",
  "ordered": true,
  "tests": [
    {
      "name": "corruptA-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n    INSERT INTO t1(x) VALUES(1);",
          "expect": "1"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "copy_file",
          "sql": "test.db",
          "fileTarget": "test.db-template"
        }
      ]
    },
    {
      "name": "corruptA-2.1",
      "steps": [
        {
          "type": "copy_file",
          "sql": "test.db-template",
          "fileTarget": "test.db"
        },
        {
          "type": "hexio_write",
          "sql": "test.db",
          "fileData": "03",
          "fileTarget": "test.db",
          "fileOffset": 19
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "1 {file is not a database}"
        }
      ]
    },
