{
  "file": "corruptG.test",
  "name": "corruptG",
  "ordered": true,
  "tests": [
    {
      "name": "corruptG-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA page_size=512;\n  CREATE TABLE t1(a,b,c);\n  INSERT INTO t1(rowid,a,b,c) VALUES(52,'abc','xyz','123');\n  CREATE INDEX t1abc ON t1(a,b,c);"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "query_assign",
          "sql": "SELECT rootpage FROM sqlite_master WHERE name = 't1abc'",
          "variable": "idxroot"
        },
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "corruptG-1.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT c FROM t1 WHERE a\u003e'abc';",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "corruptG-1.3",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA integrity_check",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "corruptG-1.4",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT c FROM t1 ORDER BY a;",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "corruptG-2.1",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT rowid FROM t1 WHERE a='abc' and b='xyz123456789XYZ';",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    }
  ]
}