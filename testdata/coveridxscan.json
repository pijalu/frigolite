{
  "file": "coveridxscan.test",
  "name": "coveridxscan",
  "ordered": true,
  "tests": [
    {
      "name": "coveridxscan-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b,c);\n    INSERT INTO t1 VALUES(5,4,3), (4,8,2), (3,2,1);\n    CREATE INDEX t1ab ON t1(a,b);\n    CREATE INDEX t1b ON t1(b);\n    SELECT a FROM t1;",
          "expect": "3 4 5"
        }
      ]
    },
    {
      "name": "coveridxscan-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT a, c FROM t1;",
          "expect": "5 3 4 2 3 1"
        }
      ]
    },
    {
      "name": "coveridxscan-1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT b FROM t1;",
          "expect": "2 4 8"
        }
      ]
