{
  "file": "cse.test",
  "name": "cse",
  "ordered": true,
  "tests": [
    {
      "name": "cse-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a INTEGER PRIMARY KEY, b, c, d, e, f);\n    INSERT INTO t1 VALUES(1,11,12,13,14,15);\n    INSERT INTO t1 VALUES(2,21,22,23,24,25);"
        },
        {
          "type": "exec",
          "sql": "SELECT b, -b, ~b, NOT b, NOT NOT b, b-b, b+b, b*b, b/b, b FROM t1",
          "expect": "11 -11 -12 0 1 0 22 121 1 11 21 -21 -22 0 1 0 42 441 1 21"
        }
      ]
    },
    {
      "name": "cse-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT b, b%b, b==b, b!=b, b\u003cb, b\u003c=b, b IS NULL, b NOT NULL, b FROM t1",
          "expect": "11 0 1 0 0 1 0 1 11 21 0 1 0 0 1 0 1 21"
        }
      ]
    },
    {
      "name": "cse-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT b, abs(b), coalesce(b,-b,NOT b,c,NOT c), c, -c FROM t1;",
          "expect": "11 11 11 12 -12 21 21 21 22 -22"
        }
      ]
    },
    {
      "name": "cse-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT CASE WHEN a==1 THEN b ELSE c END, b, c FROM t1",
          "expect": "11 11 12 22 21 22"
        }
      ]
    },
    {
      "name": "cse-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT CASE a WHEN 1 THEN b WHEN 2 THEN c ELSE d END, b, c, d FROM t1",
          "expect": "11 11 12 13 22 21 22 23"
        }
      ]
    },
    {
      "name": "cse-1.6.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT CASE b WHEN 11 THEN -b WHEN 21 THEN -c ELSE -d END, b, c, d FROM t1",
          "expect": "-11 11 12 13 -22 21 22 23"
        }
      ]
    },
    {
      "name": "cse-1.6.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT CASE b+1 WHEN c THEN d WHEN e THEN f ELSE 999 END, b, c, d FROM t1",
          "expect": "13 11 12 13 23 21 22 23"
        }
      ]
    },
    {
      "name": "cse-1.6.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT CASE WHEN b THEN d WHEN e THEN f ELSE 999 END, b, c, d FROM t1",
          "expect": "13 11 12 13 23 21 22 23"
        }
      ]
    },
    {
      "name": "cse-1.6.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT b, c, d, CASE WHEN b THEN d WHEN e THEN f ELSE 999 END FROM t1",
          "expect": "11 12 13 13 21 22 23 23"
        }
      ]
    },
    {
      "name": "cse-1.6.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT b, c, d, CASE WHEN 0 THEN d WHEN e THEN f ELSE 999 END FROM t1",
          "expect": "11 12 13 15 21 22 23 25"
        }
      ]
    },
    {
      "name": "cse-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT a, -a, ~a, NOT a, NOT NOT a, a-a, a+a, a*a, a/a, a FROM t1",
          "expect": "1 -1 -2 0 1 0 2 1 1 1 2 -2 -3 0 1 0 4 4 1 2"
        }
      ]
    },
    {
      "name": "cse-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT a, a%a, a==a, a!=a, a\u003ca, a\u003c=a, a IS NULL, a NOT NULL, a FROM t1",
