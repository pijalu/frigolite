      ]
    },
    {
      "name": "cse-1.10",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT CAST(b AS integer), typeof(b), CAST(b AS text), typeof(b) FROM t1",
          "expect": "11 integer 11 integer 21 integer 21 integer"
        }
      ]
    },
    {
      "name": "cse-1.11",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT *,* FROM t1 WHERE a=2\n      UNION ALL\n      SELECT *,* FROM t1 WHERE a=1",
          "expect": "2 21 22 23 24 25 2 21 22 23 24 25 1 11 12 13 14 15 1 11 12 13 14 15"
        }
      ]
    },
    {
      "name": "cse-1.12",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT coalesce(b,c,d,e), a, b, c, d, e FROM t1 WHERE a=2\n      UNION ALL\n      SELECT coalesce(e,d,c,b), e, d, c, b, a FROM t1 WHERE a=1",
          "expect": "21 2 21 22 23 24 14 14 13 12 11 1"
        }
      ]
    },
    {
      "name": "cse-1.13",
      "steps": [
        {
          "type": "exec",
