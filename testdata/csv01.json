{
  "file": "csv01.test",
  "name": "csv01",
  "tests": [
    {
      "name": "1.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT name FROM pragma_table_xinfo('t1');",
          "expect": "a b mix-bloom-eel {soft opinion}"
        }
      ]
    },
    {
      "name": "1.6",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT name FROM pragma_table_xinfo('t1');",
          "expect": "c0 c1 c2 c3"
        }
      ]
    },
    {
      "name": "1.8",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT name FROM pragma_table_xinfo('t1');",
          "expect": "x0 x1 x2 x3 x4"
        }
      ]
    },
    {
      "name": "2.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t2 WHERE b=10;",
          "expect": "9 10 11 12"
        }
      ]
    },
    {
      "name": "2.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t2 WHERE c=11;",
          "expect": "9 10 11 12"
        }
      ]
    },
    {
      "name": "2.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t2 WHERE d=12;"
        }
      ]
    },
    {
      "name": "2.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t2 WHERE d='12';",
          "expect": "9 10 11 12"
        }
      ]
    },
    {
      "name": "2.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t2 WHERE a='9';",
          "expect": "9 10 11 12"
        }
      ]
    },
    {
      "name": "3.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT a FROM t3 WHERE +b=6 OR c=7 OR d=12 ORDER BY +a;",
          "expect": "5 9"
        }
      ]
    },
    {
      "name": "3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid, a FROM t3;",
          "expect": "1 {no such column: rowid}"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    }
  ]
}