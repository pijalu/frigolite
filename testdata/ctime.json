{
  "file": "ctime.test",
  "name": "ctime",
  "ordered": true,
  "tests": [
    {
      "name": "ctime-1.1.1",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA compile_options();",
          "expect": "1 {near \")\": syntax error}"
        }
      ]
    },
    {
      "name": "ctime-1.1.2",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA compile_options(NULL);",
          "expect": "1 {near \"NULL\": syntax error}"
        }
      ]
    },
    {
      "name": "ctime-1.1.3",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA compile_options *;",
          "expect": "1 {near \"*\": syntax error}"
        }
      ]
    },
    {
      "name": "ctime-1.2.1",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA compile_options;",
          "expect": "0"
        }
      ]
    },
    {
      "name": "ctime-1.2.2",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA compile_options;",
          "expect": "0 1"
        }
      ]
    },
    {
      "name": "ctime-1.3.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT sqlite_compileoption_used('SQLITE_THREADSAFE')",
          "expect": "1"
        }
      ]
    },
    {
      "name": "ctime-1.3.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT sqlite_compileoption_used('THREADSAFE')",
          "expect": "1"
        }
      ]
    },
    {
      "name": "ctime-1.3.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT sqlite_compileoption_used('THREADSAFE=0')",
          "expect": "0"
        }
      ]
    },
    {
      "name": "ctime-1.3.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT sqlite_compileoption_used('THREADSAFE=1')",
          "expect": "0"
        }
      ]
    },
    {
      "name": "ctime-1.3.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT sqlite_compileoption_used('THREADSAFE=2')",
          "expect": "1"
        }
      ]
    },
    {
      "name": "ctime-1.3.6",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT sqlite_compileoption_used('THREADSAFE=')",
          "expect": "0"
        }
      ]
    },
    {
      "name": "ctime-1.4.1",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_used('SQLITE_THREADSAFE');",
          "expect": "0 1"
        }
      ]
    },
    {
      "name": "ctime-1.4.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_used('THREADSAFE');",
          "expect": "0 1"
        }
      ]
    },
    {
      "name": "ctime-1.4.3",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_used(\"THREADSAFE\");",
          "expect": "0 1"
        }
      ]
    },
    {
      "name": "ctime-1.5",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_used('THREADSAFE=0');",
          "resultTransform": "lsort:ascii"
        },
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_used('THREADSAFE=1');"
        },
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_used('THREADSAFE=2');",
          "expect": "{0 0} {0 0} {0 1}"
        }
      ]
    },
    {
      "name": "ctime-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT sqlite_compileoption_used('THREADSAFE=');",
          "expect": "0"
        }
      ]
    },
    {
      "name": "ctime-1.7.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT sqlite_compileoption_used('SQLITE_OMIT_COMPILEOPTION_DIAGS');",
          "expect": "0"
        }
      ]
    },
    {
      "name": "ctime-1.7.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT sqlite_compileoption_used('OMIT_COMPILEOPTION_DIAGS');",
          "expect": "0"
        }
      ]
    },
    {
      "name": "ctime-2.1.1",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_used();",
          "expect": "1 {wrong number of arguments to function sqlite_compileoption_used()}"
        }
      ]
    },
    {
      "name": "ctime-2.1.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_used(NULL);",
          "expect": "0 {{}}"
        }
      ]
    },
    {
      "name": "ctime-2.1.3",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_used(\"\");",
          "expect": "0 0"
        }
      ]
    },
    {
      "name": "ctime-2.1.4",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_used('');",
          "expect": "0 0"
        }
      ]
    },
    {
      "name": "ctime-2.1.5",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_used(foo);",
          "expect": "1 {no such column: foo}"
        }
      ]
    },
    {
      "name": "ctime-2.1.6",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_used('THREADSAFE', 0);",
          "expect": "1 {wrong number of arguments to function sqlite_compileoption_used()}"
        }
      ]
    },
    {
      "name": "ctime-2.1.7",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_used(0);",
          "expect": "0 0"
        }
      ]
    },
    {
      "name": "ctime-2.1.8",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_used('0');",
          "expect": "0 0"
        }
      ]
    },
    {
      "name": "ctime-2.1.9",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_used(1.0);",
          "expect": "0 0"
        }
      ]
    },
    {
      "name": "ctime-2.2.1",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_get();",
          "expect": "1 {wrong number of arguments to function sqlite_compileoption_get()}"
        }
      ]
    },
    {
      "name": "ctime-2.2.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_get(0, 0);",
          "expect": "1 {wrong number of arguments to function sqlite_compileoption_get()}"
        }
      ]
    },
    {
      "name": "ctime-2.3",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_used(sqlite_compileoption_get(0));",
          "expect": "0 1"
        }
      ]
    },
    {
      "name": "ctime-2.4",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_get(0);",
          "expect": "0"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA compile_options;"
        }
      ]
    },
    {
      "name": "ctime-2.5.1",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_get(0);",
          "expect": "0 {{}}"
        }
      ]
    },
    {
      "name": "ctime-2.5.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT sqlite_compileoption_get(-1);",
          "expect": "0 {{}}"
        }
      ]
    },
    {
      "name": "ctime-3.0.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA compile_options",
          "expect": "1"
        }
      ]
    }
  ]
}