{
  "file": "dbdata.test",
  "name": "dbdata",
  "tests": [
    {
      "name": "1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE T1(a, b);\n  INSERT INTO t1(rowid, a ,b) VALUES(5, 'v', 'five');\n  INSERT INTO t1(rowid, a, b) VALUES(10, 'x', 'ten');"
        }
      ]
    },
    {
      "name": "1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT pgno, cell, field, quote(value) FROM sqlite_dbdata WHERE pgno=2;",
          "expect": "2 0 -1 5 \n  2 0  0 'v' \n  2 0  1 'five' \n  2 1 -1 10 \n  2 1  0 'x' \n  2 1  1 'ten'"
        }
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT pgno, cell, field, quote(value) FROM sqlite_dbdata;",
          "expect": "1 0 -1 1 \n  1 0 0 'table' \n  1 0 1 'T1' \n  1 0 2 'T1' \n  1 0 3 2 \n  1 0 4 {'CREATE TABLE T1(a, b)'}\n  2 0 -1 5 \n  2 0  0 'v' \n  2 0  1 'five' \n  2 1 -1 10 \n  2 1  0 'x' \n  2 1  1 'ten'"
        }
      ]
    },
    {
      "name": "1.4",
      "steps": [
        {
