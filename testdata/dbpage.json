{
  "file": "dbpage.test",
  "name": "dbpage",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "defensive",
          "sql": "0"
        }
      ]
    },
    {
      "name": "dbpage-100",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum=0;\n    PRAGMA page_size=4096;\n    PRAGMA journal_mode=WAL;"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b);\n    WITH RECURSIVE c(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM c WHERE x\u003c100)\n      INSERT INTO t1(a,b) SELECT x, printf('%d-x%.*c',x,x,'x') FROM c;\n    PRAGMA integrity_check;",
          "expect": "ok"
        }
      ]
    },
    {
      "name": "dbpage-110",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT pgno, quote(substr(data,1,5)) FROM sqlite_dbpage('main') ORDER BY pgno;",
          "expect": "1 X'53514C6974' 2 X'0500000001' 3 X'0D0000004E' 4 X'0D00000016'"
        }
      ]
    },
    {
      "name": "dbpage-120",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT pgno, quote(substr(data,1,5)) FROM sqlite_dbpage WHERE pgno=2;",
          "expect": "2 X'0500000001'"
        }
      ]
    },
    {
      "name": "dbpage-130",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT pgno, quote(substr(data,1,5)) FROM sqlite_dbpage WHERE pgno=4;",
          "expect": "4 X'0D00000016'"
        }
      ]
    },
    {
      "name": "dbpage-140",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT pgno, quote(substr(data,1,5)) FROM sqlite_dbpage WHERE pgno=5;"
        }
      ]
    },
    {
