      "steps": [
        {
          "type": "query",
          "sql": "SELECT pgno, quote(substr(data,1,5)) FROM sqlite_dbpage WHERE pgno=0;"
        }
      ]
    },
    {
      "name": "dbpage-160",
      "steps": [
        {
          "type": "query",
          "sql": "ATTACH ':memory:' AS aux1;\n  PRAGMA aux1.page_size=4096;\n  CREATE TABLE aux1.t2(a,b,c);\n  INSERT INTO t2 VALUES(11,12,13);\n  SELECT pgno, quote(substr(data,1,5)) FROM sqlite_dbpage('aux1');",
          "expect": "1 X'53514C6974' 2 X'0D00000001'"
        }
      ]
    },
    {
      "name": "dbpage-170",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE aux1.x3(x,y,z);\n  INSERT INTO x3(x,y,z) VALUES(1,'main',1),(2,'aux1',1);\n  SELECT pgno, schema, substr(data,1,6)\n    FROM sqlite_dbpage, x3\n   WHERE sqlite_dbpage.schema=x3.y AND sqlite_dbpage.pgno=x3.z\n   ORDER BY x3.x;",
          "expect": "1 main SQLite 1 aux1 SQLite"
        }
      ]
    },
    {
      "name": "dbpage-200",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TEMP TABLE saved_content(x);\n  INSERT INTO saved_content(x) SELECT data FROM sqlite_dbpage WHERE pgno=4;\n  UPDATE sqlite_dbpage SET data=zeroblob(4096) WHERE pgno=4;"
        }
      ]
    },
    {
      "name": "dbpage-210",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA integrity_check;",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "dbpage-220",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT pgno, quote(substr(data,1,5)) FROM sqlite_dbpage('main') ORDER BY pgno;",
          "expect": "1 X'53514C6974' 2 X'0500000001' 3 X'0D0000004E' 4 X'0000000000'"
        }
      ]
    },
    {
      "name": "dbpage-230",
      "steps": [
        {
          "type": "exec",
          "sql": "UPDATE sqlite_dbpage SET data=(SELECT x FROM saved_content) WHERE pgno=4;"
        },
