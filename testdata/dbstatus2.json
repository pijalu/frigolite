{
  "file": "dbstatus2.test",
  "name": "dbstatus2",
  "ordered": true,
  "tests": [
    {
      "name": "dbstatus2-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA page_size = 1024;\n  PRAGMA auto_vacuum = 0;\n\n  CREATE TABLE t1(a PRIMARY KEY, b);\n  INSERT INTO t1 VALUES(1, randomblob(600));\n  INSERT INTO t1 VALUES(2, randomblob(600));\n  INSERT INTO t1 VALUES(3, randomblob(600));"
        }
      ]
    },
    {
      "name": "dbstatus2-1.1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA mmap_size = 0",
          "expect": "6"
        }
      ]
    },
    {
      "name": "dbstatus2-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT b FROM t1 WHERE a=2",
          "expect": "{0 2 0} {0 4 0}"
        }
      ]
    },
    {
      "name": "dbstatus2-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT b FROM t1 WHERE a=2",
          "expect": "{0 6 0} {0 4 0}"
        }
      ]
    },
    {
      "name": "dbstatus2-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT b FROM t1 WHERE a=2",
          "expect": "{0 10 0} {0 4 0}"
        }
      ]
    },
    {
      "name": "dbstatus2-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(4, randomblob(600))",
          "expect": "0 4 0"
        }
      ]
    },
    {
      "name": "dbstatus2-2.7",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(5, randomblob(600))",
          "expect": "0 4 0"
        }
      ]
    },
    {
      "name": "dbstatus2-3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode=DELETE;\n  PRAGMA cache_size=3;\n  UPDATE t1 SET b=randomblob(1000);",
          "expect": "delete"
        }
      ]
    }
  ]
}