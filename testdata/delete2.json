{
  "file": "delete2.test",
  "name": "delete2",
  "ordered": true,
  "tests": [
    {
      "name": "delete2-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE q(s string, id string, constraint pk_q primary key(id));\n    BEGIN;\n    INSERT INTO q(s,id) VALUES('hello','id.1');\n    INSERT INTO q(s,id) VALUES('goodbye','id.2');\n    INSERT INTO q(s,id) VALUES('again','id.3');\n    END;\n    SELECT * FROM q;",
          "expect": "hello id.1 goodbye id.2 again id.3"
        }
      ]
    },
    {
      "name": "delete2-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM q WHERE id='id.1';",
          "expect": "hello id.1"
        }
      ]
    },
    {
      "name": "delete2-1.4",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "SELECT * FROM q",
          "variable": "stmt_1"
        },
        {
          "type": "stmt_step",
          "sql": "SELECT * FROM q",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__",
          "expect": "SQLITE_ROW"
        }
      ]
    },
    {
      "name": "delete2-1.6",
      "steps": [
        {
          "type": "catch",
          "sql": "DELETE FROM q WHERE rowid=1",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "delete2-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM q;",
          "expect": "goodbye id.2 again id.3"
        }
      ]
    },
    {
      "name": "delete2-1.9",
      "steps": [
        {
          "type": "stmt_finalize",
          "sql": "SELECT * FROM q",
          "variable": "stmt_1"
        },
        {
          "type": "catch",
          "sql": "DELETE FROM q WHERE rowid=1",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "delete2-1.11",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM q;",
          "expect": "goodbye id.2 again id.3"
        }
      ]
    },
    {
      "name": "delete2-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n    CREATE TABLE t2(c, d);\n    INSERT INTO t1 VALUES(1, 2);\n    INSERT INTO t2 VALUES(3, 4);\n    INSERT INTO t2 VALUES(5, 6);"
        }
      ]
    },
    {
      "name": "delete2-2.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT CASE WHEN c = 5 THEN b ELSE NULL END AS b, c, d FROM t1, t2",
          "expect": "{} 3 4 {} 5 6"
        }
      ]
    }
  ]
}