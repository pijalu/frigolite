{
  "file": "delete_db.test",
  "name": "delete_db",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test2.database"
        }
      ]
    },
    {
      "name": "delete_db-1.1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x, y);\n    BEGIN;\n      INSERT INTO t1 VALUES(1, 2);",
          "expect": "test3.database test3.database-journal"
        }
      ]
    },
    {
      "name": "delete_db-1.2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT;\n    PRAGMA journal_mode = wal;\n    INSERT INTO t1 VALUES(3, 4);",
          "expect": "test3.database test3.database-shm test3.database-wal"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test2.database"
        }
      ]
    },
    {
      "name": "delete_db-1.3.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum = 0;"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE x1(a, b);\n    WITH s(i) AS ( VALUES(1) UNION ALL SELECT i+1 FROM s WHERE i\u003c1000 )\n    INSERT INTO x1 SELECT randomblob(100), randomblob(100) FROM s;\n    BEGIN;\n      UPDATE x1 SET a=randomblob(101)",
          "expect": "test3.database test3.database-journal test3.database001 test3.database002 test3.database003"
        }
      ]
    },
    {
      "name": "delete_db-1.4.0",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT;\n    PRAGMA journal_mode = wal;\n    UPDATE x1 SET a=randomblob(102)",
          "expect": "test3.database test3.database-shm test3.database-wal test3.database001 test3.database002 test3.database003"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    }
  ]
}