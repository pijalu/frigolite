{
  "file": "delete_db.test",
  "name": "delete_db",
  "tests": [
    {
      "name": "1.1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x, y);\n    BEGIN;\n      INSERT INTO t1 VALUES(1, 2);",
          "expect": "test3.database test3.database-journal"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x, y);\n    BEGIN;\n      INSERT INTO t1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "1.2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT;\n    PRAGMA journal_mode = wal;\n    INSERT INTO t1 VALUES(3, 4);",
          "expect": "test3.database test3.database-shm test3.database-wal"
        },
        {
          "type": "exec",
          "sql": "COMMIT;\n    PRAGMA journal_mode = wal;\n    INSERT INTO t1 VALUES(3, 4);"
        }
      ]
    },
    {
      "name": "1.3.0",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA auto_vacuum = 0;"
        },
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum = 0;"
        }
      ]
    },
    {
      "name": "2.1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x, y);\n      BEGIN;\n        INSERT INTO t1 VALUES(1, 2);",
          "expect": "test3.db test3.nal"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x, y);\n      BEGIN;\n        INSERT INTO t1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "2.2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT;\n      PRAGMA journal_mode = wal;\n      INSERT INTO t1 VALUES(3, 4);",
          "expect": "test3.db test3.shm test3.wal"
        },
        {
          "type": "exec",
          "sql": "COMMIT;\n      PRAGMA journal_mode = wal;\n      INSERT INTO t1 VALUES(3, 4);"
        }
      ]
    },
    {
      "name": "2.3.0",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA auto_vacuum = 0;"
        },
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum = 0;"
        }
      ]
    }
  ]
}