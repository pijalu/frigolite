{
  "file": "diskfull.test",
  "name": "diskfull",
  "ordered": true,
  "tests": [
    {
      "name": "diskfull-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n    INSERT INTO t1 VALUES(randstr(1000,1000));\n    INSERT INTO t1 SELECT * FROM t1;\n    INSERT INTO t1 SELECT * FROM t1;\n    INSERT INTO t1 SELECT * FROM t1;\n    INSERT INTO t1 SELECT * FROM t1;\n    CREATE INDEX t1i1 ON t1(x);\n    CREATE TABLE t2 AS SELECT x AS a, x AS b FROM t1;\n    CREATE INDEX t2i1 ON t2(b);"
        }
      ]
    },
    {
      "name": "diskfull-1.3",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1 SELECT * FROM t1;",
          "expect": "1 {database or disk is full}"
        }
      ]
    },
    {
      "name": "diskfull-1.5",
      "steps": [
        {
          "type": "catch",
          "sql": "DELETE FROM t1;",
          "expect": "1 {database or disk is full}"
        }
      ]
    },
    {
      "name": "diskfull-2.2.1",
      "steps": [
        {
          "type": "catch",
          "sql": "VACUUM",
          "expect": "1 {database or disk is full}"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    }
  ]
}