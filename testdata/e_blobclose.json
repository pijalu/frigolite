{
  "file": "e_blobclose.test",
  "name": "e_blobclose",
  "ordered": true,
  "tests": [
    {
      "name": "e_blobclose-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE x1(a INTEGER PRIMARY KEY, b DOTS);\n  INSERT INTO x1 VALUES(-1, '........................................');\n  INSERT INTO x1 VALUES(-10, '........................................');\n  INSERT INTO x1 VALUES(-100, '........................................');\n  INSERT INTO x1 VALUES(-1000, '........................................');\n  INSERT INTO x1 VALUES(-10000, '........................................');"
        }
      ]
    },
    {
      "name": "e_blobclose-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA lock_status",
          "expect": "main unlocked temp closed"
        }
      ]
    },
    {
      "name": "e_blobclose-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA lock_status",
          "expect": "main shared temp closed"
        }
      ]
    },
    {
      "name": "e_blobclose-1.3",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA lock_status",
          "expect": "main unlocked temp closed"
        }
      ]
    },
    {
      "name": "e_blobclose-2.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA lock_status",
          "expect": "main reserved temp closed"
        }
      ]
    },
    {
      "name": "e_blobclose-2.1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA lock_status",
          "expect": "main reserved temp closed"
        }
      ]
    },
    {
      "name": "e_blobclose-2.1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA lock_status",
          "expect": "main reserved temp closed"
        }
      ]
    },
    {
      "name": "e_blobclose-2.1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA lock_status",
          "expect": "main shared temp closed"
        }
      ]
    },
    {
      "name": "e_blobclose-2.1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA lock_status",
          "expect": "main unlocked temp closed"
        }
      ]
    },
    {
      "name": "e_blobclose-2.2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA lock_status",
          "expect": "main reserved temp closed"
        }
      ]
    },
    {
      "name": "e_blobclose-2.2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN"
        },
        {
          "type": "exec",
          "sql": "PRAGMA lock_status",
          "expect": "main reserved temp closed"
        }
      ]
    },
    {
      "name": "e_blobclose-2.2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        },
        {
          "type": "exec",
          "sql": "PRAGMA lock_status",
          "expect": "main unlocked temp closed"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "register_function",
          "functionName": "val",
          "callbackVars": {
            "": "",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "dots": "........................................",
            "testdir": "",
            "testprefix": "e_blobclose"
          },
          "functionProc": "val",
          "functionBody": " \n  sqlite3_blob_close $::B \n  db eval { PRAGMA lock_status }\n"
        }
      ]
    },
    {
      "name": "e_blobclose-2.3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA lock_status",
          "expect": "main reserved temp closed"
        }
      ]
    },
    {
      "name": "e_blobclose-2.3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO x1 VALUES(15, val())"
        },
        {
          "type": "exec",
          "sql": "PRAGMA lock_status",
          "expect": "main unlocked temp closed"
        }
      ]
    },
    {
      "name": "e_blobclose-2.3.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM x1 WHERE a = 15",
          "expect": "15 {main reserved temp closed}"
        }
      ]
    },
    {
      "name": "e_blobclose-2.3.4",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA lock_status",
          "expect": "main reserved temp closed"
        }
      ]
    },
    {
      "name": "e_blobclose-2.3.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT a, val() FROM x1 LIMIT 1",
          "expect": "-10000 {main shared temp closed}"
        }
      ]
    },
    {
      "name": "e_blobclose-3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO x1 VALUES(1, 'abc');\n    SELECT * FROM x1 WHERE a=1;",
          "expect": "1 abc"
        }
      ]
    },
    {
      "name": "e_blobclose-3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM x1 WHERE a=-10",
          "expect": "-10 abcdefghij.............................."
        }
      ]
    },
    {
      "name": "e_blobclose-3.3",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "BEGIN ; SELECT * FROM x1",
          "expect": "SQLITE_BUSY",
          "database": "db2"
        }
      ]
    },
    {
      "name": "e_blobclose-3.4",
      "steps": [
        {
          "type": "query",
