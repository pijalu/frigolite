          "expect": "main unlocked temp closed"
        }
      ]
    },
    {
      "name": "e_blobclose-3.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM x1 WHERE a IN (1, -10);",
          "expect": "-10 ........................................"
        }
      ]
    }
  ]
