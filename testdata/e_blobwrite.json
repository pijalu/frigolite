{
  "file": "e_blobwrite.test",
  "name": "e_blobwrite",
  "ordered": true,
  "tests": [
    {
      "name": "e_blobwrite-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a INTEGER PRIMARY KEY, t TEXT);\n  INSERT INTO t1 VALUES(-1, '........................................');\n  INSERT INTO t1 VALUES(-2, '........................................');\n  INSERT INTO t1 VALUES(-3, '........................................');\n  INSERT INTO t1 VALUES(-4, '........................................');\n  INSERT INTO t1 VALUES(-5, '........................................');\n  INSERT INTO t1 VALUES(-6, '........................................');"
        }
      ]
    },
    {
      "name": "e_blobwrite-1.1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT t FROM t1 WHERE a=-1",
          "expect": " 0123456789.............................. "
        }
      ]
    },
    {
      "name": "e_blobwrite-1.2.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT t FROM t1 WHERE a=-2",
          "expect": " ........0123456789...................... "
        }
      ]
    },
    {
      "name": "e_blobwrite-1.3.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT t FROM t1 WHERE a=-3",
          "expect": " ........0............................... "
        }
      ]
    },
    {
      "name": "e_blobwrite-1.4.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT t FROM t1 WHERE a=-4",
          "expect": " ..................0123456789012345678901 "
        }
      ]
    },
    {
      "name": "e_blobwrite-1.5.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT t FROM t1 WHERE a=-5",
          "expect": " ........................................ "
        }
      ]
    },
    {
      "name": "e_blobwrite-1.6.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT t FROM t1 WHERE a=-6",
          "expect": " 0123456789012345678901234567890123456789 "
        }
      ]
    },
    {
      "name": "e_blobwrite-2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t2(a TEXT, b INTEGER PRIMARY KEY);\n  INSERT INTO t2 VALUES('........................................', 43);\n  INSERT INTO t2 VALUES('........................................', 44);\n  INSERT INTO t2 VALUES('........................................', 45);"
        }
      ]
    },
    {
      "name": "e_blobwrite-2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "DELETE FROM t2 WHERE b=43"
        }
      ]
    },
    {
      "name": "e_blobwrite-2.3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT 1, 2, 3",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "e_blobwrite-3.0",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t3(i INTEGER PRIMARY KEY, j TEXT, k TEXT);\n  INSERT INTO t3 VALUES(1, '........................................', '........................................');\n  INSERT INTO t3 VALUES(2, '........................................', '........................................');\n  SELECT * FROM t3 WHERE i=1;",
          "expect": "\n  1\n  ........................................\n  ........................................\n"
        }
      ]
    },
    {
      "name": "e_blobwrite-3.1.2",
      "steps": [
        {
          "type": "query",
          "sql": "UPDATE t3 SET k = 'xyz' WHERE i=1;\n  SELECT * FROM t3 WHERE i=1;",
          "expect": "\n  1 .....0123456789......................... xyz\n"
        }
      ]
    },
    {
      "name": "e_blobwrite-3.1.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t3 WHERE i=1;",
          "expect": "\n  1 .....0123456789......................... xyz\n"
        }
      ]
    },
    {
      "name": "e_blobwrite-3.2.2",
      "steps": [
        {
          "type": "query",
          "sql": "UPDATE t3 SET j = 'xyz' WHERE i=2;\n  SELECT * FROM t3 WHERE i=2;",
          "expect": "\n  2 xyz ........................................\n"
        }
      ]
    },
    {
      "name": "e_blobwrite-3.2.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t3 WHERE i=2;",
          "expect": "\n  2 xyz ........................................\n"
        }
      ]
    }
  ]
}