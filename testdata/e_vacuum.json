      "name": "e_vacuum-3.1.1",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t4(x);\n  INSERT INTO t4(x) VALUES('x');\n  INSERT INTO t4(x) VALUES('y');\n  INSERT INTO t4(x) VALUES('z');\n  DELETE FROM t4 WHERE x = 'y';\n  SELECT rowid, x FROM t4;",
          "expect": "1 x 3 z"
        }
      ]
    },
    {
      "name": "e_vacuum-3.1.2",
      "steps": [
        {
          "type": "query",
          "sql": "VACUUM;\n  SELECT rowid, x FROM t4;",
          "expect": "1 x 2 z"
        }
      ]
    },
    {
      "name": "e_vacuum-3.1.3",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t5(x, y INTEGER PRIMARY KEY);\n  INSERT INTO t5(x) VALUES('x');\n  INSERT INTO t5(x) VALUES('y');\n  INSERT INTO t5(x) VALUES('z');\n  DELETE FROM t5 WHERE x = 'y';\n  SELECT rowid, x FROM t5;",
          "expect": "1 x 3 z"
        }
      ]
    },
    {
      "name": "e_vacuum-3.1.4",
      "steps": [
        {
          "type": "query",
          "sql": "VACUUM;\n  SELECT rowid, x FROM t5;",
          "expect": "1 x 3 z"
        }
      ]
    },
    {
      "name": "e_vacuum-3.1.5",
      "steps": [
        {
          "type": "query",
          "sql": "DROP TABLE t5;\n  CREATE TABLE t5(x);\n  INSERT INTO t5(x) VALUES('x');\n  INSERT INTO t5(x) VALUES('y');\n  INSERT INTO t5(x) VALUES('z');\n  DELETE FROM t5 WHERE x = 'y';\n  SELECT rowid, x FROM t5;",
          "expect": "1 x 3 z"
        }
      ]
