{
  "file": "e_wal.test",
  "name": "e_wal",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db-shm"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "e_wal-1.1.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = WAL;",
          "expect": "delete"
        }
      ]
    },
    {
      "name": "e_wal-1.1.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA locking_mode = EXCLUSIVE;\n  PRAGMA journal_mode = WAL;",
          "expect": "exclusive wal"
        }
      ]
    },
    {
      "name": "e_wal-1.1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x, y);\n  INSERT INTO t1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "e_wal-1.2.1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "1 {unable to open database file}"
        }
      ]
    },
    {
      "name": "e_wal-1.2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA locking_mode = EXCLUSIVE"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "e_wal-1.3.1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(3, 4)",
          "expect": "1 {unable to open database file}"
        }
      ]
    },
    {
      "name": "e_wal-1.3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA locking_mode = EXCLUSIVE"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(3, 4)"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "e_wal-2.1.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA locking_mode = EXCLUSIVE;\n  SELECT * FROM t1;",
          "expect": "exclusive 1 2 3 4"
        }
      ]
    },
    {
      "name": "e_wal-2.2.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA locking_mode = NORMAL;\n  SELECT * FROM t1;",
          "expect": "exclusive 1 2 3 4"
        }
      ]
    },
    {
      "name": "e_wal-2.2.2",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "setup_3",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "e_wal-2.3.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = DELETE;\n  SELECT * FROM t1;",
          "expect": "delete 1 2 3 4"
        }
      ]
    },
    {
      "name": "e_wal-2.3.2",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "e_wal-2.3.3",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA locking_mode = NORMAL;\n  SELECT * FROM t1;",
          "expect": "normal 1 2 3 4"
        }
      ]
    },
    {
      "name": "e_wal-2.3.4",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "0 {1 2 3 4}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "setup_4",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "e_wal-3.0",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = WAL"
        },
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "e_wal-3.1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 1"
        }
      ]
    },
    {
      "name": "e_wal-3.2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA locking_mode = EXCLUSIVE;\n  PRAGMA locking_mode = NORMAL;\n  PRAGMA locking_mode = EXCLUSIVE;\n  INSERT INTO t1 VALUES(5, 6);",
          "expect": "exclusive normal exclusive"
        }
      ]
    },
    {
      "name": "e_wal-3.2.2",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "e_wal-3.2.3",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA locking_mode = NORMAL;\n  SELECT * FROM t1;",
          "expect": "normal 1 2 3 4 5 6"
        }
      ]
    },
    {
      "name": "e_wal-3.2.4",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "0 {1 2 3 4 5 6}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "e_wal-3.2.5",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA locking_mode = EXCLUSIVE;\n  INSERT INTO t1 VALUES(7, 8);",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "setup_5",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "e_wal-3.4.1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "1 {unable to open database file}"
        }
      ]
    },
    {
      "name": "setup_6",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    },
    {
      "name": "e_wal-3.4.2",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db2"
        },
        {
          "type": "catch",
          "sql": "PRAGMA journal_mode = WAL",
          "expect": "0 delete"
        }
      ]
    },
    {
      "name": "setup_7",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "e_wal-4.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x, y)"
        }
      ]
    },
    {
      "name": "e_wal-4.1.3",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = wAL",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "e_wal-4.2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(1, 1);"
        }
      ]
    },
    {
      "name": "e_wal-4.2.3",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = delete",
          "expect": "delete"
        }
      ]
    }
  ]
}