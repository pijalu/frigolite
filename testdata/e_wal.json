{
  "file": "e_wal.test",
  "name": "e_wal",
  "tests": [
    {
      "name": "1.1.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = WAL;",
          "expect": "delete"
        }
      ]
    },
    {
      "name": "1.1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x, y);\n  INSERT INTO t1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "1.2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 {unable to open database file}"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    },
    {
      "name": "setup_4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1"
        }
      ]
    },
    {
      "name": "1.3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(3, 4)",
          "expect": "1 {unable to open database file}"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    },
    {
      "name": "setup_7",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(3, 4)"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    },
    {
      "name": "2.2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "2.3.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = DELETE;\n  SELECT * FROM t1;",
          "expect": "delete 1 2 3 4"
        }
      ]
    },
    {
      "name": "2.3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "2.3.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "0 {1 2 3 4}"
        }
      ]
    },
    {
      "name": "3.0",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = WAL"
        },
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = WAL"
        }
      ]
    },
    {
      "name": "3.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 1"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1"
        }
      ]
    },
    {
      "name": "3.2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "3.2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "0 {1 2 3 4 5 6}"
        }
      ]
    },
    {
      "name": "3.4.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 {unable to open database file}"
        }
      ]
    },
    {
      "name": "3.4.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = WAL",
          "expect": "0 delete"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    },
    {
      "name": "4.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x, y)"
        }
      ]
    },
    {
      "name": "4.1.3",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = wAL",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "4.2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(1, 1);"
        }
      ]
    },
    {
      "name": "4.2.3",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = delete",
          "expect": "delete"
        }
      ]
    }
  ]
}