{
  "file": "e_walhook.test",
  "name": "e_walhook",
  "tests": [
    {
      "name": "4.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(7)",
          "expect": "1 {SQL logic error}"
        }
      ]
    },
    {
      "name": "4.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(8)",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "4.3",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(9)",
          "expect": "1 {unable to open database file}"
        }
      ]
    },
    {
      "name": "4.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4 5 6 7 8 9"
        }
      ]
    },
    {
      "name": "1.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n    INSERT INTO t1 VALUES(1);"
        }
      ]
    },
    {
      "name": "1.1.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = wal"
        }
      ]
    },
    {
      "name": "1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(2)"
        }
      ]
    },
    {
      "name": "1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n      INSERT INTO t1 VALUES(3);\n      INSERT INTO t1 VALUES(4);\n    COMMIT;"
        }
      ]
    },
    {
      "name": "2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(5)"
        }
      ]
    },
    {
      "name": "3.0",
      "steps": [
        {
          "type": "query",
          "sql": "ATTACH 'test.db2' AS aux;\n    CREATE TABLE aux.t2(x);\n    PRAGMA aux.journal_mode = wal;",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "3.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t2 VALUES('a')"
        }
      ]
    },
    {
      "name": "3.2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(6)"
        }
      ]
    },
    {
      "name": "5.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(10)"
        }
      ]
    },
    {
      "name": "5.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(11)"
        }
      ]
    },
    {
      "name": "6.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(12)"
        }
      ]
    },
    {
      "name": "6.1.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA wal_autocheckpoint = 1000",
          "expect": "1"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n    INSERT INTO t1 VALUES(1);"
        },
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = wal"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(2)"
        },
        {
          "type": "exec",
          "sql": "BEGIN;\n      INSERT INTO t1 VALUES(3);\n      INSERT INTO t1 VALUES(4);\n    COMMIT;"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(5)"
        },
        {
          "type": "exec",
          "sql": "ATTACH 'test.db2' AS aux;\n    CREATE TABLE aux.t2(x);\n    PRAGMA aux.journal_mode = wal;"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t2 VALUES('a')"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(6)"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(10)"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(11)"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(12)"
        },
        {
          "type": "exec",
          "sql": "PRAGMA wal_autocheckpoint = 1000"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(12)"
        }
      ]
    }
  ],
  "source": "capi"
}