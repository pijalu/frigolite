{
  "file": "e_walhook.test",
  "name": "e_walhook",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "runtime_expr",
          "sql": "file dirname $argv0",
          "variable": "testdir"
        },
        {
          "type": "runtime_expr",
          "sql": "0",
          "variable": "wal_hook_count"
        }
      ]
    },
    {
      "name": "e_walhook-1.1.1",
      "steps": [
        {
          "type": "register_wal_hook",
          "callbackProcs": [
            {
              "Name": "my_wal_hook",
              "Args": [
                "args"
              ],
              "Body": "\n  incr ::wal_hook_count\n  return 0\n",
              "Defaults": null
            }
          ],
          "functionProc": "my_wal_hook"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n    INSERT INTO t1 VALUES(1);"
        },
        {
          "type": "runtime_var",
          "variable": "wal_hook_count",
          "expect": "0"
        }
      ]
    },
    {
      "name": "e_walhook-1.1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = wal"
        },
        {
          "type": "runtime_var",
          "variable": "wal_hook_count",
          "expect": "0"
        }
      ]
    },
    {
      "name": "e_walhook-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(2)"
        },
        {
          "type": "runtime_var",
          "variable": "wal_hook_count",
          "expect": "1"
        }
      ]
    },
    {
      "name": "e_walhook-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n      INSERT INTO t1 VALUES(3);\n      INSERT INTO t1 VALUES(4);\n    COMMIT;"
        },
        {
          "type": "runtime_var",
          "variable": "wal_hook_count",
          "expect": "2"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "runtime_expr",
          "sql": "0",
          "variable": "read_ok"
        },
        {
          "type": "register_wal_hook",
          "callbackProcs": [
            {
              "Name": "my_wal_hook",
              "Args": [
                "args"
              ],
              "Body": "\n  sqlite3 db2 test.db\n  if {[db2 eval { SELECT * FROM t1 }] == \"1 2 3 4 5\"} {\n    set ::read_ok 1\n  }\n  db2 close\n",
              "Defaults": null
            }
          ],
          "functionProc": "my_wal_hook"
        }
      ]
    },
    {
      "name": "e_walhook-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(5)"
        },
        {
          "type": "runtime_var",
          "variable": "read_ok",
          "expect": "1"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "register_wal_hook",
          "callbackProcs": [
            {
              "Name": "my_wal_hook",
              "Args": [
                "dbname",
                "nEntry"
              ],
              "Body": "\n  set ::wal_hook_args [list $dbname $nEntry]\n",
              "Defaults": null
            }
          ],
          "functionProc": "my_wal_hook"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    },
    {
      "name": "e_walhook-3.0",
      "steps": [
        {
          "type": "exec",
          "sql": "ATTACH 'test.db2' AS aux;\n    CREATE TABLE aux.t2(x);\n    PRAGMA aux.journal_mode = wal;",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "e_walhook-3.1.1",
      "steps": [
        {
          "type": "runtime_var_reset",
          "variable": "wal_hook_args"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t2 VALUES('a')"
        }
      ]
    },
    {
      "name": "e_walhook-3.1.2",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "wal_hook_args",
          "expect": "[list aux [wal_frame_count test.db2-wal 1024]]"
        }
      ]
    },
    {
      "name": "e_walhook-3.2.1",
      "steps": [
        {
          "type": "runtime_var_reset",
          "variable": "wal_hook_args"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(6)"
        }
      ]
    },
    {
      "name": "e_walhook-3.1.2",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "wal_hook_args",
          "expect": "[list main [wal_frame_count test.db-wal 1024]]"
        }
      ]
    },
    {
      "name": "setup_3",
      "steps": [
        {
          "type": "register_wal_hook",
          "callbackProcs": [
            {
              "Name": "my_wal_hook",
              "Args": [
                "args"
              ],
              "Body": " return 1 ;# SQLITE_ERROR ",
              "Defaults": null
            }
          ],
          "functionProc": "my_wal_hook"
        }
      ]
    },
    {
      "name": "e_walhook-4.1",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(7)",
          "expect": "1 {SQL logic error}"
        }
      ]
    },
    {
      "name": "setup_4",
      "steps": [
        {
          "type": "register_wal_hook",
          "callbackProcs": [
            {
              "Name": "my_wal_hook",
              "Args": [
                "args"
              ],
              "Body": " return 5 ;# SQLITE_BUSY ",
              "Defaults": null
            }
          ],
          "functionProc": "my_wal_hook"
        }
      ]
    },
    {
      "name": "e_walhook-4.2",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(8)",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "setup_5",
      "steps": [
        {
          "type": "register_wal_hook",
          "callbackProcs": [
            {
              "Name": "my_wal_hook",
              "Args": [
                "args"
              ],
              "Body": " return 14 ;# SQLITE_CANTOPEN ",
              "Defaults": null
            }
          ],
          "functionProc": "my_wal_hook"
        }
      ]
    },
    {
      "name": "e_walhook-4.3",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(9)",
          "expect": "1 {unable to open database file}"
        }
      ]
    },
    {
      "name": "e_walhook-4.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4 5 6 7 8 9"
        }
      ]
    },
    {
      "name": "setup_6",
      "steps": [
        {
          "type": "runtime_expr",
          "sql": "0",
          "variable": "old_wal_hook"
        },
        {
          "type": "register_wal_hook",
          "callbackProcs": [
            {
              "Name": "my_old_wal_hook",
              "Args": [
                "args"
              ],
              "Body": "\n  incr ::old_wal_hook \n  return 0\n",
              "Defaults": null
            }
          ],
          "functionProc": "my_old_wal_hook"
        }
      ]
    },
    {
      "name": "e_walhook-5.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(10)"
        },
        {
          "type": "runtime_var",
          "variable": "old_wal_hook",
          "expect": "1"
        }
      ]
    },
    {
      "name": "setup_7",
      "steps": [
        {
          "type": "register_wal_hook",
          "callbackProcs": [
            {
              "Name": "my_new_wal_hook",
              "Args": [
                "args"
              ],
              "Body": " return 0 ",
              "Defaults": null
            }
          ],
          "functionProc": "my_new_wal_hook"
        }
      ]
    },
    {
      "name": "e_walhook-5.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(11)"
        },
        {
          "type": "runtime_var",
          "variable": "old_wal_hook",
          "expect": "1"
        }
      ]
    },
    {
      "name": "setup_8",
      "steps": [
        {
          "type": "runtime_expr",
          "sql": "0",
          "variable": "old_wal_hook"
        },
        {
          "repeatCount": 2,
          "repeatBody": [
            {
              "type": "register_wal_hook",
              "callbackProcs": [
                {
                  "Name": "my_old_wal_hook",
                  "Args": [
                    "args"
                  ],
                  "Body": " incr ::old_wal_hook ; return 0 ",
                  "Defaults": null
                }
              ],
              "functionProc": "my_old_wal_hook"
            }
          ],
          "type": "repeat"
        }
      ]
    },
    {
      "name": "e_walhook-6.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(12)"
        },
        {
          "type": "runtime_var",
          "variable": "old_wal_hook",
          "expect": "1"
        }
      ]
    },
    {
      "name": "e_walhook-6.1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA wal_autocheckpoint = 1000"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(12)"
        },
        {
          "type": "runtime_var",
          "variable": "old_wal_hook",
          "expect": "1"
        }
      ]
    }
  ]
}
