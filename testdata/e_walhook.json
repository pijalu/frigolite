{
  "file": "e_walhook.test",
  "name": "e_walhook",
  "ordered": true,
  "tests": [
    {
      "name": "e_walhook-1.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n    INSERT INTO t1 VALUES(1);"
        },
        {
          "type": "runtime_var",
          "variable": "wal_hook_count",
          "expect": "0"
        }
      ]
    },
    {
      "name": "e_walhook-1.1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = wal"
        },
        {
          "type": "runtime_var",
          "variable": "wal_hook_count",
          "expect": "0"
        }
      ]
    },
    {
      "name": "e_walhook-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(2)",
          "expect": "1"
        }
      ]
    },
    {
      "name": "e_walhook-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n      INSERT INTO t1 VALUES(3);\n      INSERT INTO t1 VALUES(4);\n    COMMIT;",
          "expect": "2"
        }
      ]
    },
    {
      "name": "e_walhook-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(5)"
        },
        {
          "type": "runtime_var",
          "variable": "read_ok",
          "expect": "1"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    },
    {
      "name": "e_walhook-3.0",
      "steps": [
        {
          "type": "exec",
          "sql": "ATTACH 'test.db2' AS aux;\n    CREATE TABLE aux.t2(x);\n    PRAGMA aux.journal_mode = wal;",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "e_walhook-3.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t2 VALUES('a')"
        }
      ]
    },
    {
      "name": "e_walhook-3.2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(6)"
        }
      ]
    },
    {
      "name": "e_walhook-4.1",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(7)",
          "expect": "1 {SQL logic error}"
        }
      ]
    },
    {
      "name": "e_walhook-4.2",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(8)",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "e_walhook-4.3",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(9)",
          "expect": "1 {unable to open database file}"
        }
      ]
    },
    {
      "name": "e_walhook-4.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4 5 6 7 8 9"
        }
      ]
    },
    {
      "name": "e_walhook-5.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(10)"
        },
        {
          "type": "runtime_var",
          "variable": "old_wal_hook",
          "expect": "1"
        }
      ]
    },
    {
      "name": "e_walhook-5.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(11)"
        },
        {
          "type": "runtime_var",
          "variable": "old_wal_hook",
          "expect": "1"
        }
      ]
    },
    {
      "name": "e_walhook-6.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(12)"
        },
        {
          "type": "runtime_var",
          "variable": "old_wal_hook",
          "expect": "1"
        }
      ]
    },
    {
      "name": "e_walhook-6.1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA wal_autocheckpoint = 1000"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(12)"
        },
        {
          "type": "runtime_var",
          "variable": "old_wal_hook",
          "expect": "1"
        }
      ]
    }
  ]
}