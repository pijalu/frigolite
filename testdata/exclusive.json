    {
      "name": "exclusive-2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE abc(a, b, c);\n    INSERT INTO abc VALUES(1, 2, 3);\n    PRAGMA locking_mode = exclusive;",
          "expect": "exclusive"
        }
      ]
    },
    {
      "name": "exclusive-2.1",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO abc VALUES(4, 5, 6);\n    SELECT * FROM abc;",
          "expect": "1 2 3 4 5 6",
          "database": "db2"
        }
      ]
    },
    {
      "name": "exclusive-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM abc;",
          "expect": "1 2 3 4 5 6"
        }
      ]
    },
    {
      "name": "exclusive-2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM abc;",
          "expect": "1 2 3 4 5 6",
          "database": "db2"
        }
      ]
    },
    {
      "name": "exclusive-2.5",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO abc VALUES(7, 8, 9);",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "exclusive-2.6",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    INSERT INTO abc VALUES(7, 8, 9);",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "COMMIT",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "exclusive-2.7",
      "steps": [
        {
          "type": "catch",
          "sql": "COMMIT",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "exclusive-2.8",
      "steps": [
        {
          "type": "exec",
          "sql": "ROLLBACK;",
          "database": "db2"
        }
      ]
    },
    {
      "name": "exclusive-2.9",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO abc VALUES(7, 8, 9);"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM abc;",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "exclusive-2.10",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA locking_mode = normal;"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM abc;",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "exclusive-2.11",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM abc;"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM abc;",
          "expect": "1 2 3 4 5 6 7 8 9",
          "database": "db2"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "exclusive-4.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA locking_mode = exclusive;"
        },
        {
          "type": "exec",
          "sql": "PRAGMA default_cache_size = 10;"
        },
        {
          "type": "exec",
          "sql": "BEGIN;\n    CREATE TABLE t3(x TEXT);\n    INSERT INTO t3 VALUES(randstr(10,400));\n    INSERT INTO t3 VALUES(randstr(10,400));\n    INSERT INTO t3 SELECT randstr(10,400) FROM t3;\n    INSERT INTO t3 SELECT randstr(10,400) FROM t3;\n    INSERT INTO t3 SELECT randstr(10,400) FROM t3;\n    INSERT INTO t3 SELECT randstr(10,400) FROM t3;\n    COMMIT;"
        },
        {
          "type": "exec",
          "sql": "SELECT count(*) FROM t3;",
          "expect": "32"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "query_assign",
          "sql": "SELECT count(*), md5sum(x) FROM t3",
          "variable": "X",
          "resultAll": true
        }
      ]
    },
    {
      "name": "exclusive-4.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    DELETE FROM t3 WHERE random()%10!=0;\n    INSERT INTO t3 SELECT randstr(10,10)||x FROM t3;\n    INSERT INTO t3 SELECT randstr(10,10)||x FROM t3;\n    SELECT count(*) FROM t3;\n    ROLLBACK;"
        },
        {
          "type": "query",
          "sql": "SELECT count(*), md5sum(x) FROM t3",
          "expect": "$::X"
        }
      ]
    },
    {
      "name": "exclusive-4.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    DELETE FROM t3 WHERE random()%10!=0;\n    INSERT INTO t3 SELECT randstr(10,10)||x FROM t3;\n    DELETE FROM t3 WHERE random()%10!=0;\n    INSERT INTO t3 SELECT randstr(10,10)||x FROM t3;\n    ROLLBACK;"
        },
        {
          "type": "query",
          "sql": "SELECT count(*), md5sum(x) FROM t3",
          "expect": "$::X"
        }
      ]
    },
    {
      "name": "exclusive-4.3",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t3 SELECT randstr(10,400) FROM t3 WHERE random()%10==0;"
        }
      ]
    },
    {
      "name": "exclusive-4.4",
      "steps": [
        {
          "type": "query_assign",
          "sql": "SELECT count(*), md5sum(x) FROM t3",
          "variable": "X",
          "resultAll": true,
          "expect": "0"
        }
      ]
    },
    {
      "name": "exclusive-4.5",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA locking_mode = NORMAL;\n    DROP TABLE t3;\n    DROP TABLE abc;",
          "expect": "normal"
        }
      ]
    }
  ]
