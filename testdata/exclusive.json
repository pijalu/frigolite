    {
      "name": "exclusive-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "pragma locking_mode;\n    pragma main.locking_mode;\n    pragma temp.locking_mode;",
          "expect": "normal normal exclusive"
        }
      ]
    },
    {
      "name": "exclusive-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "pragma locking_mode = exclusive;",
          "expect": "exclusive"
        }
      ]
    },
    {
      "name": "exclusive-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "pragma locking_mode;\n    pragma main.locking_mode;\n    pragma temp.locking_mode;",
          "expect": "exclusive exclusive exclusive"
        }
      ]
    },
    {
      "name": "exclusive-1.3",
      "steps": [
