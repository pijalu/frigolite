{
  "file": "fkey7.test",
  "name": "fkey7",
  "ordered": true,
  "tests": [
    {
      "name": "fkey7-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA foreign_keys = 1;\n\n  CREATE TABLE s1(a PRIMARY KEY, b);\n  CREATE TABLE par(a, b REFERENCES s1, c UNIQUE, PRIMARY KEY(a));\n\n  CREATE TABLE c1(a, b REFERENCES par);\n  CREATE TABLE c2(a, b REFERENCES par);\n  CREATE TABLE c3(a, b REFERENCES par(c));"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "auth_proc",
          "authProc": "auth",
          "callbackVars": {
            "": "fkey7",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "testdir": "",
            "testprefix": "fkey7"
          },
          "callbackProcs": [
            {
              "Name": "auth",
              "Args": [
                "op",
                "tbl",
                "args"
              ],
              "Body": "\n  if {$op == \"SQLITE_READ\"} { set ::tbls($tbl) 1 }\n  return \"SQLITE_OK\"\n",
              "Defaults": null
            }
          ],
          "functionProc": "auth",
          "functionBody": "\n  if {$op == \"SQLITE_READ\"} { set ::tbls($tbl) 1 }\n  return \"SQLITE_OK\"\n"
        },
        {
          "type": "exec",
          "sql": "UPDATE par SET b=? WHERE a=?"
        },
        {
          "type": "exec",
          "sql": "UPDATE par SET a=? WHERE b=?"
        },
        {
          "type": "exec",
          "sql": "UPDATE par SET c=? WHERE b=?"
        },
        {
          "type": "exec",
          "sql": "UPDATE par SET a=?,b=?,c=? WHERE b=?"
        }
      ]
    },
    {
      "name": "fkey7-2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE pX(x PRIMARY KEY);\n    CREATE TABLE cX(a INTEGER PRIMARY KEY, b REFERENCES pX);"
        }
      ]
    },
    {
      "name": "fkey7-2.1",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO cX VALUES(11, zeroblob(40));",
          "expect": "1 {FOREIGN KEY constraint failed}"
        }
      ]
    },
    {
      "name": "fkey7-2.2",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "INSERT INTO cX VALUES(11, ?)",
          "variable": "stmt_1"
        },
        {
          "type": "stmt_step",
          "sql": "INSERT INTO cX VALUES(11, ?)",
          "variable": "stmt_1"
        },
        {
          "type": "stmt_finalize",
          "sql": "INSERT INTO cX VALUES(11, ?)",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "SQLITE_OK",
          "expect": "SQLITE_CONSTRAINT"
        }
      ]
    },
    {
      "name": "fkey7-3.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE p4 (id INTEGER NOT NULL PRIMARY KEY);\n    INSERT INTO p4 VALUES(1), (2), (3);\n\n    CREATE TABLE c4(x INTEGER REFERENCES p4(id) DEFERRABLE INITIALLY DEFERRED);\n    CREATE INDEX c4_x ON c4(x);\n    INSERT INTO c4 VALUES(1), (2), (3);\n\n    ANALYZE;\n    INSERT INTO p4(id) VALUES(4);"
        }
      ]
    },
    {
      "name": "fkey7-4.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA foreign_keys = true;\n  CREATE TABLE parent(\n    p PRIMARY KEY\n  );\n  CREATE TABLE child(\n    c UNIQUE REFERENCES parent(p)\n  );"
        }
      ]
    },
    {
      "name": "fkey7-4.1",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT OR FAIL INTO child VALUES(123), (123);",
          "expect": "1 {FOREIGN KEY constraint failed}"
        }
      ]
    },
    {
      "name": "fkey7-4.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM child;"
        }
      ]
    },
    {
      "name": "fkey7-4.3",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA foreign_key_check;"
        }
      ]
    },
    {
      "name": "fkey7-4.4",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO parent VALUES(123);\n  INSERT OR FAIL INTO child VALUES(123), (123);",
          "expect": "1 {UNIQUE constraint failed: child.c}"
        }
      ]
    },
    {
      "name": "fkey7-4.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM child;",
          "expect": "123"
        }
      ]
    },
    {
      "name": "fkey7-4.6",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA foreign_key_check;"
        }
      ]
    }
  ]
}