{
  "file": "fts3ag.test",
  "name": "fts3ag",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE t1 USING fts3(content);\n  INSERT INTO t1 (rowid, content) VALUES(1, 'this is a test');\n  INSERT INTO t1 (rowid, content) VALUES(2, 'also a test');"
        }
      ]
    },
    {
      "name": "fts3ag-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid FROM t1 WHERE t1 MATCH 'something'"
        }
      ]
    },
    {
      "name": "fts3ag-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid FROM t1 WHERE t1 MATCH '-this something'"
        }
      ]
    },
    {
      "name": "fts3ag-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid FROM t1 WHERE t1 MATCH 'this -something'",
          "expect": "1"
        }
      ]
    },
    {
      "name": "fts3ag-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid FROM t1 WHERE t1 MATCH '\"this something\"'"
        }
      ]
    },
    {
      "name": "fts3ag-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid FROM t1 WHERE t1 MATCH '\"something is\"'"
        }
      ]
    },
    {
      "name": "fts3ag-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid FROM t1 WHERE t1 MATCH 'something OR this'",
          "expect": "1"
        }
      ]
    },
    {
      "name": "fts3ag-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid FROM t1 WHERE t1 MATCH 'this OR something'",
          "expect": "1"
        }
      ]
    },
    {
      "name": "fts3ag-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid FROM t1 WHERE t1 MATCH 'something this'"
        }
      ]
    },
    {
      "name": "fts3ag-1.9",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid FROM t1 WHERE t1 MATCH 'this something'"
        }
      ]
    },
    {
      "name": "fts3ag-1.10",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT rowid FROM t1 WHERE t1 MATCH '-this -something'",
          "expect": "1 {malformed MATCH expression: [-this -something]}"
        }
      ]
    },
    {
      "name": "fts3ag-1.11",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid FROM t1 WHERE t1 MATCH 'this OR also'",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "fts3ag-1.12",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid FROM t1 WHERE t1 MATCH 'also OR this'",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "fts3ag-1.13",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid FROM t1 WHERE t1 MATCH 'something OR nothing'"
        }
      ]
    }
  ]
}