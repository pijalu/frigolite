{
  "file": "fts3al.test",
  "name": "fts3al",
  "ordered": true,
  "tests": [
    {
      "name": "fts3al-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE t1 USING fts3(content, x80)"
        }
      ]
    },
    {
      "name": "fts3al-1.2",
      "steps": [
        {
          "type": "catch",
          "sql": "CREATE VIRTUAL TABLE t2 USING fts3(content, tokenize x80)",
          "expect": "unknown tokenizer: x80"
        }
      ]
    },
    {
      "name": "fts3al-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE t3 USING fts3(content, tokenizex80)"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE t4 USING fts3(content)"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t4 (content) VALUES ('x80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80 x80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80 x80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80 target x80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80 x80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80 x80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80')"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t4 (content) VALUES ('x80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80 x80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80 x80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80    target    x80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80 x80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80 x80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80xxxxxx80')"
        }
      ]
    },
    {
      "name": "fts3al-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid, length(snippet(t4)) FROM t4 WHERE t4 MATCH 'target'",
          "expect": "1 241 2 247"
        }
      ]
    }
  ]
}