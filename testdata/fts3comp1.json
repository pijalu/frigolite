{
  "file": "fts3comp1.test",
  "name": "fts3comp1",
  "tests": [
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    },
    {
      "name": "3.0",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA trusted_schema = OFF;"
        }
      ]
    },
    {
      "name": "3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIEW v1 AS SELECT myfunc('xyz');"
        }
      ]
    },
    {
      "name": "3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM v1",
          "expect": "1 {unsafe use of myfunc()}"
        }
      ]
    },
    {
      "name": "3.4",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO f1(rowid, x) VALUES(123, 'one two three');",
          "expect": "1 {SQL logic error}"
        }
      ]
    },
    {
      "name": "3.6.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n  CREATE TABLE t2(y);\n\n  CREATE TRIGGER tr1 AFTER INSERT ON t1 BEGIN\n    INSERT INTO t2 VALUES( myfunc(new.x) );\n  END;"
        }
      ]
    },
    {
      "name": "3.6.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES('hello world');",
          "expect": "1 {unsafe use of myfunc()}"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    },
    {
      "name": "4.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO v1 VALUES('one two three');",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    },
    {
      "name": "4.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO v1 VALUES('one two three');",
          "expect": "1 {SQL logic error}"
        }
      ]
    },
    {
      "name": "4.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM v1",
          "expect": "1 {SQL logic error}"
        }
      ]
    }
  ]
}