    {
      "name": "fts3comp1-1.1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE t1 USING fts4(\n      a, b, \n      compress='zip', uncompress='unzip'\n    );"
        }
      ]
    },
    {
      "name": "fts3comp1-1.1.1",
      "steps": [
        {
          "type": "query",
          "sql": "INSERT INTO t1 VALUES('one two three', 'two four six');\n    SELECT a, b FROM t1;",
          "expect": "{one two three} {two four six}"
        }
      ]
    },
    {
      "name": "fts3comp1-1.1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT c0a, c1b FROM t1_content;",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "fts3comp1-1.1.3",
      "steps": [
        {
          "type": "query",
          "sql": "INSERT INTO t1 VALUES('three six nine', 'four eight twelve');\n    SELECT a, b FROM t1;",
          "expect": "{one two three} {two four six} {three six nine} {four eight twelve}"
        }
      ]
    },
    {
      "name": "fts3comp1-1.1.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT c0a, c1b FROM t1_content;",
          "expect": "1 2 3 4"
        }
      ]
    },
    {
      "name": "fts3comp1-1.1.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT a, b FROM t1 WHERE docid = 2",
          "expect": "{three six nine} {four eight twelve}"
        }
      ]
    },
    {
      "name": "fts3comp1-1.1.6",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT a, b FROM t1 WHERE t1 MATCH 'two'",
          "expect": "{one two three} {two four six}"
        }
      ]
    },
    {
      "name": "fts3comp1-1.1.7",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE VIRTUAL TABLE terms USING fts4aux(t1);\n    SELECT term, documents, occurrences FROM terms WHERE col = '*';",
          "expect": "\n    eight 1 1    four 2 2    nine 1 1    one 1 1 \n    six 2 2      three 2 2   twelve 1 1  two 1 2\n  "
        }
      ]
    },
    {
      "name": "fts3comp1-1.1.8",
