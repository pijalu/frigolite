{
  "file": "fts3corrupt3.test",
  "name": "fts3corrupt3",
  "tests": [
    {
      "name": "1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA page_size = 512;\n  CREATE VIRTUAL TABLE t1 USING fts3;\n  BEGIN;\n    INSERT INTO t1 VALUES('one');\n    INSERT INTO t1 VALUES('one');\n    INSERT INTO t1 VALUES('one');\n  COMMIT;"
        }
      ]
    },
    {
      "name": "1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT quote(root) from t1_segdir;",
          "expect": "X'00036F6E6509010200010200010200'"
        }
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "UPDATE t1_segdir SET root = X'00036F6E650EFFFFFFFFFFFFFFFFFFFFFFFF0200';"
        }
      ]
    },
    {
      "name": "1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid FROM t1 WHERE t1 MATCH 'one'",
          "expect": "0 -1"
        }
      ]
    },
    {
      "name": "2.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT quote(root) from t2_segdir;",
          "expect": "X'0101017900017A'"
        }
      ]
    }
  ],
  "source": "capi"
}