{
  "file": "fts3corrupt5.test",
  "name": "fts3corrupt5",
  "ordered": true,
  "tests": [
    {
      "name": "fts3corrupt5-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    CREATE VIRTUAL TABLE ft USING fts3(a, b, c);\n    INSERT INTO ft VALUES('one', 'one', 'one');\n  COMMIT;"
        }
      ]
    },
    {
      "name": "fts3corrupt5-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM ft WHERE ft MATCH 'b:one'",
          "expect": "one one one"
        }
      ]
    },
    {
      "name": "fts3corrupt5-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT quote(root) FROM ft_segdir;",
          "expect": "X'00036F6E6509010201010201020200'"
        }
      ]
    },
    {
      "name": "fts3corrupt5-1.3.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "UPDATE ft_segdir SET root = X'00036F6E650901'"
        }
      ]
    },
    {
      "name": "fts3corrupt5-1.3.1.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM ft WHERE ft MATCH '''b:one'''",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "fts3corrupt5-1.3.2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "UPDATE ft_segdir SET root = X'00036F6E6509010201010201FFFFFF'"
        }
      ]
    },
    {
      "name": "fts3corrupt5-1.3.2.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM ft WHERE ft MATCH '''c:one'''",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "fts3corrupt5-1.3.3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "UPDATE ft_segdir SET root = X'00036F6E6501'"
        }
      ]
    },
    {
      "name": "fts3corrupt5-1.3.3.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM ft WHERE ft MATCH '''b:one'''",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "fts3corrupt5-1.3.4.1",
      "steps": [
        {
          "type": "exec",
          "sql": "UPDATE ft_segdir SET root = X'00036F6E650101'"
        }
      ]
    },
    {
      "name": "fts3corrupt5-1.3.4.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM ft WHERE ft MATCH '''b:one'''",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "fts3corrupt5-1.3.5.1",
      "steps": [
        {
          "type": "exec",
          "sql": "UPDATE ft_segdir SET root = X'00036F6E650100'"
        }
      ]
    },
    {
      "name": "fts3corrupt5-1.3.5.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM ft WHERE ft MATCH '''b:one'''",
          "expect": "0 {}"
        }
      ]
    }
  ]
}