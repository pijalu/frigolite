{
  "file": "fts3cov.test",
  "name": "fts3cov",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "runtime_expr",
          "sql": "file dirname $argv0",
          "variable": "testdir"
        }
      ]
    },
    {
      "name": "fts3cov-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE t1 USING fts3(x);\n    INSERT INTO t1(t1) VALUES('nodesize=24');\n    BEGIN;\n      INSERT INTO t1 VALUES('Is the night chilly and dark?');\n      INSERT INTO t1 VALUES('The night is chilly, but not dark.');\n      INSERT INTO t1 VALUES('The thin gray cloud is spread on high,');\n      INSERT INTO t1 VALUES('It covers but not hides the sky.');\n    COMMIT;\n    SELECT count(*)\u003e0 FROM t1_segments;",
          "expect": "1"
        }
      ]
    },
    {
      "name": "fts3cov-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1(t1) VALUES('nodesize=24');\n    BEGIN;\n      INSERT INTO t1 VALUES('The moon is behind, and at the full;');\n      INSERT INTO t1 VALUES('And yet she looks both small and dull.');\n      INSERT INTO t1 VALUES('The night is chill, the cloud is gray:');\n      INSERT INTO t1 VALUES('''T is a month before the month of May,');\n      INSERT INTO t1 VALUES('And the Spring comes slowly up this way.');\n      INSERT INTO t1 VALUES('The lovely lady, Christabel,');\n      INSERT INTO t1 VALUES('Whom her father loves so well,');\n      INSERT INTO t1 VALUES('What makes her in the wood so late,');\n      INSERT INTO t1 VALUES('A furlong from the castle gate?');\n      INSERT INTO t1 VALUES('She had dreams all yesternight');\n      INSERT INTO t1 VALUES('Of her own betrothed knight;');\n      INSERT INTO t1 VALUES('And she in the midnight wood will pray');\n      INSERT INTO t1 VALUES('For the weal of her lover that''s far away.');\n    COMMIT;"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1(t1) VALUES('optimize');\n    SELECT substr(hex(root), 1, 2) FROM t1_segdir;",
          "expect": "03"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "defensive",
          "sql": "0"
        }
      ]
    },
    {
      "name": "fts3cov-2.2",
      "steps": [
        {
          "type": "query_assign",
          "sql": "SELECT root FROM t1_segdir",
          "variable": "root",
          "resultAll": true
        },
        {
          "type": "runtime_expr",
          "sql": "read_fts3varint [string range $root 1 end] left_child",
          "variable": "left_child"
        },
        {
          "type": "exec",
          "sql": "DELETE FROM t1_segments WHERE blockid = $left_child"
        }
      ]
    },
    {
      "name": "fts3cov-2.3",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t1 WHERE t1 MATCH 'c*'",
