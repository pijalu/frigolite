      "name": "fts3dropmod-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE t1 USING fts3(x);"
        }
      ]
    },
    {
      "name": "fts3dropmod-1.1",
      "steps": [
        {
          "type": "catch",
          "sql": "CREATE VIRTUAL TABLE t2 USING fts4(x);",
          "expect": "1 {no such module: fts4}"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
