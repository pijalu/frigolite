{
  "file": "fts3expr.test",
  "name": "fts3expr",
  "tests": [
    {
      "name": "fts3expr-5.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT fts3_exprtest('simple', 'a b')",
          "expect": "1 {Usage: fts3_exprtest(tokenizer, expr, col1, ...}"
        }
      ]
    },
    {
      "name": "fts3expr-5.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT fts3_exprtest('doesnotexist', 'a b', 'c')",
          "expect": "1 {unknown tokenizer: doesnotexist}"
        }
      ]
    },
    {
      "name": "fts3expr-5.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT fts3_exprtest('simple', 'a b OR', 'c')",
          "expect": "1 {Error parsing expression}"
        }
      ]
    }
  ]
}