      "name": "fts3expr5-1.0",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE VIRTUAL TABLE t0 USING fts3(x);\n  SELECT rowid FROM t0 WHERE x MATCH '';"
        }
      ]
    },
    {
      "name": "fts3expr5-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT rowid FROM t0 WHERE x MATCH '\"\"';"
        }
      ]
    },
    {
      "name": "fts3expr5-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT rowid FROM t0 WHERE x MATCH '\"\" \"\"';"
        }
      ]
    },
    {
      "name": "fts3expr5-1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT rowid FROM t0 WHERE x MATCH '\"\" OR \"\"';"
        }
      ]
    },
    {
      "name": "fts3expr5-1.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT rowid FROM t0 WHERE x MATCH '\"\" NOT \"\"';"
        }
      ]
    },
    {
      "name": "fts3expr5-1.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT rowid FROM t0 WHERE x MATCH '\"\"\"\"';"
        }
      ]
    },
    {
      "name": "fts3expr5-2.0",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT fts3_exprtest('simple', '(a:123)(b:234)()(c:456)', 'a', 'b', 'c')",
          "expect": "AND {AND {PHRASE 0 0 123} {PHRASE 1 0 234}} {PHRASE 2 0 456}"
        }
      ]
    },
    {
      "name": "fts3expr5-2.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT fts3_exprtest('simple', '(a:123)(b:234)(c:456)', 'a', 'b', 'c')",
          "expect": "AND {AND {PHRASE 0 0 123} {PHRASE 1 0 234}} {PHRASE 2 0 456}"
        }
      ]
    },
    {
      "name": "fts3expr5-2.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT fts3_exprtest('simple', '\"123\" AND ( )', 'a', 'b', 'c')",
