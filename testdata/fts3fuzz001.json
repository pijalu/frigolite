  "ordered": true,
  "tests": [
    {
      "name": "fts3fuzz001-100",
      "steps": [
        {
          "type": "open_empty_db"
        },
        {
          "type": "catch",
          "sql": "PRAGMA writable_schema=on; -- disable schema corruption detection\n    INSERT INTO t1(t1) SELECT x FROM t2;",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "fts3fuzz001-110",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1(t1) VALUES('integrity-check');",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "fts3fuzz001-120",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1(t1) VALUES('optimize');",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "fts3fuzz001-121",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1(t1) VALUES('integrity-check');",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "fts3fuzz001-200",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE x1 USING fts3(x);\n\n  INSERT INTO x1 VALUES('braes brag bragged bragger bragging');\n  INSERT INTO x1 VALUES('brags braid braided braiding braids');\n  INSERT INTO x1 VALUES('brain brainchild brained braining brains');\n  INSERT INTO x1 VALUES('brainstem brainstems brainstorm brainstorms');\n  INSERT INTO x1(x1) VALUES('nodesize=24');"
        }
      ]
    },
    {
      "name": "fts3fuzz001-210",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA integrity_check;",
          "expect": "ok"
        }
      ]
    },
    {
