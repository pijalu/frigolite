{
  "file": "fts4intck1.test",
  "name": "fts4intck1",
  "tests": [
    {
      "name": "1.0",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t1(a INTEGER PRIMARY KEY, b TEXT, c TEXT AS (slang(b)));\n  INSERT INTO t1(b) VALUES('the quick fox jumps over the lazy brown dog');\n  SELECT c FROM t1;",
          "expect": "{deh quick fox jumps ovehr deh lazy brown dog}"
        }
      ]
    },
    {
      "name": "1.1",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE VIRTUAL TABLE t2 USING fts4(content=\"t1\", c);\n  INSERT INTO t2(t2) VALUES('rebuild');\n  SELECT docid FROM t2 WHERE t2 MATCH 'deh';",
          "expect": "1"
        }
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA integrity_check(t2);",
          "expect": "ok"
        }
      ]
    },
    {
      "name": "2.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA integrity_check(t2);",
          "expect": "{unable to validate the inverted index for FTS4 table main.t2: SQL logic error}"
        }
      ]
    },
    {
      "name": "2.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA integrity_check(t2);",
          "expect": "ok"
        }
      ]
    },
    {
      "name": "2.3",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA integrity_check(t2);",
          "expect": "{malformed inverted index for FTS4 table main.t2}"
        }
      ]
    },
    {
      "name": "3.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE x1 USING fts4(a, b);\n  INSERT INTO x1 VALUES('one', 'two');\n  INSERT INTO x1 VALUES('three', 'four');"
        }
      ]
    },
    {
      "name": "3.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA integrity_check;",
          "expect": "ok"
        }
      ]
    },
    {
