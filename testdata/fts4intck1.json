{
  "file": "fts4intck1.test",
  "name": "fts4intck1",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "register_function",
          "functionName": "slang",
          "callbackVars": {
            "": "fts4intck1",
            "::testprefix": "fts4intck1",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "testdir": ""
          },
          "functionProc": "slang",
          "functionArgs": [
            "in"
          ],
          "functionBody": "\n  return [string map {th d e eh} $in]\n",
          "minArgs": 1,
          "maxArgs": -1,
          "deterministic": true,
          "innocuous": true
        }
      ]
    },
    {
      "name": "fts4intck1-1.0",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t1(a INTEGER PRIMARY KEY, b TEXT, c TEXT AS (slang(b)));\n  INSERT INTO t1(b) VALUES('the quick fox jumps over the lazy brown dog');\n  SELECT c FROM t1;",
          "expect": "{deh quick fox jumps ovehr deh lazy brown dog}"
        }
      ]
    },
    {
      "name": "fts4intck1-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE VIRTUAL TABLE t2 USING fts4(content=\"t1\", c);\n  INSERT INTO t2(t2) VALUES('rebuild');\n  SELECT docid FROM t2 WHERE t2 MATCH 'deh';",
          "expect": "1"
        }
      ]
    },
    {
      "name": "fts4intck1-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA integrity_check(t2);",
          "expect": "ok"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "fts4intck1-2.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA integrity_check(t2);",
          "expect": "{unable to validate the inverted index for FTS4 table main.t2: SQL logic error}"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "register_function",
          "functionName": "slang",
          "callbackVars": {
            "": "fts4intck1",
            "::testprefix": "fts4intck1",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "testdir": ""
          },
          "functionProc": "slang",
          "functionArgs": [
            "in"
          ],
          "functionBody": "\n  return [string map {th d e eh} $in]\n",
          "minArgs": 1,
          "maxArgs": -1,
          "deterministic": true,
          "innocuous": true
        }
      ]
    },
    {
      "name": "fts4intck1-2.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA integrity_check(t2);",
          "expect": "ok"
        }
      ]
    },
    {
      "name": "fts4intck1-2.3",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA integrity_check(t2);",
          "expect": "{malformed inverted index for FTS4 table main.t2}"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "fts4intck1-3.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE x1 USING fts4(a, b);\n  INSERT INTO x1 VALUES('one', 'two');\n  INSERT INTO x1 VALUES('three', 'four');"
        }
      ]
    },
    {
      "name": "setup_3",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "fts4intck1-3.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA integrity_check;",
          "expect": "ok"
        }
      ]
    }
  ]
}