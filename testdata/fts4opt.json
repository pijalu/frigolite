{
  "file": "fts4opt.test",
  "name": "fts4opt",
  "ordered": true,
  "tests": [
    {
      "name": "fts4opt-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(docid, words)"
        }
      ]
    },
    {
      "name": "fts4opt-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE t2 USING fts4(words, prefix=\"1,2,3\")"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t2(docid, words) VALUES('', '')"
        }
      ]
    },
    {
      "name": "fts4opt-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT level, count(*) FROM t2_segdir GROUP BY level",
          "expect": "\n  0    13    1 15    2 5 \n  1024 13 1025 15 1026 5 \n  2048 13 2049 15 2050 5 \n  3072 13 3073 15 3074 5\n"
        }
      ]
    },
    {
      "name": "fts4opt-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t2(t2) VALUES('integrity-check')"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "defensive",
          "sql": "0"
        },
        {
          "type": "exec",
          "sql": "BEGIN;\n      CREATE TEMP TABLE tmp_segdir(\n        level, idx, start_block, leaves_end_block, end_block, root\n      );\n\n      INSERT INTO temp.tmp_segdir \n        SELECT \n        1024*(o.level / 1024) + 32,                                -- level\n        sum(o.level\u003ci.level OR (o.level=i.level AND o.idx\u003ei.idx)), -- idx\n        o.start_block, o.leaves_end_block, o.end_block, o.root     -- other\n        FROM t2_segdir o, t2_segdir i \n        WHERE (o.level / 1024) = (i.level / 1024)\n        GROUP BY o.level, o.idx;\n  \n      DELETE FROM t2_segdir;\n      INSERT INTO t2_segdir SELECT * FROM temp.tmp_segdir;\n      DROP TABLE temp.tmp_segdir;\n  \n    COMMIT;"
        }
      ]
    },
    {
      "name": "fts4opt-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t2(t2) VALUES('integrity-check')"
        }
      ]
    },
    {
      "name": "fts4opt-1.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT level, count(*) FROM t2_segdir GROUP BY level",
          "expect": "\n  32   33 \n  1056 33 \n  2080 33 \n  3104 33\n"
        }
      ]
    },
    {
      "name": "fts4opt-1.6",
