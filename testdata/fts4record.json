          "expect": "\n  X'00057465726D610501020303000401620401058002010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010100'\n"
        }
      ]
    },
    {
      "name": "fts4record-1.5.1",
      "steps": [
        {
