          "sql": "UPDATE t1_segdir SET root = \n  X'00057465726D61050102030300040162040105FF00010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010100'"
        }
      ]
    },
    {
      "name": "fts4record-1.5.2",
      "steps": [
        {
          "type": "catch",
