{
  "file": "fts4rename.test",
  "name": "fts4rename",
  "ordered": true,
  "tests": [
    {
      "name": "fts4rename-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE temp.t1 USING fts3(a);\n  BEGIN;\n  CREATE TABLE t2(x);"
        }
      ]
    },
    {
      "name": "fts4rename-1.1",
      "steps": [
        {
          "type": "catch",
          "sql": "ALTER TABLE t1_content RENAME c0a TO docid;",
          "expect": "1 {error in table t1_content after rename: duplicate column name: docid}"
        }
      ]
    },
    {
      "name": "fts4rename-1.2",
      "steps": [
        {
          "type": "catch",
          "sql": "UPDATE t1 SET Col0 = 1 ;",
          "expect": "1 {no such column: Col0}"
        }
      ]
    },
    {
      "name": "fts4rename-1.3",
      "steps": [
        {
          "type": "catch",
          "sql": "ROLLBACK;\n  DROP TABLE t1;",
          "expect": "0 {}"
        }
      ]
    }
  ]
}