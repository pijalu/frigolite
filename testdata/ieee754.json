      "name": "ieee754-100-1-1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT ieee754(1.0);",
          "expect": "ieee754(1,0)"
        }
      ]
    },
    {
      "name": "ieee754-100-1-2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT ieee754(1,0)==1.0;",
          "expect": "1"
        }
      ]
    },
