{
  "file": "incrcorrupt.test",
  "name": "incrcorrupt",
  "tests": [
    {
      "name": "1.0",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA auto_vacuum = 2;\n  CREATE TABLE t1(a PRIMARY KEY, b);\n\n  WITH data(i) AS (\n    SELECT 1 UNION ALL SELECT i+1 FROM data\n  )\n  INSERT INTO t1 SELECT i, randomblob(600) FROM data LIMIT 20;\n  PRAGMA page_count;",
          "expect": "24"
        }
      ]
    },
    {
      "name": "1.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA incremental_vacuum;"
        }
      ]
    },
    {
      "name": "2.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA auto_vacuum = 1;\n  CREATE TABLE t1(a PRIMARY KEY, b);\n  WITH data(i) AS (\n    SELECT 1 UNION ALL SELECT i+1 FROM data\n  )\n  INSERT INTO t1 SELECT i, randomblob(600) FROM data LIMIT 20;\n  PRAGMA page_count;",
          "expect": "24"
        }
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA incremental_vacuum;",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA incremental_vacuum;",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    }
  ],
  "source": "capi"
}