{
  "file": "incrcorrupt.test",
  "name": "incrcorrupt",
  "ordered": true,
  "tests": [
    {
      "name": "incrcorrupt-1.0",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA auto_vacuum = 2;\n  CREATE TABLE t1(a PRIMARY KEY, b);\n\n  WITH data(i) AS (\n    SELECT 1 UNION ALL SELECT i+1 FROM data\n  )\n  INSERT INTO t1 SELECT i, randomblob(600) FROM data LIMIT 20;\n  PRAGMA page_count;",
          "expect": "24"
        }
      ]
    },
    {
      "name": "incrcorrupt-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA incremental_vacuum;"
        }
      ]
    },
    {
      "name": "incrcorrupt-1.2",
      "steps": [
        {
          "type": "hexio_write",
          "sql": "test.db",
          "fileData": "00000019",
          "fileTarget": "test.db",
          "fileOffset": 36
        },
        {
          "type": "catch",
          "sql": "PRAGMA incremental_vacuum;",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
      "name": "incrcorrupt-1.3",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "PRAGMA incremental_vacuum",
          "variable": "stmt_1"
        },
        {
          "type": "stmt_step",
          "sql": "PRAGMA incremental_vacuum",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__",
          "expect": "SQLITE_CORRUPT"
        }
      ]
    },
    {
      "name": "incrcorrupt-1.6",
      "steps": [
        {
          "type": "stmt_finalize",
          "sql": "PRAGMA incremental_vacuum",
          "variable": "stmt_1",
          "expect": "SQLITE_CORRUPT"
        }
      ]
    },
    {
      "name": "incrcorrupt-1.9",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "PRAGMA incremental_vacuum",
          "variable": "stmt_2"
        },
        {
          "type": "stmt_step",
          "sql": "PRAGMA incremental_vacuum",
          "variable": "stmt_2"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_2__",
          "expect": "SQLITE_CORRUPT"
        }
      ]
    },
    {
      "name": "incrcorrupt-1.12",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "SELECT 1",
          "variable": "stmt_3"
        },
        {
          "type": "stmt_finalize",
          "sql": "SELECT 1",
          "variable": "stmt_3",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "incrcorrupt-1.15",
      "steps": [
        {
          "type": "stmt_finalize",
          "sql": "PRAGMA incremental_vacuum",
          "variable": "stmt_2",
          "expect": "SQLITE_CORRUPT"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "incrcorrupt-2.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA auto_vacuum = 1;\n  CREATE TABLE t1(a PRIMARY KEY, b);\n  WITH data(i) AS (\n    SELECT 1 UNION ALL SELECT i+1 FROM data\n  )\n  INSERT INTO t1 SELECT i, randomblob(600) FROM data LIMIT 20;\n  PRAGMA page_count;",
          "expect": "24"
        }
      ]
    },
    {
      "name": "incrcorrupt-2.2",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA incremental_vacuum;",
          "expect": "1 {database disk image is malformed}"
        }
      ]
    },
    {
