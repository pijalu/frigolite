{
  "file": "incrvacuum2.test",
  "name": "incrvacuum2",
  "ordered": true,
  "tests": [
    {
      "name": "incrvacuum2-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA page_size=1024;\n    PRAGMA auto_vacuum=incremental;\n    CREATE TABLE t1(x);\n    INSERT INTO t1 VALUES(zeroblob(30000));\n    DELETE FROM t1;",
          "expect": "32768"
        }
      ]
    },
    {
      "name": "incrvacuum2-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA incremental_vacuum(1);",
          "expect": "31744"
        }
      ]
    },
    {
      "name": "incrvacuum2-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA incremental_vacuum(5);",
          "expect": "26624"
        }
      ]
    },
    {
      "name": "incrvacuum2-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA incremental_vacuum(1000);",
          "expect": "3072"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test2.db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test2.db-journal"
        }
      ]
    },
    {
      "name": "incrvacuum2-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "ATTACH DATABASE 'test2.db' AS aux;\n      PRAGMA aux.auto_vacuum=incremental;\n      CREATE TABLE aux.t2(x);\n      INSERT INTO t2 VALUES(zeroblob(30000));\n      INSERT INTO t1 SELECT * FROM t2;\n      DELETE FROM t2;\n      DELETE FROM t1;",
          "expect": "32768 32768"
        }
      ]
    },
    {
      "name": "incrvacuum2-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA aux.incremental_vacuum(1)",
          "expect": "32768 31744"
        }
      ]
    },
    {
      "name": "incrvacuum2-2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA aux.incremental_vacuum(5)",
          "expect": "32768 26624"
        }
      ]
    },
    {
      "name": "incrvacuum2-2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA main.incremental_vacuum(5)",
          "expect": "27648 26624"
        }
      ]
    },
    {
      "name": "incrvacuum2-2.5",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA aux.incremental_vacuum",
          "expect": "27648 3072"
        }
      ]
    },
    {
      "name": "incrvacuum2-2.6",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA incremental_vacuum(1)",
          "expect": "26624 3072"
        }
      ]
    },
    {
      "name": "incrvacuum2-3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum = 'full';\n    BEGIN;\n    CREATE TABLE abc(a);\n    INSERT INTO abc VALUES(randstr(1500,1500));\n    COMMIT;"
        }
      ]
    },
    {
      "name": "incrvacuum2-3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    DELETE FROM abc;\n    PRAGMA incremental_vacuum;\n    COMMIT;"
        }
      ]
    }
  ]
}