{
  "file": "index.test",
  "name": "index",
  "ordered": true,
  "tests": [
    {
      "name": "index-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE test1(f1 int, f2 int, f3 int)"
        },
        {
          "type": "exec",
          "sql": "CREATE INDEX index1 ON test1(f1)"
        },
        {
          "type": "exec",
          "sql": "SELECT name FROM sqlite_master WHERE type!='meta' ORDER BY name",
          "expect": "index1 test1"
        }
      ]
    },
    {
      "name": "index-1.1b",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT name, sql, tbl_name, type FROM sqlite_master \n           WHERE name='index1'",
          "expect": "index1 {CREATE INDEX index1 ON test1(f1)} test1 index"
        }
      ]
    },
    {
      "name": "index-1.1c",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "SELECT name, sql, tbl_name, type FROM sqlite_master \n           WHERE name='index1'",
          "expect": "index1 {CREATE INDEX index1 ON test1(f1)} test1 index"
        }
      ]
    },
