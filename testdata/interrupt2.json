    {
      "name": "interrupt2-2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TEMP TABLE z1(a, b);\n  INSERT INTO z1 SELECT * FROM t1;"
        }
      ]
    },
    {
      "name": "interrupt2-2.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM z1",
          "catchMessage": "msg",
          "expect": "{1 {SQLITE_INTERRUPT - interrupted}} {1 interrupted}"
        }
      ]
    },
    {
      "name": "interrupt2-2.0",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT count(*) FROM t1\n  UNION ALL\n  SELECT count(*) FROM z1",
          "expect": "1000 1000"
        }
      ]
    },
    {
      "name": "interrupt2-3.1.1",
      "steps": [
