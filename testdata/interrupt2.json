{
  "file": "interrupt2.test",
  "name": "interrupt2",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "interrupt2-1.0",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t1(a, b);\n  CREATE INDEX t1a ON t1(a);\n  CREATE INDEX t1b ON t1(b);\n  PRAGMA journal_mode = wal;\n\n  WITH ii(i) AS ( VALUES(1) UNION ALL SELECT i+1 FROM ii WHERE i\u003c1000 )\n  INSERT INTO t1 SELECT i, i FROM ii;",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "interrupt2-1.5.1",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA wal_checkpoint;",
          "expect": "1 interrupted"
        }
      ]
    },
    {
      "name": "interrupt2-1.5.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT count(*) FROM t1",
          "expect": "1000"
        }
      ]
    },
    {
      "name": "interrupt2-1.5.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT count(*) FROM t1",
          "expect": "1000"
        }
      ]
    },
    {
      "name": "interrupt2-1.10.1",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA wal_checkpoint;",
          "expect": "1 interrupted"
        }
      ]
    },
    {
      "name": "interrupt2-1.10.2",
      "steps": [
        {
          "type": "query",
