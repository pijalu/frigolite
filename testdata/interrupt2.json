      "steps": [
        {
          "type": "wal_checkpoint_v2",
          "sql": "truncate",
          "variable": "__catchrc_msg",
          "catchResult": true,
          "catchMessage": "msg",
          "database": "db"
        },
        {
          "type": "runtime_list",
          "listValues": [
            "$__catchrc_msg",
            "$msg"
          ],
          "expect": "1 {SQLITE_INTERRUPT - interrupted}"
        }
      ]
    },
    {
      "name": "interrupt2-1.5.4",
      "steps": [
        {
