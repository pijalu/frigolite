          "expect": "1000"
        }
      ]
    },
    {
      "name": "interrupt2-1.10.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT count(*) FROM t1",
          "expect": "1000"
        }
      ]
    },
    {
