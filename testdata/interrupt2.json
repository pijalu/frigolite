{
  "file": "interrupt2.test",
  "name": "interrupt2",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "register_testvfs",
          "sql": "default",
          "variable": "tvfs"
        },
        {
          "type": "testvfs_config",
          "sql": "filter",
          "variable": "xWrite",
          "database": "tvfs"
        },
        {
          "type": "testvfs_config",
          "sql": "script",
          "variable": "write_cb",
          "callbackProcs": [
            {
              "Name": "write_cb",
              "Args": [
                "method",
                "args"
              ],
              "Body": "\n  set filename [lindex $args 0]\n  if {[file tail $filename]==\"test.db\" \u0026\u0026 $::trigger_interrupt} {\n    if {$::trigger_interrupt} {\n      incr ::trigger_interrupt -1\n      if {$::trigger_interrupt==0} { sqlite3_interrupt db }\n    }\n  }\n  return 0\n",
              "Defaults": null
            }
          ],
          "functionProc": "write_cb",
          "database": "tvfs"
        },
        {
          "type": "runtime_expr",
          "sql": "0",
          "variable": "trigger_interrupt"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "interrupt2-1.0",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t1(a, b);\n  CREATE INDEX t1a ON t1(a);\n  CREATE INDEX t1b ON t1(b);\n  PRAGMA journal_mode = wal;\n\n  WITH ii(i) AS ( VALUES(1) UNION ALL SELECT i+1 FROM ii WHERE i\u003c1000 )\n  INSERT INTO t1 SELECT i, i FROM ii;",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "runtime_expr",
          "sql": "5",
          "variable": "trigger_interrupt"
        }
      ]
    },
    {
      "name": "interrupt2-1.5.1",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA wal_checkpoint;",
          "expect": "1 interrupted"
        }
      ]
    },
    {
      "name": "interrupt2-1.5.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT count(*) FROM t1",
          "expect": "1000"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "runtime_expr",
          "sql": "5",
          "variable": "trigger_interrupt"
        }
      ]
    },
    {
