{
  "file": "intpkey.test",
  "name": "intpkey",
  "ordered": true,
  "tests": [
    {
      "name": "intpkey-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a TEXT PRIMARY KEY, b, c);"
        }
      ]
    },
    {
      "name": "intpkey-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT name FROM sqlite_master\n    WHERE type='index' AND tbl_name='t1';",
          "expect": "sqlite_autoindex_t1_1"
        }
      ]
    },
    {
      "name": "intpkey-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE t1;\n    CREATE TABLE t1(a INTEGER PRIMARY KEY, b, c);\n    SELECT name FROM sqlite_master\n      WHERE type='index' AND tbl_name='t1';"
        }
      ]
    },
    {
      "name": "intpkey-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(5,'hello','world');",
          "expect": "5"
        }
      ]
    },
    {
      "name": "intpkey-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1;",
          "expect": "5 hello world"
        }
      ]
    },
    {
      "name": "intpkey-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid, * FROM t1;",
          "expect": "5 5 hello world"
        }
      ]
    },
    {
      "name": "intpkey-1.6",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(5,'second','entry');",
          "expect": "1 {UNIQUE constraint failed: t1.a}"
        }
      ]
    },
    {
      "name": "intpkey-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid, * FROM t1;",
          "expect": "5 5 hello world"
        }
      ]
    },
    {
      "name": "intpkey-1.8",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(6,'second','entry');",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "intpkey-1.9",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid, * FROM t1;",
          "expect": "5 5 hello world 6 6 second entry"
        }
      ]
    },
    {
      "name": "intpkey-1.10",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1(b,c) VALUES('one','two');\n    SELECT b FROM t1 ORDER BY b;",
          "expect": "hello one second"
        }
      ]
    },
    {
      "name": "intpkey-1.11",
      "steps": [
        {
          "type": "exec",
          "sql": "UPDATE t1 SET a=4 WHERE b='one';\n    SELECT * FROM t1;",
          "expect": "4 one two 5 hello world 6 second entry"
        }
      ]
    },
    {
      "name": "intpkey-1.12.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1 WHERE a==4;",
          "expect": "4 one two"
        }
      ]
    },
    {
      "name": "intpkey-1.12.2",
      "steps": [
        {
          "type": "exec",
          "sql": "EXPLAIN QUERY PLAN\n    SELECT * FROM t1 WHERE a==4;",
          "expect": "/SEARCH t1 /"
        }
      ]
    },
