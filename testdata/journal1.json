{
  "file": "journal1.test",
  "name": "journal1",
  "ordered": true,
  "tests": [
    {
      "name": "journal1-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b);\n    INSERT INTO t1 VALUES(1,randstr(10,400));\n    INSERT INTO t1 VALUES(2,randstr(10,400));\n    INSERT INTO t1 SELECT a+2, a||b FROM t1;\n    INSERT INTO t1 SELECT a+4, a||b FROM t1;\n    SELECT count(*) FROM t1;",
          "expect": "8"
        }
      ]
    },
    {
      "name": "journal1-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    DELETE FROM t1;"
        },
        {
          "type": "copy_file",
          "sql": "test.db-journal",
          "fileTarget": "test.db-journal-bu"
        },
        {
          "type": "exec",
          "sql": "ROLLBACK;"
        },
        {
          "type": "close_db"
        },
        {
          "type": "copy_file",
          "sql": "test.db-journal-bu",
          "fileTarget": "test.db-journal"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM sqlite_master",
          "expect": "0 {}"
        }
      ]
    }
  ]
}