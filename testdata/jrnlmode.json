      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode;\n    PRAGMA main.journal_mode;\n    PRAGMA temp.journal_mode;",
          "expect": "delete delete delete"
        }
      ]
    },
    {
