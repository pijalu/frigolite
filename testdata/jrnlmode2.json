{
  "file": "jrnlmode2.test",
  "name": "jrnlmode2",
  "ordered": true,
  "tests": [
    {
      "name": "jrnlmode2-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = persist;\n    CREATE TABLE t1(a, b);\n    INSERT INTO t1 VALUES(1, 2);",
          "expect": "persist"
        }
      ]
    },
    {
      "name": "jrnlmode2-1.3",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "jrnlmode2-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(3, 4);"
        },
        {
          "type": "exec",
          "sql": "BEGIN;\n    SELECT * FROM t1;"
        },
        {
          "type": "exec",
          "sql": "PRAGMA lock_status",
          "expect": "main shared temp closed"
        }
      ]
    },
    {
      "name": "jrnlmode2-1.6",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "0 {1 2 3 4}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "jrnlmode2-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "0 {1 2 3 4}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "jrnlmode2-2.1",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = truncate"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(5, 6)"
        }
      ]
    },
    {
      "name": "jrnlmode2-2.4",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "0 {1 2 3 4 5 6}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "jrnlmode2-2.5",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "jrnlmode2-2.6",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "0 {1 2 3 4 5 6}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        }
      ]
    }
  ]
}