{
  "file": "jrnlmode2.test",
  "name": "jrnlmode2",
  "tests": [
    {
      "name": "jrnlmode2-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = persist;\n    CREATE TABLE t1(a, b);\n    INSERT INTO t1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "jrnlmode2-1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "jrnlmode2-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(3, 4);"
        }
      ]
    },
    {
      "name": "jrnlmode2-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "0 {1 2 3 4}"
        }
      ]
    },
    {
      "name": "jrnlmode2-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        }
      ]
    },
    {
      "name": "jrnlmode2-2.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = truncate"
        }
      ]
    },
    {
      "name": "jrnlmode2-2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "0 {1 2 3 4 5 6}"
        }
      ]
    },
    {
      "name": "jrnlmode2-2.6",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "0 {1 2 3 4 5 6}"
        },
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = persist;\n    CREATE TABLE t1(a, b);\n    INSERT INTO t1 VALUES(1, 2);"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(3, 4);"
        },
        {
          "type": "exec",
          "sql": "BEGIN;\n    SELECT * FROM t1;"
        },
        {
          "type": "exec",
          "sql": "PRAGMA lock_status"
        },
        {
          "type": "exec",
          "sql": "COMMIT"
        },
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = truncate"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(5, 6)"
        }
      ]
    }
  ]
}