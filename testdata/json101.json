      "name": "json101-5.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT j2.rowid, jx.rowid, fullkey, path, key\n    FROM j2, json_each(j2.json) AS jx\n   WHERE jx.json<>j2.json;"
        }
      ]
    },
