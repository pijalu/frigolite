      "name": "json101-5.6",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT j2.rowid, jx.rowid, fullkey, path, key\n    FROM j2, json_tree(j2.json) AS jx\n   WHERE jx.json<>j2.json;"
        }
      ]
    },
    {
      "name": "json101-5.7",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT j2.rowid, jx.rowid, fullkey, path, key\n    FROM j2, json_each(j2.json) AS jx\n   WHERE jx.value<>jx.atom AND type NOT IN ('array','object');"
        }
