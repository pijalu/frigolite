      "steps": [
        {
          "type": "query",
          "sql": "SELECT count(*) FROM j1 WHERE json_type(x) IN ('object','array');\n  SELECT x FROM j1\n   WHERE json_extract(x,'$')<>x\n     AND json_type(x) IN ('object','array');",
          "expect": "4"
        }
      ]
    },
