      "name": "json101-4.10b",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE j1b AS SELECT jsonb(x) AS \"x\" FROM j1;\n  SELECT count(*) FROM j1b WHERE json_type(x) IN ('object','array');\n  SELECT json(x) FROM j1b\n   WHERE json_extract(x,'$')<>json(x)\n     AND json_type(x) IN ('object','array');",
          "expect": "4"
        }
      ]
