          "expect": "1 1 object | 2 1 object | 3 1 array |"
        }
      ]
    },
    {
      "name": "json101-5.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT j2.rowid, jx.rowid, fullkey, path, key\n    FROM j2, json_tree(j2.json) AS jx\n   WHERE fullkey!=(path || CASE WHEN typeof(key)=='integer' THEN '['||key||']'\n                                ELSE '.'||key END);"
        }
      ]
    },
    {
      "name": "json101-5.3b",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT j2b.rowid, jx.rowid, fullkey, path, key\n    FROM j2b, json_tree(j2b.json) AS jx\n   WHERE fullkey!=(path || CASE WHEN typeof(key)=='integer' THEN '['||key||']'\n                                ELSE '.'||key END);"
        }
      ]
    },
