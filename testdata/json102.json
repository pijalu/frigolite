    {
      "name": "json102-1000",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE user(name,phone,phoneb);\n  INSERT INTO user(name,phone) VALUES\n     ('Alice','[\"919-555-2345\",\"804-555-3621\"]'),\n     ('Bob','[\"201-555-8872\"]'),\n     ('Cindy','[\"704-555-9983\"]'),\n     ('Dave','[\"336-555-8421\",\"704-555-4321\",\"803-911-4421\"]');\n  UPDATE user SET phoneb=jsonb(phone);\n  SELECT DISTINCT user.name\n    FROM user, json_each(user.phone)\n   WHERE json_each.value LIKE '704-%'\n   ORDER BY 1;",
          "expect": "Cindy Dave"
        }
      ]
    },
    {
      "name": "json102-1000b",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT DISTINCT user.name\n    FROM user, json_each(user.phoneb)\n   WHERE json_each.value LIKE '704-%'\n   ORDER BY 1;",
          "expect": "Cindy Dave"
        }
      ]
    },
    {
      "name": "json102-1010",
      "steps": [
        {
          "type": "query",
          "sql": "UPDATE user\n     SET phone=json_extract(phone,'$[0]')\n   WHERE json_array_length(phone)<2;\n  SELECT name, substr(phone,1,5) FROM user ORDER BY name;",
          "expect": "Alice {[\"919} Bob 201-5 Cindy 704-5 Dave {[\"336}"
        }
      ]
    },
    {
      "name": "json102-1011",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT name FROM user WHERE phone LIKE '704-%'\n  UNION\n  SELECT user.name\n    FROM user, json_each(user.phone)\n   WHERE json_valid(user.phone)\n     AND json_each.value LIKE '704-%';",
          "expect": "Cindy Dave"
        }
      ]
    },
