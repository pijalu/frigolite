{
  "file": "json109.test",
  "name": "json109",
  "tests": [
    {
      "name": "1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_array_insert('[1,2,3]','$[0]',999,'$[0]',888);",
          "expect": "{[888,999,1,2,3]}"
        }
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_array_insert('[1,2,3]','$[0]',999,'$[#]',888);",
          "expect": "{[999,1,2,3,888]}"
        }
      ]
    },
    {
      "name": "1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_array_insert('[1,2,3]','$[1]',888);",
          "expect": "{[1,888,2,3]}"
        }
      ]
    },
    {
      "name": "1.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_array_insert('[1,2,3]','$[2]',888);",
          "expect": "{[1,2,888,3]}"
        }
      ]
    },
    {
      "name": "1.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_array_insert('[1,2,3]','$[3]',888);",
          "expect": "{[1,2,3,888]}"
        }
      ]
    },
    {
      "name": "1.6",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_array_insert('[1,2,3]','$[#-1]',888);",
          "expect": "{[1,2,888,3]}"
        }
      ]
    },
    {
      "name": "1.7",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_array_insert('[1,2,3]','$[#-2]',888);",
          "expect": "{[1,888,2,3]}"
        }
      ]
    },
    {
      "name": "1.8",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_array_insert('[1,2,3]','$[#-3]',888);",
          "expect": "{[888,1,2,3]}"
        }
      ]
    },
    {
      "name": "1.9",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_array_insert('[1,2,3]','$[#-4]',888);",
          "expect": "{[1,2,3]}"
        }
      ]
    }
  ]
}