{
  "file": "json109.test",
  "name": "json109",
  "ordered": true,
  "tests": [
    {
      "name": "json109-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_array_insert('[1,2,3]','$[0]',999,'$[0]',888);",
          "expect": "{[888,999,1,2,3]}"
        }
      ]
    },
    {
      "name": "json109-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_array_insert('[1,2,3]','$[0]',999,'$[#]',888);",
          "expect": "{[999,1,2,3,888]}"
        }
      ]
    },
    {
      "name": "json109-1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_array_insert('[1,2,3]','$[1]',888);",
          "expect": "{[1,888,2,3]}"
        }
      ]
    },
    {
      "name": "json109-1.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_array_insert('[1,2,3]','$[2]',888);",
          "expect": "{[1,2,888,3]}"
        }
      ]
    },
    {
      "name": "json109-1.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_array_insert('[1,2,3]','$[3]',888);",
          "expect": "{[1,2,3,888]}"
        }
      ]
    },
    {
      "name": "json109-1.6",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_array_insert('[1,2,3]','$[#-1]',888);",
          "expect": "{[1,2,888,3]}"
        }
      ]
    },
    {
      "name": "json109-1.7",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_array_insert('[1,2,3]','$[#-2]',888);",
          "expect": "{[1,888,2,3]}"
        }
      ]
    },
    {
      "name": "json109-1.8",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_array_insert('[1,2,3]','$[#-3]',888);",
          "expect": "{[888,1,2,3]}"
        }
      ]
    },
    {
      "name": "json109-1.9",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_array_insert('[1,2,3]','$[#-4]',888);",
          "expect": "{[1,2,3]}"
        }
      ]
    },
    {
      "name": "json109-2.1",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT json_array_insert('{a:[1,2,3]}','$.a',888);",
          "expect": "1 {not an array element: '$.a'}"
        }
      ]
    },
    {
      "name": "json109-2.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT json_array_insert('{a:[1,2,3]}','$.b',888);",
          "expect": "1 {not an array element: '$.b'}"
        }
      ]
    },
    {
      "name": "json109-2.3",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT json_array_insert('{a:[1,2,3]}','$.b[0]',888);",
          "expect": "0 {{{\"a\":[1,2,3],\"b\":[888]}}}"
        }
      ]
    },
    {
      "name": "json109-2.4",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT json_array_insert('{a:[1,2,3]}','$.b.c.d[0]',888);",
          "expect": "0 {{{\"a\":[1,2,3],\"b\":{\"c\":{\"d\":[888]}}}}}"
        }
      ]
    },
    {
      "name": "json109-2.5",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT json_array_insert('{a:[1,2,3]}','$.b.c.d[0',888);",
          "expect": "1 {not an array element: '$.b.c.d[0'}"
        }
      ]
    },
    {
      "name": "json109-2.6",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT json_array_insert('{a:[1,2,3]}','$.b.c.d',888);",
          "expect": "1 {not an array element: '$.b.c.d'}"
        }
      ]
    },
    {
      "name": "json109-2.7",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT json_array_insert('{a:[1,2,3]}','$[0]',888);",
          "expect": "0 {{{\"a\":[1,2,3]}}}"
        }
      ]
    },
    {
      "name": "json109-2.8",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT json_array_insert('{a:[1,2,3]}','$.b[0]',888,'$.a[1]','999','$.c',0);",
          "expect": "1 {not an array element: '$.c'}"
        }
      ]
    }
  ]
}