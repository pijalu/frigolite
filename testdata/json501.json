{
  "file": "json501.test",
  "name": "json501",
  "tests": [
    {
      "name": "3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "WITH c(x) AS (VALUES('[5, 6,]'))\n  SELECT x->>1, json(x), json_valid(x), NOT json_error_position(x) FROM c;"
        }
      ]
    },
    {
      "name": "3.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT '[5, 6 , ]'->>1;"
        }
      ]
    },
    {
      "name": "3.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT '[5, 6,,]'->>1;",
          "expect": "1 {malformed JSON}"
        }
      ]
    },
    {
      "name": "3.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT '[5, 6 , , ]'->>1;",
          "expect": "1 {malformed JSON}"
        }
      ]
    }
  ]
}