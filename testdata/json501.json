{
  "file": "json501.test",
  "name": "json501",
  "ordered": true,
  "tests": [
    {
      "name": "json501-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "WITH c(x) AS (VALUES('{a:5,b:6}'))\n  SELECT x-\u003e\u003e'a', json(x), json_valid(x), NOT json_error_position(x) FROM c;",
          "expect": "5 {{\"a\":5,\"b\":6}} 0 1"
        }
      ]
    },
    {
      "name": "json501-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT '[7,null,{a:5,b:6},[8,9]]'-\u003e\u003e'$[2].b';",
          "expect": "6"
        }
      ]
    },
    {
      "name": "json501-1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT '{ $123 : 789 }'-\u003e\u003e'$.\"$123\"';",
          "expect": "789"
        }
      ]
    },
    {
      "name": "json501-1.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT '{ _123$xyz : 789 }'-\u003e\u003e'$.\"_123$xyz\"';",
          "expect": "789"
        }
      ]
    },
    {
      "name": "json501-1.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT '{ MNO_123$xyz : 789 }'-\u003e\u003e'$.\"MNO_123$xyz\"';",
          "expect": "789"
        }
      ]
    },
    {
      "name": "json501-1.6",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json('{ MNO_123$xyz : 789 }');",
          "expect": "{{\"MNO_123$xyz\":789}}"
        }
      ]
    },
    {
      "name": "json501-1.10",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT json('{ MNO_123/xyz : 789 }');",
          "expect": "1 {malformed JSON}"
        }
      ]
    },
    {
      "name": "json501-1.11",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT '{ MNO_123æxyz : 789 }'-\u003e\u003e'MNO_123æxyz';",
          "expect": "789"
        }
      ]
    },
