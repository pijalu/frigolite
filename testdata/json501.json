{
  "file": "json501.test",
  "name": "json501",
  "tests": [
    {
      "name": "3.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT '[5, 6 , ]'->>1;"
        }
      ]
    },
    {
      "name": "3.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT '[5, 6,,]'->>1;",
          "expect": "1 {malformed JSON}"
        }
      ]
    },
    {
      "name": "3.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT '[5, 6 , , ]'->>1;",
          "expect": "1 {malformed JSON}"
        }
      ]
    }
  ]
}