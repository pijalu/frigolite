{
  "file": "json502.test",
  "name": "json502",
  "nullToken": "null",
  "ordered": true,
  "tests": [
    {
      "name": "json502-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t1(x JSON);\n  INSERT INTO t1(x) VALUES('{a:{b:{c:\"hello\",},},}');\n  SELECT fullkey FROM t1, json_tree(x);",
          "expect": "{$} {$.a} {$.a.b} {$.a.b.c}"
        }
      ]
    },
    {
      "name": "json502-2.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_error_position('{a:null,{\"h\":[1,[1,2,3]],\"j\":\"abc\"}:true}');",
          "expect": "9"
        }
      ]
    },
    {
      "name": "json502-2.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT json('{a:null,{\"h\":[1,[1,2,3]],\"j\":\"abc\"}:true}');",
          "expect": "1 {malformed JSON}"
        }
      ]
    },
    {
      "name": "json502-2.3",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT '{a:null,{\"h\":[1,[1,2,3]],\"j\":\"abc\"}:true}'-\u003e'$h[#-1]';",
          "expect": "1 {malformed JSON}"
        }
      ]
    },
    {
      "name": "json502-3.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT '{\"a\\x62c\":123}' -\u003e\u003e 'abc';",
          "expect": "123"
        }
      ]
    },
    {
      "name": "json502-3.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT '{\"abc\":123}' -\u003e\u003e 'a\\x62c';",
          "expect": "123"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "nullvalue",
          "sql": "null"
        }
      ]
    },
    {
      "name": "json502-3.3",
      "steps": [
        {
          "type": "query",
          "sql": "DROP TABLE IF EXISTS t1;\n  CREATE TABLE t1(x);\n  INSERT INTO t1 VALUES(json_insert('{}','$.a\\',111,'$.\"b\\\\\"',222));\n  INSERT INTO t1 VALUES(jsonb_insert('{}','$.a\\',111,'$.\"b\\\\\"',222));\n  SELECT x-\u003e'$.a\\', x-\u003e'$.a\\\\', x-\u003e'$.\"a\\\\\"', x-\u003e'$.\"b\\\\\"' FROM t1;",
          "expect": "111 null 111 222 111 null 111 222"
        }
      ]
    },
    {
      "name": "json502-3.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_patch('{\"a\\x62c\":123}','{\"ab\\x63\":456}') -\u003e\u003e 'abc';",
          "expect": "456"
        }
      ]
    },
    {
      "name": "json502-4.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM json_tree('{\"\\u0017\":1}','$.\"\\x17\"');",
          "expect": "{\\x17} 1 integer 1 1 null {$.\"\\x17\"} {$}"
        }
      ]
    },
    {
      "name": "json502-5.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_extract('{\"A\\\"Key\":1}', '$.A\"Key');",
          "expect": "1"
        }
      ]
    },
    {
      "name": "json502-5.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json_extract('{\"A\\\"Key\":1}', '$.\"A\\\"Key\"');",
          "expect": "1"
        }
      ]
    },
    {
      "name": "json502-5.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT JSON_SET('{}', '$.\"\\\"Key\"', 1);",
          "expect": "{{\"\\\"Key\":1}}"
        }
      ]
    }
  ]
}