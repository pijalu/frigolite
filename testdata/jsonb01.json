  "file": "jsonb01.test",
  "name": "jsonb01",
  "tests": [
    {
      "name": "jsonb01-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x JSON BLOB);\n  INSERT INTO t1 VALUES(jsonb('{a:5,b:{x:10,y:11},c:[1,2,3,4]}'));"
        }
      ]
    },
    {
      "name": "jsonb01-1.2.1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT json(jsonb_remove(x,'$.a')) FROM t1;",
          "expect": "{{\"b\":{\"x\":10,\"y\":11},\"c\":[1,2,3,4]}}"
        }
      ]
    },
    {
