{
  "file": "like3.test",
  "name": "like3",
  "ordered": true,
  "tests": [
    {
      "name": "like3-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA encoding=UTF8;\n  CREATE TABLE t1(a,b TEXT COLLATE nocase);\n  INSERT INTO t1(a,b)\n     VALUES(1,'abc'),\n           (2,'ABX'),\n           (3,'BCD'),\n           (4,x'616263'),\n           (5,x'414258'),\n           (6,x'424344');\n  CREATE INDEX t1ba ON t1(b,a);\n\n  SELECT a, b FROM t1 WHERE b LIKE 'aB%' ORDER BY +a;",
          "expect": "1 abc 2 ABX 4 abc 5 ABX"
        }
      ]
    },
    {
      "name": "like3-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT a, b FROM t1 WHERE +b LIKE 'aB%' ORDER BY +a;",
          "expect": "1 abc 2 ABX 4 abc 5 ABX"
        }
      ]
    },
    {
      "name": "like3-2.0",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t2(a, b TEXT);\n  INSERT INTO t2 SELECT a, b FROM t1;\n  CREATE INDEX t2ba ON t2(b,a);\n  SELECT a, b FROM t2 WHERE b GLOB 'ab*' ORDER BY +a;",
          "expect": "1 abc 4 abc"
        }
      ]
    },
    {
      "name": "like3-2.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT a, b FROM t2 WHERE +b GLOB 'ab*' ORDER BY +a;",
