{
  "file": "literal2.test",
  "name": "literal2",
  "ordered": true,
  "tests": [
    {
      "name": "literal2-1.0",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 123_456",
          "expect": "123456"
        }
      ]
    },
    {
      "name": "literal2-1.1",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT 123__456",
          "expect": "1"
        }
      ]
    },
    {
      "name": "literal2-2.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 1.0e1_2"
        },
        {
          "type": "query",
          "sql": "SELECT 1.0e1_2"
        }
      ]
    },
    {
      "name": "literal2-3.0.0",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 0xFF_FF",
          "expect": "65535"
        }
      ]
    },
    {
      "name": "literal2-3.0.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 0xFF_EF",
          "expect": "65519"
        }
      ]
    },
    {
      "name": "literal2-3.0.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT 0xFF__EF",
          "expect": "1"
        }
      ]
    },
    {
      "name": "literal2-3.0.4",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT 0xFFEF_",
          "expect": "1"
        }
      ]
    },
    {
      "name": "literal2-3.1.0",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 0XFF_FF",
          "expect": "65535"
        }
      ]
    },
    {
      "name": "literal2-3.1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 0XFF_EF",
          "expect": "65519"
        }
      ]
    },
    {
      "name": "literal2-3.1.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT 0XFF__EF",
          "expect": "1"
        }
      ]
    },
    {
      "name": "literal2-3.1.4",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT 0XFFEF_",
          "expect": "1"
        }
      ]
    }
  ]
