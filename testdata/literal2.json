{
  "file": "literal2.test",
  "name": "literal2",
  "tests": [
    {
      "name": "1.0",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 123_456",
          "expect": "123456"
        }
      ]
    },
    {
      "name": "1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 123__456"
        },
        {
          "type": "exec",
          "sql": "SELECT 123__456"
        },
        {
          "type": "exec",
          "sql": "SELECT 1.0e1_2"
        }
      ]
    },
    {
      "name": "3.0.0",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 0xFF_FF",
          "expect": "65535"
        }
      ]
    },
    {
      "name": "3.0.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 0xFF_EF",
          "expect": "65519"
        }
      ]
    },
    {
      "name": "3.0.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 0xFF__EF"
        },
        {
          "type": "exec",
          "sql": "SELECT 0xFF__EF"
        }
      ]
    },
    {
      "name": "3.0.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 0xFFEF_"
        },
        {
          "type": "exec",
          "sql": "SELECT 0xFFEF_"
        }
      ]
    },
    {
      "name": "3.1.0",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 0XFF_FF",
          "expect": "65535"
        }
      ]
    },
    {
      "name": "3.1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 0XFF_EF",
          "expect": "65519"
        }
      ]
    },
    {
      "name": "3.1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 0XFF__EF"
        },
        {
          "type": "exec",
          "sql": "SELECT 0XFF__EF"
        }
      ]
    },
    {
      "name": "3.1.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 0XFFEF_"
        },
        {
          "type": "exec",
          "sql": "SELECT 0XFFEF_"
        }
      ]
    }
  ]
