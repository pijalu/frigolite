{
  "file": "lock.test",
  "name": "lock",
  "tests": [
    {
      "name": "lock-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name"
        }
      ]
    },
    {
      "name": "lock-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name"
        }
      ]
    },
    {
      "name": "lock-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a int, b int)"
        }
      ]
    },
    {
      "name": "lock-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name",
          "expect": "0 t1"
        }
      ]
    },
    {
      "name": "lock-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(1,2)"
        }
      ]
    },
    {
      "name": "lock-1.7.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 {no such table: t1}"
        }
      ]
    },
    {
      "name": "lock-1.7.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "0 {1 2}"
        }
      ]
    },
    {
      "name": "lock-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "UPDATE t1 SET a=b, b=a"
        }
      ]
    },
    {
      "name": "lock-1.9",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "2 1"
        }
      ]
    },
    {
      "name": "lock-1.10",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN TRANSACTION"
        }
      ]
    },
    {
      "name": "lock-1.11",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "0 {2 1}"
        }
      ]
    },
    {
      "name": "lock-1.12",
      "steps": [
        {
          "type": "exec",
          "sql": "ROLLBACK"
        }
      ]
    },
    {
