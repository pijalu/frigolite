{
  "file": "lock.test",
  "name": "lock",
  "ordered": true,
  "tests": [
    {
      "name": "lock-1.0",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "./tempdir/../tempdir/t1/.//t2/../../..//test.db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name"
        }
      ]
    },
    {
      "name": "lock-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a int, b int)"
        },
        {
          "type": "exec",
          "sql": "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name",
          "expect": "t1"
        }
      ]
    },
    {
      "name": "lock-1.5",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name",
          "expect": "0 t1",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(1,2)"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "lock-1.7.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "0 {1 2}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "UPDATE t1 SET a=b, b=a",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "2 1",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-1.9",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "2 1"
        }
      ]
    },
    {
      "name": "lock-1.10",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN TRANSACTION"
        },
        {
          "type": "exec",
          "sql": "UPDATE t1 SET a = 0 WHERE 0"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "2 1"
        }
      ]
    },
    {
      "name": "lock-1.11",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "0 {2 1}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-1.12",
      "steps": [
        {
          "type": "exec",
          "sql": "ROLLBACK"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "0 {2 1}"
        }
      ]
    },
    {
      "name": "lock-1.13",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t2(x int, y int)"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t2 VALUES(8,9)"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t2",
          "expect": "8 9"
        }
      ]
    },
    {
      "name": "lock-1.14.1",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t2",
          "expect": "0 {8 9}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-1.14.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "0 {2 1}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-1.15",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t2",
          "expect": "0 {8 9}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-1.16",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "2 1"
        }
      ]
    },
    {
      "name": "lock-1.17",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "8 9"
        }
      ]
    },
    {
      "name": "lock-1.19",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "lock-1.20",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t2",
          "expect": "9 8"
        }
      ]
    },
    {
      "name": "lock-1.21",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "0 2"
        }
      ]
    },
    {
      "name": "lock-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN TRANSACTION"
        },
        {
          "type": "exec",
          "sql": "UPDATE t1 SET a = 0 WHERE 0"
        },
        {
          "type": "exec",
          "sql": "BEGIN TRANSACTION",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "UPDATE t1 SET a = 0 WHERE 0",
          "variable": "r",
          "catchResult": true,
          "catchMessage": "msg",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "ROLLBACK",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-2.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t2",
          "expect": "0 {9 8}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-2.3.1",
      "steps": [
        {
          "type": "catch",
          "sql": "UPDATE t1 SET a=b, b=a",
          "variable": "r",
          "catchResult": true,
          "catchMessage": "msg",
          "expect": "1 {database is locked} 0",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-2.3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN; SELECT rowid FROM sqlite_master LIMIT 1",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "UPDATE t1 SET a=b, b=a",
          "variable": "r",
          "catchResult": true,
          "catchMessage": "msg",
          "expect": "1 {database is locked} {}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "catch",
          "sql": "ROLLBACK",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-2.4.1",
      "steps": [
        {
          "type": "catch",
          "sql": "UPDATE t1 SET a=b, b=a",
          "variable": "r",
          "catchResult": true,
          "catchMessage": "msg",
          "expect": "1 {database is locked} {0 1 2 3 4 5}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-2.4.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN; SELECT rowid FROM sqlite_master LIMIT 1",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "UPDATE t1 SET a=b, b=a",
          "variable": "r",
          "catchResult": true,
          "catchMessage": "msg",
          "expect": "1 {database is locked} {}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "catch",
          "sql": "ROLLBACK",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-2.5",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "variable": "r",
          "catchResult": true,
          "catchMessage": "msg",
          "expect": "0 {2 1} {}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "exec",
          "sql": "ROLLBACK"
        }
      ]
    },
    {
      "name": "lock-2.8",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN"
        },
        {
          "type": "exec",
          "sql": "UPDATE t1 SET a = 0 WHERE 0"
        },
        {
          "type": "catch",
          "sql": "BEGIN EXCLUSIVE;",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-2.8b",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA busy_timeout",
          "expect": "400",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-2.9",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        }
      ]
    },
    {
      "name": "lock-2.9b",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA busy_timeout",
          "expect": "0",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-2.11",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA busy_timeout(400)",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "BEGIN"
        },
        {
          "type": "exec",
          "sql": "UPDATE t1 SET a = 0 WHERE 0"
        },
        {
          "type": "catch",
          "sql": "BEGIN EXCLUSIVE;",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-2.11b",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA busy_timeout",
          "expect": "400",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-2.12",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA busy_timeout(0)",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "COMMIT"
        }
      ]
    },
    {
      "name": "lock-2.12b",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA busy_timeout",
          "expect": "0",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN TRANSACTION"
        },
        {
          "type": "catch",
          "sql": "BEGIN TRANSACTION",
          "variable": "r",
          "catchResult": true,
          "catchMessage": "msg"
        },
        {
          "type": "exec",
          "sql": "ROLLBACK",
          "expect": "1 {cannot start a transaction within a transaction}"
        }
      ]
    },
    {
      "name": "lock-4.1",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "ROLLBACK"
        },
        {
          "type": "exec",
          "sql": "BEGIN"
        },
        {
          "type": "exec",
          "sql": "UPDATE t1 SET a=0 WHERE 0"
        },
        {
          "type": "open_named_db",
          "sql": "./test.db",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "UPDATE t1 SET a=0",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-4.2",
      "steps": [
        {
          "type": "catch",
          "sql": "UPDATE t1 SET a=0",
          "variable": "rc",
          "catchResult": true,
          "catchMessage": "msg",
          "expect": "1 {database is locked} {}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-4.3",
      "steps": [
        {
          "type": "catch",
          "sql": "UPDATE t1 SET a=0",
          "variable": "rc",
          "catchResult": true,
          "catchMessage": "msg",
          "expect": "1 {database is locked} {0 1 2 3 4 5}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "setup_3",
      "steps": [
        {
          "type": "exec",
          "sql": "ROLLBACK"
        }
      ]
    },
    {
      "name": "lock-5.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "2 1"
        }
      ]
    },
    {
      "name": "lock-5.2",
      "steps": [
        {
          "type": "register_function",
          "functionName": "tx_exec",
          "callbackVars": {
            "": "",
            "::callback_value": "",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "dummy": "",
            "msg": "$msg",
            "r": "$r $msg",
            "rc": "$rc $msg {}",
            "testdir": ""
          },
          "functionProc": "tx_exec",
          "functionArgs": [
            "sql"
          ],
          "functionBody": "\n  db2 eval $sql\n",
          "minArgs": 1,
          "maxArgs": -1
        },
        {
          "type": "catch",
          "sql": "INSERT INTO t1(a,b) SELECT 3, tx_exec('SELECT y FROM t2 LIMIT 1');",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "lock-5.3",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TEMP TABLE t3(x);\n      SELECT * FROM t3;"
        }
      ]
    },
    {
      "name": "lock-5.4",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t3 SELECT tx_exec('SELECT y FROM t2 LIMIT 1');",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "lock-5.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t3;",
          "expect": "8"
        }
      ]
    },
    {
      "name": "lock-5.6",
      "steps": [
        {
          "type": "catch",
          "sql": "UPDATE t1 SET a=tx_exec('SELECT x FROM t2');",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "lock-5.7",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1;",
          "expect": "9 1 9 8"
        }
      ]
    },
    {
      "name": "lock-5.8",
      "steps": [
        {
          "type": "catch",
          "sql": "UPDATE t3 SET x=tx_exec('SELECT x FROM t2');",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "lock-5.9",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t3;",
          "expect": "9"
        }
      ]
    },
    {
      "name": "lock-6.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t4(a PRIMARY KEY, b);\n    INSERT INTO t4 VALUES(1, 'one');\n    INSERT INTO t4 VALUES(2, 'two');\n    INSERT INTO t4 VALUES(3, 'three');"
        },
        {
          "type": "prepare_stmt",
          "sql": "SELECT * FROM sqlite_master",
          "variable": "stmt_1"
        },
        {
          "type": "stmt_step",
          "sql": "SELECT * FROM sqlite_master",
          "variable": "stmt_1"
        },
        {
          "type": "exec",
          "sql": "DELETE FROM t4"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM sqlite_master",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t4",
          "database": "db2"
        },
        {
          "type": "runtime_assert"
        }
      ]
    },
    {
      "name": "lock-6.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    INSERT INTO t4 VALUES(1, 'one');\n    INSERT INTO t4 VALUES(2, 'two');\n    INSERT INTO t4 VALUES(3, 'three');\n    COMMIT;"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t4",
          "expect": "1 one 2 two 3 three",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-6.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT a FROM t4 ORDER BY a",
          "expect": "1 2 3",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-6.4",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA integrity_check",
          "expect": "ok",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock-6.5",
      "steps": [
        {
          "type": "stmt_finalize",
          "sql": "SELECT * FROM sqlite_master",
          "variable": "stmt_1",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "lock-7.1",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "SELECT * FROM sqlite_master",
          "variable": "stmt_2"
        },
        {
          "type": "stmt_step",
          "sql": "SELECT * FROM sqlite_master",
          "variable": "stmt_2"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_2__",
          "expect": "SQLITE_ROW"
        }
      ]
    },
    {
      "name": "lock-7.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA lock_status",
          "expect": "main shared temp unknown"
        }
      ]
    },
    {
      "name": "lock-7.3",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = truncate;\n    BEGIN;\n    UPDATE t4 SET a = 10 WHERE 0;\n    COMMIT;"
        },
        {
          "type": "exec",
          "sql": "PRAGMA lock_status",
          "expect": "main shared temp unknown"
        }
      ]
    },
    {
      "name": "lock-7.4",
      "steps": [
        {
          "type": "stmt_finalize",
          "sql": "SELECT * FROM sqlite_master",
          "variable": "stmt_2",
          "expect": "SQLITE_OK"
        }
      ]
    }
  ]
}