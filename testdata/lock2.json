{
  "file": "lock2.test",
  "name": "lock2",
  "ordered": true,
  "tests": [
    {
      "name": "lock2-1.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "pragma lock_status",
          "expect": "main unlocked temp closed"
        }
      ]
    },
    {
      "name": "lock2-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    CREATE TABLE abc(a, b, c);"
        }
      ]
    },
    {
      "name": "lock2-1.5",
      "steps": [
        {
          "type": "catch",
          "sql": "COMMIT;",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "lock2-1.8",
      "steps": [
        {
          "type": "catch",
          "sql": "COMMIT;",
          "expect": "0 {}"
        }
      ]
    }
  ]
}