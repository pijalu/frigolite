{
  "file": "lock3.test",
  "name": "lock3",
  "tests": [
    {
      "name": "lock3-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a);\n    INSERT INTO t1 VALUES(1);"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a);\n    INSERT INTO t1 VALUES(1);"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1"
        }
      ]
    },
    {
      "name": "lock3-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN DEFERRED TRANSACTION",
          "expect": "1 2"
        },
        {
          "type": "exec",
          "sql": "BEGIN DEFERRED TRANSACTION"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(2)"
        },
        {
          "type": "exec",
          "sql": "END TRANSACTION"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1"
        }
      ]
    },
    {
      "name": "lock3-3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN IMMEDIATE TRANSACTION",
          "expect": "0 {1 2}"
        },
        {
          "type": "exec",
          "sql": "BEGIN IMMEDIATE TRANSACTION"
        }
      ]
    },
    {
      "name": "lock3-3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(3)",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "lock3-3.3",
      "steps": [
        {
          "type": "exec",
          "sql": "END TRANSACTION"
        },
        {
          "type": "exec",
          "sql": "END TRANSACTION"
        }
      ]
    },
    {
      "name": "lock3-4.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN EXCLUSIVE TRANSACTION",
          "expect": "1 {database is locked}"
        },
        {
          "type": "exec",
          "sql": "BEGIN EXCLUSIVE TRANSACTION"
        }
      ]
    },
    {
      "name": "lock3-4.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(3)",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "lock3-4.3",
      "steps": [
        {
          "type": "exec",
          "sql": "END TRANSACTION"
        },
        {
          "type": "exec",
          "sql": "END TRANSACTION"
        }
      ]
    }
  ]
}