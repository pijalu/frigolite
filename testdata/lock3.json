{
  "file": "lock3.test",
  "name": "lock3",
  "ordered": true,
  "tests": [
    {
      "name": "lock3-1.1",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "./tempdir/t1//t2/./t3//./../..//./../../tempdir/..//test.db//",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a);\n    INSERT INTO t1 VALUES(1);"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock3-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN DEFERRED TRANSACTION"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(2)",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "END TRANSACTION"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "lock3-3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN IMMEDIATE TRANSACTION"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "0 {1 2}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock3-3.2",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(3)",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock3-3.3",
      "steps": [
        {
          "type": "exec",
          "sql": "END TRANSACTION"
        }
      ]
    },
    {
      "name": "lock3-4.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN EXCLUSIVE TRANSACTION"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock3-4.2",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(3)",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock3-4.3",
      "steps": [
        {
          "type": "exec",
          "sql": "END TRANSACTION"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        }
      ]
    }
  ]
}