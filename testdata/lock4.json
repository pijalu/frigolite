{
  "file": "lock4.test",
  "name": "lock4",
  "ordered": true,
  "tests": [
    {
      "name": "lock4-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum=OFF;\n     CREATE TABLE t1(x);"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test2.db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test2.db-journal"
        }
      ]
    },
    {
      "name": "lock4-1.1",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test2.db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum=OFF;\n     CREATE TABLE t2(x)",
          "database": "db2"
        },
        {
          "type": "close_named_db",
          "expect": "2048 2048",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock4-1.2",
      "steps": [
        {
          "type": "write_file",
          "sql": "test2-script.tcl",
          "fileData": "sqlite3_test_control_pending_byte \n\n     sqlite3 db2 test2.db\n     db2 eval {\n        BEGIN;\n        INSERT INTO t2 VALUES(2);\n     }\n     sqlite3 db test.db\n     db timeout 1000000\n     db eval {\n        INSERT INTO t1 VALUES(2);\n     }\n     db close\n     db2 eval COMMIT\n     exit\n  \n"
        },
        {
          "type": "exec",
          "sql": "BEGIN EXCLUSIVE;\n     INSERT INTO t1 VALUES(1);"
        },
        {
          "type": "open_named_db",
          "sql": "test2.db",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "INSERT INTO t2 VALUES(1)",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock4-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT;"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t2",
          "expect": "2",
          "database": "db2"
        }
      ]
    }
  ]
}