{
  "file": "lock6.test",
  "name": "lock6",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "write_file",
          "sql": "tf_main2.tcl",
          "fileData": "\n  set l [open log w]\n  set script \"\"\n  while {![eof stdin]} {\n    flush stdout\n    set line [gets stdin]\n    puts $l \"READ $line\"\n    if { $line == \"OVER\" } {\n      catch {eval $script} result\n      puts $result\n      puts $l \"WRITE $result\"\n      puts OVER\n      puts $l \"WRITE OVER\"\n      flush stdout\n      set script \"\"\n    } else {\n      append script $line\n      append script \" ; \"\n    }\n  }\n  close $l\n\n"
        }
      ]
    },
    {
      "name": "lock6-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "pragma lock_status",
          "expect": "main unlocked temp closed"
        }
      ]
    },
    {
      "name": "lock6-1.3",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "catch",
          "sql": "select * from sqlite_master",
          "catchMessage": "msg"
        }
      ]
    },
    {
      "name": "lock6-1.4",
      "steps": [
        {
          "type": "query_assign",
          "sql": "PRAGMA lock_proxy_file=\":auto:\";\n      PRAGMA lock_proxy_file;",
          "variable": "lockpath",
          "resultAll": true,
          "resultRows": true
        },
        {
          "type": "runtime_var",
          "variable": "lockpath",
          "expect": "{:auto: (not held)}"
        }
      ]
    },
    {
      "name": "lock6-1.4.1",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA lock_proxy_file=\"notmine\";\n      select * from sqlite_master;",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "lock6-1.4.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA lock_proxy_file;",
          "expect": "notmine"
        }
      ]
    },
    {
      "name": "lock6-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA lock_proxy_file=\"mine\";\n      select * from sqlite_master;"
        }
      ]
    }
  ]
}