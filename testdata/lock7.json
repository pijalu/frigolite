{
  "file": "lock7.test",
  "name": "lock7",
  "ordered": true,
  "tests": [
    {
      "name": "lock7-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b)"
        },
        {
          "type": "close_db"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db1"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "BEGIN",
          "database": "db1"
        },
        {
          "type": "exec",
          "sql": "BEGIN",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock7-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA lock_status",
          "expect": "main unlocked temp closed",
          "database": "db1"
        }
      ]
    },
    {
      "name": "lock7-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA lock_status",
          "expect": "main unlocked temp closed",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock7-1.4",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(1, 1)",
          "expect": "0 {}",
          "database": "db1"
        }
      ]
    },
    {
      "name": "lock7-1.5",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(2, 2)",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock7-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA lock_status",
          "expect": "main reserved temp closed",
          "database": "db1"
        }
      ]
    },
    {
      "name": "lock7-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA lock_status",
          "expect": "main unlocked temp closed",
          "database": "db2"
        }
      ]
    },
    {
      "name": "lock7-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT",
          "database": "db1"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db1"
        },
        {
          "type": "close_named_db",
          "database": "db2"
        }
      ]
    }
  ]
}