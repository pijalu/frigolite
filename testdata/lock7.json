{
  "file": "lock7.test",
  "name": "lock7",
  "tests": [
    {
      "name": "lock7-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b)"
        }
      ]
    },
    {
      "name": "lock7-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA lock_status",
          "expect": "main unlocked temp closed"
        }
      ]
    },
    {
      "name": "lock7-1.3",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA lock_status",
          "expect": "main unlocked temp closed"
        }
      ]
    },
    {
      "name": "lock7-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(1, 1)",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "lock7-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(2, 2)",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "lock7-1.6",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA lock_status",
          "expect": "main reserved temp closed"
        }
      ]
    },
    {
      "name": "lock7-1.7",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA lock_status",
          "expect": "main unlocked temp closed"
        }
      ]
    },
    {
      "name": "lock7-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b)"
        },
        {
          "type": "exec",
          "sql": "PRAGMA lock_status"
        },
        {
          "type": "exec",
          "sql": "PRAGMA lock_status"
        },
        {
          "type": "exec",
          "sql": "PRAGMA lock_status"
        },
        {
          "type": "exec",
          "sql": "PRAGMA lock_status"
        },
        {
          "type": "exec",
          "sql": "COMMIT"
        }
      ]
    }
  ]
}