{
  "file": "memdb2.test",
  "name": "memdb2",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "open_named_db",
          "sql": "file:/test.db?vfs=memdb",
          "database": "db2"
        }
      ]
    },
    {
      "name": "memdb2-1.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x, y);\n    INSERT INTO t1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "memdb2-1.1.2",
      "steps": [
        {
          "type": "query",
          "sql": "BEGIN;\n      SELECT * FROM t1;",
          "expect": "1 2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "memdb2-1.1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n      INSERT INTO t1 VALUES(3, 4);"
        }
      ]
    },
    {
      "name": "memdb2-1.1.4",
      "steps": [
        {
          "type": "catch",
          "sql": "COMMIT",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "memdb2-1.1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1;\n    END;",
          "expect": "1 2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "memdb2-1.1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        }
      ]
    },
    {
      "name": "memdb2-1.1.7",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4",
          "database": "db2"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "reopen_db",
          "sql": "\\\\test.db"
        },
        {
          "type": "open_named_db",
          "sql": "file:\\\\test.db?vfs=memdb",
          "database": "db2"
        }
      ]
    },
    {
      "name": "memdb2-1.2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x, y);\n    INSERT INTO t1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "memdb2-1.2.2",
      "steps": [
        {
          "type": "query",
          "sql": "BEGIN;\n      SELECT * FROM t1;",
          "expect": "1 2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "memdb2-1.2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n      INSERT INTO t1 VALUES(3, 4);"
        }
      ]
    },
    {
      "name": "memdb2-1.2.4",
      "steps": [
        {
          "type": "catch",
          "sql": "COMMIT",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "memdb2-1.2.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1;\n    END;",
          "expect": "1 2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "memdb2-1.2.6",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        }
      ]
    },
    {
      "name": "memdb2-1.2.7",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4",
          "database": "db2"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "close_named_db",
          "database": "db2"
        }
      ]
    }
  ]
}