{
  "file": "misuse.test",
  "name": "misuse",
  "ordered": true,
  "tests": [
    {
      "name": "misuse-1.1",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test2.db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test2.db-journal"
        }
      ]
    },
    {
      "name": "misuse-1.1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test2.db"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b);\n    INSERT INTO t1 VALUES(1,2);"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "variable": "r",
          "catchResult": true,
          "catchMessage": "msg",
          "expect": "0 {a b 1 2}"
        }
      ]
    },
    {
      "name": "misuse-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT x_coalesce(NULL,a) AS 'xyz' FROM t1",
          "variable": "r",
          "catchResult": true,
          "catchMessage": "msg",
          "expect": "1 {no such function: x_coalesce}"
        }
      ]
    },
    {
      "name": "misuse-1.3",
      "steps": [
        {
          "type": "register_test_funcs"
        },
        {
          "type": "query",
          "sql": "SELECT x_coalesce(NULL,a) AS 'xyz' FROM t1",
          "variable": "r",
          "catchResult": true,
          "catchMessage": "msg",
          "expect": "0 {xyz 1}"
        }
      ]
    },
    {
      "name": "misuse-1.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "variable": "r",
          "catchResult": true,
          "catchMessage": "msg",
          "expect": "0 {a b 1 2}"
        }
      ]
    },
    {
      "name": "misuse-1.6",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "0 {1 2}"
        }
      ]
    },
