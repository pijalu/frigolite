{
  "file": "mmapcorrupt.test",
  "name": "mmapcorrupt",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "mmapcorrupt-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA page_size = 16384;\n  CREATE TABLE tn1(a PRIMARY KEY) WITHOUT ROWID;\n  CREATE TABLE t0(a PRIMARY KEY) WITHOUT ROWID;\n  CREATE TABLE t1(a PRIMARY KEY) WITHOUT ROWID;\n  INSERT INTO t1 VALUES('B');"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "hexio_write",
          "sql": "test.db",
          "fileData": "800380",
          "fileTarget": "test.db",
          "fileOffset": -3
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "mmapcorrupt-2.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA mmap_size = 1000000;\n  SELECT sql FROM sqlite_schema LIMIT 1;\n  SELECT * FROM t0;",
          "expect": "1000000 {CREATE TABLE tn1(a PRIMARY KEY) WITHOUT ROWID}"
        }
      ]
    },
    {
      "name": "mmapcorrupt-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t0 SELECT * FROM t1;"
        }
      ]
    }
  ]
}