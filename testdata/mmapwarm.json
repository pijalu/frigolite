{
  "file": "mmapwarm.test",
  "name": "mmapwarm",
  "ordered": true,
  "tests": [
    {
      "name": "mmapwarm-1.0",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA auto_vacuum = 0;\n  CREATE TABLE t1(x, y);\n  WITH s(i) AS (\n    SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i\u003c500\n  )\n  INSERT INTO t1 SELECT randomblob(400), randomblob(500) FROM s;\n  PRAGMA page_count;",
          "expect": "507"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "mmapwarm-1.1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA mmap_size = 1000000",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "mmapwarm-1.2",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA mmap_size = 1000000",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "mmapwarm-1.3",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "mmapwarm-1.4",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "mmapwarm-2.0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "BEGIN",
          "expect": "SQLITE_MISUSE"
        }
      ]
    }
  ]
}