{
  "file": "nockpt.test",
  "name": "nockpt",
  "ordered": true,
  "tests": [
    {
      "name": "nockpt-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum=OFF;\n  PRAGMA page_size = 1024;\n  PRAGMA journal_mode = wal;\n  CREATE TABLE c1(x, y, z);\n  INSERT INTO c1 VALUES(1, 2, 3);",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "nockpt-1.3",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "nockpt-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO c1 VALUES(4, 5, 6);\n  INSERT INTO c1 VALUES(7, 8, 9);"
        }
      ]
    },
    {
      "name": "nockpt-1.9",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "nockpt-1.12",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM c1",
          "expect": "1 2 3 4 5 6 7 8 9"
        }
      ]
    },
    {
      "name": "nockpt-1.13",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA main.journal_mode",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "nockpt-1.14",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA main.journal_mode = delete",
          "expect": "delete"
        }
      ]
    }
  ]
}