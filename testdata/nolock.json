{
  "file": "nolock.test",
  "name": "nolock",
  "ordered": true,
  "tests": [
    {
      "name": "nolock-1.0",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "nolock-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b,c); INSERT INTO t1 VALUES(1,2,3);",
          "expect": "xLock 7 xUnlock 5 xCheckReservedLock 0"
        }
      ]
    },
    {
      "name": "nolock-1.1",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "nolock-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b,c); INSERT INTO t1 VALUES(1,2,3);",
          "expect": "xLock 7 xUnlock 5 xCheckReservedLock 0"
        }
      ]
    },
    {
      "name": "nolock-1.2",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "nolock-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b,c); INSERT INTO t1 VALUES(1,2,3);",
          "expect": "xLock 0 xUnlock 0 xCheckReservedLock 0"
        }
      ]
    },
    {
      "name": "nolock-1.3",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "xLock 2 xUnlock 2 xCheckReservedLock 0"
        }
      ]
    },
    {
      "name": "nolock-1.4",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "xLock 0 xUnlock 0 xCheckReservedLock 0"
        }
      ]
    },
    {
      "name": "nolock-2.0",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "nolock-2.0",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b);\n     INSERT INTO t1 VALUES('hello','world');\n     CREATE TABLE t2(x,y);\n     INSERT INTO t2 VALUES(12345,67890);\n     SELECT * FROM t1, t2;",
          "expect": "hello world 12345 67890"
        }
      ]
    },
    {
      "name": "nolock-2.1",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1, t2",
          "expect": "hello world 12345 67890",
          "database": "db2"
        }
      ]
    },
    {
      "name": "nolock-2.11",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "open_named_db",
          "sql": "file:test.db?immutable=0",
          "database": "db2"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1, t2",
          "expect": "hello world 12345 67890",
          "database": "db2"
        }
      ]
    },
    {
      "name": "nolock-2.21",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "open_named_db",
          "sql": "file:test.db?immutable=1",
          "database": "db2"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1, t2",
          "expect": "hello world 12345 67890",
          "database": "db2"
        }
      ]
    },
    {
      "name": "nolock-2.31",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "open_named_db",
          "sql": "file:test.db?immutable=1",
          "database": "db2"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1, t2",
          "expect": "hello world 12345 67890",
          "database": "db2"
        }
      ]
    },
    {
      "name": "nolock-3.1",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1, t2",
          "expect": "hello world 12345 67890",
          "database": "db2"
        }
      ]
    },
    {
      "name": "nolock-3.11",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1, t2",
          "expect": "hello world 12345 67890",
          "database": "db2"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "nolock-4.1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode=WAL;\n       CREATE TABLE t1(x);\n       INSERT INTO t1 VALUES('youngling');\n       SELECT * FROM t1;",
          "expect": "delete youngling"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "nolock-4.2",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode=WAL;\n      CREATE TABLE t1(x);\n      INSERT INTO t1 VALUES('catbird');\n      SELECT * FROM t1;",
          "expect": "wal catbird"
        }
      ]
    },
    {
      "name": "nolock-4.3",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "variable": "rc",
          "catchResult": true,
          "catchMessage": "msg",
          "expect": "1 {unable to open database file}"
        }
      ]
    }
  ]
}