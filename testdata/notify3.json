    {
      "name": "setup_1",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "notify3-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b); \n    INSERT INTO t1 VALUES('t1 A', 't1 B');"
        }
      ]
    },
    {
      "name": "notify3-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t2(a, b);\n    INSERT INTO t2 VALUES('t2 A', 't2 B');",
          "database": "db2"
        }
      ]
    },
    {
      "name": "notify3-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN EXCLUSIVE;\n    INSERT INTO t2 VALUES('t2 C', 't2 D');",
          "database": "db2"
        }
      ]
    },
    {
      "name": "notify3-1.4",
      "steps": [
        {
          "type": "catch",
          "sql": "ATTACH 'test.db2' AS aux",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "notify3-1.5",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t2",
          "expect": "1 {database schema is locked: aux}"
        }
      ]
    },
    {
      "name": "notify3-1.7",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "SELECT * FROM t2",
          "variable": "stmt_1",
          "catchMessage": "msg"
        },
        {
          "type": "runtime_var",
          "variable": "msg",
          "expect": "(262) database schema is locked: aux"
        }
      ]
    },
    {
      "name": "notify3-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT",
          "database": "db2"
        },
        {
          "type": "runtime_var",
          "variable": "res",
          "expect": "2"
        }
      ]
    },
    {
      "name": "notify3-1.9",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t2",
          "expect": "0 {{t2 A} {t2 B} {t2 C} {t2 D}}"
        }
      ]
    },
