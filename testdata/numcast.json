{
  "file": "numcast.test",
  "name": "numcast",
  "ordered": true,
  "tests": [
    {
      "name": "numcast-utf8.0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "open_empty_db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA encoding='utf8'"
        },
        {
          "type": "query_assign",
          "sql": "PRAGMA encoding",
          "variable": "x",
          "resultAll": true,
          "expect": "utf8"
        }
      ]
    },
    {
      "name": "numcast-utf8.1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT CAST(12345.0 AS real)",
          "expect": "12345.0"
        }
      ]
    },
    {
      "name": "numcast-utf8.1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT CAST(12345.0 AS integer)",
          "expect": "12345"
        }
      ]
    },
    {
      "name": "numcast-utf8.2.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT CAST(12345.0e0 AS real)",
          "expect": "12345.0"
        }
      ]
    },
    {
      "name": "numcast-utf8.2.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT CAST(12345.0e0 AS integer)",
          "expect": "12345"
        }
      ]
    },
    {
      "name": "numcast-utf8.3.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT CAST(-12345.0e0 AS real)",
          "expect": "-12345.0"
        }
      ]
    },
    {
      "name": "numcast-utf8.3.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT CAST(-12345.0e0 AS integer)",
          "expect": "-12345"
        }
      ]
    },
    {
      "name": "numcast-utf8.4.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT CAST(-12345.25 AS real)",
          "expect": "-12345.25"
        }
      ]
    },
    {
      "name": "numcast-utf8.4.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT CAST(-12345.25 AS integer)",
          "expect": "-12345"
        }
      ]
    },
