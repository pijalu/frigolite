{
  "file": "pagesize.test",
  "name": "pagesize",
  "ordered": true,
  "tests": [
    {
      "name": "pagesize-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA page_size",
          "expect": "1024"
        }
      ]
    },
    {
      "name": "pagesize-1.2",
      "steps": [
        {
          "type": "catch",
          "sql": "EXPLAIN PRAGMA page_size",
          "expect": "0"
        }
      ]
    },
    {
      "name": "pagesize-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a);\n    PRAGMA page_size=2048;\n    PRAGMA page_size;",
          "expect": "1024"
        }
      ]
    },
    {
      "name": "pagesize-1.4",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "pagesize-1.4",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA page_size=511;\n    PRAGMA page_size;",
          "expect": "1024"
        }
      ]
    },
    {
      "name": "pagesize-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA page_size=512;\n    PRAGMA page_size;",
          "expect": "512"
        }
      ]
    },
    {
      "name": "pagesize-2.512.0.1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "open_empty_db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA page_size=512;"
        },
        {
          "type": "exec",
          "sql": "PRAGMA page_size",
          "expect": "512"
        }
      ]
    },
    {
      "name": "pagesize-2.512.0.2",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x UNIQUE, y UNIQUE, z UNIQUE)"
        },
        {
          "type": "exec",
          "sql": "PRAGMA page_size",
          "expect": "512"
        }
      ]
    },
    {
      "name": "pagesize-2.512.0.3",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(1,2,3);\n        INSERT INTO t1 VALUES(2,3,4);\n        SELECT * FROM t1;",
          "expect": "1 2 3 2 3 4"
        }
      ]
    },
    {
      "name": "pagesize-2.512.1",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "pagesize-2.512.1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA page_size=512"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n      PRAGMA page_size;",
          "expect": "512"
        }
      ]
    },
    {
      "name": "pagesize-2.512.2",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA page_size",
          "expect": "512"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "pagesize-3.1",
      "steps": [
        {
          "type": "query",
          "sql": "BEGIN;\n  SELECT * FROM sqlite_master;\n  PRAGMA page_size=2048;\n  PRAGMA main.page_size;",
          "expect": "1024"
        }
      ]
    },
    {
      "name": "pagesize-3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n  COMMIT;"
        }
      ]
    },
    {
      "name": "pagesize-3.3",
      "steps": [
        {
          "type": "query",
          "sql": "BEGIN;\n    PRAGMA page_size = 2048;\n  COMMIT;\n  PRAGMA main.page_size;",
          "expect": "1024"
        }
      ]
    }
  ]
}