{
  "file": "pagesize.test",
  "name": "pagesize",
  "ordered": true,
  "tests": [
    {
      "name": "pagesize-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA page_size",
          "expect": "1024"
        }
      ]
    },
    {
      "name": "pagesize-1.2",
      "steps": [
        {
          "type": "catch",
          "sql": "EXPLAIN PRAGMA page_size",
          "expect": "0"
        }
      ]
    },
