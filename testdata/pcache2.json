{
  "file": "pcache2.test",
  "name": "pcache2",
  "ordered": true,
  "tests": [
    {
      "name": "pcache2-1.1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "runtime_assert",
          "expect": "0 0 0"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db-journal"
        }
      ]
    },
    {
      "name": "pcache2-1.2",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA cache_size=10; SELECT 1 FROM sqlite_master;",
          "expect": "2"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test2.db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test2.db-journal"
        }
      ]
    },
    {
      "name": "pcache2-1.3",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test2.db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "PRAGMA cache_size=50; SELECT 1 FROM sqlite_master;",
          "expect": "4",
          "database": "db2"
        }
      ]
    },
    {
      "name": "pcache2-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b);\n     CREATE TABLE t2(x,y);\n     INSERT INTO t1 VALUES(1, zeroblob(800));\n     INSERT INTO t1 VALUES(2, zeroblob(800));\n     INSERT INTO t2 SELECT * FROM t1;\n     INSERT INTO t1 SELECT x+2, y FROM t2;\n     INSERT INTO t2 SELECT a+10, b FROM t1;\n     INSERT INTO t1 SELECT x+10, y FROM t2;\n     INSERT INTO t2 SELECT a+100, b FROM t1;\n     INSERT INTO t1 SELECT x+100, y FROM t2;\n     INSERT INTO t2 SELECT a+1000, b FROM t1;\n     INSERT INTO t1 SELECT x+1000, y FROM t2;",
          "expect": "0 13 13"
        }
      ]
    },
    {
      "name": "pcache2-2.1",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "close_db"
        },
        {
          "type": "runtime_assert",
          "sql": "$__catch_result",
          "expect": "0"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "pcache2-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA page_size = 4096;\n  CREATE TABLE t1(x);"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "close_named_db",
          "database": "db2"
        }
      ]
    }
  ]
}