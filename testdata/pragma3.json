{
  "file": "pragma3.test",
  "name": "pragma3",
  "ordered": true,
  "tests": [
    {
      "name": "pragma3-100",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA data_version;",
          "expect": "1"
        }
      ]
    },
    {
      "name": "pragma3-101",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA temp.data_version;",
          "expect": "1"
        }
      ]
    },
    {
      "name": "pragma3-102",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA main.data_version=1234;\n  PRAGMA main.data_version;",
          "expect": "1 1"
        }
      ]
    },
    {
      "name": "pragma3-110",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA data_version;\n  BEGIN IMMEDIATE;\n  PRAGMA data_version;\n  CREATE TABLE t1(a);\n  INSERT INTO t1 VALUES(100),(200),(300);\n  PRAGMA data_version;\n  COMMIT;\n  SELECT * FROM t1;\n  PRAGMA data_version;",
          "expect": "1 1 1 100 200 300 1"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "pragma3-120",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1;\n    PRAGMA data_version;",
          "expect": "100 200 300 1",
          "database": "db2"
        }
      ]
    },
    {
      "name": "pragma3-130",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA data_version;\n  BEGIN IMMEDIATE;\n  PRAGMA data_version;\n  INSERT INTO t1 VALUES(400),(500);\n  PRAGMA data_version;\n  COMMIT;\n  SELECT * FROM t1;\n  PRAGMA data_version;\n  PRAGMA shrink_memory;",
          "expect": "1 1 1 100 200 300 400 500 1"
        }
      ]
    },
    {
      "name": "pragma3-140",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1;\n    PRAGMA data_version;\n    BEGIN IMMEDIATE;\n    PRAGMA data_version;\n    UPDATE t1 SET a=a+1;\n    COMMIT;\n    SELECT * FROM t1;\n    PRAGMA data_version;",
          "expect": "100 200 300 400 500 2 2 101 201 301 401 501 2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "pragma3-150",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1;\n  PRAGMA data_version;",
          "expect": "101 201 301 401 501 2"
        }
      ]
    },
    {
