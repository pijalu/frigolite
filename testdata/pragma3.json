      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA data_version;\n      BEGIN;\n      INSERT INTO t3(a,b,c) VALUES('abc','def','ghi');\n      SELECT * FROM t3;\n      PRAGMA data_version;",
          "expect": "2 abc def ghi 2",
          "database": "db2"
        }
      ]
    },
