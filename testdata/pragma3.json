      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    PRAGMA data_version;\n    UPDATE t1 SET a=555 WHERE a=501;\n    PRAGMA data_version;\n    SELECT * FROM t1 ORDER BY a;\n    PRAGMA data_version;",
          "expect": "2 2 101 201 301 401 555 2"
        }
      ]
    },
