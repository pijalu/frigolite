{
  "file": "pragma4.test",
  "name": "pragma4",
  "tests": [
    {
      "name": "4.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b, c);\n  ATTACH 'test.db2' AS aux;\n  CREATE TABLE aux.t2(d, e, f);"
        }
      ]
    },
    {
      "name": "4.1.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA table_info = t1",
          "expect": "0 a {} 0 {} 0 1 b {} 0 {} 0 2 c {} 0 {} 0"
        }
      ]
    },
    {
      "name": "4.1.3",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA table_info = t2",
          "expect": "0 d {} 0 {} 0 1 e {} 0 {} 0 2 f {} 0 {} 0"
        }
      ]
    },
    {
      "name": "4.1.5a",
      "steps": [
