{
  "file": "pragma5.test",
  "name": "pragma5",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT count(*) FROM pragma_function_list"
        },
        {
          "type": "register_function",
          "functionName": "external",
          "callbackVars": {
            "": "$__catch_result",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "testdir": "",
            "testprefix": "pragma5"
          },
          "functionProc": "external",
          "minArgs": -1,
          "maxArgs": -1
        }
      ]
    },
    {
      "name": "pragma5-1.0",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA table_info(pragma_function_list)",
          "expect": "\n  0 name {} 0 {} 0 \n  1 builtin {} 0 {} 0\n  2 type {} 0 {} 0\n  3 enc {} 0 {} 0\n  4 narg {} 0 {} 0\n  5 flags {} 0 {} 0\n"
        }
      ]
    },
    {
      "name": "pragma5-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT DISTINCT name, builtin\n    FROM pragma_function_list WHERE name='upper' AND builtin",
          "expect": "upper 1"
        }
      ]
    },
    {
      "name": "pragma5-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT DISTINCT name, builtin\n    FROM pragma_function_list WHERE name LIKE 'exter%';",
          "expect": "external 0"
        }
      ]
    },
    {
      "name": "pragma5-2.0",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA table_info(pragma_module_list)",
          "expect": "\n    0 name {} 0 {} 0 \n  "
        }
      ]
    },
    {
      "name": "pragma5-2.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM pragma_module_list WHERE name='fts5'",
          "expect": "fts5"
        }
      ]
    },
    {
      "name": "pragma5-3.0",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA table_info(pragma_pragma_list)",
          "expect": "\n  0 name {} 0 {} 0 \n"
        }
      ]
    },
    {
      "name": "pragma5-3.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM pragma_pragma_list WHERE name='pragma_list'",
          "expect": "pragma_list"
        }
      ]
    }
  ]
}