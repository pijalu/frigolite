{
  "file": "pragma6.test",
  "name": "pragma6",
  "ordered": true,
  "tests": [
    {
      "name": "pragma6-1.0",
      "steps": [
        {
          "type": "open_empty_db"
        }
      ]
    },
    {
      "name": "pragma6-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TEMP TABLE t2(\n        a t1 PRIMARY KEY default 27,\n        b default(current_timestamp),\n        d TEXT UNIQUE DEFAULT 'ch`arlie',\n        c TEXT UNIQUE DEFAULT 084,\n        UNIQUE(c,b,b,a,b)\n    ) WITHOUT ROWID;"
        },
        {
          "type": "catch",
          "sql": "INSERT INTO t1(a) VALUES(zeroblob(40000))"
        }
      ]
    },
    {
      "name": "pragma6-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA integrity_check;"
        },
        {
          "type": "exec",
          "sql": "PRAGMA quick_check;"
        }
      ]
    }
  ]
}