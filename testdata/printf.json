{
  "file": "printf.test",
  "name": "printf",
  "ordered": true,
  "tests": [
    {
      "name": "printf-16.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT printf('%.*g',2147483647,0.01);",
          "expect": "0.01"
        }
      ]
    },
    {
