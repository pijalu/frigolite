        }
      ]
    },
    {
      "name": "printf2-1.13",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT printf('%c','abcdefghijklmnop');",
          "expect": "a"
        }
      ]
    },
    {
      "name": "printf2-2.1",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t1(a,b,c);\n  INSERT INTO t1 VALUES(1,2,3);\n  INSERT INTO t1 VALUES(-1,-2,-3);\n  INSERT INTO t1 VALUES('abc','def','ghi');\n  INSERT INTO t1 VALUES(1.5,2.25,3.125);\n  SELECT printf('(%s)-%n-(%s)',a,b,c) FROM t1 ORDER BY rowid;",
          "expect": "(1)--(2) (-1)--(-2) (abc)--(def) (1.5)--(2.25)"
        }
      ]
    },
    {
      "name": "printf2-2.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT printf('%s=(%p)',a,a) FROM t1 ORDER BY a;",
          "expect": "-1=(FFFFFFFFFFFFFFFF) 1=(1) 1.5=(1) abc=(0)"
        }
      ]
    },
    {
      "name": "printf2-2.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT printf('%s=(%d/%g/%s)',a) FROM t1 ORDER BY a;",
          "expect": "-1=(0/0/) 1=(0/0/) 1.5=(0/0/) abc=(0/0/)"
        }
      ]
    },
