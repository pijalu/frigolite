{
  "file": "progress.test",
  "name": "progress",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n  CREATE TABLE t1(a);\n  INSERT INTO t1 VALUES(1);\n  INSERT INTO t1 VALUES(2);\n  INSERT INTO t1 VALUES(3);\n  INSERT INTO t1 VALUES(4);\n  INSERT INTO t1 VALUES(5);\n  INSERT INTO t1 VALUES(6);\n  INSERT INTO t1 VALUES(7);\n  INSERT INTO t1 VALUES(8);\n  INSERT INTO t1 VALUES(9);\n  INSERT INTO t1 VALUES(10);\n  COMMIT;"
        }
      ]
    },
    {
      "name": "progress-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1"
        }
      ]
    },
    {
      "name": "progress-1.1",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "variable": "rc",
          "catchResult": true
        }
      ]
    },
    {
      "name": "progress-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 SELECT a+10 FROM t1 WHERE a \u003c 6"
        },
        {
          "type": "exec",
          "sql": "DELETE FROM t1 WHERE a \u003e 10"
        },
        {
          "type": "catch",
          "sql": "INSERT INTO t1 SELECT a+10 FROM t1 WHERE a \u003c 9"
        },
        {
          "type": "exec",
          "sql": "SELECT count(*) FROM t1",
          "expect": "10"
        }
      ]
    },
    {
      "name": "progress-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(11)"
        },
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(12)"
        },
        {
          "type": "catch",
          "sql": "COMMIT",
          "expect": "1 {cannot commit - no transaction is active}"
        }
      ]
    },
    {
      "name": "progress-1.3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT count(*) FROM t1",
          "expect": "10"
        }
      ]
    },
    {
      "name": "progress-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1;",
          "expect": "0"
        }
      ]
    },
    {
      "name": "progress-1.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT sum(a) FROM t1",
          "expect": "55"
        }
      ]
    },
    {
      "name": "progress-1.6",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "rx",
          "expect": "10"
        }
      ]
    },
    {
      "name": "progress-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE abc(a, b, c);\n    INSERT INTO abc VALUES(1, 2, 3);\n    INSERT INTO abc VALUES(4, 5, 6);\n    INSERT INTO abc VALUES(7, 8, 9);"
        },
        {
          "type": "query",
          "sql": "SELECT a, b, c FROM abc"
        },
        {
          "type": "runtime_var",
          "variable": "res",
          "expect": "1 2 3 interrupted 4 5 6 interrupted 7 8 9 interrupted"
        }
      ]
    }
  ]
}