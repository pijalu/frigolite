          "type": "register_test_funcs"
        }
      ]
    },
    {
      "name": "ptrchng-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x INTEGER PRIMARY KEY, y BLOB);\n    INSERT INTO t1 VALUES(1, 'abc');\n    INSERT INTO t1 VALUES(2, \n       'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ01234356789');\n    INSERT INTO t1 VALUES(3, x'626c6f62');\n    INSERT INTO t1 VALUES(4,\n x'000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f2021222324'\n    );\n    SELECT count(*) FROM t1;",
          "expect": "4"
        }
      ]
    },
    {
      "name": "ptrchng-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT pointer_change(y, 'text', 'noop', 'blob') FROM t1 WHERE x=1",
          "expect": "0"
        }
      ]
    },
    {
      "name": "ptrchng-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT pointer_change(y, 'blob', 'noop', 'text') FROM t1 WHERE x=1",
