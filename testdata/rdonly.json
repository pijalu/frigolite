{
  "file": "rdonly.test",
  "name": "rdonly",
  "ordered": true,
  "tests": [
    {
      "name": "rdonly-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n    INSERT INTO t1 VALUES(1);\n    SELECT * FROM t1;",
          "expect": "1"
        }
      ]
    },
    {
      "name": "rdonly-1.2",
      "steps": [
        {
          "type": "close_db",
          "expect": "1"
        }
      ]
    },
    {
      "name": "rdonly-1.3",
      "steps": [
        {
          "type": "hexio_write",
          "sql": "test.db",
          "fileData": "03",
          "fileTarget": "test.db",
          "fileOffset": 18
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1;",
          "expect": "1"
        }
      ]
    },
    {
      "name": "rdonly-1.4",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(2)",
          "expect": "1 {attempt to write a readonly database}"
        }
      ]
    },
    {
      "name": "rdonly-1.5",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "hexio_write",
          "sql": "test.db",
          "fileData": "01",
          "fileTarget": "test.db",
          "fileOffset": 18
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(2);\n    SELECT * FROM t1;",
          "expect": "0 {1 2}"
        }
      ]
    },
    {
      "name": "rdonly-1.6",
      "steps": [
        {
          "type": "hexio_write",
          "sql": "test.db",
          "fileData": "03",
          "fileTarget": "test.db",
          "fileOffset": 18
        },
        {
          "type": "hexio_write",
          "sql": "test.db",
          "fileData": "11223344",
          "fileTarget": "test.db",
          "fileOffset": 24
        },
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(2);",
          "expect": "1 {attempt to write a readonly database}"
        }
      ]
    }
  ]
}