{
  "file": "rdonly.test",
  "name": "rdonly",
  "tests": [
    {
      "name": "rdonly-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t1(x);\n    INSERT INTO t1 VALUES(1);\n    SELECT * FROM t1;",
          "expect": "1"
        }
      ]
    },
    {
      "name": "rdonly-1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1;",
          "expect": "1"
        }
      ]
    },
    {
      "name": "rdonly-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(2)",
          "expect": "1 {attempt to write a readonly database}"
        }
      ]
    },
    {
      "name": "rdonly-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(2);\n    SELECT * FROM t1;",
          "expect": "0 {1 2}"
        }
      ]
    },
    {
      "name": "rdonly-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(2);",
          "expect": "1 {attempt to write a readonly database}"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n    INSERT INTO t1 VALUES(1);\n    SELECT * FROM t1;"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1;"
        }
      ]
    }
  ],
  "source": "capi"
}