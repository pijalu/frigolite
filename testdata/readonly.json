{
  "file": "readonly.test",
  "name": "readonly",
  "tests": [
    {
      "name": "1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n  INSERT INTO t1 VALUES(1, 2), (3, 4), (5, 6);"
        }
      ]
    },
    {
      "name": "1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(7, 8);",
          "expect": "1 {attempt to write a readonly database}"
        }
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    SELECT * FROM t1;",
          "expect": "1 2 3 4 5 6"
        }
      ]
    }
  ]
}