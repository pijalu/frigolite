{
  "file": "reindex.test",
  "name": "reindex",
  "ordered": true,
  "tests": [
    {
      "name": "reindex-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b);\n    INSERT INTO t1 VALUES(1,2);\n    INSERT INTO t1 VALUES(3,4);\n    CREATE INDEX i1 ON t1(a);\n    REINDEX;"
        }
      ]
    },
    {
      "name": "reindex-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "REINDEX t1;"
        }
      ]
    },
    {
      "name": "reindex-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "REINDEX i1;"
        }
      ]
    },
    {
      "name": "reindex-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "REINDEX main.t1;"
        }
      ]
    },
    {
      "name": "reindex-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "REINDEX main.i1;"
        }
      ]
    },
    {
      "name": "reindex-1.9",
      "steps": [
        {
          "type": "catch",
          "sql": "REINDEX bogus",
          "expect": "1 {unable to identify the object to be reindexed}"
        }
      ]
    },
    {
      "name": "reindex-2.1",
      "steps": [
        {
          "type": "register_collation",
          "collationName": "c1",
          "collationProc": "c1",
          "collationBody": "\n    return [expr {-[string compare $a $b]}]\n  ",
          "callbackVars": {
            "": "reindex",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "testdir": "",
            "testprefix": "reindex"
          },
          "functionArgs": [
            "a",
            "b"
          ]
        },
        {
          "type": "register_collation",
          "collationName": "c2",
          "collationProc": "c2",
          "collationBody": "\n    return [expr {-[string compare [string tolower $a] [string tolower $b]]}]\n  ",
          "callbackVars": {
            "": "reindex",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "testdir": "",
            "testprefix": "reindex"
          },
          "functionArgs": [
            "a",
            "b"
          ]
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t2(\n      a TEXT PRIMARY KEY COLLATE c1,\n      b TEXT UNIQUE COLLATE c2,\n      c TEXT COLLATE nocase,\n      d TEST COLLATE binary\n    );\n    INSERT INTO t2 VALUES('abc','abc','abc','abc');\n    INSERT INTO t2 VALUES('ABCD','ABCD','ABCD','ABCD');\n    INSERT INTO t2 VALUES('bcd','bcd','bcd','bcd');\n    INSERT INTO t2 VALUES('BCDE','BCDE','BCDE','BCDE');\n    SELECT a FROM t2 ORDER BY a;",
          "expect": "bcd abc BCDE ABCD"
        }
      ]
    },
    {
      "name": "reindex-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT b FROM t2 ORDER BY b;",
          "expect": "BCDE bcd ABCD abc"
        }
      ]
    },
    {
      "name": "reindex-2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT c FROM t2 ORDER BY c;",
          "expect": "abc ABCD bcd BCDE"
        }
      ]
    },
    {
      "name": "reindex-2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT d FROM t2 ORDER BY d;",
          "expect": "ABCD BCDE abc bcd"
        }
      ]
    },
    {
      "name": "reindex-2.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT a FROM t2 ORDER BY a;",
          "expect": "bcd abc BCDE ABCD"
        }
      ]
    },
    {
      "name": "reindex-2.5.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA integrity_check",
          "expect": "0"
        }
      ]
    },
    {
      "name": "reindex-2.6",
      "steps": [
        {
          "type": "exec",
          "sql": "REINDEX c2;\n    SELECT a FROM t2 ORDER BY a;",
          "expect": "bcd abc BCDE ABCD"
        }
      ]
    },
    {
      "name": "reindex-2.7",
      "steps": [
        {
          "type": "exec",
          "sql": "REINDEX t1;\n    SELECT a FROM t2 ORDER BY a;",
          "expect": "bcd abc BCDE ABCD"
        }
      ]
    },
    {
      "name": "reindex-2.8",
      "steps": [
        {
          "type": "exec",
          "sql": "REINDEX c1;\n    SELECT a FROM t2 ORDER BY a;",
          "expect": "ABCD BCDE abc bcd"
        }
      ]
    },
    {
      "name": "reindex-3.1",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "REINDEX c1;",
          "expect": "1 {no such collation sequence: c1}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "reindex-3.2",
      "steps": [
        {
          "type": "catch",
          "sql": "REINDEX c1;",
          "expect": "0 {}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "reindex-3.3",
      "steps": [
        {
          "type": "catch",
          "sql": "REINDEX;",
          "expect": "1 {no such collation sequence: c2}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "reindex-3.99",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "reindex-4.1.0",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t0 (\n        c0 INTEGER PRIMARY KEY DESC, \n        c1 UNIQUE DEFAULT NULL\n      )  ;\n      INSERT INTO t0(c0) VALUES (1), (2), (3), (4), (5);\n      SELECT c0 FROM t0 WHERE c1 IS NULL ORDER BY 1;",
          "expect": "1 2 3 4 5"
        }
      ]
    },
    {
      "name": "reindex-4.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "REINDEX;"
        }
      ]
    },
    {
      "name": "reindex-4.1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT c0 FROM t0 WHERE c1 IS NULL ORDER BY 1;",
          "expect": "1 2 3 4 5"
        }
      ]
    },
    {
      "name": "reindex-4.1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT c0 FROM t0 WHERE c1 IS NULL AND c0 IN (1,2,3,4,5);",
          "expect": "1 2 3 4 5"
        }
      ]
    },
    {
      "name": "reindex-4.1.4",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA integrity_check;",
          "expect": "ok"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "reindex-4.2.0",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t0 (\n        c0 INTEGER PRIMARY KEY DESC, \n        c1 UNIQUE DEFAULT NULL\n      ) WITHOUT ROWID ;\n      INSERT INTO t0(c0) VALUES (1), (2), (3), (4), (5);\n      SELECT c0 FROM t0 WHERE c1 IS NULL ORDER BY 1;",
          "expect": "1 2 3 4 5"
        }
      ]
    },
    {
      "name": "reindex-4.2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "REINDEX;"
        }
      ]
    },
    {
      "name": "reindex-4.2.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT c0 FROM t0 WHERE c1 IS NULL ORDER BY 1;",
          "expect": "1 2 3 4 5"
        }
      ]
    },
    {
      "name": "reindex-4.2.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT c0 FROM t0 WHERE c1 IS NULL AND c0 IN (1,2,3,4,5);",
          "expect": "1 2 3 4 5"
        }
      ]
    },
    {
      "name": "reindex-4.2.4",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA integrity_check;",
          "expect": "ok"
        }
      ]
    }
  ]
}