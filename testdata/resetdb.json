{
  "file": "resetdb.test",
  "name": "resetdb",
  "ordered": true,
  "tests": [
    {
      "name": "resetdb-100",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA auto_vacuum = 0;\n  PRAGMA page_size=4096;\n  CREATE TABLE t1(a,b);\n  WITH RECURSIVE c(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM c WHERE x\u003c20)\n    INSERT INTO t1(a,b) SELECT x, randomblob(300) FROM c;\n  CREATE INDEX t1a ON t1(a);\n  CREATE INDEX t1b ON t1(b);\n  SELECT sum(a), sum(length(b)) FROM t1;\n  PRAGMA integrity_check;\n  PRAGMA journal_mode;\n  PRAGMA page_count;",
          "expect": "210 6000 ok delete 8"
        }
      ]
    },
    {
      "name": "resetdb-110",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT sum(a), sum(length(b)) FROM t1;\n    PRAGMA integrity_check;\n    PRAGMA journal_mode;\n    PRAGMA page_count;",
          "expect": "210 6000 ok delete 8"
        }
      ]
    },
    {
      "name": "resetdb-200",
      "steps": [
        {
          "type": "catch",
          "sql": "UPDATE sqlite_dbpage SET data=randomblob(4096) WHERE pgno=1;\n    PRAGMA quick_check;",
          "expect": "1 {file is not a database}"
        }
      ]
    },
    {
      "name": "resetdb-201",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA quick_check;",
          "expect": "1 {file is not a database}"
        }
      ]
    },
    {
      "name": "resetdb-210",
      "steps": [
        {
          "type": "exec",
          "sql": "VACUUM"
        },
        {
          "type": "catch",
          "sql": "PRAGMA page_count;\n     PRAGMA page_size;\n     PRAGMA quick_check;\n     PRAGMA journal_mode;",
          "expect": "0 {1 4096 ok delete}"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "resetdb-300",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA auto_vacuum = 0;\n  PRAGMA page_size=8192;\n  PRAGMA journal_mode=WAL;\n  CREATE TABLE t1(a,b);\n  WITH RECURSIVE c(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM c WHERE x\u003c20)\n    INSERT INTO t1(a,b) SELECT x, randomblob(1300) FROM c;\n  CREATE INDEX t1a ON t1(a);\n  CREATE INDEX t1b ON t1(b);\n  SELECT sum(a), sum(length(b)) FROM t1;\n  PRAGMA integrity_check;\n  PRAGMA journal_mode;\n  PRAGMA page_size;\n  PRAGMA page_count;",
          "expect": "wal 210 26000 ok wal 8192 12"
        }
      ]
    },
    {
      "name": "resetdb-310",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT sum(a), sum(length(b)) FROM t1;\n    PRAGMA integrity_check;\n    PRAGMA journal_mode;\n    PRAGMA page_size;\n    PRAGMA page_count;",
          "expect": "210 26000 ok wal 8192 12"
        }
      ]
    },
    {
      "name": "resetdb-320",
      "steps": [
        {
          "type": "catch",
          "sql": "UPDATE sqlite_dbpage SET data=randomblob(8192) WHERE pgno=1;\n  PRAGMA quick_check",
          "expect": "1 {file is not a database}"
        }
      ]
    },
    {
      "name": "resetdb-330",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA quick_check",
          "expect": "1 {file is not a database}"
        }
      ]
    },
    {
      "name": "resetdb-400",
      "steps": [
        {
          "type": "exec",
          "sql": "VACUUM"
        },
        {
          "type": "catch",
          "sql": "PRAGMA page_count;\n     PRAGMA page_size;\n     PRAGMA journal_mode;\n     PRAGMA quick_check;",
          "expect": "0 {1 8192 wal ok}"
        }
      ]
    },
    {
      "name": "resetdb-500",
      "steps": [
        {
          "type": "exec",
          "sql": "VACUUM"
        },
        {
          "type": "catch",
          "sql": "PRAGMA page_count;\n     PRAGMA page_size;\n     PRAGMA journal_mode;\n     PRAGMA quick_check;",
          "expect": "0 {1 8192 wal ok}"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "resetdb-600",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = wal;\n  CREATE TABLE t1(a);\n  INSERT INTO t1 VALUES(1), (2), (3), (4);",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "resetdb-610",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4"
        }
      ]
    },
    {
      "name": "resetdb-630",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM sqlite_master"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "resetdb-700",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA page_size=512;\n  PRAGMA auto_vacuum = 0;\n  CREATE TABLE t1(a,b,c);\n  CREATE INDEX t1a ON t1(a);\n  CREATE INDEX t1bc ON t1(b,c);\n  WITH RECURSIVE c(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM c WHERE x\u003c10)\n    INSERT INTO t1(a,b,c) SELECT x, randomblob(100),randomblob(100) FROM c;\n  PRAGMA page_count;\n  PRAGMA integrity_check;",
          "expect": "19 ok"
        }
      ]
    },
    {
      "name": "resetdb-710",
      "steps": [
        {
          "type": "exec",
          "sql": "UPDATE sqlite_dbpage SET data=\n    X'' WHERE pgno=1;"
        }
      ]
    },
    {
      "name": "resetdb-720",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA integrity_check;",
          "expect": "ok"
        }
      ]
    },
    {
      "name": "resetdb-730",
      "steps": [
        {
          "type": "exec",
          "sql": "VACUUM",
          "expect": "0"
        }
      ]
    },
    {
      "name": "resetdb-740",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA page_count;\n  PRAGMA integrity_check;",
          "expect": "1 ok"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "resetdb-800",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA encoding = 'utf8';\n    CREATE TABLE t1(a, b);\n    PRAGMA encoding;",
          "expect": "UTF-8"
        }
      ]
    },
    {
      "name": "resetdb-810",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TEMP TABLE t2(x);\n    INSERT INTO t2 VALUES('hello world');\n    SELECT name FROM sqlite_schema;",
          "expect": "t1"
        }
      ]
    },
    {
      "name": "resetdb-820",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA encoding = 'utf16'",
          "expect": "1"
        }
      ]
    },
    {
      "name": "resetdb-830",
      "steps": [
        {
          "type": "exec",
          "sql": "VACUUM",
          "expect": "0"
        }
      ]
    },
    {
      "name": "resetdb-840",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n      INSERT INTO t1 VALUES('one', 'two');\n      PRAGMA encoding;",
          "expect": "UTF-16"
        }
      ]
    },
    {
      "name": "resetdb-850",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t1;",
          "expect": "1 {attached databases must use the same text encoding as main database}"
        }
      ]
    },
    {
      "name": "resetdb-860",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t2;",
          "expect": "1 {attached databases must use the same text encoding as main database}"
        }
      ]
    }
  ]
}