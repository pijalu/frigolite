{
  "file": "rollback.test",
  "name": "rollback",
  "ordered": true,
  "tests": [
    {
      "name": "rollback-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a);\n    INSERT INTO t1 VALUES(1);\n    INSERT INTO t1 VALUES(2);\n    INSERT INTO t1 VALUES(3);\n    INSERT INTO t1 VALUES(4);\n    SELECT * FROM t1;",
          "expect": "1 2 3 4"
        }
      ]
    },
    {
      "name": "rollback-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t3(a unique on conflict rollback);\n      INSERT INTO t3 SELECT a FROM t1;\n      BEGIN;\n      INSERT INTO t1 SELECT * FROM t1;"
        }
      ]
    },
    {
      "name": "rollback-1.3",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "SELECT a FROM t1",
          "variable": "stmt_1"
        },
        {
          "type": "stmt_step",
          "sql": "SELECT a FROM t1",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__",
          "expect": "SQLITE_ROW"
        }
      ]
    },
    {
      "name": "rollback-1.4",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t3 SELECT a FROM t1;",
          "expect": "1 {UNIQUE constraint failed: t3.a}"
        }
      ]
    },
    {
      "name": "rollback-1.5",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "SELECT a FROM t1",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__",
          "expect": "SQLITE_ROW"
        }
      ]
    },
    {
      "name": "rollback-1.6",
      "steps": [
        {
          "type": "stmt_reset",
          "sql": "SELECT a FROM t1",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "SQLITE_OK",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "rollback-1.7",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "SELECT a FROM t1",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__",
          "expect": "SQLITE_ROW"
        }
      ]
    },
    {
      "name": "rollback-1.8",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "SELECT a FROM t1",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__",
          "expect": "SQLITE_ROW"
        }
      ]
    },
    {
      "name": "rollback-1.9",
      "steps": [
        {
          "type": "stmt_finalize",
          "sql": "SELECT a FROM t1",
          "variable": "stmt_1",
          "expect": "SQLITE_OK"
        }
      ]
    }
  ]
}