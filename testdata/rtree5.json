{
  "file": "rtree5.test",
  "name": "rtree5",
  "ordered": true,
  "tests": [
    {
      "name": "rtree5-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE t1 USING rtree_i32(id, x1, x2, y1, y2)"
        }
      ]
    },
    {
      "name": "rtree5-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(1, 5, 10, 4, 11.2)"
        }
      ]
    },
    {
      "name": "rtree5-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 5 10 4 11"
        }
      ]
    },
    {
      "name": "rtree5-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT typeof(x1) FROM t1",
          "expect": "integer"
        }
      ]
    },
    {
      "name": "rtree5-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT x1==5 FROM t1",
          "expect": "1"
        }
      ]
    },
    {
      "name": "rtree5-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT x1==5.2 FROM t1",
          "expect": "0"
        }
      ]
    },
    {
      "name": "rtree5-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT x1==5.0 FROM t1",
          "expect": "1"
        }
      ]
    },
    {
      "name": "rtree5-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT count(*) FROM t1 WHERE x1==5",
          "expect": "1"
        }
      ]
    },
    {
      "name": "rtree5-1.9",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT count(*) FROM t1 WHERE x1==5.0",
          "expect": "1"
        }
      ]
    },
    {
      "name": "rtree5-1.10",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT (1\u003c\u003c31)-5, (1\u003c\u003c31)-1, -1*(1\u003c\u003c31), -1*(1\u003c\u003c31)+5",
          "expect": "2147483643 2147483647 -2147483648 -2147483643"
        }
      ]
    },
    {
      "name": "rtree5-1.11",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(2, (1\u003c\u003c31)-5, (1\u003c\u003c31)-1, -1*(1\u003c\u003c31), -1*(1\u003c\u003c31)+5)"
        }
      ]
    },
    {
      "name": "rtree5-1.12",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1 WHERE id=2",
          "expect": "2 2147483643 2147483647 -2147483648 -2147483643"
        }
      ]
    },
    {
      "name": "rtree5-1.13",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1 WHERE \n        x1=2147483643 AND x2=2147483647 AND \n        y1=-2147483648 AND y2=-2147483643",
          "expect": "2 2147483643 2147483647 -2147483648 -2147483643"
        }
      ]
    }
  ]
}