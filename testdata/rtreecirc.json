{
  "file": "rtreecirc.test",
  "name": "rtreecirc",
  "ordered": true,
  "tests": [
    {
      "name": "rtreecirc-1.0",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE VIRTUAL TABLE rt USING rtree(id, x1, x2, y1, y2);\n  SELECT name FROM sqlite_master ORDER BY 1;",
          "expect": "\n  rt rt_node rt_parent rt_rowid\n"
        }
      ]
    },
    {
      "name": "rtreecirc-1.1.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TRIGGER tr1 AFTER INSERT ON rt_node BEGIN\n      SELECT * FROM rt;\n    END;"
        }
      ]
    },
    {
      "name": "rtreecirc-1.1.1.2",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO rt VALUES(1, 2, 3, 4, 5);",
          "expect": "1 {no such table: main.rt}"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "rtreecirc-1.1.2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TRIGGER tr1 AFTER INSERT ON rt_parent BEGIN\n      SELECT * FROM rt;\n    END;"
        }
      ]
    },
    {
      "name": "rtreecirc-1.1.2.2",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO rt VALUES(1, 2, 3, 4, 5);",
          "expect": "1 {no such table: main.rt}"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "rtreecirc-1.1.3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TRIGGER tr1 AFTER INSERT ON rt_rowid BEGIN\n      SELECT * FROM rt;\n    END;"
        }
      ]
    },
    {
      "name": "rtreecirc-1.1.3.2",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO rt VALUES(1, 2, 3, 4, 5);",
          "expect": "1 {no such table: main.rt}"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    }
  ]
}