    {
      "name": "rtreedoc2-2-5.1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM myrtree WHERE id MATCH box(4, 5);"
        }
      ]
    },
    {
      "name": "rtreedoc2-2-5.1.2",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "box_geom_calls",
          "expect": "3"
