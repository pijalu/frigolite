    {
      "name": "rtreedoc2-2-6.0",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE VIRTUAL TABLE xyz USING rtree(x, x1,x2, y1,y2);\n  WITH s(i) AS (\n    VALUES(1) UNION ALL SELECT i+1 FROM s WHERE i\u003c15\n  )\n  INSERT INTO xyz SELECT NULL, one.i,one.i+1,  two.i,two.i+1 FROM s one, s two;"
        }
      ]
