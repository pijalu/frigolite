{
  "file": "rtreedoc2.test",
  "name": "rtreedoc2",
  "ordered": true,
  "tests": [
    {
      "name": "rtreedoc2-1-1.1.0",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM pragma_function_list WHERE name IN('circle', 'qcircle');",
          "expect": "\n"
        }
      ]
    },
    {
      "name": "rtreedoc2-1-1.1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM pragma_function_list WHERE name = 'circle' AND enc='utf8';",
          "expect": "\n  circle 0 s utf8 -1 0\n"
        }
      ]
    },
    {
      "name": "rtreedoc2-1-1.1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM pragma_function_list WHERE name = 'qcircle' AND enc='utf8';",
          "expect": "\n  qcircle 0 s utf8 -1 0\n"
        }
      ]
    },
    {
      "name": "rtreedoc2-1-1.2.0",
      "steps": [
        {
          "type": "emptytext",
          "sql": "SELECT circle(1, 2, 3);",
          "expect": "{}"
        }
      ]
    },
    {
      "name": "rtreedoc2-1-1.2.1",
      "steps": [
        {
          "type": "emptytext",
          "sql": "SELECT qcircle(1, 2, 3);",
          "expect": "{}"
        }
      ]
    },
    {
      "name": "rtreedoc2-1-1.3.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE demo_index USING rtree(id, x1,x2, y1,y2);\n  INSERT INTO demo_index VALUES(10, 45,45,  24,24);\n  INSERT INTO demo_index VALUES(20, 50,50,  28,28);\n  INSERT INTO demo_index VALUES(30, 43,43,  22,22);"
        }
      ]
    },
    {
      "name": "rtreedoc2-1-1.3.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT id FROM demo_index WHERE id MATCH circle(45.3, 22.9, 5.0)",
          "expect": "10 30"
        }
      ]
    },
    {
      "name": "rtreedoc2-1-1.3.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT id FROM demo_index WHERE id MATCH qcircle(45.3, 22.9, 5.0, 1)",
          "expect": "10 30"
        },
        {
          "type": "query",
          "sql": "SELECT id FROM demo_index WHERE id MATCH box(43,46, 21,25);",
          "expect": "10 30"
        }
      ]
    },
    {
      "name": "rtreedoc2-1-1.3.3",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "box_geom",
          "expect": "{box {43.0 46.0 21.0 25.0} {45.0 45.0 24.0 24.0}} {box {43.0 46.0 21.0 25.0} {50.0 50.0 28.0 28.0}} {box {43.0 46.0 21.0 25.0} {43.0 43.0 22.0 22.0}}"
        }
      ]
    },
    {
      "name": "rtreedoc2-2-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE rt1 USING rtree(id, x1,x2);\n  CREATE VIRTUAL TABLE rt2 USING rtree(id, x1,x2, y1,y2);\n  CREATE VIRTUAL TABLE rt3 USING rtree(id, x1,x2, y1,y2, z1,z2);\n\n  INSERT INTO rt1 DEFAULT VALUES;\n  INSERT INTO rt2 DEFAULT VALUES;\n  INSERT INTO rt3 DEFAULT VALUES;"
        }
      ]
    },
    {
      "name": "rtreedoc2-2-1.1.1",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT id FROM rt1 WHERE id MATCH box();",
          "expect": "1 {SQL logic error}"
        }
      ]
    },
    {
      "name": "rtreedoc2-2-1.2.1",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT id FROM rt2 WHERE id MATCH box();",
          "expect": "1 {SQL logic error}"
        }
      ]
    },
    {
      "name": "rtreedoc2-2-1.3.1",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT id FROM rt3 WHERE id MATCH box();",
          "expect": "1 {SQL logic error}"
        }
      ]
    },
    {
      "name": "rtreedoc2-2-2.0",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM rt2 WHERE id MATCH box(22,23, 24,25);",
          "expect": "1 {SQL logic error}"
        }
      ]
    },
    {
      "name": "rtreedoc2-2-3.0",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO rt1 VALUES(10, 10, 10);\n  INSERT INTO rt1 VALUES(11, 11, 11);\n  INSERT INTO rt1 VALUES(12, 12, 12);\n  INSERT INTO rt1 VALUES(13, 13, 13);\n  INSERT INTO rt1 VALUES(14, 14, 14);"
        }
      ]
    },
    {
      "name": "rtreedoc2-2-3.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM rt1 WHERE id MATCH box(1,1);"
        }
      ]
    },
    {
      "name": "rtreedoc2-2-3.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM rt1 WHERE id MATCH box(1,1);",
          "expect": "1 {SQL logic error}"
        }
      ]
    },
    {
      "name": "rtreedoc2-2-3.3",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "box_geom",
          "expect": "{box {1.0 1.0} {0.0 0.0}} {box {1.0 1.0} {10.0 10.0}} {box {1.0 1.0} {11.0 11.0}} {box 0.0 {12.0 12.0}}"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "rtreedoc2-2-4.0",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE VIRTUAL TABLE r1 USING rtree(id, minX,maxX, minY,maxY);\n  WITH s(i) AS (\n    VALUES(1) UNION ALL SELECT i+1 FROM s WHERE i\u003c120\n  )\n  INSERT INTO r1 SELECT i,i,i+1,  200,201 FROM s;"
        }
      ]
    },
    {
      "name": "rtreedoc2-2-4.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT count(*) FROM r1 WHERE id MATCH box(0,150,199,201)",
          "expect": "120"
        }
      ]
    },
    {
      "name": "rtreedoc2-2-5.1.1",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT count(*) FROM r1 WHERE id MATCH box(1,2,3)",
          "expect": "1 {SQL logic error}"
        }
      ]
    },
    {
      "name": "rtreedoc2-2-5.1.2",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "box_geom",
          "expect": "1.0 2.0 3.0"
        }
      ]
    },
    {
      "name": "rtreedoc2-2-5.2.1",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT count(*) FROM r1 WHERE id MATCH box(10001)",
          "expect": "1 {SQL logic error}"
        }
      ]
    },
    {
      "name": "rtreedoc2-2-5.2.2",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "box_geom",
          "expect": "10001.0"
        }
      ]
    },
    {
      "name": "rtreedoc2-2-5.3.1",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT count(*) FROM r1 WHERE id MATCH box(-10001)",
          "expect": "1 {SQL logic error}"
        }
      ]
    },
    {
      "name": "rtreedoc2-2-5.3.2",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "box_geom",
          "expect": "-10001.0"
        }
      ]
    },
    {
      "name": "rtreedoc2-2-5.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE myrtree USING rtree(id, x1,x2);\n  INSERT INTO myrtree VALUES(1, 1, 1);\n  INSERT INTO myrtree VALUES(2, 2, 2);\n  INSERT INTO myrtree VALUES(3, 3, 3);"
        }
      ]
    },
    {
