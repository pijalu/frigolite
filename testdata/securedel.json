{
  "file": "securedel.test",
  "name": "securedel",
  "ordered": true,
  "tests": [
    {
      "name": "securedel-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA secure_delete;",
          "expect": "2"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test2.db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test2.db-journal"
        }
      ]
    },
    {
      "name": "securedel-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "ATTACH 'test2.db' AS db2;\n    PRAGMA main.secure_delete=ON;\n    PRAGMA db2.secure_delete;",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "securedel-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA main.secure_delete=OFF;\n    PRAGMA db2.secure_delete;",
          "expect": "0 2"
        }
      ]
    },
    {
      "name": "securedel-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA secure_delete=OFF;\n    PRAGMA db2.secure_delete;",
          "expect": "0 0"
        }
      ]
    },
    {
      "name": "securedel-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA secure_delete=ON;\n    PRAGMA db2.secure_delete;",
          "expect": "1 1"
        }
      ]
    },
    {
      "name": "securedel-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA secure_delete=FAST;\n    PRAGMA db2.secure_delete;",
          "expect": "2 2"
        }
      ]
    },
    {
      "name": "securedel-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA secure_delete=ON;\n    PRAGMA db2.secure_delete;",
          "expect": "1 1"
        }
      ]
    },
    {
      "name": "securedel-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA main.secure_delete=FAST;\n    PRAGMA db2.secure_delete;",
          "expect": "2 1"
        }
      ]
    },
    {
      "name": "securedel-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA main.secure_delete=ON;\n    PRAGMA db2.secure_delete;",
          "expect": "1 1"
        }
      ]
    },
    {
      "name": "securedel-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "DETACH db2;\n    ATTACH 'test2.db' AS db2;\n    PRAGMA db2.secure_delete;",
          "expect": "1"
        }
      ]
    },
    {
      "name": "securedel-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "DETACH db2;\n    PRAGMA main.secure_delete=OFF;\n    ATTACH 'test2.db' AS db2;\n    PRAGMA db2.secure_delete;",
          "expect": "0 0"
        }
      ]
    }
  ]
}