      "name": "select2-4.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE aa(a);\n    CREATE TABLE bb(b);\n    INSERT INTO aa VALUES(1);\n    INSERT INTO aa VALUES(3);\n    INSERT INTO bb VALUES(2);\n    INSERT INTO bb VALUES(4);\n    SELECT * FROM aa, bb WHERE max(a,b)\u003e2;",
          "expect": "1 4 3 2 3 4"
        }
      ]
    },
    {
      "name": "select2-4.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO bb VALUES(0);\n    SELECT * FROM aa CROSS JOIN bb WHERE b;",
          "expect": "1 2 1 4 3 2 3 4"
        }
      ]
    },
    {
      "name": "select2-4.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM aa CROSS JOIN bb WHERE NOT b;",
          "expect": "1 0 3 0"
        }
      ]
    },
    {
      "name": "select2-4.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM aa, bb WHERE min(a,b);",
          "expect": "1 2 1 4 3 2 3 4"
        }
      ]
    },
    {
      "name": "select2-4.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM aa, bb WHERE NOT min(a,b);",
          "expect": "1 0 3 0"
        }
      ]
    },
    {
      "name": "select2-4.6",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM aa, bb WHERE CASE WHEN a=b-1 THEN 1 END;",
          "expect": "1 2 3 4"
        }
      ]
    },
