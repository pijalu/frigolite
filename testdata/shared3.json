    {
      "name": "shared3-1.1",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db1"
        },
        {
          "type": "exec",
          "sql": "PRAGMA encoding=UTF16;\n    CREATE TABLE t1(x,y);\n    INSERT INTO t1 VALUES('abc','This is a test string');",
          "database": "db1"
        },
        {
          "type": "close_named_db",
          "database": "db1"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db1"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "abc {This is a test string}",
          "database": "db1"
        }
      ]
    },
    {
      "name": "shared3-1.2",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "query",
          "sql": "SELECT y FROM t1 WHERE x='abc'",
          "expect": "{This is a test string}",
          "database": "db2"
        }
      ]
    },
