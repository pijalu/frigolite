{
  "file": "shared6.test",
  "name": "shared6",
  "ordered": true,
  "tests": [
    {
      "name": "shared6-1.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n    CREATE TABLE t2(c, d);\n    CREATE TABLE t3(e, f);"
        },
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "shared6-1.1.3",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db1"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "shared6-1.2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "BEGIN EXCLUSIVE",
          "database": "db1"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "1 {database table is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "shared6-1.2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "database": "db1"
        }
      ]
    },
    {
      "name": "shared6-1.2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT;\n    BEGIN;\n    INSERT INTO t2 VALUES(3, 4);",
          "database": "db1"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "database": "db2"
        }
      ]
    },
    {
      "name": "shared6-1.2.X",
