{
  "file": "shared7.test",
  "name": "shared7",
  "ordered": true,
  "tests": [
    {
      "name": "shared7-1.2",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);"
        },
        {
          "type": "catch",
          "sql": "ATTACH 'test.db' AS err1;",
          "expect": "1 {database is already attached}"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test2.db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test2.db-journal"
        }
      ]
    },
    {
      "name": "shared7-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "ATTACH 'test2.db' AS test2;\n    CREATE TABLE test2.t2(y);"
        },
        {
          "type": "catch",
          "sql": "ATTACH 'test2.db' AS err2;",
          "expect": "1 {database is already attached}"
        }
      ]
    },
    {
      "name": "shared7-1.4",
      "steps": [
        {
          "type": "catch",
          "sql": "ATTACH 'test.db' AS err1;",
          "expect": "1 {database is already attached}"
        }
      ]
    }
  ]
}