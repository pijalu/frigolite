      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "sharedA-0.1",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db1"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n    INSERT INTO t1 VALUES(randomblob(100));\n    INSERT INTO t1 SELECT randomblob(100) FROM t1;\n    INSERT INTO t1 SELECT randomblob(100) FROM t1;\n    INSERT INTO t1 SELECT randomblob(100) FROM t1;\n    INSERT INTO t1 SELECT randomblob(100) FROM t1;\n    INSERT INTO t1 SELECT randomblob(100) FROM t1;\n    INSERT INTO t1 SELECT randomblob(100) FROM t1;\n    CREATE INDEX i1 ON t1(x);",
          "database": "db1"
        },
        {
          "type": "exec",
          "sql": "BEGIN;\n    DROP INDEX i1;",
          "database": "db1"
        },
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 SELECT randomblob(100) FROM t1;\n    ROLLBACK;\n    PRAGMA integrity_check;",
          "expect": "ok",
          "database": "db1"
        }
      ]
    },
    {
