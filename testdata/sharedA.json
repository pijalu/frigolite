          "type": "open_named_db",
          "sql": "test.db",
          "database": "db1"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n    INSERT INTO t1 VALUES(123);",
          "database": "db2"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1;\n    CREATE INDEX i1 ON t1(x);",
          "expect": "123",
          "database": "db1"
        }
      ]
    },
    {
      "name": "sharedA-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1 ORDER BY x;",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "BEGIN; DROP INDEX i1;",
          "database": "db1"
        },
        {
          "type": "close_named_db",
          "database": "db1"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1 ORDER BY x;",
          "expect": "123",
          "database": "db2"
        }
      ]
    },
