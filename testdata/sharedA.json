    {
      "name": "sharedA-2.1",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db1"
        },
        {
          "type": "exec",
          "sql": "ATTACH 'test.db2' AS two",
          "database": "db1"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n    INSERT INTO t1 VALUES(1);\n    INSERT INTO t1 VALUES(2);\n    INSERT INTO t1 VALUES(3);\n    CREATE TABLE two.t2(x);\n    INSERT INTO t2 SELECT * FROM t1;",
          "database": "db1"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3",
          "database": "db2"
        }
      ]
    },
    {
      "name": "sharedA-2.2",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "CREATE INDEX i1 ON t1(x)",
