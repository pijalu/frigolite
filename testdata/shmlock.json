{
  "file": "shmlock.test",
  "name": "shmlock",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db3"
        }
      ]
    },
    {
      "name": "shmlock-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = wal;\n  CREATE TABLE t1(a, b);\n  INSERT INTO t1 VALUES(1, 2);",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "shmlock-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "shmlock-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2",
          "database": "db3"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "close_named_db",
          "database": "db3"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db0"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db1"
        }
      ]
    },
    {
      "name": "shmlock-3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2",
          "database": "db0"
        }
      ]
    },
    {
      "name": "shmlock-3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2",
          "database": "db1"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db0"
        },
        {
          "type": "close_named_db",
          "database": "db1"
        }
      ]
    }
  ]
}