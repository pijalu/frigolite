{
  "file": "shmlock.test",
  "name": "shmlock",
  "tests": [
    {
      "name": "1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = wal;\n  CREATE TABLE t1(a, b);\n  INSERT INTO t1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1"
        }
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1"
        }
      ]
    },
    {
      "name": "2.0",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "SQLITE_BUSY"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1"
        }
      ]
    },
    {
      "name": "3.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1"
        }
      ]
    },
    {
      "name": "3.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1"
        }
      ]
    }
  ]
}