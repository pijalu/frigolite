{
  "file": "shrink.test",
  "name": "shrink",
  "ordered": true,
  "tests": [
    {
      "name": "shrink-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA cache_size = 2000;\n    CREATE TABLE t1(x,y);\n    INSERT INTO t1 VALUES(randomblob(1000000),1);",
          "expect": "1"
        }
      ]
    },
    {
      "name": "shrink-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "UPDATE t1 SET y=y+1;",
          "expect": "1"
        }
      ]
    },
    {
      "name": "shrink-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA shrink_memory",
          "expect": "1"
        }
      ]
    }
  ]
}