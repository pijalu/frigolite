{
  "file": "snapshot2.test",
  "name": "snapshot2",
  "ordered": true,
  "tests": [
    {
      "name": "snapshot2-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = wal;\n  CREATE TABLE t1(a, b, c);\n  INSERT INTO t1 VALUES(1, 2, 3);\n  INSERT INTO t1 VALUES(4, 5, 6);",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "snapshot2-1.1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4 5 6"
        }
      ]
    },
    {
      "name": "snapshot2-1.1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN",
          "expect": "1 SQLITE_ERROR"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        }
      ]
    },
    {
      "name": "snapshot2-1.1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(7, 8, 9)"
        },
        {
          "type": "exec",
          "sql": "BEGIN",
          "expect": "48"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        }
      ]
    },
    {
      "name": "snapshot2-1.2.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4 5 6 7 8 9"
        }
      ]
    },
    {
      "name": "snapshot2-1.2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN",
          "expect": "1 SQLITE_ERROR"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        }
      ]
    },
    {
      "name": "snapshot2-1.2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(10, 11, 12)"
        },
        {
          "type": "exec",
          "sql": "BEGIN",
          "expect": "48"
        }
      ]
    },
    {
      "name": "setup_3",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "snapshot2-2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n  PRAGMA journal_mode = wal;\n  INSERT INTO t1 VALUES(1);\n  INSERT INTO t1 VALUES(2);",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "snapshot2-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM sqlite_master"
        },
        {
          "type": "exec",
          "sql": "BEGIN"
        },
        {
          "type": "exec",
          "sql": "COMMIT"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(3);"
        }
      ]
    },
    {
      "name": "snapshot2-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM sqlite_master"
        },
        {
          "type": "exec",
          "sql": "BEGIN",
          "expect": "1 SQLITE_ERROR_SNAPSHOT"
        }
      ]
    },
    {
      "name": "snapshot2-2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        },
        {
          "type": "exec",
          "sql": "BEGIN"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "snapshot2-2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3"
        }
      ]
    },
    {
      "name": "snapshot2-2.5",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA wal_checkpoint"
        },
        {
          "type": "exec",
          "sql": "BEGIN",
          "expect": "1 SQLITE_ERROR_SNAPSHOT"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "snapshot2-3.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = wal;\n  CREATE TABLE t1(x, y);\n  INSERT INTO t1 VALUES('a', 'b');\n  INSERT INTO t1 VALUES('c', 'd');",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "snapshot2-3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES('e', 'f')"
        }
      ]
    },
    {
      "name": "snapshot2-3.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1;",
          "expect": "a b c d e f"
        }
      ]
    },
    {
      "name": "snapshot2-4.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n      SELECT * FROM sqlite_master;",
          "expect": "1 SQLITE_ERROR"
        }
      ]
    },
    {
      "name": "snapshot2-4.3",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        }
      ]
    },
    {
      "name": "snapshot2-4.5",
      "steps": [
        {
          "type": "exec",
          "sql": "ATTACH 'test.db2' AS aux;\n    PRAGMA aux.journal_mode = wal;\n    CREATE TABLE aux.t2(x, y);",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "snapshot2-4.7",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA aux.journal_mode = delete;",
          "expect": "1 SQLITE_ERROR"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "snapshot2-5.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t2(x);\n  PRAGMA journal_mode = wal;\n  INSERT INTO t2 VALUES('abc');\n  INSERT INTO t2 VALUES('def');\n  INSERT INTO t2 VALUES('ghi');",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "snapshot2-5.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t2;\n    BEGIN;"
        }
      ]
    },
    {
      "name": "snapshot2-5.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN",
          "expect": "abc def ghi"
        }
      ]
    },
    {
      "name": "snapshot2-5.3",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA wal_checkpoint = RESTART"
        },
        {
          "type": "exec",
          "sql": "BEGIN",
          "expect": "abc def ghi"
        }
      ]
    },
    {
      "name": "snapshot2-5.4",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t2 VALUES('jkl')"
        },
        {
          "type": "exec",
          "sql": "BEGIN",
          "expect": "1 SQLITE_ERROR_SNAPSHOT"
        }
      ]
    }
  ]
}