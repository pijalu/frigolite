{
  "file": "snapshot3.test",
  "name": "snapshot3",
  "ordered": true,
  "tests": [
    {
      "name": "snapshot3-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(y);\n  PRAGMA journal_mode = wal;\n  INSERT INTO t1 VALUES(1);\n  INSERT INTO t1 VALUES(2);\n  INSERT INTO t1 VALUES(3);\n  INSERT INTO t1 VALUES(4);",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "snapshot3-1.1",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db3"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM sqlite_master",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM sqlite_master",
          "database": "db3"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4",
          "database": "db2"
        }
      ]
    },
    {
      "name": "snapshot3-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN",
          "database": "db2"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "PRAGMA wal_checkpoint"
        },
        {
          "type": "exec",
          "sql": "BEGIN",
          "database": "db2"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4",
          "database": "db2"
        }
      ]
    },
    {
      "name": "snapshot3-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA wal_checkpoint = truncate"
        }
      ]
    },
    {
      "name": "snapshot3-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN",
          "expect": "0 {}",
          "database": "db3"
        }
      ]
    },
    {
      "name": "snapshot3-1.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1; END",
          "expect": "1 2 3 4",
          "database": "db3"
        }
      ]
    },
    {
      "name": "snapshot3-1.6",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1; END",
          "expect": "1 2 3 4",
          "database": "db2"
        }
      ]
    },
    {
      "name": "snapshot3-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA wal_checkpoint = truncate",
          "expect": "0"
        }
      ]
    },
    {
      "name": "snapshot3-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN",
          "expect": "1 SQLITE_ERROR_SNAPSHOT",
          "database": "db3"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db3"
        },
        {
          "type": "close_named_db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "snapshot3-2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = wal;\n  CREATE TABLE t1(a, b);\n  INSERT INTO t1 VALUES(1, 2);\n  INSERT INTO t1 VALUES(3, 4);",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db3"
        }
      ]
    },
    {
      "name": "snapshot3-2.0.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4",
          "database": "db2"
        }
      ]
    },
    {
      "name": "snapshot3-2.0.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4",
          "database": "db3"
        }
      ]
    },
    {
      "name": "snapshot3-2.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA wal_checkpoint;",
          "expect": "0 4 4",
          "database": "db2"
        }
      ]
    },
    {
      "name": "snapshot3-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN"
        }
      ]
    },
    {
      "name": "snapshot3-2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(5, 6);",
          "database": "db2"
        }
      ]
    },
    {
      "name": "snapshot3-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN",
          "database": "db3"
        }
      ]
    }
  ]
}