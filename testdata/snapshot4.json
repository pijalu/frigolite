{
  "file": "snapshot4.test",
  "name": "snapshot4",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "snapshot4-1.0",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA cache_size = 10;\n  CREATE TABLE t1(a, b);\n  INSERT INTO t1 VALUES(1, randomblob(400));\n  PRAGMA journal_mode = wal;\n  WITH s(i) AS (\n    SELECT 2 UNION ALL SELECT i+1 FROM s WHERE i\u003c100\n  ) \n  INSERT INTO t1 SELECT i, randomblob(400) FROM s;",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "snapshot4-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n      SELECT count(*) FROM t1;",
          "expect": "100"
        }
      ]
    },
    {
      "name": "snapshot4-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT count(*) FROM t1;\n    CREATE TABLE t2(x);",
          "expect": "100",
          "database": "db2"
        }
      ]
    },
    {
      "name": "snapshot4-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA wal_checkpoint",
          "expect": "0 54 52",
          "database": "db2"
        }
      ]
    },
    {
      "name": "snapshot4-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT;\n    SELECT * FROM sqlite_master;\n    BEGIN;"
        },
        {
          "type": "exec",
          "sql": "SELECT count(*) FROM t1",
          "expect": "100"
        }
      ]
    }
  ]
}