{
  "file": "spellfix3.test",
  "name": "spellfix3",
  "ordered": true,
  "tests": [
    {
      "name": "spellfix3-100",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT spellfix1_scriptcode('And God said, “Let there be light”');",
          "expect": "215"
        }
      ]
    },
    {
      "name": "spellfix3-110",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT spellfix1_scriptcode('Бог сказал: \"Да будет свет\"');",
          "expect": "220"
        }
      ]
    },
    {
      "name": "spellfix3-120",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT spellfix1_scriptcode('και ειπεν ο θεος γενηθητω φως και εγενετο φως');",
          "expect": "200"
        }
      ]
    },
    {
      "name": "spellfix3-130",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT spellfix1_scriptcode('וַיֹּ֥אמֶר אֱלֹהִ֖ים יְהִ֣י א֑וֹר וַֽיְהִי־אֽוֹר׃');",
          "expect": "125"
        }
      ]
    },
    {
      "name": "spellfix3-140",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT spellfix1_scriptcode('فِي ذَلِكَ الوَقتِ، قالَ اللهُ: لِيَكُنْ نُورٌ. فَصَارَ نُورٌ.');",
          "expect": "160"
        }
      ]
    },
    {
      "name": "spellfix3-200",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT spellfix1_scriptcode('+3.14159');",
          "expect": "215"
        }
      ]
    },
    {
      "name": "spellfix3-210",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT spellfix1_scriptcode('And God said: \"Да будет свет\"');",
          "expect": "998"
        }
      ]
    },
    {
      "name": "spellfix3-220",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT spellfix1_scriptcode('+3.14159 light');",
          "expect": "215"
        }
      ]
    },
    {
      "name": "spellfix3-230",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT spellfix1_scriptcode('+3.14159 свет');",
          "expect": "220"
        }
      ]
    },
    {
      "name": "spellfix3-240",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT spellfix1_scriptcode('וַיֹּ֥אמֶר +3.14159');",
          "expect": "125"
        }
      ]
    }
  ]
}