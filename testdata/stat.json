{
  "file": "stat.test",
  "name": "stat",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "register_function",
          "functionName": "a_string",
          "callbackVars": {
            "": "1",
            "::asc": "1",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "testdir": "",
            "testprefix": "stat"
          },
          "functionProc": "a_string",
          "functionArgs": [
            "n"
          ],
          "functionBody": " string range [string repeat [incr ::asc]. $n] 1 $n ",
          "minArgs": 1,
          "maxArgs": -1
        }
      ]
    },
    {
      "name": "stat-0.0",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA table_info(dbstat);",
          "expect": "/0 name TEXT .* 1 path TEXT .* 9 pgsize INTEGER/"
        }
      ]
    },
    {
      "name": "stat-0.1a",
      "steps": [
        {
          "type": "catch",
          "sql": "DROP TABLE dbstat;",
          "expect": "1 {table dbstat may not be dropped}"
        }
      ]
    },
    {
      "name": "stat-0.1b",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA table_info=dbstat;",
          "expect": "/0 name TEXT .* 1 path TEXT .* 9 pgsize INTEGER/"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "register_function",
          "functionName": "a_string",
          "callbackVars": {
            "": "1",
            "::asc": "1",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "testdir": "",
            "testprefix": "stat"
          },
          "functionProc": "a_string",
          "functionArgs": [
            "n"
          ],
          "functionBody": " string range [string repeat [incr ::asc]. $n] 1 $n ",
          "minArgs": 1,
          "maxArgs": -1
        }
      ]
    },
    {
      "name": "stat-0.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA auto_vacuum = OFF;\n  CREATE VIRTUAL TABLE temp.stat USING dbstat;\n  SELECT * FROM stat;"
        }
      ]
    },
    {
      "name": "stat-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n    CREATE INDEX i1 ON t1(b);\n    INSERT INTO t1(rowid, a, b) VALUES(2, 2, 3);\n    INSERT INTO t1(rowid, a, b) VALUES(3, 4, 5);"
        }
      ]
    },
    {
      "name": "stat-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT name, path, pageno, pagetype, ncell, payload, unused, mx_payload\n      FROM stat WHERE name = 't1';",
          "expect": "t1 / 2 leaf 2 10 998 5"
        }
      ]
    },
    {
      "name": "stat-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT name, path, pageno, pagetype, ncell, payload, unused, mx_payload\n      FROM stat WHERE name = 'i1';",
          "expect": "i1 / 3 leaf 2 10 1000 5"
        }
      ]
    },
    {
      "name": "stat-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT name, path, pageno, pagetype, ncell, payload, unused, mx_payload\n      FROM stat WHERE name = 'sqlite_schema';",
          "expect": "sqlite_schema / 1 leaf 2 77 831 40"
        }
      ]
    },
    {
      "name": "stat-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE t1;"
        }
      ]
    },
    {
      "name": "stat-2.1",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t3(a PRIMARY KEY, b);\n  INSERT INTO t3(rowid, a, b) VALUES(2, a_string(111), a_string(222));\n  INSERT INTO t3 SELECT a_string(110+rowid), a_string(221+rowid) FROM t3\n   ORDER BY rowid;\n  INSERT INTO t3 SELECT a_string(110+rowid), a_string(221+rowid) FROM t3\n   ORDER BY rowid;\n  INSERT INTO t3 SELECT a_string(110+rowid), a_string(221+rowid) FROM t3\n   ORDER BY rowid;\n  INSERT INTO t3 SELECT a_string(110+rowid), a_string(221+rowid) FROM t3\n   ORDER BY rowid;\n  INSERT INTO t3 SELECT a_string(110+rowid), a_string(221+rowid) FROM t3\n   ORDER BY rowid;\n  SELECT name, path, pageno, pagetype, ncell, payload, unused, mx_payload\n    FROM stat WHERE name != 'sqlite_schema' ORDER BY name;",
          "expect": "sqlite_autoindex_t3_1 / 3 internal 3 368 623 125 sqlite_autoindex_t3_1 /000/ 8 leaf 8 946 46 123 sqlite_autoindex_t3_1 /001/ 9 leaf 8 988 2 131 sqlite_autoindex_t3_1 /002/ 15 leaf 7 857 137 132 sqlite_autoindex_t3_1 /003/ 20 leaf 6 739 257 129 t3 / 2 internal 15 0 907 0 t3 /000/ 4 leaf 2 678 328 340 t3 /001/ 5 leaf 2 682 324 342 t3 /002/ 6 leaf 2 682 324 342 t3 /003/ 7 leaf 2 690 316 346 t3 /004/ 10 leaf 2 682 324 342 t3 /005/ 11 leaf 2 690 316 346 t3 /006/ 12 leaf 2 698 308 350 t3 /007/ 13 leaf 2 706 300 354 t3 /008/ 14 leaf 2 682 324 342 t3 /009/ 16 leaf 2 690 316 346 t3 /00a/ 17 leaf 2 698 308 350 t3 /00b/ 18 leaf 2 706 300 354 t3 /00c/ 19 leaf 2 714 292 358 t3 /00d/ 21 leaf 2 722 284 362 t3 /00e/ 22 leaf 2 730 276 366 t3 /00f/ 23 leaf 2 738 268 370"
        }
      ]
    },
    {
      "name": "stat-2.1agg",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM dbstat WHERE aggregate=TRUE ORDER BY name;",
          "expect": "sqlite_autoindex_t3_1 {} 5 {} 32 3898 1065 132 {} 5120 sqlite_schema {} 1 {} 2 84 824 49 {} 1024 t3 {} 17 {} 47 11188 5815 370 {} 17408"
        }
      ]
    },
    {
      "name": "stat-2.2",
      "steps": [
        {
          "type": "query",
          "sql": "UPDATE t3 SET a=a||hex(randomblob(700));\n  VACUUM;\n  SELECT pageno FROM stat EXCEPT SELECT pageno-1 FROM stat;",
          "expect": "64 136"
        }
      ]
    },
    {
      "name": "stat-2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE t3; VACUUM;"
        }
      ]
    },
    {
      "name": "stat-3.1",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t4(x);\n  CREATE INDEX i4 ON t4(x);\n  INSERT INTO t4(rowid, x) VALUES(2, a_string(7777));\n  SELECT name, path, pageno, pagetype, ncell, payload, unused, mx_payload\n    FROM stat WHERE name != 'sqlite_schema' ORDER BY name;",
          "expect": "i4 / 3 leaf 1 103 905 7782 i4 /000+000000 4 overflow 0 1020 0 0 i4 /000+000001 5 overflow 0 1020 0 0 i4 /000+000002 6 overflow 0 1020 0 0 i4 /000+000003 7 overflow 0 1020 0 0 i4 /000+000004 8 overflow 0 1020 0 0 i4 /000+000005 9 overflow 0 1020 0 0 i4 /000+000006 10 overflow 0 1020 0 0 i4 /000+000007 11 overflow 0 539 481 0 t4 / 2 leaf 1 640 367 7780 t4 /000+000000 12 overflow 0 1020 0 0 t4 /000+000001 13 overflow 0 1020 0 0 t4 /000+000002 14 overflow 0 1020 0 0 t4 /000+000003 15 overflow 0 1020 0 0 t4 /000+000004 16 overflow 0 1020 0 0 t4 /000+000005 17 overflow 0 1020 0 0 t4 /000+000006 18 overflow 0 1020 0 0"
        }
      ]
    },
    {
      "name": "stat-3.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT *, '|' FROM dbstat WHERE aggregate=TRUE ORDER BY name;",
          "expect": "i4 {} 9 {} 1 7782 1386 7782 {} 9216 | sqlite_schema {} 1 {} 2 74 834 40 {} 1024 | t4 {} 8 {} 1 7780 367 7780 {} 8192 |"
        }
      ]
    },
    {
      "name": "stat-4.1",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t5(x);\n  CREATE INDEX i5 ON t5(x);\n  SELECT name, path, pageno, pagetype, ncell, payload, unused, mx_payload\n    FROM stat WHERE name = 't5' OR name = 'i5';",
          "expect": "i5 / 20 leaf 0 0 1016 0 t5 / 19 leaf 0 0 1016 0"
        }
      ]
    },
    {
      "name": "setup_3",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "setup_4",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "stat-5.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA auto_vacuum = OFF;\n  CREATE TABLE tx(y);\n  ATTACH ':memory:' AS aux1;\n  CREATE VIRTUAL TABLE temp.stat USING dbstat(aux1);\n  CREATE TABLE aux1.t1(x);\n  INSERT INTO t1 VALUES(zeroblob(1513));\n  INSERT INTO t1 VALUES(zeroblob(1514));\n  SELECT name, path, pageno, pagetype, ncell, payload, unused, mx_payload\n    FROM stat WHERE name = 't1';",
          "expect": "t1 / 2 leaf 2 993 5 1517 t1 /000+000000 3 overflow 0 1020 0 0 t1 /001+000000 4 overflow 0 1020 0 0"
        }
      ]
    },
    {
      "name": "stat-5.20",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT name, quote(path), pageno, quote(pagetype), ncell, payload,\n         unused, mx_payload, '|' FROM dbstat('main',1);",
          "expect": "sqlite_schema NULL 1 NULL 1 34 878 34 | tx NULL 1 NULL 0 0 1016 0 |"
        }
      ]
    },
    {
      "name": "stat-5.21",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT name, quote(path), pageno, quote(pagetype), ncell, payload,\n         unused, mx_payload, '|' FROM dbstat('aux1',1);",
          "expect": "sqlite_schema NULL 1 NULL 1 34 878 34 | t1 NULL 3 NULL 2 3033 5 1517 |"
        }
      ]
    },
    {
      "name": "stat-6.1",
      "steps": [
        {
          "type": "catch",
          "sql": "CREATE VIRTUAL TABLE temp.s2 USING dbstat(mainx);",
          "expect": "1 {no such database: mainx}"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    },
    {
      "name": "stat-7.1",
      "steps": [
        {
          "type": "exec",
          "sql": "ATTACH 'test.db2' AS '123';\n  PRAGMA \"123\".auto_vacuum = OFF;\n  CREATE TABLE \"123\".x1(a, b);\n  INSERT INTO x1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "stat-7.1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM dbstat('123');",
          "expect": "\n  sqlite_schema / 1 leaf 1 37 875 37 0 1024 \n  x1 / 2 leaf 1 4 1008 4 1024 1024\n"
        }
      ]
    },
    {
      "name": "stat-7.1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM dbstat(123);",
          "expect": "\n  sqlite_schema / 1 leaf 1 37 875 37 0 1024 \n  x1 / 2 leaf 1 4 1008 4 1024 1024\n"
        }
      ]
    },
    {
      "name": "stat-7.1.3",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE VIRTUAL TABLE x2 USING dbstat('123');\n  SELECT * FROM x2;",
          "expect": "\n  sqlite_schema / 1 leaf 1 37 875 37 0 1024 \n  x1 / 2 leaf 1 4 1008 4 1024 1024\n"
        }
      ]
    },
    {
      "name": "stat-7.1.4",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE VIRTUAL TABLE x3 USING dbstat(123);\n  SELECT * FROM x3;",
          "expect": "\n  sqlite_schema / 1 leaf 1 37 875 37 0 1024 \n  x1 / 2 leaf 1 4 1008 4 1024 1024\n"
        }
      ]
    },
    {
      "name": "stat-7.2",
      "steps": [
        {
          "type": "exec",
          "sql": "DETACH 123;\n  DROP TABLE x2;\n  DROP TABLE x3;\n  ATTACH 'test.db2' AS '123corp';"
        }
      ]
    },
    {
      "name": "stat-7.2.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM dbstat('123corp');",
          "expect": "\n  sqlite_schema / 1 leaf 1 37 875 37 0 1024 \n  x1 / 2 leaf 1 4 1008 4 1024 1024\n"
        }
      ]
    },
    {
      "name": "stat-7.2.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM dbstat(123corp);",
          "expect": "1 {unrecognized token: \"123corp\"}"
        }
      ]
    },
    {
      "name": "stat-7.2.3",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE VIRTUAL TABLE x2 USING dbstat('123corp');\n  SELECT * FROM x2;",
          "expect": "\n  sqlite_schema / 1 leaf 1 37 875 37 0 1024 \n  x1 / 2 leaf 1 4 1008 4 1024 1024\n"
        }
      ]
    },
    {
      "name": "stat-7.2.4",
      "steps": [
        {
          "type": "catch",
          "sql": "CREATE VIRTUAL TABLE x3 USING dbstat(123corp);\n  SELECT * FROM x3;",
          "expect": "1 {unrecognized token: \"123corp\"}"
        }
      ]
    },
    {
      "name": "stat-8.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE st4 USING dbstat;"
        }
      ]
    },
    {
      "name": "stat-8.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM st4 WHERE st4.aggregate = NULL;"
        }
      ]
    },
    {
      "name": "stat-8.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT aggregate=1 FROM st4 WHERE aggregate = 5"
        }
      ]
    },
    {
      "name": "stat-8.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM st4 WHERE name = NULL;"
        }
      ]
    },
    {
      "name": "stat-8.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM st4 WHERE schema = NULL;"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "stat-9.1",
      "steps": [
        {
          "type": "catch",
          "sql": "CREATE TABLE dbstat(x, y);\n  DROP TABLE nosuchdb.dbstat;",
          "expect": "/1 {(no such table: nosuchdb.dbstat|table dbstat may not be dropped)}/"
        }
      ]
    }
  ]
}