{
  "file": "stmt.test",
  "name": "stmt",
  "ordered": true,
  "tests": [
    {
      "name": "stmt-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a integer primary key, b INTEGER NOT NULL)"
        }
      ]
    },
    {
      "name": "stmt-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA temp_store = file;\n    BEGIN;\n      INSERT INTO t1 VALUES(1, 1);",
          "expect": "2"
        }
      ]
    },
    {
      "name": "stmt-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 SELECT a+1, b+1 FROM t1;",
          "expect": "2"
        }
      ]
    },
    {
      "name": "stmt-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT",
          "expect": "1"
        }
      ]
    },
    {
      "name": "stmt-1.6.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n      INSERT INTO t1 SELECT a+2, b+2 FROM t1;",
          "expect": "2"
        }
      ]
    },
    {
      "name": "stmt-1.6.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 SELECT a+4, b+4 FROM t1",
          "expect": "2"
        }
      ]
    },
    {
      "name": "stmt-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT",
          "expect": "1"
        }
      ]
    },
    {
      "name": "stmt-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(9, 9)"
        },
        {
          "type": "exec",
          "sql": "ROLLBACK",
          "expect": "2"
        }
      ]
    },
    {
      "name": "stmt-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN"
        },
        {
          "type": "exec",
          "sql": "REPLACE INTO t1 VALUES(9, 9)"
        },
        {
          "type": "exec",
          "sql": "ROLLBACK",
          "expect": "2"
        }
      ]
    },
    {
      "name": "stmt-2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 SELECT 9, 9"
        },
        {
          "type": "exec",
          "sql": "ROLLBACK",
          "expect": "2"
        }
      ]
    },
    {
      "name": "stmt-2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 SELECT 9, 9;\n    INSERT INTO t1 SELECT 10, 10;"
        },
        {
          "type": "exec",
          "sql": "ROLLBACK",
          "expect": "2"
        }
      ]
    },
    {
      "name": "stmt-2.5",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE INDEX i1 ON t1(b)"
        }
      ]
    },
    {
      "name": "stmt-2.6",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN"
        },
        {
          "type": "exec",
          "sql": "REPLACE INTO t1 VALUES(5, 5);\n  REPLACE INTO t1 VALUES(5, 5);"
        },
        {
          "type": "exec",
          "sql": "ROLLBACK",
          "expect": "2"
        }
      ]
    }
  ]
}