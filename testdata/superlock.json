{
  "file": "superlock.test",
  "name": "superlock",
  "tests": [
    {
      "name": "1.1",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t1(a, b);\n  INSERT INTO t1 VALUES(1, 2);\n  PRAGMA journal_mode = DELETE;",
          "expect": "delete"
        }
      ]
    },
    {
      "name": "1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "2.1",
      "steps": [
        {
          "type": "query",
          "sql": "INSERT INTO t1 VALUES(3, 4);\n  PRAGMA journal_mode = WAL;",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(5, 6)",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "2.5",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA wal_checkpoint",
          "expect": "0 {1 -1 -1}"
        }
      ]
    },
    {
      "name": "3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(3, 4)"
        }
      ]
    },
    {
      "name": "3.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 {database is locked}"
        }
