        }
      ]
    },
    {
      "name": "3.5",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA wal_checkpoint",
          "expect": "0 {1 -1 -1}"
        }
      ]
    },
    {
      "name": "4.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA wal_checkpoint",
          "expect": "0 1 1"
        }
      ]
    },
    {
      "name": "4.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "4.4",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(5, 6)",
