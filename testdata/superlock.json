    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "superlock-6.1",
      "steps": [
        {
          "type": "query",
          "sql": "ATTACH 'test.db2' AS aux;\n  PRAGMA aux.journal_mode = wal;\n  CREATE TABLE aux.t2(x, y);\n  INSERT INTO aux.t2 VALUES('a', 'b');\n  PRAGMA schema_version = 450;\n  DETACH aux;\n\n  PRAGMA main.journal_mode = wal;\n  CREATE TABLE t1(a, b);\n  INSERT INTO t1 VALUES(1, 2);\n  INSERT INTO t1 VALUES(3, 4);\n  SELECT * FROM t1;",
          "expect": "wal wal 1 2 3 4"
        }
      ]
    },
    {
      "name": "superlock-6.2",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "1 {no such table: t1}"
        }
      ]
    },
    {
      "name": "superlock-6.3",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t2",
          "expect": "0 {a b}"
        }
      ]
    },
    {
      "name": "superlock-6.4",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "0 {1 2 3 4}"
        }
      ]
    },
    {
      "name": "superlock-6.5",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t2",
          "expect": "1 {no such table: t2}"
        }
      ]
    },
    {
      "name": "superlock-6.6",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA wal_checkpoint",
          "expect": "0 0 0"
        }
      ]
    },
