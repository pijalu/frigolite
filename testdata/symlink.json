{
  "file": "symlink.test",
  "name": "symlink",
  "ordered": true,
  "tests": [
    {
      "name": "symlink-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x, y);"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    },
    {
      "name": "symlink-1.1",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "symlink-1.1.2",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "open_named_db",
          "sql": "test.db2",
          "variable": "rc",
          "catchResult": true,
          "catchMessage": "msg",
          "expect": "1 {unable to open database file}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "symlink-1.1.3",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "symlink-1.1.4",
      "steps": [
        {
          "type": "catch",
          "sql": "ATTACH 'test.db2' AS aux1;",
          "expect": "1 {unable to open database: test.db2}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "symlink-1.2.1",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "symlink-1.2.2",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db2",
          "expect": "1",
          "database": "db2"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "symlink-1.3",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db",
          "catchMessage": "msg"
        }
      ]
    },
    {
      "name": "symlink-1.4",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.",
          "catchMessage": "msg"
        }
      ]
    },
    {
      "name": "symlink-1.5",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.",
          "catchMessage": "msg"
        }
      ]
    },
    {
      "name": "symlink-2.0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "close_named_db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db3"
        }
      ]
    },
    {
      "name": "symlink-2.0",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x)"
        }
      ]
    },
    {
      "name": "symlink-2.1.1",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db2",
          "expect": "0",
          "database": "db2"
        }
      ]
    },
    {
      "name": "symlink-3.1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
          "catchMessage": "res"
        },
        {
          "type": "runtime_var",
          "variable": "res",
          "expect": "unable to open database file"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "x"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "y"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "z"
        }
      ]
    },
    {
      "name": "symlink-4.1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = wal;\n    CREATE TABLE t1(x, y);\n    INSERT INTO t1 VALUES('hello', 'world');",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "symlink-4.2.1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "hello world"
        }
      ]
    },
    {
      "name": "symlink-4.3.1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "hello world"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "w"
        }
      ]
    },
    {
      "name": "symlink-4.4.1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "hello world"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "symlink-5.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE xyz(x, y, z);\n  INSERT INTO xyz VALUES(1, 2, 3);"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "../../../test.db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "symlink-5.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM xyz;",
          "expect": "1 2 3",
          "database": "db2"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    },
    {
      "name": "setup_3",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "symlink-5.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM xyz;",
          "expect": "1 2 3",
          "database": "db2"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    }
  ]
}