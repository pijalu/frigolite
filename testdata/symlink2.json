{
  "file": "symlink2.test",
  "name": "symlink2",
  "ordered": true,
  "tests": [
    {
      "name": "symlink2-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x, y);\n  INSERT INTO t1 VALUES(1,9999);"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "link.db"
        }
      ]
    },
    {
      "name": "symlink2-3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT x, y FROM t1;",
          "expect": "1 9999"
        }
      ]
    },
    {
      "name": "symlink2-3.2",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "link.db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "SELECT x, y FROM t1;",
          "expect": "1 9999",
          "database": "db2"
        }
      ]
    },
    {
      "name": "symlink2-3.3",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db3"
        },
        {
          "type": "exec",
          "sql": "SELECT x, y FROM t1;",
          "expect": "1 9999",
          "database": "db3"
        }
      ]
    },
    {
      "name": "symlink2-3.4",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db3"
        }
      ]
    },
    {
      "name": "symlink2-3.5",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "link.db",
          "database": "db4"
        },
        {
          "type": "catch",
          "sql": "SELECT x, y FROM t1;",
          "catchMessage": "res",
          "database": "db4"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db4"
        }
      ]
    },
    {
      "name": "symlink2-4.0",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "symlink2-5.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT x, y FROM t1;",
          "expect": "1 9999"
        }
      ]
    }
  ]
}