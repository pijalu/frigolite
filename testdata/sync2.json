{
  "file": "sync2.test",
  "name": "sync2",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "sync2-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n  INSERT INTO t1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "sync2-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(3, 4)",
          "expect": "4"
        }
      ]
    },
    {
      "name": "sync2-1.2.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA main.synchronous = NORMAL"
        }
      ]
    },
    {
      "name": "sync2-1.2.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA main.synchronous",
          "expect": "1"
        }
      ]
    },
    {
      "name": "sync2-1.2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(5, 6)",
          "expect": "3"
        }
      ]
    },
    {
      "name": "sync2-1.3.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA main.synchronous = OFF"
        }
      ]
    },
    {
      "name": "sync2-1.3.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA main.synchronous",
          "expect": "0"
        }
      ]
    },
    {
      "name": "sync2-1.3.3",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(7, 8)",
          "expect": "0"
        }
      ]
    },
    {
      "name": "sync2-1.4.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA main.synchronous = FULL"
        }
      ]
    },
    {
      "name": "sync2-1.4.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA main.synchronous",
          "expect": "2"
        }
      ]
    },
    {
      "name": "sync2-1.4.3",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(9, 10)",
          "expect": "4"
        }
      ]
    },
    {
      "name": "sync2-1.5",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = wal",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "sync2-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(11, 12)",
          "expect": "3"
        }
      ]
    },
    {
      "name": "sync2-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(13, 14)",
          "expect": "1"
        }
      ]
    },
    {
      "name": "sync2-1.8.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA main.synchronous = NORMAL"
        }
      ]
    },
    {
      "name": "sync2-1.8.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA main.synchronous",
          "expect": "1"
        }
      ]
    },
    {
      "name": "sync2-1.8.3",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(15, 16)",
          "expect": "0"
        }
      ]
    },
    {
      "name": "sync2-1.9",
      "steps": [
        {
          "type": "query_assign",
          "sql": "PRAGMA wal_checkpoint",
          "variable": "res",
          "resultAll": true,
          "expect": "2 0 3 3"
        }
      ]
    },
    {
      "name": "sync2-1.10.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA main.synchronous = OFF"
        }
      ]
    },
    {
      "name": "sync2-1.10.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA main.synchronous",
          "expect": "0"
        }
      ]
    },
    {
      "name": "sync2-1.10.3",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(17, 18)",
          "expectedExpr": "$res"
        }
      ]
    }
  ]
}