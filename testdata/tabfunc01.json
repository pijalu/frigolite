{
  "file": "tabfunc01.test",
  "name": "tabfunc01",
  "tests": [
    {
      "name": "tabfunc01-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT *, '|' FROM generate_series WHERE start=1 AND stop=9 AND step=2;",
          "expect": "1 | 3 | 5 | 7 | 9 |"
        }
      ]
    },
    {
      "name": "tabfunc01-1.1b",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA table_xinfo(generate_series);",
          "expect": "0 value {} 0 {} 0 0 1 start {} 0 {} 0 1 2 stop {} 0 {} 0 1 3 step {} 0 {} 0 1"
        }
      ]
    },
    {
      "name": "tabfunc01-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT *, '|' FROM generate_series(0) LIMIT 5;",
          "expect": "0 | 1 | 2 | 3 | 4 |"
        }
      ]
    },
    {
      "name": "tabfunc01-1.2b",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT *, '|' FROM generate_series LIMIT 5;",
          "expect": "1 {first argument to \"generate_series()\" missing or unusable}"
        }
      ]
    },
    {
      "name": "tabfunc01-1.2c",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT *, '|' FROM generate_series(value) LIMIT 5;",
          "expect": "1 {first argument to \"generate_series()\" missing or unusable}"
        }
      ]
    },
    {
      "name": "tabfunc01-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE t1 USING generate_series;",
          "expect": "1 {no such module: generate_series}"
        }
      ]
    },
