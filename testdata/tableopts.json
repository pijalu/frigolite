{
  "file": "tableopts.test",
  "name": "tableopts",
  "tests": [
    {
      "name": "tableopt-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b) WITHOUT rowid;",
          "expect": "1 {PRIMARY KEY missing on table t1}"
        }
      ]
    },
    {
      "name": "tableopt-1.1b",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a INTEGER PRIMARY KEY AUTOINCREMENT,b) WITHOUT rowid;",
          "expect": "1 {AUTOINCREMENT not allowed on WITHOUT ROWID tables}"
        }
      ]
    },
    {
      "name": "tableopt-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b) WITHOUT unknown2;",
          "expect": "1 {unknown table option: unknown2}"
        }
      ]
    },
    {
      "name": "tableopt-2.1",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t1(a, b, c, PRIMARY KEY(a,b)) WITHOUT rowid;\n  INSERT INTO t1 VALUES(1,2,3),(2,3,4);\n  SELECT c FROM t1 WHERE a IN (1,2) ORDER BY b;",
          "expect": "3 4"
        }
      ]
    },
    {
      "name": "tableopt-2.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT rowid, * FROM t1;",
          "expect": "1 {no such column: rowid}"
        }
      ]
    },
    {
      "name": "tableopt-2.1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT _rowid_, * FROM t1;",
          "expect": "1 {no such column: _rowid_}"
        }
      ]
    },
    {
      "name": "tableopt-2.1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT oid, * FROM t1;",
          "expect": "1 {no such column: oid}"
        }
      ]
    },
    {
      "name": "tableopt-2.2",
      "steps": [
        {
          "type": "query",
          "sql": "VACUUM;\n  SELECT c FROM t1 WHERE a IN (1,2) ORDER BY b;",
          "expect": "3 4"
        }
      ]
    },
    {
      "name": "tableopt-3.1",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE without(x INTEGER PRIMARY KEY, without TEXT);\n  INSERT INTO without VALUES(1, 'xyzzy'), (2, 'fizzle');\n  SELECT * FROM without WHERE without='xyzzy';",
          "expect": "1 xyzzy"
        }
      ]
    }
  ]
}