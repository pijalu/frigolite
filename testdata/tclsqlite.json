  "ordered": true,
  "tests": [
    {
      "name": "tcl-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a int, b int)"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(10,20)"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "variable": "v",
          "catchResult": true,
          "catchMessage": "msg",
          "expect": "1 {The error message}"
        }
      ]
    },
    {
      "name": "tcl-1.4",
