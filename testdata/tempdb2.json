{
  "file": "tempdb2.test",
  "name": "tempdb2",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "open_empty_db"
        },
        {
          "type": "register_function",
          "functionName": "int2str",
          "callbackVars": {
            "": "unlocked",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "testdir": "",
            "testprefix": "tempdb2",
            "unlocked": "unlocked"
          },
          "functionProc": "int2str",
          "functionArgs": [
            "i"
          ],
          "functionBody": " string range [string repeat \"$i.\" 450] 0 899 ",
          "minArgs": 1,
          "maxArgs": -1
        }
      ]
    },
    {
      "name": "tempdb2-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA page_size=1024;\n  PRAGMA cache_size=50;\n\n  BEGIN;\n    CREATE TABLE t1(a INTEGER PRIMARY KEY, b);\n    INSERT INTO t1 VALUES(1, int2str(1));\n    INSERT INTO t1 VALUES(2, int2str(1));\n    INSERT INTO t1 VALUES(3, int2str(1));\n\n    CREATE TABLE t2(a INTEGER PRIMARY KEY, b);\n    WITH c(x) AS ( VALUES(1) UNION ALL SELECT x+1 FROM c WHERE x\u003c100 ) \n    INSERT INTO t2 SELECT x, int2str(x) FROM c;\n  COMMIT;\n\n  PRAGMA lock_status;",
          "expect": "main unlocked temp closed"
        }
      ]
    },
    {
      "name": "tempdb2-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "UPDATE t1 SET b=int2str(2);\n  SELECT b=int2str(2) FROM t1",
          "expect": "1 1 1"
        }
      ]
    },
    {
      "name": "tempdb2-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    DELETE FROM t1;\n    UPDATE t2 SET b=int2str(a+1);\n  ROLLBACK;"
        }
      ]
    },
    {
      "name": "tempdb2-1.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT b=int2str(2) FROM t1",
          "expect": "1 1 1"
        }
      ]
    },
