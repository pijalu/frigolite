{
  "file": "temptable.test",
  "name": "temptable",
  "ordered": true,
  "tests": [
    {
      "name": "temptable-1.0",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "./test.db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "temptable-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b,c);"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(1,2,3);"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3"
        }
      ]
    },
    {
      "name": "temptable-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM sqlite_master",
          "database": "db2"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3",
          "database": "db2"
        }
      ]
    },
    {
      "name": "temptable-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT name FROM sqlite_master",
          "expect": "t1"
        }
      ]
    },
    {
      "name": "temptable-1.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT name FROM sqlite_master",
          "expect": "t1",
          "database": "db2"
        }
      ]
    },
    {
      "name": "temptable-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TEMP TABLE t2(x,y,z);\n    INSERT INTO t2 VALUES(4,5,6);",
          "database": "db2"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t2",
          "expect": "4 5 6",
          "database": "db2"
        }
      ]
    },
    {
      "name": "temptable-1.6",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM sqlite_master"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t2",
          "expect": "1 {no such table: t2}"
        }
      ]
    },
    {
      "name": "temptable-1.7",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t2 VALUES(8,9,0);",
          "expect": "1 {no such table: t2}"
        }
      ]
    },
    {
      "name": "temptable-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t2 VALUES(8,9,0);",
          "database": "db2"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t2 ORDER BY x",
          "expect": "4 5 6 8 9 0",
          "database": "db2"
        }
      ]
    },
    {
      "name": "temptable-1.9",
      "steps": [
        {
          "type": "exec",
          "sql": "DELETE FROM t2 WHERE x==8",
          "database": "db2"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t2 ORDER BY x",
          "expect": "4 5 6",
          "database": "db2"
        }
      ]
    },
    {
      "name": "temptable-1.10",
      "steps": [
        {
          "type": "exec",
          "sql": "DELETE FROM t2",
          "database": "db2"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "temptable-1.11",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t2 VALUES(7,6,5);\n     INSERT INTO t2 VALUES(4,3,2);\n     SELECT * FROM t2 ORDER BY x;",
          "expect": "4 3 2 7 6 5",
          "database": "db2"
        }
      ]
    },
    {
      "name": "temptable-1.12",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE t2;",
          "database": "db2"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t2",
          "variable": "r",
          "catchResult": true,
          "catchMessage": "msg",
          "expect": "1 {no such table: t2}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "temptable-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN TRANSACTION;\n    CREATE TEMPORARY TABLE t2(x,y);\n    INSERT INTO t2 VALUES(1,2);\n    SELECT * FROM t2;",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "temptable-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "ROLLBACK"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t2",
          "expect": "1 {no such table: t2}"
        }
      ]
    },
    {
      "name": "temptable-2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN TRANSACTION;\n    CREATE TEMPORARY TABLE t2(x,y);\n    INSERT INTO t2 VALUES(1,2);\n    SELECT * FROM t2;",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "temptable-2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t2",
          "expect": "0 {1 2}"
        }
      ]
    },
    {
      "name": "temptable-2.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t2",
          "variable": "r",
          "catchResult": true,
          "catchMessage": "msg",
          "expect": "1 {no such table: t2}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "temptable-3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE INDEX i2 ON t2(x);\n    SELECT name FROM sqlite_master WHERE type='index';"
        }
      ]
    },
    {
      "name": "temptable-3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT y FROM t2 WHERE x=1;",
          "expect": "2"
        }
      ]
    },
    {
      "name": "temptable-3.3",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP INDEX i2;\n    SELECT y FROM t2 WHERE x=1;",
          "expect": "2"
        }
      ]
    },
    {
      "name": "temptable-3.4",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE INDEX i2 ON t2(x);\n    DROP TABLE t2;"
        },
        {
          "type": "catch",
          "sql": "DROP INDEX i2",
          "expect": "1 {no such index: i2}"
        }
      ]
    },
    {
