    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "temptable-6.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t8(x);\n    INSERT INTO t8 VALUES('xyzzy');\n    SELECT * FROM t8;",
          "expect": "xyzzy"
        }
      ]
    },
    {
      "name": "temptable-6.2",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t8;",
          "expect": "xyzzy"
        }
      ]
    },
    {
      "name": "temptable-6.3",
      "steps": [
        {
          "type": "catch",
          "sql": "CREATE TABLE t9(x,y);",
          "expect": "1 {attempt to write a readonly database}"
        }
      ]
    },
    {
      "name": "temptable-6.4",
      "steps": [
        {
          "type": "catch",
          "sql": "CREATE TEMP TABLE t9(x,y);",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "temptable-6.5",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t9 VALUES(1,2);\n    SELECT * FROM t9;",
          "expect": "0 {1 2}"
        }
      ]
    },
    {
      "name": "temptable-6.6",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t8 VALUES('hello');\n    SELECT * FROM t8;",
          "expect": "1 {attempt to write a readonly database}"
        }
      ]
    },
    {
      "name": "temptable-6.7",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t8,t9;",
          "expect": "0 {xyzzy 1 2}"
        }
      ]
    },
