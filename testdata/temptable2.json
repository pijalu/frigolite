{
  "file": "temptable2.test",
  "name": "temptable2",
  "tests": [
    {
      "name": "1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TEMP TABLE t1(a, b);\n  CREATE INDEX i1 ON t1(a, b);"
        }
      ]
    },
    {
      "name": "1.3",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA temp.integrity_check;",
          "expect": "ok"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    },
    {
      "name": "2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TEMP TABLE t2(a, b);\n  INSERT INTO t2 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    INSERT INTO t2 VALUES(3, 4);\n    SELECT * FROM t2;",
          "expect": "1 2 3 4"
        }
      ]
    },
    {
      "name": "2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "ROLLBACK;\n  SELECT * FROM t2;",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    },
    {
      "name": "3.1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT count(*) FROM t1;",
          "expect": "1000"
        }
      ]
    },
    {
      "name": "3.1.4",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA temp.integrity_check",
          "expect": "ok"
        }
      ]
