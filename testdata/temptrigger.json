          "sql": "DROP TRIGGER tr1;\n  CREATE TRIGGER tr1 AFTER INSERT ON m1 BEGIN\n    INSERT INTO a1 SELECT d, c FROM aux.a1;\n  END;",
          "expect": "1 {trigger tr1 cannot reference objects in database aux}"
        }
      ]
    },
    {
      "name": "8.0",
      "steps": [
        {
          "type": "exec",
          "sql": "ATTACH 'test.db2' AS aux;\n  CREATE TABLE t1(a, b);\n  CREATE TABLE t2(c, d);\n  CREATE TABLE aux.t1(e, f);\n  CREATE TABLE aux.t2(g, h);"
