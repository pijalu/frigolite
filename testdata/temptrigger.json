    {
      "name": "temptrigger-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n    CREATE TEMP TABLE tt1(a, b);\n    CREATE TEMP TRIGGER tr1 AFTER INSERT ON t1 BEGIN\n      INSERT INTO tt1 VALUES(new.a, new.b);\n    END;"
        }
      ]
    },
    {
      "name": "temptrigger-1.2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(1, 2)"
