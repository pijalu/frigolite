    {
      "name": "4.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n  CREATE TEMP TRIGGER tr1 BEFORE INSERT ON t1 BEGIN\n    SELECT 1,2,3;\n  END;"
        }
      ]
    },
    {
      "name": "4.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TEMP TABLE t1(x);"
        }
      ]
    },
    {
      "name": "5.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n  CREATE TEMP TRIGGER tr1 BEFORE INSERT ON t1 BEGIN SELECT 1,2,3; END;"
        }
      ]
    },
    {
      "name": "5.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM sqlite_master;\n  SELECT * FROM temp.sqlite_master;",
          "expect": "trigger tr1 t1 0 \n  {CREATE TRIGGER tr1 BEFORE INSERT ON t1 BEGIN SELECT 1,2,3; END}"
        }
      ]
    },
    {
