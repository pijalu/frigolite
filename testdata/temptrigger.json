      "name": "8.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TRIGGER tr1 AFTER INSERT ON t2 BEGIN\n    INSERT INTO aux.t1 VALUES(new.c, new.d);\n  END;",
          "expect": "1 {qualified table names are not allowed on INSERT, UPDATE, and DELETE statements within triggers}"
        }
      ]
    },
