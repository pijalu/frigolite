{
  "file": "tkt-4a03edc4c8.test",
  "name": "tkt-4a03edc4c8",
  "ordered": true,
  "tests": [
    {
      "name": "tkt-4a03ed-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(\n      a INTEGER PRIMARY KEY ON CONFLICT REPLACE,\n      b UNIQUE ON CONFLICT FAIL\n    );\n    INSERT INTO t1 VALUES(1, 1);\n    INSERT INTO t1 VALUES(2, 2);"
        },
        {
          "type": "catch",
          "sql": "BEGIN;\n      INSERT INTO t1 VALUES(1, 2);\n    COMMIT;",
          "expect": "1 {UNIQUE constraint failed: t1.b}"
        }
      ]
    },
    {
      "name": "tkt-4a03ed-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA integrity_check;",
          "expect": "ok"
        }
      ]
    },
    {
      "name": "tkt-4a03ed-1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1 ORDER BY a;",
          "expect": "1 1 2 2"
        }
      ]
    }
  ]
}