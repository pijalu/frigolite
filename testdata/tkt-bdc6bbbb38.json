        }
      ]
    },
    {
      "name": "tkt-bdc6bbbb38-1.1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT offsets(t2) FROM t2 WHERE t2 MATCH 'a AND d OR b' ORDER BY docid ASC",
          "expect": "\n    {0 0 0 1 0 2 2 1}\n  "
        }
      ]
    },
    {
