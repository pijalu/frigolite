{
  "file": "tkt-f3e5abed55.test",
  "name": "tkt-f3e5abed55",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "delete_glob",
          "sql": "test.db*mj*"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    },
    {
      "name": "tkt-f3e5abed55-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "ATTACH 'test.db2' AS aux;\n    CREATE TABLE main.t1(a, b);\n    CREATE TABLE aux.t2(c, d);"
        }
      ]
    },
    {
      "name": "tkt-f3e5abed55-1.3",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "BEGIN; SELECT * FROM t1",
          "database": "db2"
        }
      ]
    },
    {
      "name": "tkt-f3e5abed55-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n      INSERT INTO t1 VALUES(1, 2);\n      INSERT INTO t2 VALUES(1, 2);"
        },
        {
          "type": "catch",
          "sql": "COMMIT",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "tkt-f3e5abed55-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "COMMIT"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "delete_glob",
          "sql": "test.db*mj*"
        },
        {
          "type": "close_db"
        },
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "register_testvfs",
          "sql": "default",
          "variable": "tvfs"
        },
        {
          "type": "testvfs_config",
          "sql": "script",
          "variable": "xDelete",
          "callbackProcs": [
            {
              "Name": "xDelete",
              "Args": [
                "method",
                "file",
                "args"
              ],
              "Body": "\n    if {[file tail $file] == \"test.db-journal\"} {\n      faultsim_save\n      tvfs filter {}\n    }\n    return \"SQLITE_OK\"\n  ",
              "Defaults": null
            }
          ],
          "functionProc": "xDelete",
          "database": "tvfs"
        },
        {
          "type": "testvfs_config",
          "sql": "filter",
          "variable": "xDelete",
          "database": "tvfs"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "tkt-f3e5abed55-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "ATTACH 'test.db2' AS aux;\n      BEGIN;\n        INSERT INTO t1 VALUES(3, 4);\n        INSERT INTO t2 VALUES(3, 4);"
        }
      ]
    },
    {
      "name": "tkt-f3e5abed55-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN; SELECT * FROM t1",
          "expect": "1 2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "tkt-f3e5abed55-2.3",
      "steps": [
        {
          "type": "catch",
          "sql": "COMMIT",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "tkt-f3e5abed55-2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "COMMIT;\n      SELECT * FROM t1;\n      SELECT * FROM t2;",
          "expect": "1 2 3 4 1 2 3 4"
        }
      ]
    },
    {
      "name": "tkt-f3e5abed55-2.5",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "faultsim_restore_reopen"
        },
        {
          "type": "exec",
          "sql": "ATTACH 'test.db2' AS aux;\n      SELECT * FROM t1;\n      SELECT * FROM t2;",
          "expect": "1 2 3 4 1 2 3 4"
        }
      ]
    }
  ]
}