{
  "file": "tkt-f3e5abed55.test",
  "name": "tkt-f3e5abed55",
  "ordered": true,
  "tests": [
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    },
    {
      "name": "tkt-f3e5abed55-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "ATTACH 'test.db2' AS aux;\n    CREATE TABLE main.t1(a, b);\n    CREATE TABLE aux.t2(c, d);"
        }
      ]
    },
    {
      "name": "tkt-f3e5abed55-1.3",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "BEGIN; SELECT * FROM t1",
          "database": "db2"
        }
      ]
    },
    {
      "name": "tkt-f3e5abed55-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n      INSERT INTO t1 VALUES(1, 2);\n      INSERT INTO t2 VALUES(1, 2);"
        },
        {
          "type": "catch",
          "sql": "COMMIT",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "tkt-f3e5abed55-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "COMMIT"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "tkt-f3e5abed55-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "ATTACH 'test.db2' AS aux;\n      BEGIN;\n        INSERT INTO t1 VALUES(3, 4);\n        INSERT INTO t2 VALUES(3, 4);"
        }
      ]
    },
    {
      "name": "tkt-f3e5abed55-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN; SELECT * FROM t1",
          "expect": "1 2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "tkt-f3e5abed55-2.3",
      "steps": [
        {
          "type": "catch",
          "sql": "COMMIT",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "tkt-f3e5abed55-2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "COMMIT;\n      SELECT * FROM t1;\n      SELECT * FROM t2;",
          "expect": "1 2 3 4 1 2 3 4"
        }
      ]
    },
    {
      "name": "tkt-f3e5abed55-2.5",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "ATTACH 'test.db2' AS aux;\n      SELECT * FROM t1;\n      SELECT * FROM t2;",
          "expect": "1 2 3 4 1 2 3 4"
        }
      ]
    }
  ]
}