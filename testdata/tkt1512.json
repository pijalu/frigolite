{
  "file": "tkt1512.test",
  "name": "tkt1512",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA auto_vacuum"
        }
      ]
    },
    {
      "name": "tkt1512-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b);\n    INSERT INTO t1 VALUES(1,2);\n    INSERT INTO t1 VALUES(3,4);\n    SELECT * FROM t1",
          "expect": "1 2 3 4"
        }
      ]
    },
    {
      "name": "tkt1512-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE t1;",
          "expect": "2048"
        }
      ]
    },
    {
      "name": "tkt1512-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "VACUUM;",
          "expect": "1024"
        }
      ]
    }
  ]
}