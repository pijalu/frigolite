          "sql": "test2.db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test2.db-journal"
        }
      ]
    },
    {
      "name": "tkt1873-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x, y);\n    ATTACH 'test2.db' AS aux;\n    CREATE TABLE aux.t2(x, y);\n    INSERT INTO t1 VALUES(1, 2);\n    INSERT INTO t1 VALUES(3, 4);\n    INSERT INTO t2 VALUES(5, 6);\n    INSERT INTO t2 VALUES(7, 8);"
        }
      ]
    },
    {
      "name": "tkt1873-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t2 LIMIT 1",
          "variable": "rc",
          "catchResult": true,
          "catchMessage": "msg"
        }
      ]
    },
    {
      "name": "tkt1873-1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1 LIMIT 1",
          "variable": "rc",
          "catchResult": true,
          "catchMessage": "msg"
        }
      ]
    },
    {
      "name": "tkt1873-1.4",
      "steps": [
        {
          "type": "catch",
          "sql": "select * from t2;",
          "expect": "1 {no such table: t2}"
        }
      ]
    },
    {
      "name": "tkt1873-1.5",
      "steps": [
        {
          "type": "catch",
          "sql": "ATTACH 'test2.db' AS aux;\n    select * from t2;",
          "expect": "0 {5 6 7 8}"
        }
      ]
    }
  ]
