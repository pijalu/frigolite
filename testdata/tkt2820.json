          "sql": "CREATE TABLE t1(a);"
        }
      ]
    },
    {
      "name": "tkt2820-1.1",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "SELECT * FROM sqlite_master",
          "variable": "stmt_1"
        },
        {
          "type": "stmt_step",
          "sql": "SELECT * FROM sqlite_master",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__",
          "expect": "SQLITE_ROW"
        }
      ]
    },
    {
      "name": "tkt2820-1.2",
      "steps": [
        {
          "type": "catch",
          "sql": "DROP TABLE t1",
          "expect": "1 {database table is locked}"
        }
      ]
    },
    {
      "name": "tkt2820-1.3",
      "steps": [
        {
          "type": "stmt_finalize",
          "sql": "SELECT * FROM sqlite_master",
          "variable": "stmt_1"
        },
        {
          "type": "exec",
          "sql": "SELECT name FROM sqlite_master ORDER BY 1",
          "expect": "t1"
        }
