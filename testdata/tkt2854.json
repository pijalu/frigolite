{
  "file": "tkt2854.test",
  "name": "tkt2854",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "tkt2854-1.1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "open_named_db",
          "sql": "file:test.db?cache=private",
          "database": "db3"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE abc(a, b, c);"
        }
      ]
    },
    {
      "name": "tkt2854-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    SELECT * FROM abc;",
          "database": "db2"
        }
      ]
    },
    {
      "name": "tkt2854-1.3",
      "steps": [
        {
          "type": "catch",
          "sql": "BEGIN EXCLUSIVE",
          "expect": "1 {database table is locked}"
        }
      ]
    },
    {
      "name": "tkt2854-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM abc",
          "database": "db3"
        }
      ]
    },
    {
      "name": "tkt2854-1.5",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO abc VALUES(1, 2, 3)",
          "expect": "1 {database is locked}",
          "database": "db3"
        }
      ]
    },
    {
      "name": "tkt2854-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT",
          "database": "db2"
        }
      ]
    },
    {
      "name": "tkt2854-1.7",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "SELECT * FROM abc",
          "variable": "stmt_1"
        },
        {
          "type": "prepare_stmt",
          "sql": "BEGIN EXCLUSIVE",
          "variable": "stmt_2"
        },
        {
          "type": "prepare_stmt",
          "sql": "BEGIN IMMEDIATE",
          "variable": "stmt_3"
        },
        {
          "type": "prepare_stmt",
          "sql": "BEGIN",
          "variable": "stmt_4"
        },
        {
          "type": "prepare_stmt",
          "sql": "COMMIT",
          "variable": "stmt_5"
        },
        {
          "type": "exec",
          "sql": "BEGIN EXCLUSIVE"
        }
      ]
    },
    {
      "name": "tkt2854-1.8",
      "steps": [
        {
          "type": "catch",
          "sql": "BEGIN EXCLUSIVE",
          "expect": "1 {database schema is locked: main}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "tkt2854-1.9",
      "steps": [
        {
          "type": "catch",
          "sql": "BEGIN IMMEDIATE",
          "expect": "1 {database schema is locked: main}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "tkt2854-1.10",
      "steps": [
        {
          "type": "catch",
          "sql": "BEGIN",
          "expect": "1 {database schema is locked: main}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "tkt2854-1.11",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "SELECT * FROM abc",
          "variable": "stmt_1"
        },
        {
          "type": "stmt_finalize",
          "sql": "SELECT * FROM abc",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__ SQLITE_OK",
          "expect": "SQLITE_ERROR SQLITE_LOCKED"
        }
      ]
    },
    {
      "name": "tkt2854-1.12",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "BEGIN EXCLUSIVE",
          "variable": "stmt_2"
        },
        {
          "type": "stmt_finalize",
          "sql": "BEGIN EXCLUSIVE",
          "variable": "stmt_2"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_2__ SQLITE_OK",
          "expect": "SQLITE_ERROR SQLITE_LOCKED"
        }
      ]
    },
    {
      "name": "tkt2854-1.13",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "BEGIN IMMEDIATE",
          "variable": "stmt_3"
        },
        {
          "type": "stmt_finalize",
          "sql": "BEGIN IMMEDIATE",
          "variable": "stmt_3"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_3__ SQLITE_OK",
          "expect": "SQLITE_ERROR SQLITE_LOCKED"
        }
      ]
    },
    {
      "name": "tkt2854-1.14",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "BEGIN",
          "variable": "stmt_4"
        },
        {
          "type": "stmt_finalize",
          "sql": "BEGIN",
          "variable": "stmt_4"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_4__ SQLITE_OK",
          "expect": "SQLITE_DONE SQLITE_OK"
        }
      ]
    },
    {
      "name": "tkt2854-1.15",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "COMMIT",
          "variable": "stmt_5"
        },
        {
          "type": "stmt_finalize",
          "sql": "COMMIT",
          "variable": "stmt_5"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_5__ SQLITE_OK",
          "expect": "SQLITE_DONE SQLITE_OK"
        }
      ]
    },
    {
      "name": "tkt2854-1.16",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM abc",
