{
  "file": "tkt35xx.test",
  "name": "tkt35xx",
  "tests": [
    {
      "name": "tkt35xx-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA auto_vacuum = 0;\n    PRAGMA page_size = 1024;"
        },
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum = 0;\n    PRAGMA page_size = 1024;"
        }
      ]
    },
    {
      "name": "tkt35xx-1.2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    CREATE TABLE t5(e PRIMARY KEY, f);\n    DROP TABLE t5;\n    INSERT INTO t3(a, b) SELECT c, d FROM t4;",
          "expect": "1 {UNIQUE constraint failed: t3.a}"
        }
      ]
    },
    {
      "name": "tkt35xx-1.2.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT count(*) FROM t3",
          "expect": "4"
        },
        {
          "type": "exec",
          "sql": "SELECT count(*) FROM t3"
        }
      ]
    },
    {
      "name": "tkt35xx-1.2.6",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT count(*) FROM t3",
          "expect": "5"
        },
        {
          "type": "exec",
          "sql": "SELECT count(*) FROM t3"
        }
      ]
    }
  ]
}