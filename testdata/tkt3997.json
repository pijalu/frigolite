{
  "file": "tkt3997.test",
  "name": "tkt3997",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "register_collation",
          "collationName": "reverse",
          "collationProc": "reverse",
          "collationBody": "\n  return [string compare $rhs $lhs]\n",
          "callbackVars": {
            "": "",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "testdir": ""
          },
          "functionArgs": [
            "lhs",
            "rhs"
          ]
        },
        {
          "type": "register_collation",
          "collationName": "usual",
          "collationProc": "usual",
          "collationBody": "\n  return [string compare $lhs $rhs]\n",
          "callbackVars": {
            "": "",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "testdir": ""
          },
          "functionArgs": [
            "lhs",
            "rhs"
          ]
        }
      ]
    },
    {
      "name": "tkt3997-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "create table mytext(name BLOB);\n    INSERT INTO mytext VALUES('abc');\n    INSERT INTO mytext VALUES('acd');\n    INSERT INTO mytext VALUES('afe');"
        }
      ]
    },
    {
      "name": "tkt3997-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT name \n    FROM mytext \n    ORDER BY name COLLATE reverse",
          "expect": "afe acd abc"
        }
      ]
    },
    {
      "name": "tkt3997-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT name \n    FROM (SELECT name FROM mytext)  \n    ORDER BY name COLLATE reverse",
          "expect": "afe acd abc"
        }
      ]
    },
    {
      "name": "tkt3997-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE mytext2(name COLLATE reverse);\n    INSERT INTO mytext2 SELECT name FROM mytext;"
        }
      ]
    },
    {
      "name": "tkt3997-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT name \n    FROM (SELECT name FROM mytext2)  \n    ORDER BY name",
          "expect": "afe acd abc"
        }
      ]
    },
    {
      "name": "tkt3997-2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT name \n    FROM (SELECT name FROM mytext2)\n    ORDER BY name COLLATE usual",
          "expect": "abc acd afe"
        }
      ]
    }
  ]
}