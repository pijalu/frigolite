{
  "file": "trace.test",
  "name": "trace",
  "ordered": true,
  "tests": [
    {
      "name": "trace-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b);\n    INSERT INTO t1 VALUES(1,2);\n    SELECT * FROM t1;",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "trace-1.4",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "stmtlist",
          "expect": "{CREATE TABLE t1(a,b);} {INSERT INTO t1 VALUES(1,2);} {SELECT * FROM t1;}"
        }
      ]
    },
    {
      "name": "trace-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1b(x TEXT PRIMARY KEY, y);\n     INSERT INTO t1b VALUES('abc','def'),('ghi','jkl'),('mno','pqr');"
        },
        {
          "type": "query",
          "sql": "SELECT y FROM t1b WHERE x GLOB 'a*'",
          "expect": "def"
        }
      ]
    },
    {
      "name": "trace-1.7",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "stmtlist",
          "expect": "{SELECT y FROM t1b WHERE x GLOB 'a*'}"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "trace-2.1",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "INSERT INTO t1 VALUES(2,3)",
          "variable": "stmt_1"
        },
        {
          "type": "stmt_step",
          "sql": "INSERT INTO t1 VALUES(2,3)",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "expect": "{INSERT INTO t1 VALUES(2,3)}"
        }
      ]
    },
    {
      "name": "trace-2.2",
      "steps": [
        {
          "type": "stmt_reset",
          "sql": "INSERT INTO t1 VALUES(2,3)",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert"
        }
      ]
    },
    {
      "name": "trace-2.3",
      "steps": [
        {
          "type": "stmt_step",
          "sql": "INSERT INTO t1 VALUES(2,3)",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "expect": "{INSERT INTO t1 VALUES(2,3)}"
        }
      ]
    },
    {
      "name": "trace-2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 2 3 2 3"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "stmt_finalize",
          "sql": "INSERT INTO t1 VALUES(2,3)",
          "variable": "stmt_1"
        }
      ]
    },
    {
      "name": "trace-2.6",
      "steps": [
        {
          "type": "exec",
          "sql": "VACUUM",
          "expect": "VACUUM"
        }
      ]
    },
    {
