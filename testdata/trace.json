    {
      "name": "trace-5.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TRIGGER r1t1 AFTER UPDATE ON t1 BEGIN\n        UPDATE t2 SET a=new.a WHERE rowid=new.rowid;\n      END;\n      CREATE TRIGGER r1t2 AFTER UPDATE ON t2 BEGIN\n        SELECT 'hello';\n      END;"
        },
        {
          "type": "exec",
          "sql": "UPDATE t1 SET a=a+1;",
          "expect": "{UPDATE t1 SET a=a+1;} {-- TRIGGER r1t1} {-- UPDATE t2 SET a=new.a WHERE rowid=new.rowid} {-- TRIGGER r1t2} {-- SELECT 'hello'} {-- TRIGGER r1t1} {-- UPDATE t2 SET a=new.a WHERE rowid=new.rowid} {-- TRIGGER r1t2} {-- SELECT 'hello'} {-- TRIGGER r1t1} {-- UPDATE t2 SET a=new.a WHERE rowid=new.rowid} {-- TRIGGER r1t2} {-- SELECT 'hello'}"
        }
      ]
    },
    {
      "name": "trace-6.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT x'3031323334' AS x"
        },
        {
          "type": "exec",
          "sql": "SELECT 6, 6.0, 'test-six y''all', $t6blob, $t6null",
          "expect": "6 6.0 {test-six y'all} 01234 {}"
        }
      ]
    },
    {
      "name": "trace-6.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT 6, ?1, 6",
          "expect": "6 6 6"
        }
      ]
    },
    {
      "name": "trace-6.5",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t6([$::t6int],\"?1\"); INSERT INTO t6 VALUES(1,2)"
        },
        {
          "type": "exec",
          "sql": "SELECT '$::t6int', [$::t6int], 6, ?1, \"?1\", 6 FROM t6",
          "expect": "{$::t6int} 1 6 6 2 6"
        }
      ]
    },
    {
      "name": "trace-6.100",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "open_empty_db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA encoding=UTF16be;\n     CREATE TABLE t6([$::t6str],\"?1\");\n     INSERT INTO t6 VALUES(1,2);"
        },
        {
          "type": "exec",
          "sql": "SELECT '$::t6str', [$::t6str], 'test-six y''all', ?1, \"?1\", 'test-six y''all' FROM t6",
          "expect": "{$::t6str} 1 {test-six y'all} {test-six y'all} 2 {test-six y'all}"
        }
      ]
    },
    {
      "name": "trace-6.200",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "open_empty_db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA encoding=UTF16le;\n     CREATE TABLE t6([$::t6str],\"?1\");\n     INSERT INTO t6 VALUES(1,2);"
        },
        {
          "type": "exec",
          "sql": "SELECT '$::t6str', [$::t6str], 'test-six y''all', ?1, \"?1\", 'test-six y''all' FROM t6",
          "expect": "{$::t6str} 1 {test-six y'all} {test-six y'all} 2 {test-six y'all}"
        }
      ]
