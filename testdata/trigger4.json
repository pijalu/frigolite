{
  "file": "trigger4.test",
  "name": "trigger4",
  "ordered": true,
  "tests": [
    {
      "name": "trigger4-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "create table test1(id integer primary key,a);\n    create table test2(id integer,b);\n    create view test as\n      select test1.id as id,a as a,b as b\n      from test1 join test2 on test2.id =  test1.id;\n    create trigger I_test instead of insert on test\n      begin\n        insert into test1 (id,a) values (NEW.id,NEW.a);\n        insert into test2 (id,b) values (NEW.id,NEW.b);\n      end;\n    insert into test values(1,2,3);\n    select * from test1;",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "trigger4-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "select * from test2;",
          "expect": "1 3"
        }
      ]
    },
    {
      "name": "trigger4-1.3",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "insert into test values(4,5,6);\n    select * from test1;",
          "expect": "1 2 4 5"
        }
      ]
    },
    {
      "name": "trigger4-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "select * from test2;",
          "expect": "1 3 4 6"
        }
      ]
    },
    {
      "name": "trigger4-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "create trigger U_test instead of update on test\n      begin\n        update test1 set a=NEW.a where id=NEW.id;\n        update test2 set b=NEW.b where id=NEW.id;\n      end;\n    update test set a=22 where id=1;\n    select * from test1;",
          "expect": "1 22 4 5"
        }
      ]
    },
    {
      "name": "trigger4-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "select * from test2;",
          "expect": "1 3 4 6"
        }
      ]
    },
    {
      "name": "trigger4-2.3",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "update test set b=66 where id=4;\n    select * from test1;",
          "expect": "1 22 4 5"
        }
      ]
    },
    {
      "name": "trigger4-2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "select * from test2;",
          "expect": "1 3 4 66"
        }
      ]
    },
    {
      "name": "trigger4-3.1",
      "steps": [
        {
          "type": "catch",
          "sql": "drop table test2;\n    insert into test values(7,8,9);",
          "expect": "1 {no such table: main.test2}"
        }
      ]
    },
    {
      "name": "trigger4-3.2",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "catch",
          "sql": "insert into test values(7,8,9);",
          "expect": "1 {no such table: main.test2}"
        }
      ]
    },
    {
      "name": "trigger4-3.3",
      "steps": [
        {
          "type": "catch",
          "sql": "update test set a=222 where id=1;",
          "expect": "1 {no such table: main.test2}"
        }
      ]
    },
    {
      "name": "trigger4-3.4",
      "steps": [
        {
          "type": "exec",
          "sql": "select * from test1;",
          "expect": "1 22 4 5"
        }
      ]
    },
    {
      "name": "trigger4-3.5",
      "steps": [
        {
          "type": "exec",
          "sql": "create table test2(id,b);\n    insert into test values(7,8,9);\n    select * from test1;",
          "expect": "1 22 4 5 7 8"
        }
      ]
    },
    {
      "name": "trigger4-3.6",
      "steps": [
        {
          "type": "exec",
          "sql": "select * from test2;",
          "expect": "7 9"
        }
      ]
    },
    {
      "name": "trigger4-3.7",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "update test set b=99 where id=7;\n    select * from test2;",
          "expect": "7 99"
        }
      ]
    },
    {
      "name": "trigger4-4.1",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "trigtest.db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "trigtest.db-journal"
        }
      ]
    },
    {
      "name": "trigger4-4.1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "trigtest.db"
        },
        {
          "type": "catch",
          "sql": "drop table tbl; drop view vw"
        },
        {
          "type": "exec",
          "sql": "create table tbl(a integer primary key, b integer);\n\tcreate view vw as select * from tbl;\n\tcreate trigger t_del_tbl instead of delete on vw for each row begin\n\t  delete from tbl where a = old.a;\n\tend;\n\tcreate trigger t_upd_tbl instead of update on vw for each row begin\n\t  update tbl set a=new.a, b=new.b where a = old.a;\n\tend;\n\tcreate trigger t_ins_tbl instead of insert on vw for each row begin\n\t  insert into tbl values (new.a,new.b);\n\tend;\n\tinsert into tbl values(101,1001);\n\tinsert into tbl values(102,1002);\n\tinsert into tbl select a+2, b+2 from tbl;\n\tinsert into tbl select a+4, b+4 from tbl;\n\tinsert into tbl select a+8, b+8 from tbl;\n\tinsert into tbl select a+16, b+16 from tbl;\n\tinsert into tbl select a+32, b+32 from tbl;\n\tinsert into tbl select a+64, b+64 from tbl;\n\tselect count(*) from vw;",
          "expect": "128"
        }
      ]
    },
    {
      "name": "trigger4-4.2",
      "steps": [
        {
          "type": "exec",
          "sql": "select a, b from vw where a\u003c103 or a\u003e226 order by a",
          "expect": "101 1001 102 1002 227 1127 228 1128"
        }
      ]
    },
    {
      "name": "trigger4-5.1",
      "steps": [
        {
          "type": "catch",
          "sql": "delete from vw where a\u003e101 and a\u003c2000",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "trigger4-5.2",
      "steps": [
        {
          "type": "exec",
          "sql": "select * from vw",
          "expect": "101 1001"
        }
      ]
    },
    {
      "name": "trigger4-6.1",
      "steps": [
        {
          "type": "catch",
          "sql": "insert into vw values(102,1002);\n\tinsert into vw select a+2, b+2 from vw;\n\tinsert into vw select a+4, b+4 from vw;\n\tinsert into vw select a+8, b+8 from vw;\n\tinsert into vw select a+16, b+16 from vw;\n\tinsert into vw select a+32, b+32 from vw;\n\tinsert into vw select a+64, b+64 from vw;",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "trigger4-6.2",
      "steps": [
        {
          "type": "exec",
          "sql": "select count(*) from vw",
          "expect": "128"
        }
      ]
    },
    {
      "name": "trigger4-7.1",
      "steps": [
        {
          "type": "catch",
          "sql": "update vw set b=b+1000 where a\u003e101 and a\u003c2000",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "trigger4-7.2",
      "steps": [
        {
          "type": "exec",
          "sql": "select a, b from vw where a\u003c=102 or a\u003e=227 order by a",
          "expect": "101 1001 102 2002 227 2127 228 2128"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "trigtest.db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
