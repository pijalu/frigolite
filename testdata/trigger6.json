{
  "file": "trigger6.test",
  "name": "trigger6",
  "ordered": true,
  "tests": [
    {
      "name": "trigger6-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x, y);\n    CREATE TABLE log(a, b, c);\n    CREATE TRIGGER r1 BEFORE INSERT ON t1 BEGIN\n      INSERT INTO log VALUES(1, new.x, new.y);\n    END;\n    CREATE TRIGGER r2 BEFORE UPDATE ON t1 BEGIN\n      INSERT INTO log VALUES(2, new.x, new.y);\n    END;"
        },
        {
          "type": "register_function",
          "functionName": "counter",
          "callbackVars": {
            "": "0",
            "::trigger6_cnt": "0",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "testdir": ""
          },
          "functionProc": "trigger6_counter",
          "functionArgs": [
            "args"
          ],
          "functionBody": "\n    incr ::trigger6_cnt\n    return $::trigger6_cnt\n  ",
          "maxArgs": -1
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(1,counter());\n    SELECT * FROM t1;",
          "expect": "1 1"
        }
      ]
    },
    {
      "name": "trigger6-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM log;",
          "expect": "1 1 1"
        }
      ]
    },
    {
      "name": "trigger6-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "DELETE FROM t1;\n    DELETE FROM log;\n    INSERT INTO t1 VALUES(2,counter(2,3)+4);\n    SELECT * FROM t1;",
          "expect": "2 6"
        }
      ]
    },
    {
      "name": "trigger6-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM log;",
          "expect": "1 2 6"
        }
      ]
    },
    {
      "name": "trigger6-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "DELETE FROM log;\n    UPDATE t1 SET y=counter(5);\n    SELECT * FROM t1;",
          "expect": "2 3"
        }
      ]
    },
    {
      "name": "trigger6-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM log;",
          "expect": "2 2 3"
        }
      ]
    }
  ]
}