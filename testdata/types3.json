{
  "file": "types3.test",
  "name": "types3",
  "ordered": true,
  "tests": [
    {
      "name": "types3-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT typeof(:V)",
          "expect": "text"
        }
      ]
    },
    {
      "name": "types3-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT typeof(:V)",
          "expect": "int integer"
        }
      ]
    },
    {
      "name": "types3-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT typeof(:V)",
          "expect": "int integer"
        }
      ]
    },
    {
      "name": "types3-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT typeof(:V)",
          "expect": "double real"
        }
      ]
    },
    {
      "name": "types3-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT typeof(:V)",
          "expect": "bytearray blob"
        }
      ]
    },
    {
      "name": "types3-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT typeof(:V)",
          "expect": "bytearray text"
        }
      ]
    },
    {
      "name": "types3-2.1",
      "steps": [
        {
          "type": "query_assign",
          "sql": "SELECT x'616263'",
          "variable": "V",
          "expect": "bytearray"
        }
      ]
    },
    {
      "name": "types3-2.2",
      "steps": [
        {
          "type": "query_assign",
          "sql": "SELECT 123",
          "variable": "V",
          "expect": "int"
        }
      ]
    },
    {
      "name": "types3-2.3",
      "steps": [
        {
          "type": "query_assign",
          "sql": "SELECT 1234567890123456",
          "variable": "V"
        }
      ]
    },
    {
      "name": "types3-2.4.1",
      "steps": [
        {
          "type": "query_assign",
          "sql": "SELECT 1234567890123456.1",
          "variable": "V",
          "expect": "double"
        }
      ]
    },
    {
      "name": "types3-2.4.2",
      "steps": [
        {
          "type": "query_assign",
          "sql": "SELECT 1234567890123.456",
          "variable": "V",
          "expect": "double"
        }
      ]
    },
    {
      "name": "types3-2.5",
      "steps": [
        {
          "type": "query_assign",
          "sql": "SELECT '1234567890123456.0'",
          "variable": "V"
        }
      ]
    },
    {
      "name": "types3-2.6",
      "steps": [
        {
          "type": "query_assign",
          "sql": "SELECT NULL",
          "variable": "V"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "register_test_funcs"
        }
      ]
    },
    {
      "name": "types3-3.1",
      "steps": [
        {
          "type": "query",
          "sql": "DROP TABLE IF EXISTS t1;\n  CREATE TABLE t1(x TEXT PRIMARY KEY);\n  INSERT INTO t1 VALUES('1');\n  SELECT * FROM t1 WHERE NOT x=upper(1);"
        }
      ]
    },
    {
      "name": "types3-3.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1 WHERE NOT x=add_text_type(1);"
        }
      ]
    },
    {
      "name": "types3-3.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1 WHERE NOT x=add_int_type('1');"
        }
      ]
    },
    {
      "name": "types3-3.4",
      "steps": [
        {
          "type": "query",
          "sql": "DELETE FROM t1;\n  INSERT INTO t1 VALUES(1.25);\n  SELECT * FROM t1 WHERE NOT x=add_real_type('1.25');"
        }
      ]
    },
    {
      "name": "types3-3.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1 WHERE NOT x=add_text_type(1.25);"
        }
      ]
    }
  ]
}