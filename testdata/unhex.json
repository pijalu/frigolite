{
  "file": "unhex.test",
  "name": "unhex",
  "tests": [
    {
      "name": "2.0",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT typeof( unhex('') ), length( unhex('') );",
          "expect": "blob 0"
        }
      ]
    },
    {
      "name": "3.0",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT unhex();",
          "expect": "1 {wrong number of arguments to function unhex()}"
        }
      ]
    },
    {
      "name": "3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT unhex('ABCD', '1234', '');",
          "expect": "1 {wrong number of arguments to function unhex()}"
        }
      ]
    },
    {
      "name": "6.0",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT typeof( unhex(' ', ' -') ), length( unhex('-', ' -') );",
          "expect": "blob 0"
        }
      ]
    },
    {
      "name": "6.4.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT typeof(unhex(NULL))",
          "expect": "null"
        }
      ]
    },
    {
      "name": "6.4.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT typeof(unhex(NULL, ' '))",
          "expect": "null"
        }
      ]
    },
    {
      "name": "6.4.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT typeof(unhex('1234', NULL))",
          "expect": "null"
        }
      ]
    }
  ]
}