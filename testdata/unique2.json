{
  "file": "unique2.test",
  "name": "unique2",
  "ordered": true,
  "tests": [
    {
      "name": "1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE IF EXISTS t1"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x TEXT PRIMARY KEY, y NOT NULL) WITHOUT ROWID"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1(x,y) VALUES(1,1),(2,2),(3,2),(4,3)"
        }
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {
          "type": "catch",
          "sql": "CREATE UNIQUE INDEX t1y ON t1(y)",
          "expect": "1 {UNIQUE constraint failed: t1.y}"
        }
      ]
    },
