{
  "file": "vacuum-into.test",
  "name": "vacuum-into",
  "ordered": true,
  "tests": [
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "out.db"
        }
      ]
    },
    {
      "name": "vacuum-into-100",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t1(\n    a INTEGER PRIMARY KEY,\n    b ANY,\n    c INT AS (b+1),                          --- See \"2024-04-09\" block\n    CHECK( typeof(b)!='integer' OR b\u003ea-5 )   --- comment below\n  );\n  WITH RECURSIVE c(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM c WHERE x\u003c100)\n  INSERT INTO t1(a,b) SELECT x, randomblob(600) FROM c;\n  CREATE INDEX t1b ON t1(b);\n  DELETE FROM t1 WHERE a%2;\n  SELECT count(*), sum(a), sum(length(b)) FROM t1;",
          "expect": "50 2550 30000"
        }
      ]
    },
    {
      "name": "vacuum-into-110",
      "steps": [
        {
          "type": "exec",
          "sql": "VACUUM main INTO 'out.db';"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "out.db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "vacuum-into-120",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT count(*), sum(a), sum(length(b)) FROM t1",
          "expect": "50 2550 30000",
          "database": "db2"
        }
      ]
    },
    {
      "name": "vacuum-into-130",
      "steps": [
        {
          "type": "catch",
          "sql": "VACUUM INTO 'out.db';",
          "expect": "1 {output file already exists}"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "out2.db"
        }
      ]
    },
    {
      "name": "vacuum-into-140",
      "steps": [
        {
          "type": "catch",
          "sql": "VACUUM INTO 'out2.db';",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "vacuum-into-150",
      "steps": [
        {
          "type": "catch",
          "sql": "VACUUM INTO 'out2.db';",
          "expect": "1 {output file already exists}"
        }
      ]
    },
    {
      "name": "vacuum-into-200",
      "steps": [
        {
          "type": "catch",
          "sql": "VACUUM main INTO ':memory:';",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "vacuum-into-300",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t2(name TEXT);\n  INSERT INTO t2 VALUES(':memory:');\n  VACUUM main INTO (SELECT name FROM t2);"
        }
      ]
    },
    {
      "name": "vacuum-into-310",
      "steps": [
        {
          "type": "catch",
          "sql": "VACUUM INTO null;",
          "expect": "1 {non-text filename}"
        }
      ]
    },
    {
      "name": "vacuum-into-320",
      "steps": [
        {
          "type": "catch",
          "sql": "VACUUM INTO x;",
          "expect": "1 {no such column: x}"
        }
      ]
    },
    {
      "name": "vacuum-into-330",
      "steps": [
        {
          "type": "catch",
          "sql": "VACUUM INTO t1.nosuchcol;",
          "expect": "1 {no such column: t1.nosuchcol}"
        }
      ]
    },
    {
      "name": "vacuum-into-340",
      "steps": [
        {
          "type": "catch",
          "sql": "VACUUM INTO main.t1.nosuchcol;",
          "expect": "1 {no such column: main.t1.nosuchcol}"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "register_function",
          "functionName": "target",
          "callbackVars": {
            "": "",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "testdir": ""
          },
          "functionProc": "target",
          "minArgs": -1,
          "maxArgs": -1
        }
      ]
    },
    {
      "name": "vacuum-into-410",
      "steps": [
        {
          "type": "exec",
          "sql": "VACUUM INTO target()",
          "expect": "1"
        }
      ]
    },
    {
      "name": "vacuum-into-420",
      "steps": [
        {
          "type": "catch",
          "sql": "VACUUM INTO target2()",
          "expect": "1 {no such function: target2}"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    },
    {
      "name": "vacuum-into-500",
      "steps": [
        {
          "type": "exec",
          "sql": "VACUUM INTO 'test.db2';"
        }
      ]
    },
    {
      "name": "setup_3",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "vacuum-into-510",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT name FROM sqlite_master ORDER BY 1",
          "expect": "t1 t1b t2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "setup_4",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "vacuum-into-700",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n  INSERT INTO t1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    },
    {
      "name": "vacuum-into-710.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA synchronous = normal\n   ;\n    VACUUM INTO 'test.db2'"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    },
    {
      "name": "vacuum-into-720.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA synchronous = full\n   ;\n    VACUUM INTO 'test.db2'"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    },
    {
      "name": "vacuum-into-730.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA synchronous = off\n   ;\n    VACUUM INTO 'test.db2'"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    },
    {
      "name": "vacuum-into-740.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA synchronous = extra;\n   ;\n    VACUUM INTO 'test.db2'"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db2"
        }
      ]
    },
    {
      "name": "vacuum-into-750.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA fullfsync = 1;\n    PRAGMA synchronous = full;\n   ;\n    VACUUM INTO 'test.db2'"
        }
      ]
    },
    {
      "name": "setup_5",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    }
  ]
}