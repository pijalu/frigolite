{
  "file": "vacuum.test",
  "name": "vacuum",
  "ordered": true,
  "tests": [
    {
      "name": "vacuum-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    CREATE TABLE t1(a INTEGER PRIMARY KEY, b, c);\n    INSERT INTO t1 VALUES(NULL,randstr(10,100),randstr(5,50));\n    INSERT INTO t1 VALUES(123456,randstr(10,100),randstr(5,50));\n    INSERT INTO t1 SELECT NULL, b||'-'||rowid, c||'-'||rowid FROM t1;\n    INSERT INTO t1 SELECT NULL, b||'-'||rowid, c||'-'||rowid FROM t1;\n    INSERT INTO t1 SELECT NULL, b||'-'||rowid, c||'-'||rowid FROM t1;\n    INSERT INTO t1 SELECT NULL, b||'-'||rowid, c||'-'||rowid FROM t1;\n    INSERT INTO t1 SELECT NULL, b||'-'||rowid, c||'-'||rowid FROM t1;\n    INSERT INTO t1 SELECT NULL, b||'-'||rowid, c||'-'||rowid FROM t1;\n    INSERT INTO t1 SELECT NULL, b||'-'||rowid, c||'-'||rowid FROM t1;\n    CREATE INDEX i1 ON t1(b,c);\n    CREATE UNIQUE INDEX i2 ON t1(c,a);\n    CREATE TABLE t2 AS SELECT * FROM t1;\n    COMMIT;\n    DROP TABLE t2;",
          "expect": "1"
        }
      ]
    },
    {
      "name": "vacuum-1.1b",
      "steps": [
        {
          "type": "register_function",
          "functionName": "substr",
          "callbackVars": {
            "": "0",
            "::cksum": "",
            "::size1": "",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "fcnt": "1",
            "testdir": ""
          },
          "functionProc": "failing_app_func",
          "functionArgs": [
            "args"
          ],
          "functionBody": "error \"bad function\"",
          "maxArgs": -1
        },
        {
          "type": "register_function",
          "functionName": "like",
          "callbackVars": {
            "": "0",
            "::cksum": "",
            "::size1": "",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "fcnt": "1",
            "testdir": ""
          },
          "functionProc": "failing_app_func",
          "functionArgs": [
            "args"
          ],
          "functionBody": "error \"bad function\"",
          "maxArgs": -1
        },
        {
          "type": "register_function",
          "functionName": "quote",
          "callbackVars": {
            "": "0",
            "::cksum": "",
            "::size1": "",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "fcnt": "1",
            "testdir": ""
          },
          "functionProc": "failing_app_func",
          "functionArgs": [
            "args"
          ],
          "functionBody": "error \"bad function\"",
          "maxArgs": -1
        },
        {
          "type": "catch",
          "sql": "SELECT substr(name,1,3) FROM sqlite_master",
          "expect": "1 {bad function}"
        }
      ]
    },
    {
      "name": "vacuum-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "VACUUM;"
        }
      ]
    },
    {
      "name": "vacuum-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    CREATE TABLE t2 AS SELECT * FROM t1;\n    CREATE TABLE t3 AS SELECT * FROM t1;\n    CREATE VIEW v1 AS SELECT b, c FROM t3;\n    CREATE TRIGGER r1 AFTER DELETE ON t2 BEGIN SELECT 1; END;\n    COMMIT;\n    DROP TABLE t2;",
          "expect": "1"
        }
      ]
    },
    {
      "name": "vacuum-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "VACUUM;"
        }
      ]
    },
    {
      "name": "vacuum-2.1.1",
      "steps": [
        {
          "type": "catch",
          "sql": "BEGIN;\n      VACUUM;",
          "expect": "1 {cannot VACUUM from within a transaction}"
        }
      ]
    },
    {
      "name": "vacuum-2.1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        }
      ]
    },
    {
      "name": "vacuum-2.2",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "BEGIN;\n    CREATE TABLE t4 AS SELECT * FROM t1;\n    CREATE TABLE t5 AS SELECT * FROM t1;\n    COMMIT;\n    DROP TABLE t4;\n    DROP TABLE t5;",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "VACUUM",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "vacuum-2.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT count(*) FROM sqlite_master",
          "database": "db2"
        }
      ]
    },
    {
      "name": "vacuum-2.5",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    CREATE TABLE t6 AS SELECT * FROM t1;\n    CREATE TABLE t7 AS SELECT * FROM t1;\n    COMMIT;"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db3"
        },
        {
          "type": "exec",
          "sql": "-- The \"SELECT * FROM sqlite_master\" statement ensures that this test\n    -- works when shared-cache is enabled. If shared-cache is enabled, then\n    -- db3 shares a cache with db2 (but not db - it was opened as \n    -- \"./test.db\").\n    SELECT * FROM sqlite_master;\n    SELECT * FROM t7 LIMIT 1",
          "database": "db3"
        },
        {
          "type": "exec",
          "sql": "VACUUM;"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t7 VALUES(1234567890,'hello','world');",
          "database": "db3"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t7 WHERE a=1234567890",
          "expect": "1234567890 hello world"
        }
      ]
    },
    {
      "name": "vacuum-2.7",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t7 WHERE a=1234567890",
          "expect": "1234567890 hello world",
          "database": "db3"
        }
      ]
    },
    {
      "name": "vacuum-2.8",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t7 SELECT * FROM t6;\n    SELECT count(*) FROM t7;",
          "expect": "513"
        }
      ]
    },
    {
      "name": "vacuum-2.10",
      "steps": [
        {
          "type": "exec",
          "sql": "DELETE FROM t7;\n    SELECT count(*) FROM t7;",
          "expect": "0",
          "database": "db3"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db3"
        }
      ]
    },
    {
      "name": "vacuum-3.1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA empty_result_callbacks=on;\n    VACUUM;"
        }
      ]
    },
    {
      "name": "vacuum-4.1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "prepare_stmt",
          "sql": "VACUUM",
          "variable": "stmt_1"
        },
        {
          "type": "stmt_step",
          "sql": "VACUUM",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__",
          "expect": "SQLITE_DONE"
        }
      ]
    },
    {
      "name": "vacuum-4.2",
      "steps": [
        {
          "type": "stmt_finalize",
          "sql": "VACUUM",
          "variable": "stmt_1",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "vacuum-5.1",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "vacuum-5.1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "catch",
          "sql": "CREATE TABLE Test (TestID int primary key);\n    INSERT INTO Test VALUES (NULL);\n    CREATE VIEW viewTest AS SELECT * FROM Test;\n\n    BEGIN;\n    CREATE TABLE tempTest (TestID int primary key, Test2 int NULL);\n    INSERT INTO tempTest SELECT TestID, 1 FROM Test;\n    DROP TABLE Test;\n    CREATE TABLE Test(TestID int primary key, Test2 int NULL);\n    INSERT INTO Test SELECT * FROM tempTest;\n    DROP TABLE tempTest;\n    COMMIT;\n    VACUUM;",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "vacuum-5.2",
      "steps": [
        {
          "type": "catch",
          "sql": "VACUUM;",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "vacuum-6.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE \"abc abc\"(a, b, c);\n    INSERT INTO \"abc abc\" VALUES(1, 2, 3);\n    VACUUM;"
        }
      ]
    },
    {
      "name": "vacuum-6.2",
      "steps": [
        {
          "type": "exec",
          "sql": "select * from \"abc abc\";",
          "expect": "1 2 3"
        }
      ]
    },
    {
      "name": "vacuum-6.3",
      "steps": [
        {
          "type": "exec",
          "sql": "DELETE FROM \"abc abc\";\n      INSERT INTO \"abc abc\" VALUES(X'00112233', NULL, NULL);\n      VACUUM;"
        }
      ]
    },
    {
      "name": "vacuum-6.4",
      "steps": [
        {
          "type": "exec",
          "sql": "select count(*) from \"abc abc\" WHERE a = X'00112233';",
          "expect": "1"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": ":memory:"
        }
      ]
    },
    {
      "name": "vacuum-7.0",
      "steps": [
        {
          "type": "open_named_db",
          "sql": ":memory:",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(t);\n    VACUUM;",
          "database": "db2"
        }
      ]
    },
    {
      "name": "vacuum-7.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t2(t);\n    CREATE TABLE t3(t);\n    DROP TABLE t2;\n    PRAGMA freelist_count;",
          "expect": "1"
        }
      ]
    },
    {
      "name": "vacuum-7.2",
      "steps": [
        {
          "type": "exec",
          "sql": "VACUUM;\n    pragma integrity_check;",
          "expect": "ok",
          "database": "db2"
        }
      ]
    },
    {
      "name": "vacuum-7.3",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA freelist_count;",
          "expect": "0",
          "database": "db2"
        }
      ]
    },
    {
      "name": "vacuum-7.4",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum",
          "expect": "0",
          "database": "db2"
        }
      ]
    },
    {
      "name": "vacuum-7.5",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum = 1",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum",
          "expect": "0",
          "database": "db2"
        }
      ]
    },
    {
      "name": "vacuum-7.6",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum = 1",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "VACUUM",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum",
          "expect": "1",
          "database": "db2"
        }
      ]
    },
