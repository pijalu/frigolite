      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA page_size = 1024;\n  CREATE TABLE t1(x INTEGER PRIMARY KEY, y);\n  INSERT INTO t1 VALUES(2, randomblob(1200));"
        }
      ]
    },
