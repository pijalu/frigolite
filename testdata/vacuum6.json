          "sql": "CREATE TABLE tx(a, b);\n  CREATE INDEX i1 ON tx(b);\n  WITH s(i) AS (\n      SELECT 8000 UNION ALL SELECT i+1 FROM s WHERE i<10000\n  )\n  INSERT INTO tx SELECT i, randomblob(i) FROM s;\n\n  SELECT sum(length(b)) FROM tx;",
          "expect": "18009000"
        }
      ]
