        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x INTEGER PRIMARY KEY, y);\n  INSERT INTO t1 VALUES(1, 1);"
        }
      ]
    },
    {
      "name": "1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "VACUUM"
        }
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x,b);\n  CREATE INDEX x1 ON t1(x);\n  CREATE INDEX x2 ON t1(x);\n  CREATE INDEX x3 ON t1(x);\n  INSERT INTO t1 SELECT 2,'';\n  VACUUM;"
        }
      ]
    },
    {
