{
  "file": "vtab3.test",
  "name": "vtab3",
  "ordered": true,
  "tests": [
    {
      "name": "vtab3-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE elephant(\n      name VARCHAR(32), \n      color VARCHAR(16), \n      age INTEGER, \n      UNIQUE(name, color)\n    );"
        }
      ]
    },
    {
      "name": "vtab3-1.2",
      "steps": [
        {
          "type": "register_echo_module"
        },
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE pachyderm USING echo(elephant);"
        },
        {
          "type": "runtime_var",
          "variable": "auth_log",
          "expect": "SQLITE_INSERT sqlite_master {} main {} SQLITE_CREATE_VTABLE pachyderm echo main {}"
        }
      ]
    },
    {
      "name": "vtab3-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE pachyderm;"
        },
        {
          "type": "runtime_var",
          "variable": "auth_log",
          "expect": "SQLITE_DELETE sqlite_master {} main {} SQLITE_DROP_VTABLE pachyderm echo main {} SQLITE_DELETE pachyderm {} main {} SQLITE_DELETE sqlite_master {} main {}"
        }
      ]
    },
    {
      "name": "vtab3-1.4",
      "steps": [
        {
          "type": "catch",
          "sql": "CREATE VIRTUAL TABLE pachyderm USING echo(elephant);",
          "expect": "1 {not authorized}"
        }
      ]
    },
    {
      "name": "vtab3-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT name FROM sqlite_master WHERE type = 'table';",
          "expect": "elephant"
        },
        {
          "type": "catch",
          "sql": "CREATE VIRTUAL TABLE pachyderm USING echo(elephant);",
          "expect": "1 {not authorized}"
        }
      ]
    },
    {
      "name": "vtab3-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT name FROM sqlite_master WHERE type = 'table';",
          "expect": "elephant"
        }
      ]
    },
    {
      "name": "vtab3-1.5",
      "steps": [
        {
          "type": "catch",
          "sql": "CREATE VIRTUAL TABLE pachyderm USING echo(elephant);",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "vtab3-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT name FROM sqlite_master WHERE type = 'table';",
          "expect": "elephant pachyderm"
        }
      ]
    },
    {
      "name": "vtab3-1.7.1.1",
      "steps": [
        {
          "type": "catch",
          "sql": "DROP TABLE pachyderm;",
          "variable": "rc",
          "catchResult": true,
          "catchMessage": "msg"
        },
        {
          "type": "runtime_expr",
          "sql": "not authorized",
          "variable": "msg",
          "condition": "$msg eq \"authorization denied\""
        }
      ]
    },
    {
      "name": "vtab3-1.7.1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT name FROM sqlite_master WHERE type = 'table';",
          "expect": "elephant pachyderm"
        }
      ]
