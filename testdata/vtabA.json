{
  "file": "vtabA.test",
  "name": "vtabA",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "register_echo_module"
        }
      ]
    },
    {
      "name": "vtabA-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b HIDDEN VARCHAR, c INTEGER)"
        }
      ]
    },
    {
      "name": "vtabA-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE t1e USING echo(t1)"
        }
      ]
    },
    {
      "name": "vtabA-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA table_info(t1e)",
          "expect": "0 a {} 0 {} 0 1 c INTEGER 0 {} 0"
        }
      ]
    },
    {
      "name": "vtabA-1.4",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1e VALUES('value a', 'value c');",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "vtabA-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT a, b, c FROM t1e;",
          "expect": "{value a} {} {value c}"
        }
      ]
    },
    {
      "name": "vtabA-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1e;",
          "expect": "{value a} {value c}"
        }
      ]
    },
    {
      "name": "vtabA-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "DELETE FROM t1e;\n  INSERT INTO t1e SELECT 'abc','def';"
        }
      ]
    },
    {
      "name": "vtabA-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1e VALUES('ghi','jkl'),('mno','pqr'),('stu','vwx');"
        }
      ]
    },
    {
      "name": "vtabA-1.9",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT a,b,c, '|' FROM t1e ORDER BY 1;",
          "expect": "abc {} def | ghi {} jkl | mno {} pqr | stu {} vwx |"
        }
      ]
    },
    {
      "name": "vtabA-1.20",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1e SELECT * FROM t1e;"
        }
      ]
    },
    {
      "name": "vtabA-1.21",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1e ORDER BY 1;",
          "expect": "abc def abc def ghi jkl ghi jkl mno pqr mno pqr stu vwx stu vwx"
        }
      ]
    },
    {
      "name": "vtabA-1.22",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "SELECT b FROM t1e",
          "variable": "stmt_1"
        },
        {
          "type": "stmt_finalize",
          "sql": "SELECT b FROM t1e",
          "variable": "stmt_1",
          "expect": "VARCHAR"
        }
      ]
    },
    {
      "name": "vtabA-1.23",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA table_info(t1e)",
          "expect": "a c"
        }
      ]
    },
