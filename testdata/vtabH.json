    {
      "name": "vtabH-2.0.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT name, value FROM vars WHERE name MATCH 'x*' AND value GLOB 'aban*'",
          "expect": "x3 abandon x4 abandonint"
        }
