      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t6(a, b TEXT);\n  CREATE INDEX i6 ON t6(b, a);\n  CREATE VIRTUAL TABLE e6 USING echo(t6);"
        }
      ]
    },
    {
