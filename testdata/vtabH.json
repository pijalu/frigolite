      "steps": [
        {
          "type": "query",
          "sql": "CREATE VIRTUAL TABLE vars USING tclvar;\n  SELECT name, arrayname, value FROM vars WHERE name = 'xyz';",
          "expect": "xyz {} 10"
        }
      ]
