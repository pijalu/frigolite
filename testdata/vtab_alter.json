{
  "file": "vtab_alter.test",
  "name": "vtab_alter",
  "tests": [
    {
      "name": "vtab_alter-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b VARCHAR, c INTEGER)"
        }
      ]
    },
    {
      "name": "vtab_alter-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE t1echo USING echo(t1)"
        }
      ]
    },
    {
      "name": "vtab_alter-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1echo",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "vtab_alter-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE t1echo RENAME TO new"
        }
      ]
    },
    {
      "name": "vtab_alter-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1echo",
          "expect": "1 {no such table: t1echo}"
        }
      ]
    },
    {
      "name": "vtab_alter-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM new",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "vtab_alter-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP TABLE new;\n    DROP TABLE t1;\n    CREATE TABLE t1_base(a, b, c);\n    CREATE VIRTUAL TABLE t1 USING echo('*_base');"
        }
      ]
    },
    {
      "name": "vtab_alter-2.2",
      "steps": [
        {
          "type": "query",
          "sql": "INSERT INTO t1_base VALUES(1, 2, 3);\n    SELECT * FROM t1;",
          "expect": "1 2 3"
        }
      ]
    },
    {
      "name": "vtab_alter-2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "ALTER TABLE t1 RENAME TO x"
        }
      ]
    },
    {
      "name": "vtab_alter-2.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM x;",
          "expect": "1 2 3"
        }
      ]
    },
    {
      "name": "vtab_alter-2.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM x_base;",
          "expect": "1 2 3"
        }
      ]
    },
    {
      "name": "vtab_alter-3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE y_base(a, b, c)"
        }
      ]
    },
    {
      "name": "vtab_alter-3.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM x",
          "expect": "1 2 3"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b VARCHAR, c INTEGER)"
        },
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE t1echo USING echo(t1)"
        },
        {
          "type": "exec",
          "sql": "ALTER TABLE t1echo RENAME TO new"
        },
        {
          "type": "exec",
          "sql": "DROP TABLE new;\n    DROP TABLE t1;\n    CREATE TABLE t1_base(a, b, c);\n    CREATE VIRTUAL TABLE t1 USING echo('*_base');"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1_base VALUES(1, 2, 3);\n    SELECT * FROM t1;"
        },
        {
          "type": "exec",
          "sql": "ALTER TABLE t1 RENAME TO x"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM x;"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM x_base;"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE y_base(a, b, c)"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM x"
        }
      ]
    }
  ],
  "source": "capi"
}