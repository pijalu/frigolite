{
  "file": "vtab_shared.test",
  "name": "vtab_shared",
  "tests": [
    {
      "name": "vtab_shared-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t0(a, b, c);\n    INSERT INTO t0 VALUES(1, 2, 3);\n    CREATE VIRTUAL TABLE t1 USING echo(t0);"
        }
      ]
    },
    {
      "name": "vtab_shared-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3"
        }
      ]
    },
    {
      "name": "vtab_shared-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 {no such module: echo}"
        }
      ]
    },
    {
      "name": "vtab_shared-1.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t0",
          "expect": "1 2 3"
        }
      ]
    },
