        }
      ]
    },
    {
      "name": "vtab_shared-1.11",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE t2 USING echo(t0);\n    CREATE VIRTUAL TABLE t3 USING echo(t0);"
        }
      ]
    },
    {
