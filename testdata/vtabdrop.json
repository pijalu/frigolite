{
  "file": "vtabdrop.test",
  "name": "vtabdrop",
  "ordered": true,
  "tests": [
    {
      "name": "vtabdrop-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE rt USING rtree(id, x1, x2);\n    CREATE TABLE t1(x, y);\n    INSERT INTO t1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "vtabdrop-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n        INSERT INTO t1 VALUES(3, 4);"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1"
        },
        {
          "type": "exec",
          "sql": "COMMIT"
        }
      ]
    },
    {
      "name": "vtabdrop-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT name FROM sqlite_master ORDER BY 1;\n    SELECT * FROM t1;\n    SELECT * FROM rt;",
          "expect": "rt rt_node rt_parent rt_rowid t1 1 2 3 4"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "vtabdrop-1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT name FROM sqlite_master ORDER BY 1;",
          "expect": "rt rt_node rt_parent rt_rowid t1"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "vtabdrop-2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE ft USING fts5(x);\n    CREATE TABLE t1(x, y);\n    INSERT INTO t1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "vtabdrop-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n        INSERT INTO t1 VALUES(3, 4);"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1"
        },
        {
          "type": "exec",
          "sql": "COMMIT"
        }
      ]
    },
    {
      "name": "vtabdrop-2.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT name FROM sqlite_master ORDER BY 1;",
          "expect": "ft ft_config ft_content ft_data ft_docsize ft_idx t1"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "vtabdrop-2.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT name FROM sqlite_master ORDER BY 1;",
          "expect": "ft ft_config ft_content ft_data ft_docsize ft_idx t1"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "vtabdrop-2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIRTUAL TABLE ft USING fts3(x);\n    CREATE TABLE t1(x, y);\n    INSERT INTO t1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "vtabdrop-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n        INSERT INTO t1 VALUES(3, 4);"
        },
        {
          "type": "query",
          "sql": "SELECT * FROM t1"
        },
        {
          "type": "exec",
          "sql": "COMMIT"
        }
      ]
    },
    {
      "name": "vtabdrop-2.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT name FROM sqlite_master ORDER BY 1;",
          "expect": "ft ft_content ft_segdir ft_segments sqlite_autoindex_ft_segdir_1 t1"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "vtabdrop-2.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT name FROM sqlite_master ORDER BY 1;",
          "expect": "ft ft_content ft_segdir ft_segments sqlite_autoindex_ft_segdir_1 t1"
        }
      ]
    }
  ]
