{
  "file": "vtabrhs1.test",
  "name": "vtabrhs1",
  "tests": [
    {
      "name": "1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT rhs FROM qpvtab\n   WHERE cn='a'\n     AND a=12345",
          "expect": "12345"
        }
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT rhs FROM qpvtab\n   WHERE cn='a'\n     AND a<>4.5",
          "expect": "4.5"
        }
      ]
    },
    {
      "name": "1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT rhs FROM qpvtab\n   WHERE cn='a'\n     AND 'quokka' < a",
          "expect": "'quokka'"
        }
      ]
    },
    {
      "name": "1.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT rhs FROM qpvtab\n   WHERE cn='a'\n     AND a IS NULL",
          "expect": "{}"
        }
      ]
    },
    {
      "name": "1.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT rhs FROM qpvtab\n   WHERE cn='a'\n     AND a GLOB x'0123'",
          "expect": "x'0123'"
        }
      ]
    },
    {
      "name": "2.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT typeof(rhs) FROM qpvtab WHERE cn='a' AND a=format('abc');",
          "expect": "null"
        }
      ]
    },
    {
      "name": "2.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT typeof(rhs) FROM qpvtab WHERE cn='a' AND a=?2",
          "expect": "null"
        }
      ]
    }
  ],
  "source": "capi"
}