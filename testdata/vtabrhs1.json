{
  "file": "vtabrhs1.test",
  "name": "vtabrhs1",
  "ordered": true,
  "tests": [
    {
      "name": "vtabrhs1-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT rhs FROM qpvtab\n   WHERE cn='a'\n     AND a=12345",
          "expect": "12345"
        }
      ]
    },
    {
      "name": "vtabrhs1-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT rhs FROM qpvtab\n   WHERE cn='a'\n     AND a\u003c\u003e4.5",
          "expect": "4.5"
        }
      ]
    },
    {
      "name": "vtabrhs1-1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT rhs FROM qpvtab\n   WHERE cn='a'\n     AND 'quokka' \u003c a",
          "expect": "'quokka'"
        }
      ]
    },
    {
      "name": "vtabrhs1-1.4",
      "steps": [
        {
          "type": "emptytext",
          "sql": "SELECT rhs FROM qpvtab\n   WHERE cn='a'\n     AND a IS NULL",
          "expect": "{}"
        }
      ]
    },
    {
      "name": "vtabrhs1-1.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT rhs FROM qpvtab\n   WHERE cn='a'\n     AND a GLOB x'0123'",
          "expect": "x'0123'"
        }
      ]
    },
    {
      "name": "vtabrhs1-2.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT typeof(rhs) FROM qpvtab WHERE cn='a' AND a=format('abc');",
          "expect": "null"
        }
      ]
    },
    {
      "name": "vtabrhs1-2.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT typeof(rhs) FROM qpvtab WHERE cn='a' AND a=?2",
          "expect": "null"
        }
      ]
    }
  ]
}