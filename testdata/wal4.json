{
  "file": "wal4.test",
  "name": "wal4",
  "ordered": true,
  "tests": [
    {
      "name": "wal4-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode=WAL;\n    CREATE TABLE t1(x);\n    INSERT INTO t1 VALUES(1);\n    INSERT INTO t1 VALUES(2);\n    SELECT x FROM t1 ORDER BY x;",
          "expect": "wal 1 2"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "sv_test.db"
        }
      ]
    },
    {
      "name": "wal4-1.3",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "1 {no such table: t1}"
        }
      ]
    }
  ]
}