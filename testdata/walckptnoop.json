{
  "file": "walckptnoop.test",
  "name": "walckptnoop",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "register_function",
          "functionName": "myrandomblob",
          "callbackVars": {
            "": "123",
            "SQLITE_MAX_ATTACHED": "10",
            "SQLITE_MAX_COLUMN": "2000",
            "SQLITE_MAX_LENGTH": "1000000000",
            "SQLITE_MAX_VARIABLE_NUMBER": "32766",
            "VAL": "123",
            "testdir": "",
            "testprefix": "walckptnoop"
          },
          "functionProc": "myrandomblob",
          "functionArgs": [
            "n"
          ],
          "functionBody": "\n  set l [list]\n  for {set i 0} {$i \u003c $n} {incr i} {\n    lappend l [expr [myrand] % 256]\n  }\n  binary format c* $l\n",
          "minArgs": 1,
          "maxArgs": -1
        }
      ]
    },
    {
      "name": "walckptnoop-1.0",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA page_size=1024;\n  PRAGMA auto_vacuum=NONE;\n  PRAGMA secure_delete=OFF;\n  VACUUM;\n  CREATE TABLE t1(x INTEGER PRIMARY KEY, y TEXT);\n  CREATE INDEX i1 ON t1(y);\n  PRAGMA journal_mode = wal;\n\n  WITH s(i) AS (\n    SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i\u003c1000\n  )\n  INSERT INTO t1 SELECT NULL, hex(myrandomblob(64)) FROM s;",
          "expect": "0 wal"
        }
      ]
    },
    {
      "name": "walckptnoop-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA wal_checkpoint = noop;",
          "expect": "0 298 0"
        }
      ]
    },
    {
      "name": "walckptnoop-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA wal_checkpoint = noop;",
          "expect": "0 298 0"
        }
      ]
    },
    {
      "name": "walckptnoop-1.3",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA wal_checkpoint = passive;",
          "expect": "0 298 298"
        }
      ]
    },
    {
      "name": "walckptnoop-1.4",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA wal_checkpoint = noop;",
          "expect": "0 298 298"
        }
      ]
    },
    {
      "name": "walckptnoop-1.5",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA wal_checkpoint = noop;",
          "expect": "0 298 0"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum=NONE;\n  PRAGMA secure_delete=OFF;"
        }
      ]
    },
    {
      "name": "walckptnoop-1.6",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA wal_checkpoint = noop;",
          "expect": "0 0 0"
        }
      ]
    },
    {
      "name": "walckptnoop-1.7",
      "steps": [
        {
          "type": "catch",
          "sql": "BEGIN;\n    DELETE FROM t1;\n    PRAGMA wal_checkpoint = noop;",
          "expect": "1 {database table is locked}"
        }
      ]
    },
    {
      "name": "walckptnoop-1.8",
      "steps": [
        {
          "type": "catch",
          "sql": "COMMIT;\n  PRAGMA wal_checkpoint = noop;",
          "expect": "0 {0 5 0}"
        }
      ]
    },
    {
      "name": "walckptnoop-1.10",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = delete;\n  PRAGMA wal_checkpoint = noop;",
          "expect": "delete 0 -1 -1"
        }
      ]
    }
  ]
}