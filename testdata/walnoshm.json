{
  "file": "walnoshm.test",
  "name": "walnoshm",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "walnoshm-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x, y);\n  INSERT INTO t1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "walnoshm-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = WAL;\n  SELECT * FROM t1;",
          "expect": "delete 1 2"
        }
      ]
    },
    {
      "name": "walnoshm-1.4",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA locking_mode = exclusive;\n  PRAGMA journal_mode = WAL;\n  SELECT * FROM t1;",
          "expect": "exclusive wal 1 2"
        }
      ]
    },
    {
      "name": "walnoshm-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(3, 4)"
        }
      ]
    },
    {
      "name": "walnoshm-1.7",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA locking_mode = normal;",
          "expect": "exclusive"
        }
      ]
    },
    {
      "name": "walnoshm-1.8",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = delete;\n  PRAGMA main.locking_mode;",
          "expect": "delete exclusive"
        }
      ]
    },
    {
      "name": "walnoshm-1.9",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA locking_mode = normal;",
          "expect": "normal"
        }
      ]
    },
    {
      "name": "walnoshm-1.10",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1;",
          "expect": "1 2 3 4"
        }
      ]
    },
    {
      "name": "walnoshm-2.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t2(x, y);\n  INSERT INTO t2 VALUES('a', 'b');\n  INSERT INTO t2 VALUES('c', 'd');"
        }
      ]
    },
    {
      "name": "walnoshm-2.1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA locking_mode = exclusive;\n  PRAGMA journal_mode = WAL;\n  INSERT INTO t2 VALUES('e', 'f');\n  INSERT INTO t2 VALUES('g', 'h');",
          "expect": "exclusive wal"
        }
      ]
    },
    {
      "name": "walnoshm-2.1.3",
      "steps": [
        {
          "type": "copy_file",
          "sql": "test.db",
          "fileTarget": "test2.db"
        },
        {
          "type": "copy_file",
          "sql": "test.db-wal",
          "fileTarget": "test2.db-wal"
        },
        {
          "type": "open_named_db",
          "sql": "test2.db",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t2",
          "expect": "1 {unable to open database file}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "walnoshm-2.1.4",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA journal_mode = delete",
          "expect": "1 {unable to open database file}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "walnoshm-2.1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA locking_mode = exclusive; \n    PRAGMA journal_mode = delete;\n    SELECT * FROM t2;",
          "expect": "exclusive delete a b c d e f g h",
          "database": "db2"
        }
      ]
    },
    {
      "name": "walnoshm-2.2.1",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "copy_file",
          "sql": "test.db",
          "fileTarget": "test2.db"
        },
        {
          "type": "copy_file",
          "sql": "test.db-wal",
          "fileTarget": "test2.db-wal"
        },
        {
          "type": "open_named_db",
          "sql": "test2.db",
          "database": "db3"
        },
        {
          "type": "open_named_db",
          "sql": "test2.db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t2",
          "expect": "a b c d e f g h",
          "database": "db3"
        }
      ]
    },
    {
      "name": "walnoshm-2.2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA locking_mode = exclusive",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "PRAGMA journal_mode = delete",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "walnoshm-2.2.3",
      "steps": [
        {
          "type": "open_named_db",
          "sql": "test2.db",
          "database": "db4"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t2",
          "expect": "a b c d e f g h",
          "database": "db4"
        }
      ]
    },
    {
      "name": "walnoshm-2.2.4",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT * FROM t2",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "walnoshm-2.2.5",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db4"
        },
        {
          "type": "open_named_db",
          "sql": "test2.db",
          "database": "db4"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t2",
          "expect": "a b c d e f g h",
          "database": "db4"
        }
      ]
    },
    {
      "name": "walnoshm-2.2.6",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db3"
        },
        {
          "type": "close_named_db",
          "database": "db4"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t2",
          "expect": "a b c d e f g h",
          "database": "db2"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "walnoshm-3.1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1;\n    PRAGMA locking_mode = EXCLUSIVE;\n    INSERT INTO t1 VALUES(5, 6);\n    PRAGMA locking_mode = NORMAL;\n    INSERT INTO t1 VALUES(7, 8);"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4 5 6 7 8",
          "database": "db2"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "close_named_db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "walnoshm-3.2",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA locking_mode = EXCLUSIVE;\n    INSERT INTO t1 VALUES(9, 10);\n    PRAGMA locking_mode = NORMAL;\n    INSERT INTO t1 VALUES(11, 12);"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "1 {database is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "setup_3",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "close_named_db",
          "database": "db2"
        }
      ]
    }
  ]
}