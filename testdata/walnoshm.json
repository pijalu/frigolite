{
  "file": "walnoshm.test",
  "name": "walnoshm",
  "tests": [
    {
      "name": "1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x, y);\n  INSERT INTO t1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = WAL;\n  SELECT * FROM t1;",
          "expect": "delete 1 2"
        }
      ]
    },
    {
      "name": "1.4",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA locking_mode = exclusive;\n  PRAGMA journal_mode = WAL;\n  SELECT * FROM t1;",
          "expect": "exclusive wal 1 2"
        }
      ]
    },
    {
      "name": "1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(3, 4)"
        }
      ]
    },
    {
      "name": "1.7",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA locking_mode = normal;",
          "expect": "exclusive"
        }
      ]
    },
    {
      "name": "1.8",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = delete;\n  PRAGMA main.locking_mode;",
          "expect": "delete exclusive"
        }
      ]
    },
    {
      "name": "1.9",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA locking_mode = normal;",
          "expect": "normal"
        }
      ]
    },
    {
      "name": "1.10",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1;",
          "expect": "1 2 3 4"
        }
      ]
    },
    {
      "name": "2.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t2(x, y);\n  INSERT INTO t2 VALUES('a', 'b');\n  INSERT INTO t2 VALUES('c', 'd');"
        }
      ]
    },
    {
      "name": "2.1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA locking_mode = exclusive;\n  PRAGMA journal_mode = WAL;\n  INSERT INTO t2 VALUES('e', 'f');\n  INSERT INTO t2 VALUES('g', 'h');"
        }
      ]
    },
    {
      "name": "2.1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t2",
          "expect": "1 {unable to open database file}"
        }
      ]
    },
    {
      "name": "2.1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = delete",
          "expect": "1 {unable to open database file}"
        }
      ]
    },
    {
      "name": "2.1.5",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA locking_mode = exclusive; \n    PRAGMA journal_mode = delete;\n    SELECT * FROM t2;",
          "expect": "exclusive delete a b c d e f g h"
        }
      ]
    },
    {
      "name": "2.2.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t2",
          "expect": "a b c d e f g h"
        }
      ]
    },
    {
      "name": "2.2.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA locking_mode = exclusive",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "2.2.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t2",
          "expect": "a b c d e f g h"
        }
      ]
    },
    {
      "name": "2.2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t2",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "2.2.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t2",
          "expect": "a b c d e f g h"
        }
      ]
    },
    {
      "name": "2.2.6",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t2",
          "expect": "a b c d e f g h"
        }
      ]
    },
    {
      "name": "3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1;\n    PRAGMA locking_mode = EXCLUSIVE;\n    INSERT INTO t1 VALUES(5, 6);\n    PRAGMA locking_mode = NORMAL;\n    INSERT INTO t1 VALUES(7, 8);"
        }
      ]
    },
    {
      "name": "3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA locking_mode = EXCLUSIVE;\n    INSERT INTO t1 VALUES(9, 10);\n    PRAGMA locking_mode = NORMAL;\n    INSERT INTO t1 VALUES(11, 12);"
        },
        {
          "type": "exec",
          "sql": "PRAGMA locking_mode = exclusive; \n    PRAGMA journal_mode = delete;\n    SELECT * FROM t2;"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t2"
        },
        {
          "type": "exec",
          "sql": "PRAGMA locking_mode = exclusive"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t2"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t2"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t2"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1;\n    PRAGMA locking_mode = EXCLUSIVE;\n    INSERT INTO t1 VALUES(5, 6);\n    PRAGMA locking_mode = NORMAL;\n    INSERT INTO t1 VALUES(7, 8);"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1"
        },
        {
          "type": "exec",
          "sql": "PRAGMA locking_mode = EXCLUSIVE;\n    INSERT INTO t1 VALUES(9, 10);\n    PRAGMA locking_mode = NORMAL;\n    INSERT INTO t1 VALUES(11, 12);"
        }
      ]
    }
  ]
}