          "sql": "CREATE TABLE t1(x, y);\n    CREATE TABLE t2(x, y);\n    CREATE INDEX i1y ON t1(y);\n  \n    WITH cnt(i) AS (\n      SELECT 1 UNION ALL SELECT i+1 FROM cnt WHERE i\u003c20\n    )\n    INSERT INTO t1 SELECT i, randomblob(800) FROM cnt;"
