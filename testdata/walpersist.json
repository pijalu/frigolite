{
  "file": "walpersist.test",
  "name": "walpersist",
  "ordered": true,
  "tests": [
    {
      "name": "walpersist-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode=WAL;\n    CREATE TABLE t1(a);\n    INSERT INTO t1 VALUES(randomblob(5000));",
          "expect": "1"
        }
      ]
    },
    {
      "name": "walpersist-1.2",
      "steps": [
        {
          "type": "close_db",
          "expect": "1 0 0"
        }
      ]
    },
    {
      "name": "walpersist-1.3",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "query",
          "sql": "SELECT length(a) FROM t1",
          "expect": "5000"
        }
      ]
    },
    {
      "name": "walpersist-1.11",
      "steps": [
        {
          "type": "close_db",
          "expect": "1 1 1"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db-shm"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db-wal"
        }
      ]
    },
    {
      "name": "walpersist-2.1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode=WAL;\n    PRAGMA wal_autocheckpoint=OFF;\n    PRAGMA journal_size_limit=12000;\n    CREATE TABLE t1(x);\n    INSERT INTO t1 VALUES(randomblob(50000));\n    UPDATE t1 SET x=randomblob(50000);",
          "expect": "1"
        }
      ]
    },
    {
      "name": "walpersist-2.2",
      "steps": [
        {
          "type": "close_db",
          "expect": "1 0"
        }
      ]
    },
    {
      "name": "walpersist-2.3",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA integrity_check",
          "expect": "ok"
        }
      ]
    },
    {
