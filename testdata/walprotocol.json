{
  "file": "walprotocol.test",
  "name": "walprotocol",
  "tests": [
    {
      "name": "1.0",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = wal;\n  CREATE TABLE x(y);\n  INSERT INTO x VALUES('z');",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM x"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM x"
        }
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM x"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM x"
        }
      ]
    },
    {
      "name": "1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM x",
          "expect": "1 {locking protocol}"
        }
      ]
    },
    {
      "name": "1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM x",
          "expect": "1 {locking protocol}"
        }
      ]
    },
    {
      "name": "1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM x",
          "expect": "0 z"
        }
      ]
    },
    {
      "name": "2.2",
