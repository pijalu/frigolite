{
  "file": "walprotocol.test",
  "name": "walprotocol",
  "ordered": true,
  "tests": [
    {
      "name": "walprotocol-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = wal;\n  CREATE TABLE x(y);\n  INSERT INTO x VALUES('z');",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "walprotocol-1.1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM x",
          "expect": "{0 1 lock exclusive} {1 2 lock exclusive} {4 1 lock exclusive} {4 1 unlock exclusive} {5 1 lock exclusive} {5 1 unlock exclusive} {6 1 lock exclusive} {6 1 unlock exclusive} {7 1 lock exclusive} {7 1 unlock exclusive} {1 2 unlock exclusive} {0 1 unlock exclusive}"
        }
      ]
    },
    {
      "name": "walprotocol-1.2",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM x",
          "expect": "{0 1 lock exclusive} {1 2 lock exclusive} {4 1 lock exclusive} {4 1 unlock exclusive} {5 1 lock exclusive} {5 1 unlock exclusive} {6 1 lock exclusive} {6 1 unlock exclusive} {7 1 lock exclusive} {7 1 unlock exclusive} {1 2 unlock exclusive} {0 1 unlock exclusive}"
        }
      ]
    },
    {
      "name": "walprotocol-1.3",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM x",
          "expect": "1 {locking protocol}"
        }
      ]
    },
    {
      "name": "walprotocol-1.4",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM x",
          "expect": "1 {locking protocol}"
        }
      ]
    },
    {
      "name": "walprotocol-1.5",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM x",
          "expect": "0 z"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db-journal"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "delete_file",
      "steps": [
        {
          "type": "delete_file",
          "sql": "wal"
        }
      ]
    },
    {
      "name": "walprotocol-2.1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum = off;\n    PRAGMA journal_mode = WAL;\n    CREATE TABLE b(c);\n    INSERT INTO b VALUES('Tehran');\n    INSERT INTO b VALUES('Qom');\n    INSERT INTO b VALUES('Markazi');\n    PRAGMA wal_checkpoint;",
          "expect": "wal 0 5 5"
        }
      ]
    },
    {
      "name": "walprotocol-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM b",
          "expect": "Tehran Qom Markazi"
        }
      ]
    },
    {
      "name": "walprotocol-2.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM b",
          "expect": "Tehran Qom Markazi Qazvin"
        }
      ]
    },
    {
      "name": "walprotocol-2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO b VALUES('Gilan');\n    INSERT INTO b VALUES('Ardabil');"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "walprotocol-2.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM b",
          "expect": "Tehran Qom Markazi Qazvin Gilan Ardabil"
        }
      ]
    },
    {
      "name": "walprotocol-2.6",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "r",
          "expect": "0 {Tehran Qom Markazi Qazvin Gilan Ardabil}"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "close_named_db",
          "database": "db2"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "walprotocol-2.7",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM b",
          "expect": "Tehran Qom Markazi Qazvin Gilan Ardabil"
        }
      ]
    },
    {
      "name": "walprotocol-2.8",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "r",
          "expect": "0 {Tehran Qom Markazi Qazvin Gilan Ardabil}"
        }
      ]
    },
    {
      "name": "setup_3",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "close_named_db",
          "database": "db2"
        }
      ]
    }
  ]
}