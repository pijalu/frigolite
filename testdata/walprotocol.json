{
  "file": "walprotocol.test",
  "name": "walprotocol",
  "tests": [
    {
      "name": "1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = wal;\n  CREATE TABLE x(y);\n  INSERT INTO x VALUES('z');"
        }
      ]
    },
    {
      "name": "1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM x"
        }
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM x"
        }
      ]
    },
    {
      "name": "1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM x",
          "expect": "1 {locking protocol}"
        }
      ]
    },
    {
      "name": "1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM x",
          "expect": "1 {locking protocol}"
        }
      ]
    },
    {
      "name": "1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM x",
          "expect": "0 z"
        }
      ]
    },
    {
      "name": "2.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA auto_vacuum = off;\n    PRAGMA journal_mode = WAL;\n    CREATE TABLE b(c);\n    INSERT INTO b VALUES('Tehran');\n    INSERT INTO b VALUES('Qom');\n    INSERT INTO b VALUES('Markazi');\n    PRAGMA wal_checkpoint;",
          "expect": "wal 0 5 5"
        }
      ]
    },
    {
      "name": "2.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM b",
          "expect": "Tehran Qom Markazi"
        }
      ]
    },
    {
      "name": "2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO b VALUES('Gilan');\n    INSERT INTO b VALUES('Ardabil');"
        }
      ]
    },
    {
      "name": "2.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM b",
          "expect": "Tehran Qom Markazi Qazvin Gilan Ardabil"
        }
      ]
    },
    {
      "name": "2.7",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM b",
          "expect": "Tehran Qom Markazi Qazvin Gilan Ardabil"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM x"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM x"
        },
        {
          "type": "exec",
          "sql": "PRAGMA auto_vacuum = off;\n    PRAGMA journal_mode = WAL;\n    CREATE TABLE b(c);\n    INSERT INTO b VALUES('Tehran');\n    INSERT INTO b VALUES('Qom');\n    INSERT INTO b VALUES('Markazi');\n    PRAGMA wal_checkpoint;"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM b"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO b VALUES('Gilan');\n    INSERT INTO b VALUES('Ardabil');"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM b"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM b"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM b"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO b VALUES('Qazvin')"
        }
      ]
    }
  ]
}