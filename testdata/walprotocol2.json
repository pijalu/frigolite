{
  "file": "walprotocol2.test",
  "name": "walprotocol2",
  "ordered": true,
  "tests": [
    {
      "name": "walprotocol2-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = wal;\n  CREATE TABLE x(y);\n  INSERT INTO x VALUES('z');",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "register_testvfs",
          "variable": "T"
        },
        {
          "type": "testvfs_config",
          "sql": "filter",
          "variable": "xShmLock",
          "database": "T"
        },
        {
          "type": "testvfs_config",
          "sql": "script",
          "variable": "lock_callback",
          "callbackProcs": [
            {
              "Name": "lock_callback",
              "Args": [
                "method",
                "filename",
                "handle",
                "lock"
              ],
              "Body": "\n  # puts \"$method $filename $handle $lock\"\n",
              "Defaults": null
            }
          ],
          "functionProc": "lock_callback",
          "database": "T"
        },
        {
          "type": "reopen_db",
          "sql": "test.db",
          "vfs": "T"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "vfs": "T",
          "database": "db2"
        }
      ]
    },
    {
      "name": "walprotocol2-2.0",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM x;",
          "expect": "z"
        }
      ]
    },
    {
      "name": "walprotocol2-2.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM x;",
          "expect": "z",
          "database": "db2"
        }
      ]
    },
    {
      "name": "walprotocol2-2.2",
      "steps": [
        {
          "type": "catch",
          "sql": "BEGIN EXCLUSIVE;",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "walprotocol2-2.4",
      "steps": [
        {
          "type": "catch",
          "sql": "BEGIN EXCLUSIVE;",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "walprotocol2-2.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM x;\n  COMMIT;",
          "expect": "z y x"
        }
      ]
    }
  ]
}