{
  "file": "walprotocol2.test",
  "name": "walprotocol2",
  "tests": [
    {
      "name": "1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = wal;\n  CREATE TABLE x(y);\n  INSERT INTO x VALUES('z');"
        }
      ]
    },
    {
      "name": "2.0",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM x;",
          "expect": "z"
        }
      ]
    },
    {
      "name": "2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN EXCLUSIVE;",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN EXCLUSIVE;",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "2.5",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM x;\n  COMMIT;"
        }
      ]
    }
  ]
}