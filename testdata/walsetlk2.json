{
  "file": "walsetlk2.test",
  "name": "walsetlk2",
  "ordered": true,
  "tests": [
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "walsetlk2-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = wal;\n  CREATE TABLE t1(a, b, c);\n  INSERT INTO t1 VALUES(1, 2, 3);",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "walsetlk2-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3"
        }
      ]
    },
    {
      "name": "walsetlk2-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(4, 5, 6);"
        }
      ]
    },
    {
      "name": "walsetlk2-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(7, 8, 9);"
        }
      ]
    },
    {
      "name": "walsetlk2-1.4",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "xshmlock",
          "expect": "{0 1 lock exclusive} {4 1 lock exclusive} {4 1 unlock exclusive} {4 1 lock shared} {0 1 unlock exclusive} {4 1 unlock shared}"
        }
      ]
    },
    {
      "name": "walsetlk2-1.5.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4 5 6 7 8 9"
        }
      ]
    },
    {
      "name": "walsetlk2-1.5.2",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(10, 11, 12);"
        }
      ]
    },
    {
      "name": "walsetlk2-1.5.3",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "xshmlock",
          "expect": "{0 1 lock exclusive} {4 1 lock shared} {0 1 unlock exclusive} {4 1 unlock shared}"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "walsetlk2-2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n  INSERT INTO t1 VALUES(1, 2), (3, 4);"
        }
      ]
    },
    {
      "name": "walsetlk2-2.1",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(7, 8);",
          "expect": "1 {database is locked}"
        }
      ]
    },
    {
      "name": "walsetlk2-2.2",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1 VALUES(7, 8);",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "walsetlk2-2.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4 5 6 7 8"
        }
      ]
    },
    {
      "name": "walsetlk2-2.4",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_mode = wal;",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "setup_3",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "walsetlk2-2.5",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(9, 10);"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    }
  ]
}