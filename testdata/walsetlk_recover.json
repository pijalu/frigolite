{
  "file": "walsetlk_recover.test",
  "name": "walsetlk_recover",
  "ordered": true,
  "tests": [
    {
      "name": "walsetlk_recover-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = wal;\n  CREATE TABLE t1(a, b);\n  INSERT INTO t1 VALUES(1, 2);\n  INSERT INTO t1 VALUES(3, 4);\n  INSERT INTO t1 VALUES(5, 6);",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "register_testvfs",
          "variable": "tvfs"
        },
        {
          "type": "reopen_db",
          "sql": "test.db",
          "vfs": "tvfs"
        },
        {
          "type": "testvfs_config",
          "sql": "script",
          "variable": "sleep_callback",
          "callbackProcs": [
            {
              "Name": "sleep_callback",
              "Args": [
                "args"
              ],
              "Body": "\n  incr ::sleep_count\n",
              "Defaults": null
            }
          ],
          "functionProc": "sleep_callback",
          "database": "tvfs"
        },
        {
          "type": "testvfs_config",
          "sql": "filter",
          "variable": "xSleep",
          "database": "tvfs"
        },
        {
          "type": "runtime_expr",
          "sql": "0",
          "variable": "sleep_count"
        },
        {
          "type": "reopen_db",
          "sql": "test.db",
          "vfs": "tvfs"
        }
      ]
    },
    {
      "name": "walsetlk_recover-1.2",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "msg",
          "expect": "database is locked"
        }
      ]
    },
    {
      "name": "walsetlk_recover-1.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4 5 6"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "walsetlk_recover-1.5.2",
      "steps": [
        {
          "type": "runtime_expr",
          "sql": "$::sleep_count\u003e0",
          "expect": "1"
        }
      ]
    }
  ]
}