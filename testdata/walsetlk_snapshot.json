{
  "file": "walsetlk_snapshot.test",
  "name": "walsetlk_snapshot",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "walsetlk_snapshot-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_mode = wal;\n  CREATE TABLE t1(a, b);\n  INSERT INTO t1 VALUES(1, 2);\n  INSERT INTO t1 VALUES(3, 4);\n  INSERT INTO t1 VALUES(5, 6);",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "walsetlk_snapshot-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(7, 8);\n    COMMIT;"
        }
      ]
    },
    {
      "name": "walsetlk_snapshot-1.2",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "msg",
          "expect": "SQLITE_BUSY"
        }
      ]
    },
    {
      "name": "walsetlk_snapshot-1.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4 5 6 7 8"
        }
      ]
    }
  ]
}