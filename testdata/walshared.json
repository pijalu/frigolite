{
  "file": "walshared.test",
  "name": "walshared",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "walshared-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA cache_size = 10;\n    PRAGMA journal_mode = WAL;\n    CREATE TABLE t1(a PRIMARY KEY, b UNIQUE);\n    INSERT INTO t1 VALUES(randomblob(100), randomblob(200));",
          "expect": "wal"
        }
      ]
    },
    {
      "name": "walshared-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n      INSERT INTO t1 VALUES(randomblob(100), randomblob(200));\n      INSERT INTO t1 SELECT randomblob(100), randomblob(200) FROM t1;\n      INSERT INTO t1 SELECT randomblob(100), randomblob(200) FROM t1;\n      INSERT INTO t1 SELECT randomblob(100), randomblob(200) FROM t1;"
        }
      ]
    },
    {
      "name": "walshared-1.2",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA wal_checkpoint",
          "expect": "1 {database table is locked}"
        }
      ]
    },
    {
      "name": "walshared-1.3",
      "steps": [
        {
          "type": "catch",
          "sql": "PRAGMA wal_checkpoint",
          "expect": "1 {database table is locked}",
          "database": "db2"
        }
      ]
    },
    {
      "name": "walshared-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        },
        {
          "type": "exec",
          "sql": "PRAGMA integrity_check",
          "expect": "ok",
          "database": "db2"
        }
      ]
    }
  ]
}