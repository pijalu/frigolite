          "type": "testvfs_config",
          "sql": "script",
          "variable": "xShmMap",
          "callbackProcs": [
            {
              "Name": "xShmMap",
              "Args": [
                "method",
                "file",
                "name",
                "args"
              ],
              "Body": " \n  switch -- $method {\n    xShmMap {  return SQLITE_READONLY }\n    xShmLock {\n      if {$args == \"{0 1 lock shared}\"} {\n        incr ::cnt -1\n        if {$::cnt\u003e0} { return SQLITE_BUSY }\n      }\n    }\n  }\n  return SQLITE_OK\n",
