{
  "file": "walvfs.test",
  "name": "walvfs",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "walvfs-1.0",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA auto_vacuum = 0;\n  PRAGMA journal_mode = wal;\n  PRAGMA synchronous = normal;\n  CREATE TABLE t1(a, b, c);\n  INSERT INTO t1 VALUES(1, 2, 3);\n  INSERT INTO t1 VALUES(4, 5, 6);\n  INSERT INTO t1 VALUES(7, 8, 9);\n  PRAGMA wal_checkpoint;",
          "expect": "wal 0 5 5"
        }
      ]
    },
    {
      "name": "walvfs-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(10, 11, 12)"
        },
        {
          "type": "runtime_var",
          "variable": "sync_count",
          "expect": "1"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
      "name": "walvfs-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA synchronous = normal;\n  INSERT INTO t1 VALUES(13, 14, 15);\n  INSERT INTO t1 VALUES(16, 17, 18);\n  PRAGMA wal_checkpoint;",
          "expect": "0 4 4"
        }
      ]
    },
    {
      "name": "walvfs-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(10, 11, 12)"
        },
        {
          "type": "runtime_var",
          "variable": "sync_count",
          "expect": "0"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "walvfs-2.0",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA journal_size_limit = 10000;\n  CREATE TABLE t1(x);\n  PRAGMA journal_mode = wal;\n  WITH s(i) AS (\n    SELECT 1 UNION ALL SELECT i+1 FROM s LIMIT 20\n  )\n  INSERT INTO t1 SELECT randomblob(750) FROM s;",
          "expect": "10000 wal"
        }
      ]
    },
    {
      "name": "walvfs-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA wal_checkpoint;\n    INSERT INTO t1 VALUES(randomblob(750));",
          "expect": "10000"
        }
      ]
    },
    {
      "name": "walvfs-2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA journal_size_limit = 8000;\n    PRAGMA wal_checkpoint;\n    INSERT INTO t1 VALUES(randomblob(750));",
          "expect": "8000"
        }
