                "handle",
                "args"
              ],
              "Body": "\n  switch -- $method {\n    xShmMap {\n      return \"SQLITE_READONLY_CANTINIT\"\n    }\n    xShmLock {\n      if {$args==\"{3 1 lock shared}\"} {\n        return \"SQLITE_IOERR\"\n      }\n    }\n  }\n",
              "Defaults": null
            }
          ],
          "functionProc": "xShmMap",
          "database": "tvfs"
        },
        {
          "type": "reopen_db",
          "sql": "test.db",
          "vfs": "tvfs"
        }
      ]
    },
