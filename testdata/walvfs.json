          "sql": "test.db",
          "vfs": "tvfs"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n    PRAGMA journal_mode = wal;\n    WITH s(i) AS (\n        SELECT 1 UNION ALL SELECT i+1 FROM s LIMIT 20\n    )\n    INSERT INTO t1 SELECT randomblob(750) FROM s;",
          "expect": "wal"
