{
  "file": "walvfs.test",
  "name": "walvfs",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "register_testvfs",
          "variable": "tvfs"
        },
        {
          "type": "testvfs_config",
          "sql": "script",
          "variable": "xSync",
          "callbackProcs": [
            {
              "Name": "xSync",
              "Args": [
                "method",
                "file",
                "args"
              ],
              "Body": "\n  if {[file tail $file]==\"test.db-wal\"} {\n    incr ::sync_count\n  }\n",
              "Defaults": null
            }
          ],
          "functionProc": "xSync",
          "database": "tvfs"
        },
        {
          "type": "testvfs_config",
          "sql": "filter",
          "variable": "xSync",
          "database": "tvfs"
        },
        {
          "type": "reopen_db",
          "sql": "test.db",
          "vfs": "tvfs"
        }
      ]
    },
    {
      "name": "walvfs-1.0",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA auto_vacuum = 0;\n  PRAGMA journal_mode = wal;\n  PRAGMA synchronous = normal;\n  CREATE TABLE t1(a, b, c);\n  INSERT INTO t1 VALUES(1, 2, 3);\n  INSERT INTO t1 VALUES(4, 5, 6);\n  INSERT INTO t1 VALUES(7, 8, 9);\n  PRAGMA wal_checkpoint;",
          "expect": "wal 0 5 5"
        }
      ]
    },
    {
      "name": "setup_1",
      "steps": [
        {
          "type": "runtime_expr",
          "sql": "0",
          "variable": "sync_count"
        }
      ]
    },
    {
      "name": "walvfs-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(10, 11, 12)"
        },
        {
          "type": "runtime_var",
          "variable": "sync_count",
          "expect": "1"
        }
      ]
    },
    {
      "name": "setup_2",
      "steps": [
        {
          "type": "close_db"
        },
