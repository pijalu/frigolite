    {
      "name": "setup_18",
      "steps": [
        {
          "type": "testvfs_config",
          "sql": "script",
          "variable": "xShmLock",
          "callbackProcs": [
            {
              "Name": "xShmLock",
              "Args": [
                "method",
                "file",
                "handle",
                "spec"
              ],
              "Body": "\n  if {$::flag \u0026\u0026 [lrange $spec 2 end]==\"lock shared\"} {\n    return SQLITE_BUSY\n  }\n  if {$spec==\"3 1 unlock shared\"} {\n    set ::flag 1\n  }\n  return SQLITE_OK\n",
              "Defaults": null
            }
          ],
          "functionProc": "xShmLock",
          "database": "tvfs"
        },
