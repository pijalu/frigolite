    {
      "name": "setup_5",
      "steps": [
        {
          "type": "testvfs_config",
          "sql": "filter",
          "variable": "xWrite",
          "database": "tvfs"
        },
        {
          "type": "testvfs_config",
          "sql": "script",
          "variable": "xWrite",
          "callbackProcs": [
            {
              "Name": "xWrite",
              "Args": [
                "method",
                "file",
                "args"
              ],
              "Body": "\n  if {[file tail $file]==\"test.db\"} {\n    incr ::cnt -1\n    if {$::cnt==0} {\n      sqlite3_memdebug_fail 1 -repeat 0\n      # For this test to pass, the following statement must call malloc() at \n      # least once. Even if the lookaside is enabled.\n      set ::xwrite_stmt_res [catchsql { SELECT hex(randomblob(4000)) }]\n      sqlite3_interrupt db\n    }\n  }\n  return SQLITE_OK\n",
              "Defaults": null
            }
          ],
          "functionProc": "xWrite",
          "database": "tvfs"
        }
      ]
    },
