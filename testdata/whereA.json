{
  "file": "whereA.test",
  "name": "whereA",
  "ordered": true,
  "tests": [
    {
      "name": "whereA-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a INTEGER PRIMARY KEY, b UNIQUE, c);\n    INSERT INTO t1 VALUES(1,2,3);\n    INSERT INTO t1 values(2,'hello','world');\n    INSERT INTO t1 VALUES(3,4.53,NULL);\n    SELECT * FROM t1",
          "expect": "1 2 3 2 hello world 3 4.53 {}"
        }
      ]
    },
    {
      "name": "whereA-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA reverse_unordered_selects=1;\n    SELECT * FROM t1;",
          "expect": "3 4.53 {} 2 hello world 1 2 3"
        }
      ]
    },
    {
      "name": "whereA-1.3",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA reverse_unordered_selects=1;\n    SELECT * FROM t1;",
          "expect": "3 4.53 {} 2 hello world 1 2 3"
        }
      ]
    },
    {
      "name": "whereA-1.4",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA reverse_unordered_selects=1;\n    SELECT * FROM t1 ORDER BY rowid;",
          "expect": "1 2 3 2 hello world 3 4.53 {}"
        }
      ]
    },
    {
      "name": "whereA-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "VACUUM;\n    SELECT * FROM t1 ORDER BY rowid;",
          "expect": "1 2 3 2 hello world 3 4.53 {}"
        }
      ]
    },
    {
      "name": "whereA-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA reverse_unordered_selects;",
          "expect": "1"
        }
      ]
    },
    {
      "name": "whereA-1.7",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "PRAGMA reverse_unordered_selects=1;\n    VACUUM;\n    SELECT * FROM t1;",
          "expect": "3 4.53 {} 2 hello world 1 2 3"
        }
      ]
    },
    {
      "name": "whereA-1.8",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1 WHERE b=2 AND a IS NULL;"
        }
      ]
    },
    {
      "name": "whereA-1.9",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1 WHERE b=2 AND a IS NOT NULL;",
          "expect": "1 2 3"
        }
      ]
    },
    {
      "name": "whereA-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA reverse_unordered_selects=0;\n    SELECT * FROM t1 WHERE a\u003e0;",
          "expect": "1 2 3 2 hello world 3 4.53 {}"
        }
      ]
    },
    {
      "name": "whereA-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA reverse_unordered_selects=1;\n    SELECT * FROM t1 WHERE a\u003e0;",
          "expect": "3 4.53 {} 2 hello world 1 2 3"
        }
      ]
    },
    {
      "name": "whereA-2.3",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA reverse_unordered_selects=1;\n    SELECT * FROM t1 WHERE a\u003e0 ORDER BY rowid;",
          "expect": "1 2 3 2 hello world 3 4.53 {}"
        }
      ]
    },
    {
      "name": "whereA-3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA reverse_unordered_selects=0;\n    SELECT * FROM t1 WHERE b\u003e0;",
          "expect": "1 2 3 3 4.53 {} 2 hello world"
        }
      ]
    },
    {
      "name": "whereA-3.2",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA reverse_unordered_selects=1;\n    SELECT * FROM t1 WHERE b\u003e0;",
          "expect": "2 hello world 3 4.53 {} 1 2 3"
        }
      ]
    },
    {
      "name": "whereA-3.3",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA reverse_unordered_selects=1;\n    SELECT * FROM t1 WHERE b\u003e0 ORDER BY b;",
          "expect": "1 2 3 3 4.53 {} 2 hello world"
        }
      ]
    },
    {
      "name": "whereA-4.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t2(x);\n    INSERT INTO t2 VALUES(1);\n    INSERT INTO t2 VALUES(2);\n    SELECT x FROM t2;",
          "expect": "2 1"
        }
      ]
    },
    {
      "name": "whereA-4.2",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE INDEX t2x ON t2(x);"
        },
        {
          "type": "exec",
          "sql": "SELECT x FROM t2;",
          "expect": "2 1 0"
        }
      ]
    },
    {
      "name": "whereA-4.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT x FROM t2 ORDER BY x;",
          "expect": "1 2 0"
        }
      ]
    },
    {
      "name": "whereA-4.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT x FROM t2 ORDER BY x DESC;",
          "expect": "2 1 0"
        }
      ]
    },
    {
      "name": "whereA-4.5",
      "steps": [
        {
          "type": "exec",
          "sql": "DROP INDEX t2x;"
        },
        {
          "type": "exec",
          "sql": "SELECT x FROM t2 ORDER BY x;",
          "expect": "1 2 1"
        }
      ]
    },
    {
      "name": "whereA-4.6",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT x FROM t2 ORDER BY x DESC;",
          "expect": "2 1 1"
        }
      ]
    },
    {
      "name": "whereA-5.1",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA reverse_unordered_selects=on;\n  DROP TABLE IF EXISTS t1;\n  CREATE TABLE t1(a,b);\n  INSERT INTO t1 VALUES(1,2);\n  CREATE INDEX t1b ON t1(b);\n  SELECT a FROM t1 WHERE b=-99 OR b\u003e1;",
          "expect": "1"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "whereA-6.1",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t1(a, b);\n  CREATE INDEX t1aa ON t1(a,a);\n  INSERT INTO t1 VALUES(1,2);\n  ANALYZE;\n  UPDATE sqlite_stat1 SET stat='27 3 3' WHERE idx='t1aa';\n  ANALYZE sqlite_schema;\n  PRAGMA reverse_unordered_selects (1) ;\n  SELECT a FROM t1 WHERE  a=1 OR a=2;",
          "expect": "1"
        }
      ]
    }
  ]
}