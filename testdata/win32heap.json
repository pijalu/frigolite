{
  "file": "win32heap.test",
  "name": "win32heap",
  "ordered": true,
  "tests": [
    {
      "name": "win32heap-1.1",
      "steps": [
        {
          "type": "close_db",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "win32heap-1.2",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "catch",
          "sql": "CREATE TABLE t1(x);",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "win32heap-1.3",
      "steps": [
        {
          "type": "catch",
          "sql": "INSERT INTO t1 (x) VALUES(RANDOMBLOB(1048576));",
          "expect": "1 {out of memory}"
        }
      ]
    },
    {
      "name": "win32heap-1.4",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT COUNT(*) FROM t1;",
          "expect": "0 0"
        }
      ]
    },
    {
      "name": "win32heap-1.5",
      "steps": [
        {
          "type": "close_db",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "win32heap-1.6",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "catch",
          "sql": "INSERT INTO t1 (x) VALUES(RANDOMBLOB(1048576));",
          "expect": "0 {}"
        }
      ]
    },
    {
      "name": "win32heap-1.7",
      "steps": [
        {
          "type": "catch",
          "sql": "SELECT COUNT(*) FROM t1;",
          "expect": "0 1"
        }
      ]
    }
  ]
}