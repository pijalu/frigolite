{
  "file": "win32nolock.test",
  "name": "win32nolock",
  "tests": [
    {
      "name": "win32nolock-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n    BEGIN;\n    INSERT INTO t1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "win32nolock-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "0 {1 2}"
        }
      ]
    },
    {
      "name": "win32nolock-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA mmap_size = 0"
        }
      ]
    },
    {
      "name": "win32nolock-1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4"
        }
      ]
    },
    {
      "name": "win32nolock-1.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1;",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "win32nolock-1.5",
      "steps": [
        {
          "type": "query",
          "sql": "BEGIN;\n    SELECT * FROM t1;",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "win32nolock-1.6",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2"
        }
      ]
    },
    {
      "name": "win32nolock-1.7",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4"
        }
      ]
    },
    {
      "name": "win32nolock-1.9.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN EXCLUSIVE;",
          "expect": "{0 {}} {1 {database is locked}}"
        }
      ]
    },
    {
      "name": "win32nolock-1.10.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN EXCLUSIVE;",
          "expect": "{0 {}} {0 {}}"
        }
      ]
    },
    {
      "name": "win32nolock-1.11.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN EXCLUSIVE;",
          "expect": "{0 {}} {0 {}}"
        }
      ]
    },
    {
      "name": "win32nolock-1.12.1",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN EXCLUSIVE;",
          "expect": "{0 {}} {0 {}}"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n    BEGIN;\n    INSERT INTO t1 VALUES(1, 2);"
        },
        {
          "type": "exec",
          "sql": "PRAGMA mmap_size = 0"
        },
        {
          "type": "exec",
          "sql": "BEGIN;\n    INSERT INTO t1 VALUES(3, 4);"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1;"
        },
        {
          "type": "exec",
          "sql": "BEGIN;\n    SELECT * FROM t1;"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1"
        }
      ]
    }
  ],
  "source": "capi"
}