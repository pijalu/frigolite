{
  "file": "win32nolock.test",
  "name": "win32nolock",
  "ordered": true,
  "tests": [
    {
      "name": "win32nolock-1.0",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n    BEGIN;\n    INSERT INTO t1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "win32nolock-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        },
        {
          "type": "catch",
          "sql": "SELECT * FROM t1",
          "expect": "0 {1 2}"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        }
      ]
    },
    {
      "name": "win32nolock-1.2",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "PRAGMA mmap_size = 0",
          "database": "db2"
        },
        {
          "type": "exec",
          "sql": "BEGIN;\n    INSERT INTO t1 VALUES(3, 4);"
        }
      ]
    },
    {
      "name": "win32nolock-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4"
        }
      ]
    },
    {
      "name": "win32nolock-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1;",
          "expect": "1 2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "win32nolock-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "BEGIN;\n    SELECT * FROM t1;",
          "expect": "1 2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "win32nolock-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "COMMIT"
        },
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2",
          "database": "db2"
        }
      ]
    },
    {
      "name": "win32nolock-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1",
          "expect": "1 2 3 4",
          "database": "db2"
        }
      ]
    },
    {
      "name": "win32nolock-1.8",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "close_named_db",
          "database": "db2"
        }
      ]
    },
    {
      "name": "win32nolock-1.9.1",
      "steps": [
        {
          "type": "reopen_db",
          "sql": "test.db"
        },
        {
          "type": "open_named_db",
          "sql": "test.db",
          "database": "db2"
        },
        {
          "type": "catch",
          "sql": "BEGIN EXCLUSIVE;"
        },
        {
          "type": "catch",
          "sql": "BEGIN EXCLUSIVE;",
          "expect": "{0 {}} {1 {database is locked}}",
          "database": "db2"
        }
      ]
    },
