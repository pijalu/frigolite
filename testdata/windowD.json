{
  "file": "windowD.test",
  "name": "windowD",
  "ordered": true,
  "tests": [
    {
      "name": "windowD-1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t0(c0 TEXT);\n  CREATE VIEW v0(c0, c1) \n    AS SELECT CUME_DIST() OVER (PARTITION BY t0.c0), TRUE FROM t0;\n  INSERT INTO t0 VALUES ('x');"
        }
      ]
    },
    {
      "name": "windowD-1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT ('500') IS (v0.c1) FROM v0;",
          "expect": "\n  0\n"
        }
      ]
    },
    {
      "name": "windowD-1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT (('500') IS (v0.c1)) FROM v0, t0;",
          "expect": "\n  0\n"
        },
        {
          "type": "query",
          "sql": "SELECT (('500') IS (v0.c1)) IS FALSE FROM v0;",
          "expect": "\n  1\n"
        }
      ]
    },
    {
      "name": "windowD-1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM v0;",
          "expect": "\n  1.0 1\n"
        }
      ]
    },
    {
      "name": "windowD-1.4",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM v0 WHERE ('500' IS v0.c1) IS FALSE;",
          "expect": "\n  1.0 1\n"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": null
    },
    {
      "name": "windowD-2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);\n  INSERT INTO t1 VALUES('value');\n  CREATE VIEW v1(a, b, c, d) AS SELECT 1, 2, TRUE, FALSE FROM t1;"
        }
      ]
    },
    {
      "name": "windowD-2.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 500 IS a, 500 IS b, 500 IS c, 500 IS d FROM v1",
          "expect": "0 0 0 0"
        }
      ]
    },
    {
      "name": "windowD-2.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM v1 WHERE 500 IS c;"
        }
      ]
    },
    {
      "name": "windowD-2.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM v1 WHERE 500 IS d;"
        }
      ]
    },
    {
      "name": "windowD-2.4",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE VIEW v2 AS SELECT max(x) OVER () AS a, TRUE AS c FROM t1;"
        }
      ]
    },
    {
      "name": "windowD-2.5",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT 500 IS c FROM v2;",
          "expect": "0"
        }
      ]
    },
    {
      "name": "windowD-2.6",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM v2 WHERE 500 IS c;"
        }
      ]
    }
  ]
}