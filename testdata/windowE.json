    {
      "name": "4.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b);\n  INSERT INTO t1 VALUES(1, 1);\n  INSERT INTO t1 VALUES(2, 9223372036854775807);\n  INSERT INTO t1 VALUES(3, 3);\n  INSERT INTO t1 VALUES(4, 4);"
        }
      ]
    },
    {
      "name": "4.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT a, \n    total(b) OVER (ORDER BY a ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING)\n  FROM t1;",
          "expect": "1 9.22337203685478e+18 2 9.22337203685478e+18 3 7.0 4 4.0"
        }
      ]
    },
    {
      "name": "4.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT a, \n    total(b) OVER (ORDER BY a ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING)\n  FROM t1;",
          "expect": "1 9.22337203685478e+18 2 9.22337203685478e+18 3 7.0 4 4.0"
        }
      ]
    },
    {
      "name": "5.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t(id, x);\n  INSERT INTO t VALUES(1, -1);\n  INSERT INTO t VALUES(2, 9223372036854775807);\n  INSERT INTO t VALUES(3, 1);\n  INSERT INTO t VALUES(4, 0.5);"
        }
      ]
    },
    {
      "name": "5.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT id,\n    sum(id) OVER (ORDER BY id ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) \n  FROM t t1",
          "expect": "1 6\n  2 9\n  3 7\n  4 4"
        }
      ]
    },
    {
      "name": "5.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT id,\n    sum(x) OVER (ORDER BY id ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING) \n  FROM t t1",
          "expect": "1 9223372036854775807 \n  2 9.22337203685478e+18 \n  3 1.5 \n  4 0.5"
        }
      ]
    },
