{
  "file": "windowE.test",
  "name": "windowE",
  "tests": [
    {
      "name": "1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a INTEGER PRIMARY KEY, b TEXT COLLATE custom);\n  INSERT INTO t1 VALUES(1, 'one');\n  INSERT INTO t1 VALUES(2, 'two');\n  INSERT INTO t1 VALUES(3, 'three');\n  INSERT INTO t1 VALUES(4, 'four');\n  INSERT INTO t1 VALUES(5, 'five');\n  INSERT INTO t1 VALUES(6, 'six');\n  CREATE INDEX t1b ON t1(b);"
        }
      ]
    },
    {
      "name": "1.1",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT * FROM t1",
          "expect": "1 one 2 two 3 three 4 four 5 five 6 six"
        }
      ]
    },
    {
      "name": "1.2",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT group_concat(a,',') OVER win FROM t1 \n  WINDOW win AS (\n    ORDER BY b RANGE BETWEEN 1 PRECEDING AND 2 PRECEDING\n  )",
          "expect": "5 4 1 6 3 2"
        }
      ]
    },
    {
      "name": "1.3",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT group_concat(a,',') OVER win FROM t1 \n  WINDOW win AS (\n    ORDER BY b RANGE BETWEEN 1 PRECEDING AND 2 PRECEDING\n  )",
          "expect": "5 5,4 5,4,1 5,4,1,6 5,4,1,6,3 5,4,1,6,3,2"
        }
      ]
    },
    {
      "name": "2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(x);"
        }
      ]
    },
    {
      "name": "2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT min(x) OVER w1 FROM t1\n    WINDOW w1 AS (PARTITION BY x_count(x) OVER w1);",
          "expect": "1 {x_count() may not be used as a window function}"
        }
      ]
    },
    {
      "name": "2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT min(x) FILTER (WHERE x_count(x) OVER w1) OVER w1 FROM t1\n    WINDOW w1 AS (PARTITION BY x OVER w1);",
          "expect": "1 {near \"OVER\": syntax error}"
        }
      ]
    },
    {
      "name": "3.0",
