{
  "file": "without_rowid7.test",
  "name": "without_rowid7",
  "tests": [
    {
      "name": "1.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a, b COLLATE nocase, PRIMARY KEY(a, a, b)) WITHOUT ROWID;"
        }
      ]
    },
    {
      "name": "1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(1, 'one'), (1, 'ONE');",
          "expect": "1 {UNIQUE constraint failed: t1.a, t1.b}"
        }
      ]
    },
    {
      "name": "2.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t2(a, b, PRIMARY KEY(a COLLATE nocase, a)) WITHOUT ROWID;"
        }
      ]
    },
    {
      "name": "2.1",
      "steps": [
        {
          "type": "query",
          "sql": "INSERT INTO t2 VALUES(1, 'one');\n  SELECT b FROM t2;",
          "expect": "one"
        }
      ]
    },
    {
      "name": "2.2a",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA index_info(t2);",
          "expect": "0 0 a 1 0 a"
        }
      ]
    },
    {
      "name": "2.3a",
      "steps": [
        {
          "type": "query",
          "sql": "PRAGMA index_xinfo(t2);",
          "expect": "0 0 a 0 nocase 1 1 0 a 0 BINARY 1 2 1 b 0 BINARY 0"
        }
      ]
    },
    {
      "name": "2.4",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t3(a, b, PRIMARY KEY(a COLLATE nocase, a));\n  PRAGMA index_info(t3);"
        }
      ]
    },
    {
      "name": "3.0",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(\n      a PRIMARY KEY COLLATE mysort, b COLLATE mysort2\n  ) WITHOUT ROWID;\n  INSERT INTO t1 VALUES(1, 2);"
        }
      ]
    },
    {
      "name": "3.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1 WHERE a=1;",
          "expect": "1 {no such collation sequence: mysort}"
        }
      ]
    },
    {
      "name": "3.2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE UNIQUE INDEX i1 ON t1(b);",
          "expect": "1 {no such collation sequence: mysort2}"
        }
      ]
    },
    {
      "name": "3.3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE UNIQUE INDEX i1 ON t1(1);",
          "expect": "1 {no such collation sequence: mysort}"
        }
      ]
    },
    {
      "name": "3.6",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT * FROM t1 WHERE a=1;",
          "expect": "1 {no such collation sequence: mysort}"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    },
    {
      "name": "__RESET_DB__",
      "steps": [
        {
          "type": "reset_db"
        }
      ]
    }
  ],
  "source": "capi"
}