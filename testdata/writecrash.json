  "name": "writecrash",
  "ordered": true,
  "tests": [
    {
      "name": "writecrash-1.0",
      "steps": [
        {
          "type": "query",
          "sql": "CREATE TABLE t1(a INTEGER PRIMARY KEY, b BLOB UNIQUE);\n  WITH s(i) AS (\n    VALUES(1) UNION ALL SELECT i+1 FROM s WHERE i\u003c100\n  )\n  INSERT INTO t1 SELECT NULL, randomblob(900) FROM s;"
        }
      ]
    },
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "close_db"
        },
        {
          "type": "reopen_db",
          "sql": "test.db"
        }
      ]
    },
    {
