{
  "file": "zeroblob.test",
  "name": "zeroblob",
  "tests": [
    {
      "name": "11.0",
      "steps": [
        {
          "type": "query",
          "sql": "SELECT length(zeroblob(-1444444444444444));",
          "expect": "0"
        }
      ]
    },
    {
      "name": "11.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT zeroblob(5000 * 1024 * 1024);",
          "expect": "1 {string or blob too big}"
        }
      ]
    },
    {
      "name": "11.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT quote(zeroblob(5000 * 1024 * 1024));",
          "expect": "1 {string or blob too big}"
        }
      ]
    },
    {
      "name": "11.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT quote(zeroblob(-1444444444444444));",
          "expect": "0 X''"
        }
      ]
    },
    {
      "name": "11.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT quote(test_zeroblob(-1));",
          "expect": "0 X''"
        }
      ]
    },
    {
      "name": "13.100",
      "steps": [
        {
          "type": "query",
          "sql": "DROP TABLE IF EXISTS t1;\n  CREATE TABLE t1(a,b,c);\n  CREATE INDEX t1bbc ON t1(b, b+c);\n  INSERT INTO t1(a,b,c) VALUES(1,zeroblob(8),3);\n  SELECT a, quote(b), length(b), c FROM t1;",
          "expect": "1 X'0000000000000000' 8 3"
        }
      ]
    },
