{
  "file": "zeroblob.test",
  "name": "zeroblob",
  "ordered": true,
  "tests": [
    {
      "name": "setup_0",
      "steps": [
        {
          "type": "exec",
          "sql": "PRAGMA cache_size=10"
        }
      ]
    },
    {
      "name": "zeroblob-1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE TABLE t1(a,b,c,d);"
        },
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(2,3,4,zeroblob(1000000));"
        }
      ]
    },
    {
      "name": "zeroblob-1.1.1",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "sqlite3_max_blobsize",
          "expect": "10"
        }
      ]
    },
    {
      "name": "zeroblob-1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT length(d) FROM t1",
          "expect": "1000000"
        }
      ]
    },
    {
      "name": "zeroblob-1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(3,4,zeroblob(10000),5);"
        },
        {
          "type": "runtime_var",
          "variable": "sqlite3_max_blobsize",
          "expect": "10010"
        }
      ]
    },
    {
      "name": "zeroblob-1.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT length(c), length(d) FROM t1",
          "expect": "1 1000000 10000 1"
        }
      ]
    },
    {
      "name": "zeroblob-1.5",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(4,5,zeroblob(10000),zeroblob(10000));"
        }
      ]
    },
    {
      "name": "zeroblob-1.5.1",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "sqlite3_max_blobsize",
          "expect": "11"
        }
      ]
    },
    {
      "name": "zeroblob-1.6",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT length(c), length(d) FROM t1",
          "expect": "1 1000000 10000 1 10000 10000"
        }
      ]
    },
    {
      "name": "zeroblob-1.7",
      "steps": [
        {
          "type": "exec",
          "sql": "INSERT INTO t1 VALUES(5,zeroblob(10000),NULL,zeroblob(10000));"
        }
      ]
    },
    {
      "name": "zeroblob-1.7.1",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "sqlite3_max_blobsize",
          "expect": "10"
        }
      ]
    },
    {
      "name": "zeroblob-1.8",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT length(b), length(d) FROM t1 WHERE a=5",
          "expect": "10000 10000"
        }
      ]
    },
    {
      "name": "zeroblob-2.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT a FROM t1 WHERE b=zeroblob(10000)",
          "expect": "5"
        }
      ]
    },
    {
      "name": "zeroblob-2.2",
      "steps": [
        {
          "type": "exec",
          "sql": "CREATE INDEX i1_1 ON t1(b);\n    SELECT a FROM t1 WHERE b=zeroblob(10000);",
          "expect": "5"
        }
      ]
    },
    {
      "name": "zeroblob-3.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT count(DISTINCT a) FROM (\n        SELECT x'00000000000000000000' AS a\n        UNION ALL\n        SELECT zeroblob(10) AS a\n      )",
          "expect": "1"
        }
      ]
    },
    {
      "name": "zeroblob-4.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT hex(zeroblob(2) || x'61')",
          "expect": "000061"
        }
      ]
    },
    {
      "name": "zeroblob-5.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT CAST (zeroblob(100) AS REAL);",
          "expect": "0.0"
        }
      ]
    },
    {
      "name": "zeroblob-5.2",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT CAST (zeroblob(100) AS INTEGER);",
          "expect": "0"
        }
      ]
    },
    {
      "name": "zeroblob-5.3",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT CAST (zeroblob(100) AS TEXT);",
          "expect": "{}"
        }
      ]
    },
    {
      "name": "zeroblob-5.4",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT CAST(zeroblob(100) AS BLOB);"
        }
      ]
    },
    {
      "name": "zeroblob-6.1.1",
      "steps": [
        {
          "type": "exec",
          "sql": "select zeroblob(-1)",
          "expect": "{}"
        }
      ]
    },
    {
      "name": "zeroblob-6.1.2",
      "steps": [
        {
          "type": "exec",
          "sql": "select zeroblob(-10)",
          "expect": "{}"
        }
      ]
    },
    {
      "name": "zeroblob-6.1.3",
      "steps": [
        {
          "type": "exec",
          "sql": "select zeroblob(-100)",
          "expect": "{}"
        }
      ]
    },
    {
      "name": "zeroblob-6.2",
      "steps": [
        {
          "type": "exec",
          "sql": "select length(zeroblob(-1))",
          "expect": "0"
        }
      ]
    },
    {
      "name": "zeroblob-6.3",
      "steps": [
        {
          "type": "exec",
          "sql": "select zeroblob(-1)|1",
          "expect": "1"
        }
      ]
    },
    {
      "name": "zeroblob-6.4",
      "steps": [
        {
          "type": "catch",
          "sql": "select length(zeroblob(2147483648))",
          "expect": "1 {string or blob too big}"
        }
      ]
    },
    {
      "name": "zeroblob-6.5",
      "steps": [
        {
          "type": "catch",
          "sql": "select zeroblob(2147483648)",
          "expect": "1 {string or blob too big}"
        }
      ]
    },
    {
      "name": "zeroblob-6.6",
      "steps": [
        {
          "type": "exec",
          "sql": "select hex(zeroblob(-1))",
          "expect": "{}"
        }
      ]
    },
    {
      "name": "zeroblob-6.7",
      "steps": [
        {
          "type": "exec",
          "sql": "select typeof(zeroblob(-1))",
          "expect": "blob"
        }
      ]
    },
    {
      "name": "zeroblob-7.1",
      "steps": [
        {
          "type": "prepare_stmt",
          "sql": "SELECT length(?)",
          "variable": "stmt_1"
        },
        {
          "type": "stmt_step",
          "sql": "SELECT length(?)",
          "variable": "stmt_1"
        },
        {
          "type": "runtime_assert",
          "sql": "__STEP_stmt_1__",
          "expect": "SQLITE_ROW"
        }
      ]
    },
    {
      "name": "zeroblob-7.3",
      "steps": [
        {
          "type": "stmt_finalize",
          "sql": "SELECT length(?)",
          "variable": "stmt_1",
          "expect": "SQLITE_OK"
        }
      ]
    },
    {
      "name": "zeroblob-7.4",
      "steps": [
        {
          "type": "runtime_var",
          "variable": "sqlite3_max_blobsize",
          "expect": "0"
        }
      ]
    },
    {
      "name": "zeroblob-8.1",
      "steps": [
        {
          "type": "exec",
          "sql": "SELECT 'hello' AS a, zeroblob(10) as b from t1 ORDER BY a, b;",
          "expect": "8"
        }
      ]
    },
    {
